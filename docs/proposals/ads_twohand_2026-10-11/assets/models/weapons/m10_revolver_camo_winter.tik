TIKI
setup
{
	//[user 2026-08-17] East's S&W M10 .38, imported as an ADDITION. His mod replaces the Colt 45
	//and also ships fps_anims_pistol.txt (our pistol animation table) and colt45fire1.wav (our own
	//pro-audio Colt recording); neither is taken. His shader names were grip / body / hammer /
	//barrel / aim - the unsuffixed originals he renamed to grip96 / body96 on his own C96 exactly
	//because they collide - so all thirteen are prefixed coop_m10_ over textures/coop_m10/.
	//Everything below is OUR colt45.tik, so the revolver inherits our sidearm tuning.
	scale 0.52
	path models/weapons/coop_m10
	skelmodel m10.skd
	surface Cylinder1 shader coop_skin_m10_revolver_camo_winter_8
	surface Cube1     shader coop_skin_m10_revolver_camo_winter_2
	surface Cylinder6 shader coop_skin_m10_revolver_camo_winter_7
	surface Cone1     shader coop_skin_m10_revolver_camo_winter_11
	surface Cylinder4 shader coop_skin_m10_revolver_camo_winter_1
	surface Tube3     shader coop_skin_m10_revolver_camo_winter_5
	surface Tube2     shader coop_skin_m10_revolver_camo_winter_6
	surface Tube1     shader coop_skin_m10_revolver_camo_winter_3
	surface Cube2     shader coop_skin_m10_revolver_camo_winter_4
	surface Cube3     shader coop_skin_m10_revolver_camo_winter_0
	surface Cylinder5 shader coop_skin_m10_revolver_camo_winter_10
	//[user 2026-08-17] Was coop_m10_cyop - a truncated name that nothing defined, so this surface
	//drew untextured. The real shader is coop_m10_cyopen1 (coop_m10_cyopen2 is its unreferenced
	//twin; the pack ships 13 textures for 12 surfaces).
	surface Cylinder2 shader coop_skin_m10_revolver_camo_winter_9
	surface coop_m10_face shader coop_m10_face
	surface coop_m10_heads shader coop_m10_heads
	// HZM coop [revolver chambers 2026-10-12] one head per chamber: the cgame draws coop_round<N> iff N <= rounds in the
	// gun (m10rounds.py); the all-six surface is kept in the mesh but never drawn (init: +nodraw)
	surface coop_round1 shader coop_m10_heads
	surface coop_round2 shader coop_m10_heads
	surface coop_round3 shader coop_m10_heads
	surface coop_round4 shader coop_m10_heads
	surface coop_round5 shader coop_m10_heads
	surface coop_round6 shader coop_m10_heads
}
$define sounddir sound/weapons

init
{
	server
	{
		surface coop_m10_heads +nodraw	// HZM coop [revolver chambers] replaced by coop_round1..6
	//========================================//
	//		WEAPON NAME		  //
	//========================================//

		classname		Weapon
		weapontype		pistol
		name			"S&W M10 .38 (Winter)"
		//[user 2026-08-17] unique rank - a shared one hides the gun on the weapon wheel
		rank			1604 1604
	//========================================//
	//		WEAPON ACCURACY 	  //
	//========================================//
//		Colt .45 Pistol: Max Eff. Range is 15-25 yds with a muzzle velocity of 805 ft/s. (.45 ACP round)

		sp bulletrange		4000 			//the range at which bulletspread is applied
		sp bulletspread		60 60 100 100 	//  minpitch minyaw maxpitch maxyaw
		sp firespreadmult	0.38 0.7 200 0.6	//add falloff cap maxtime

		dm bulletrange		4000 			//the range at which bulletspread is applied fully (5 yards)
//		dm bulletspread		60 60 130 130 	//minpitch minyaw maxpitch maxyaw(offsets in world units) spread is maximum at top movement speed
//		dm bulletspread		48 48 70 70 	//minpitch minyaw maxpitch maxyaw(offsets in world units) spread is maximum at top movement speed
		dm bulletspread		45 45 65 65 	//minpitch minyaw maxpitch maxyaw(offsets in world units) spread is maximum at top movement speed

		dm firespreadmult	0.48 0.5 200 0.6	//add falloff cap maxtime 0.38 0.7 200 0.6 (original)

		realism bulletrange	4000 			//the range at which bulletspread is applied fully (5 yards)
		realism bulletspread	45 45 65 65	//minpitch minyaw maxpitch maxyaw(offsets in world units) spread is maximum at top movement speed
		realism firespreadmult	0.48 0.5 200 0.6	//add falloff cap maxtime 0.38 0.7 200 0.6 (original)

	//========================================//
	//		DAMAGE / RATE OF FIRE	  //
	//========================================//

		sp bulletdamage		35
		dm bulletdamage		37	//originally 35, 30, 35, 40
		sprealism bulletdamage	55	//originally 35, 30, 35, 40
		dmrealism bulletdamage	55

		sp firedelay		0.14
		dm firedelay		0.14
		realism firedelay	0.14

	//========================================//
	//		PLAYER MOVEMENT		  //
	//========================================//

		sp movementspeed 	1.0	
		dm movementspeed 	1.0	
		realism movementspeed 	1.0	

	//========================================//
	//		RIFLE BUTT / SECONDARY FIRE//
	//========================================//

		secondary firetype			melee
		secondary ammotype			none
		secondary ammorequired		0
		secondary meansofdeath		bash
		secondary bulletknockback	50
		secondary quiet

		sp secondary bulletrange	64
		sp secondary bulletdamage	25

		dm secondary bulletrange	96
		dm secondary bulletdamage	35

		realism secondary bulletrange	96
		realism secondary bulletdamage	35

	//========================================//
	//		AMMO			  //
	//========================================//

		firetype		bullet
		ammotype		"pistol"
		meansofdeath	bullet
		semiauto
		bulletcount		1
		clipsize		6	// HZM coop [2026-10-12] six chambers
		ammorequired	1

		sp startammo	8
		dm startammo	24	// HZM coop [2026-10-12] six chambers
		sprealism startammo	8
		dmrealism startammo	12	// HZM coop [2026-10-12] six chambers

	//========================================//
	//		CROSSHAIR, ZOOM, TRACERS  //
	//========================================//

		sp tracerfrequency 	1
		dm tracerfrequency 	0
		sprealism tracerfrequency 	1
		dmrealism tracerfrequency 	0

		crosshair			1

	//========================================//
	//		SOUND, AI, OTHER	  //
	//========================================//

		pickupsound		colt45_snd_pickup
		ammopickupsound		colt45_snd_pickup_ammo
		noammosound		colt45_snd_noammo

		// Holstering info
holstertag				"Bip01 Pelvis"
holsteroffset				"1.5 -4 -10.0"
holsterangles				"5 190 195"
holsterScale				1.0

		// AI animation group info
		weapongroup		pistol
		airange			short
		
		// this is attached to the player during reload
		cache models/ammo/colt_clip.tik

		//[200] Smithy - get handled
		exec coop_mod/itemhandler.scr "initialiseItem" "pistol" "Colt 45"
	}
	client
	{
		cache muzsprite.spr
		cache models/ammo/pistolshell.tik
	}
}

animations
{
	//[user 2026-08-17] His world animation. Shell-ejection FX were removed
	//with the tag_eject references above - a revolver does not eject, and
	//his mesh carries no tag_eject for them to attach to.
	idle		m10.skc
	idle_empty	m10.skc
	// HZM coop [revolver reload 2026-10-12] the cylinder + crane + ejector rod swing out on their own bone (coop_cyl,
	// split out of the mesh): open / one round at a time / close, as the Webley's start / single / end.
	reload		coop_m10_open.skc
	{
		server
		{
		}
		client
		{
				entry sound colt45_snd_reload item
		}
	}
	reload_single	coop_m10_single_slow.skc
	{
		client
		{
			12 sound webley_snd_reload_single
		}
	}
	// HZM coop [aimed revolver rows] the gun worked LOW under the centre box: its own open / close eased and earlier
	reload_end_ads	coop_m10_close_ads.skc
	{
		client
		{
			5 sound webley_snd_reload_end
		}
	}
	// HZM coop [aimed revolver rows end]
	reload_end	coop_m10_close.skc
	{
		server
		{
			last idle
		}
		client
		{
			8 sound webley_snd_reload_end
		}
	}
	secondaryfire     m10.skc
	{
		server
		{
			entry shoot secondary
		}
	}
	fire     fire_colt45.skc
	{
		server
		{
			entry shoot primary
		}
		client
		{
			entry stopaliaschannel m10_snd_fire
			entry sound m10_snd_fire

			// By now, the server has already fired the weapon, so it's
			// ok to apply the view kick apon entry to avoid problems
			// with multiple application on single frame animations.

			////////////////////////////////////////////////////////////////////////////////////////
			// View Kick Controls
			//
			// View Kicking works based on the assumptions that every weapon has its own tendencies to kick in
			// a paticular fashion. In MOH we call then scatter patterns. Currently we have 2 scatter patterns which
			// will be explained.
			// Scatter Patterns:
			// "V" - the cone. The longer you shoot the more random your shots will be in the horizontal axis.
			// "T" - the T shape. The gun has a tendancy to push in a paticular direction. not used much...too artificial looking
			//
			//
			//             		+-------------------------------------------- Scatter Pitch Min
			//              		|    +--------------------------------------- Scatter Pitch Max
			//              		|    |       +------------------------------- Scatter Yaw Min
			//             		|    |       |   +--------------------------- Scatter Yaw Max
			//             		|    |       |   |     +--------------------- The Recentering speed in fraction per second
			//              		|    |       |   |     |    +---------------- The Scatter Pattern
			//              		|    |       |   |     |    |     +---------- The absolute pitch min/max
			//              		|    |       |   |     |    |     |  +------- The absolute yaw min/max
			//              		|    |       |   |     |    |     |  | +----- This is the pitch at which you loose all
			//              		|    |       |   |     |    |     |  | |      control of the weapon and its behavior is
			//             	 	|    |       |   |     |    |     |  | |      purely random.
			//				V    V       V   V     V    V     V  V V

			entry viewkick 	    -1.2 -1.2   -0.2  0.2    1   "V"    3.0 1.0 1.6

			// muzzle flash
			entry tagdlight tag_barrel 0.25 0.2 0.15 120 0.11
			entry tagspawnlinked tag_barrel
			(
				scale 0.2
				alpha 0.5
				offsetalongaxis 2 0 0
				count 1
				model muzsprite.spr
				angles 0 0 crandom 25
				life 0.04
				randomroll
				fade
			)
			entry tagspawnlinked tag_barrel
			(
				count 1
				scalemin 0.25
				scalemax 0.5
				model muzsprite.spr
				randomroll
				life 0.04
//				alpha 0.5
				fade
			)

			// smoke puff
			entry tagspawn tag_barrel
			(
				count 2
				model vsssource.spr
				alpha 0.30
				color 0.50 0.50 0.50
				spritegridlighting
				scale 0.3
				life 1.00
				scalerate 10.00
				velocity 80.00
				randvel range 20 -60 crandom -40 range 20 -60
				friction 5.00
				fade
				randomroll
			)

			// shell eject
		}
	}
	fire_empty   m10.skc
	{
		server
		{
			entry shoot primary
		}
		client
		{
			entry stopaliaschannel m10_snd_fire
			entry sound m10_snd_fire

			// By now, the server has already fired the weapon, so it's
			// ok to apply the view kick apon entry to avoid problems
			// with multiple application on single frame animations.

			////////////////////////////////////////////////////////////////////////////////////////
			// View Kick Controls
			//
			// View Kicking works based on the assumptions that every weapon has its own tendencies to kick in
			// a paticular fashion. In MOH we call then scatter patterns. Currently we have 2 scatter patterns which
			// will be explained.
			// Scatter Patterns:
			// "V" - the cone. The longer you shoot the more random your shots will be in the horizontal axis.
			// "T" - the T shape. The gun has a tendancy to push in a paticular direction. not used much...too artificial looking
			//
			//
			//             		+-------------------------------------------- Scatter Pitch Min
			//              		|    +--------------------------------------- Scatter Pitch Max
			//              		|    |       +------------------------------- Scatter Yaw Min
			//             		|    |       |   +--------------------------- Scatter Yaw Max
			//             		|    |       |   |     +--------------------- The Recentering speed in fraction per second
			//              		|    |       |   |     |    +---------------- The Scatter Pattern
			//              		|    |       |   |     |    |     +---------- The absolute pitch min/max
			//              		|    |       |   |     |    |     |  +------- The absolute yaw min/max
			//              		|    |       |   |     |    |     |  | +----- This is the pitch at which you loose all
			//              		|    |       |   |     |    |     |  | |      control of the weapon and its behavior is
			//             	 	|    |       |   |     |    |     |  | |      purely random.
			//				V    V       V   V     V    V     V  V V

			entry viewkick 	    -1.2 -1.2   -0.2  0.2    1   "V"    3.0 1.0 1.6

			// muzzle flash
			entry tagdlight tag_barrel 0.25 0.2 0.15 120 0.11
			entry tagspawnlinked tag_barrel
			(
				scale 0.2
				alpha 0.5
				offsetalongaxis 2 0 0
				count 1
				model muzsprite.spr
				angles 0 0 crandom 25
				life 0.04
				randomroll
				fade
			)
			entry tagspawnlinked tag_barrel
			(
				count 1
				scalemin 0.25
				scalemax 0.5
				model muzsprite.spr
				randomroll
				life 0.04
//				alpha 0.5
				fade
			)

			// smoke puff
			entry tagspawn tag_barrel
			(
				count 2
				model vsssource.spr
				alpha 0.30
				color 0.50 0.50 0.50
				spritegridlighting
				scale 0.3
				life 1.00
				scalerate 10.00
				velocity 80.00
				randvel range 20 -60 crandom -40 range 20 -60
				friction 5.00
				fade
				randomroll
			)

			// shell eject
		}
	}
	guardfire_i    fire_colt45.skc
	{
		client
		{
			entry stopaliaschannel m10_snd_fire
			entry sound m10_snd_fire

			// By now, the server has already fired the weapon, so it's
			// ok to apply the view kick apon entry to avoid problems
			// with multiple application on single frame animations.

			////////////////////////////////////////////////////////////////////////////////////////
			// View Kick Controls
			//
			// View Kicking works based on the assumptions that every weapon has its own tendencies to kick in
			// a paticular fashion. In MOH we call then scatter patterns. Currently we have 2 scatter patterns which
			// will be explained.
			// Scatter Patterns:
			// "V" - the cone. The longer you shoot the more random your shots will be in the horizontal axis.
			// "T" - the T shape. The gun has a tendancy to push in a paticular direction. not used much...too artificial looking
			//
			//
			//             		+-------------------------------------------- Scatter Pitch Min
			//              		|    +--------------------------------------- Scatter Pitch Max
			//              		|    |       +------------------------------- Scatter Yaw Min
			//             		|    |       |   +--------------------------- Scatter Yaw Max
			//             		|    |       |   |     +--------------------- The Recentering speed in fraction per second
			//              		|    |       |   |     |    +---------------- The Scatter Pattern
			//              		|    |       |   |     |    |     +---------- The absolute pitch min/max
			//              		|    |       |   |     |    |     |  +------- The absolute yaw min/max
			//              		|    |       |   |     |    |     |  | +----- This is the pitch at which you loose all
			//              		|    |       |   |     |    |     |  | |      control of the weapon and its behavior is
			//             	 	|    |       |   |     |    |     |  | |      purely random.
			//				V    V       V   V     V    V     V  V V

			entry viewkick 	    -1.2 -1.2   -0.2  0.2    1   "V"    3.0 1.0 1.6

			// muzzle flash
			entry tagdlight tag_barrel 0.25 0.2 0.05 120 0.11
			entry tagspawnlinked tag_barrel
			(
				scale 0.2
				alpha 0.5
				offsetalongaxis 2 0 0
				count 1
				model muzsprite.spr
				angles 0 0 crandom 25
				life 0.04
				randomroll
				fade
			)
			entry tagspawnlinked tag_barrel
			(
				count 1
				scalemin 0.25
				scalemax 0.5
				model muzsprite.spr
				randomroll
				life 0.04
//				alpha 0.5
				fade
			)

			// smoke puff
			entry tagspawn tag_barrel
			(
				count 2
				model vsssource.spr
				alpha 0.30
				color 0.50 0.50 0.50
				spritegridlighting
				scale 0.3
				life 1.00
				scalerate 10.00
				velocity 80.00
				randvel range 20 -60 crandom -40 range 20 -60
				friction 5.00
				fade
				randomroll
			)

			// shell eject
		}
	}

	guardfire_ii     fire_colt45.skc
	{
		client
		{
			entry stopaliaschannel m10_snd_fire
			entry sound m10_snd_fire

			// By now, the server has already fired the weapon, so it's
			// ok to apply the view kick apon entry to avoid problems
			// with multiple application on single frame animations.

			////////////////////////////////////////////////////////////////////////////////////////
			// View Kick Controls
			//
			// View Kicking works based on the assumptions that every weapon has its own tendencies to kick in
			// a paticular fashion. In MOH we call then scatter patterns. Currently we have 2 scatter patterns which
			// will be explained.
			// Scatter Patterns:
			// "V" - the cone. The longer you shoot the more random your shots will be in the horizontal axis.
			// "T" - the T shape. The gun has a tendancy to push in a paticular direction. not used much...too artificial looking
			//
			//
			//             		+-------------------------------------------- Scatter Pitch Min
			//              		|    +--------------------------------------- Scatter Pitch Max
			//              		|    |       +------------------------------- Scatter Yaw Min
			//             		|    |       |   +--------------------------- Scatter Yaw Max
			//             		|    |       |   |     +--------------------- The Recentering speed in fraction per second
			//              		|    |       |   |     |    +---------------- The Scatter Pattern
			//              		|    |       |   |     |    |     +---------- The absolute pitch min/max
			//              		|    |       |   |     |    |     |  +------- The absolute yaw min/max
			//              		|    |       |   |     |    |     |  | +----- This is the pitch at which you loose all
