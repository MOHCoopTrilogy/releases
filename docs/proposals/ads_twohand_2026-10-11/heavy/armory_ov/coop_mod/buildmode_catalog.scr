	// ---- 39: POSED SOLDIERS (11) ----
	// [user 07-18] Retail AA "posed" set-dressing figures (models/posed/) - pre-posed static
	// soldiers, a gunner tableau and dogs, distinct from cat 17/24 lying corpses. Loaded straight
	// from the retail paks (main/Pak0.pk3), so no files ship in the mod pk3. This category is COVER:
	// human-height solids, so KP0 'solid' gives a SOLID_BBOX the takecover.scr traces work against.
	// DEFAULTS TO SOLID on entry (coop_build_catIsCover, same hook as cats 34/35/37). No per-item
	// setsize - bug-829 rescales the hull from runtime bounds when you scale one up.
	// NOTE: only the 11 posed tiks whose skelmodel mesh AND idle anim BOTH still resolve in the GOG
	// War Chest data are listed. The other 21 posed tiks (incl. german_wehrmact_soldier + variants,
	// mg42_posed, the officers, panzer_shutze/obershutze/tankcommander, waffenss_shutze, allied_ranger,
	// and several whose idle .skc was dropped) reference .skb meshes / .skc anims that the repack
	// replaced with differently-named .skd files. openmohaa-hzm loads skelmodels by exact path+ext
	// with no .skb->.skd fallback, and a missing precached anim aborts the whole tiki (returns NULL),
	// so those would spawn nothing - they are intentionally omitted. See _research/buildmode_object_inventory.md.
	level.coop_build_catname[39] = "POSED SOLDIERS"
	level.coop_build_item[39][1]  = "models/posed/30cal_posed.tik"			// posed .30cal + gunner tableau (AA)
	level.coop_build_item[39][2]  = "models/posed/german_afrika_private.tik"		// DAK private
	level.coop_build_item[39][3]  = "models/posed/german_afrika_grenedeir.tik"	// DAK grenadier
	level.coop_build_item[39][4]  = "models/posed/german_afrika_nco.tik"		// DAK NCO
	level.coop_build_item[39][5]  = "models/posed/german_misc_frogman.tik"		// specialist - frogman
	level.coop_build_item[39][6]  = "models/posed/german_worker.tik"			// laborer
	level.coop_build_item[39][7]  = "models/posed/allied_pilot.tik"			// US pilot
	level.coop_build_item[39][8]  = "models/posed/allied_resistance_manon.tik"	// resistance - Manon
	level.coop_build_item[39][9]  = "models/posed/french_resistance-jeff.tik"	// French resistance - Jeff
	level.coop_build_item[39][10] = "models/posed/french_resistance-paul.tik"	// French resistance - Paul
	level.coop_build_item[39][11] = "models/posed/german_shepherd.tik"		// German shepherd dog
	level.coop_build_itemcount[39] = 11
