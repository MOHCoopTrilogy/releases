	// ---- 33: GEOMETRY (SCALABLE) (14) ----
	// [user 07-17] Textured BOX primitives to recreate the baked func_crate brushwork you can't spawn as
	// models (1,653 crates across the maps are BSP brushes, not props). Each is the stock unit cube
	// (cube_CampFire.skd) wired to a map-authentic crate/material shader; place, SCALE (KP+/-) to any size,
	// rotate, solid-toggle for collision. The texture picker = cycle the item (each is one texture).
	// Assets: models/coop_build/box_*.tik. Design: _research/buildmode_geometry_research.md.
	level.coop_build_catname[33] = "GEOMETRY (SCALABLE)"
	level.coop_build_item[33][1]  = "models/coop_build/box_crate_heat.tik"
	level.coop_build_item[33][2]  = "models/coop_build/box_crate_30cal.tik"
