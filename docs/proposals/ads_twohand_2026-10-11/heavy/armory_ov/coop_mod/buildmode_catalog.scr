	level.coop_build_item[33][14] = "models/coop_build/box_sandbag.tik"
	//[user 07-17] the two crate looks from the user's cover screenshots: the strapped Reichsadler
	// crate (nazi_crate - the big baked cover crates all over the maps) + the plain wooden indycrate.
	level.coop_build_item[33][15] = "models/coop_build/box_crate_nazi.tik"
	level.coop_build_item[33][16] = "models/coop_build/box_crate_indy.tik"
	//[user 07-17] complete the BAKED-ONLY cover looks (textures that exist on map brushes with no model):
	// reinforced German crate (the other big baked cover crate), U-boat pens food crates, panzer stowage
	// boxes (+winter), sandbag wall. HEIGHT GUIDE (cube ~16u @ 1.0): 3.0 = crouch cover, 4.0 = chest-high
	// (matches the baked crates), 6.0-8.0 = full standing cover. Place SOLID for the cover system.
	level.coop_build_item[33][17] = "models/coop_build/box_crate_reinforced.tik"
