	// ---- 40: SCENE EXTRAS (3) ----
	// [user 07-18] Small battlefield-scatter deco absent from the other cats. Loaded from the mounted
	// xw-weapons pak (maintt/zzzzz_xw_weapons.pk3) - dropped ammo clips, LOW footprint, deco (NOT
	// forced solid). No files ship in the coop pk3. The larger scene items originally scouted for this
	// category - rubble_bigpile, the SH office safe, the loose German helmets, papers_open2 and mg_box
	// - were SKIPPED: each references a mesh or idle anim that the GOG War Chest repack no longer ships
	// (safe/mg_box/g43clip carry a stale 'path', helmet/papers/rubble_bigpile lost their .skb/.skc),
	// so under openmohaa-hzm's exact-match loader they would fail to load. See the inventory doc.
	level.coop_build_catname[40] = "SCENE EXTRAS"
	level.coop_build_item[40][1] = "models/ammo/thompson_clip50.tik"		// dropped 50-rd Thompson drum
	level.coop_build_item[40][2] = "models/ammo/nambu_clip.tik"		// dropped Nambu clip
