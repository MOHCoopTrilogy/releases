	// ---- 38: MOHAARU SCENE (23) ----
	// [user 07-18] MOHAARU set-dressing (deco, NOT forced solid): a period cargo trike, autumn +
	// bare trees, autumn bushes, a HitP grass/bush/fern foliage row, three European shopfront signs,
	// market/butcher food clutter, a chair and three tavern bottles. Milkshape .skb + static .skd
	// meshes; shaders in scripts/coop_mohaaru_imports.shader (trees reuse vanilla natural textures).
	// NOTE: the church, coal-shoveling worker and all 5 HitP palms + the fern were SKIPPED at import
	// - their runtime textures ship in no MOHAARU pack/vanilla/mod, so they would render white.
	level.coop_build_catname[38] = "MOHAARU SCENE"
	level.coop_build_item[38][1]  = "models/milkshape/triporteur/triporteur.tik"		// civilian cargo tricycle
