	level.coop_build_item[35][8]  = "models/vehicles/t26r_d.tik"			// T-26 destroyed wreck
	level.coop_build_item[35][9]  = "models/static/ba6-cuerpo.tik"		// BA-6 armoured car body
	level.coop_build_item[35][10] = "models/static/ba6-torre.tik"		// BA-6 turret (pairs w/body)
