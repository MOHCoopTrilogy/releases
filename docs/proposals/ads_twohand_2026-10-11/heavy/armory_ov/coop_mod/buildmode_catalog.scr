	// ---- 34: COVER OBJECTS (14) ----
	// [user 07-18] Authentic in-game static props curated for COVER - real map art, and several
	// TALLER than the baked crates. Each is a normal static model: placed via KP0 'solid' it gets a
	// SOLID_BBOX clip from its runtime bounds, so the cover system (takecover.scr world traces) works
	// against it. This category DEFAULTS TO SOLID on entry (buildmode.scr catnext/catprev). Placed at
	// scale 1.0 the clip already matches the visual; if you SCALE one up, buildmode.scr's setsize
	// hull-fix (bug-829) rescales the collision to match. Sizes are the base bbox at scale 1.0
	// (WxDxH game units, ~1u=1in); TALL = ~90u+ (standing cover), MED = waist/chest.
	level.coop_build_catname[34] = "COVER OBJECTS"
	level.coop_build_item[34][1]  = "models/static/vehicle_shermantank_dead.tik"	// TALL wrecked tank   349x127x146
	level.coop_build_item[34][2]  = "models/static/vehicle_dtruck_burnt.tik"	// TALL burnt truck    198x92x93
	level.coop_build_item[34][3]  = "models/static/vehicle_dtruck_rusted.tik"	// TALL rusted truck   198x92x93
	level.coop_build_item[34][4]  = "models/static/vehicle_car_burnt.tik"		// TALL burnt car      259x100x94
	level.coop_build_item[34][5]  = "models/static/vehicle_car_rusted.tik"		// TALL rusted car     259x100x94
	level.coop_build_item[34][6]  = "models/static/rock_large.tik"			// TALL boulder        121x137x120
	level.coop_build_item[34][7]  = "models/static/rock_winter_large.tik"		// TALL snow boulder   121x137x120
	level.coop_build_item[34][8]  = "models/static/rock_large_brown.tik"		// TALL desert boulder 121x137x120
	level.coop_build_item[34][9]  = "models/static/static_powerbox2.tik"		// MED concrete box    28x65x78
	level.coop_build_item[34][10] = "models/static/static_powerbox1.tik"		// MED concrete box    24x47x59
	level.coop_build_item[34][11] = "models/static/cart.tik"			// MED wooden cart     78x184x53
	level.coop_build_item[34][12] = "models/static/produce_cart.tik"		// MED produce cart    99x68x52
	level.coop_build_item[34][13] = "models/static/peetrough.tik"			// MED stone trough    32x128x41
	level.coop_build_item[34][14] = "models/static/rock_medium.tik"			// LOW rock (crouch)   44x55x31
	level.coop_build_itemcount[34] = 14
	level.coop_build_catIsCover[34] = 1		// buildmode.scr defaults cover categories to SOLID on entry

	// ---- 35: 1936 COVER (15) ----
	// [user 07-18] Imported placeable objects from the "1936" Spanish-Civil-War total conversion
	// (moddb.com/mods/1936). This category is COVER: masonry wall, hedge, period trucks, armour + a
	// wreck, two monuments, and the Maxim HMG - all solid blockers. DEFAULTS TO SOLID on entry (same
	// hook as cat 34, via coop_build_catIsCover). Vehicle tiks spawn as static props here (a
	// script_model does not run their VehicleTank init), so the tank/armoured-car TURRETS are separate
	// items - place the hull first, then drop the turret on top. Custom shaders ship in
	// scripts/coop_1936_imports.shader; some surfaces reuse vanilla panzer_iv/opel/dtruck/it_p_statue
	// shaders already in the trilogy. Scale (KP+/-) to taste; bug-829 setsize keeps the solid hull matched.
	level.coop_build_catname[35] = "1936 COVER"
	level.coop_build_item[35][1]  = "models/static/muro.tik"			// masonry wall segment
	level.coop_build_item[35][2]  = "models/static/seto.tik"			// hedge row (low cover)
	level.coop_build_item[35][3]  = "models/static/zis5.tik"			// ZIS-5 cargo truck
	level.coop_build_item[35][4]  = "models/static/zis5a.tik"			// ZIS-5 cargo truck (variant)
