	level.coop_build_itemcount[40] = 3

	// ---- 42: LIGHTS (DYNAMIC) (4) ----      [user 2026-08-05] bug-1403
	// Real runtime illumination. A light FIXTURE from category 14 is only geometry - MOHAA room
	// lighting is a lightmap baked into the BSP and nothing at runtime can change it. These are
	// invisible FX emitters carrying the client 'dlight' command (cg_commands.cpp:678), which is
	// the engine's only runtime light source. Place one alongside a fixture model.
	// HARD BUDGET: MAX_DLIGHTS is 32 engine-wide and cannot be increased, because bit flags are
	// used on surfaces (tr_types.h:27). Muzzle flashes and explosions share that pool, so
	// props.scr caps PLACED lights at coop_lightBudget (default 14) with a warning from 10.
	level.coop_build_catname[42] = "LIGHTS (DYNAMIC)"
	level.coop_build_item[42][1] = "models/coop_build/light_warm.tik"		// lamp        r260
	level.coop_build_item[42][2] = "models/coop_build/light_white.tik"		// work light  r300
	level.coop_build_item[42][3] = "models/coop_build/light_cold.tik"		// moonlight   r340
	level.coop_build_item[42][4] = "models/coop_build/light_fire.tik"		// brazier     r200
	//[user 2026-08-05] BRIGHT tier - colour is passed to the renderer UNCLAMPED
	//(tr_scene.c:317-319), so values over 1.0 are a legitimate brightness control. These roughly
	//double the colour AND widen the radius; intensity is the RADIUS and is independent of colour.
	level.coop_build_item[42][5] = "models/coop_build/light_warm_bright.tik"	// lamp BRIGHT      r380
	level.coop_build_item[42][6] = "models/coop_build/light_white_bright.tik"	// work BRIGHT      r420
	level.coop_build_item[42][7] = "models/coop_build/light_cold_bright.tik"	// moonlight BRIGHT r460
	level.coop_build_item[42][8] = "models/coop_build/light_fire_bright.tik"	// brazier BRIGHT   r300
	level.coop_build_itemcount[42] = 8

	// ---- 43: LADDERS (CLIMBABLE) (4) ----   [user 2026-08-05] bug-1412
	// Placing one spawns a real func_ladder climb volume beside the visual (props.scr).
	// MOHAA ships no ladder MODEL - vanilla ladders are brush geometry - so these are the
	// shape_post primitive wearing the stock ladder textures.
	level.coop_build_catname[43] = "LADDERS (CLIMBABLE)"
	level.coop_build_item[43][1] = "models/coop_build/ladder_rusty.tik"
	level.coop_build_item[43][2] = "models/coop_build/ladder_metal.tik"
	level.coop_build_item[43][3] = "models/coop_build/ladder_clean.tik"
	level.coop_build_item[43][4] = "models/coop_build/ladder_wood.tik"
	level.coop_build_itemcount[43] = 4

	// ---- 44: SUPPORT (HOLDOUT) (1) ----   [user 2026-08-05]
	// The CALL RADIO: place ONE near each holdout point. Mid-wave, when only one player is left
	// standing, the last man holds USE at it ONCE to respawn the whole squad (holdout.scr).
	level.coop_build_catname[44] = "SUPPORT (HOLDOUT)"
	level.coop_build_item[44][1] = "models/miscobj/radio_military.tik"
	level.coop_build_itemcount[44] = 1

	level.coop_build_catcount = 44	//[user 2026-08-05] 44 = SUPPORT (HOLDOUT)
	level.coop_build_catalogReady = 1
}end
