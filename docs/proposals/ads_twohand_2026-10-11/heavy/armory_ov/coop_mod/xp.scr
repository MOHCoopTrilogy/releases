	level.coop_xp_rankUnlockCnt[19] = 1
	level.coop_xp_rankUnlock[19][0] = "models/weapons/fg42.tik"

	//[user 2026-08-23, bug-2080] ARMORY GLOVES by rank. Appended with the running count so they
	//sit alongside whatever that rank already grants rather than overwriting index 0.
	level.coop_xp_rankUnlock[6][ level.coop_xp_rankUnlockCnt[6] ] = "glv_uswinter"
