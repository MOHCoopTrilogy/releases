// [302] HZM XP SYSTEM - Phase 1 (tracking + persistence + end-of-map debrief + own-rank HUD)
// Design doc: _research/xp_system.md. Every award funnels through xp_award (single entry point).
//
// Identity:    cl_guid userinfo (persistent per install; autoexec ships cl_guidServerUniq 0),
//              fallback "n_"+netname for clients with no guid.
// Persistence: write-through server cvar coop_xp_<id> (survives map transitions) +
//              fs_write_content file coop_mod/save/xp_<id>.dat (survives server restarts).
//              NEVER park XP in game.* - the coop transition wipes it.
// Per-player:  self.flags["coop_xp_id" / "coop_xp_total" / "coop_xp_map" / "coop_xp_rank" /
//              "coop_xp_join" / "coop_xp_rankmapstart"] + breakdown buckets
//              self.flags["coop_xp_b_kills" / _valor / _objective / _support / _revive / _mission].
// HUD slots:   62 emblem, 63 rank text (persistent own-rank HUD);
//              64 bar bg, 65 bar fill, 66-68 breakdown lines, 69 toast (debrief card only).

//=========================================================================
// Init - threaded from main.scr::main right after server.scr::main.
//=========================================================================
xp_init:{
	if( level.coop_xp_init == 1 ){ end }
	level.coop_xp_init = 1

	local.en = getcvar "coop_xp"
	level.coop_xp_enabled = 1
	if( local.en == "0" ){ level.coop_xp_enabled = 0 }

	level.coop_xp_scale = 1
	local.sc = getcvar "coop_xp_scale"
	if( local.sc != "" && local.sc != "0" ){ level.coop_xp_scale = float( local.sc ) }

	// [235] seed the kill-popup toggle so the coop-settings checkbox reflects the real default (ON)
	if( getcvar "coop_xpKillPopup" == "" ){ setcvar "coop_xpKillPopup" "1" }

	// [user 07-10] 22-rank ladder (US Army WW2, Technician grades + generals to 5-star). Thresholds are
	// LOCKED once players have XP on file. level.coop_xp_rankMax is the top index - use it, never a literal.
	level.coop_xp_rankMax = 21

	//[user 07-16] WEAPON UNLOCKS per rank (give-tik). Skill-tree ids (30cal/mg42/rockets) absent;
	//variants come from challenge kill-chains; HDM pinned R2 (guaranteed before the m2 U-boat map).
	level.coop_xp_rankUnlockCnt[1] = 2
	level.coop_xp_rankUnlock[1][0] = "models/weapons/carbine.tik"
	level.coop_xp_rankUnlock[1][1] = "models/weapons/p38.tik"
	level.coop_xp_rankUnlockCnt[2] = 2
	level.coop_xp_rankUnlock[2][0] = "models/weapons/silencedpistol.tik"
	level.coop_xp_rankUnlock[2][1] = "models/weapons/steilhandgranate_start.tik"
	level.coop_xp_rankUnlockCnt[3] = 2
	level.coop_xp_rankUnlock[3][0] = "models/weapons/kar98.tik"
	level.coop_xp_rankUnlock[3][1] = "models/weapons/mills_grenade_sp_start.tik"
	level.coop_xp_rankUnlockCnt[4] = 2
	level.coop_xp_rankUnlock[4][0] = "models/weapons/sten.tik"
	level.coop_xp_rankUnlock[4][1] = "models/weapons/lugerp08.tik"
	level.coop_xp_rankUnlockCnt[5] = 2
	level.coop_xp_rankUnlock[5][0] = "models/weapons/g43.tik"
	level.coop_xp_rankUnlock[5][1] = "models/weapons/m18_smoke_grenade_start.tik"
	level.coop_xp_rankUnlockCnt[6] = 2
	level.coop_xp_rankUnlock[6][0] = "models/weapons/ppsh_smg.tik"
	level.coop_xp_rankUnlock[6][1] = "models/weapons/webley_revolver.tik"
	level.coop_xp_rankUnlockCnt[7] = 2
