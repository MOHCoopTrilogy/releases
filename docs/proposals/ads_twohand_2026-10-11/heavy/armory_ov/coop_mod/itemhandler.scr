//[200] Smithy - this script is called every time an item enters the world by exec it on their tiki
//Handles all pickups of weapons and items in the level
//Manages player weapon loadouts for each mission
//Implements item respawning
//Enables multiple main weapons in MP gametypes
//---------------------------------------------------
//  level.coop_itemHandler					= 1		//use the coop item handler
//  level.coop_healthDropFreq 				= 5 	//every num of axis deaths drop a health kit (5 is default engine behavior, 0 turns off health drops)
//  level.coop_healthRespawnTime 			= 30 	//respawn time (seconds) for world (bsp or script) health items
//	level.coop_ammoRespawnTime 				= 30 	//respawn time (seconds) for world (bsp or script) weapon and ammo items
//	level.coop_retainInventory 				= 1 	//keep all weapons from previous life (0 to turn off)
//	level.coop_disableHealthItems 			= 0		//disable all health items except for enemy drops and scripted items with targetnames
//	level.coop_disableAmmoItems 			= 0 	//disable all ammo items except for scripted items with targetnames
//---------------------------------------------------
//Misc info:
//---------------------------------------------------
//	- items can be given their own respawn time with .flags["coop_itemRespawnTime"] (set to -1 to never respawn)
//	- you can get a player's active weapon with .flags["coop_activeWeapon"]. if it returns null it means it is holstered (or they dont have one)
//	- all inventory weapons for players are accessible via targetname array. convention is ("player" + player.entnum + "Inventory")
//
//---------------------------------------------------
//new functions you can use:
//---------------------------------------------------
//dropItem
// <entity>                             		<item to drop>      <do velocity>     <targetname>      <angles> <mass>
//Example: local.entity thread dropItem "items/item_25_healthbox.tik"  game.true       "droppedHealth"   (0 90 0)  1200
//---------------------------------------------------
//dropItemOnDeath
//local.actor thread dropItem <item model> <angles> <mass>
//---------------------------------------------------
//=========================================================================
main local.thread local.arg1 local.arg2:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/main->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.threadName = "coop_mod/itemhandler.scr::main"

	if !(waitthread coop_mod/main.scr::inCoopMode){ end } //dont load this if we aren't in coop mode
	if (!self){ end }
	
	if (local.thread == NIL){ end } 
	if (self.classname != "Health" && self.classname != "AmmoEntity" && self.classname != "Weapon"){ end }	

	//make sure main.scr has loaded
	waitthread coop_mod/main.scr::waitForMainScript
	if (!self){ end }


	//if we don't allow item handler end here
	if (!level.coop_itemHandler){ end }

	//these aren't used in coop
	if (self.model){
		if (self.model == "models/weapons/m18_smoke_grenade.tik" 	||
			self.model == "models/weapons/rdg-1_smoke_grenade.tik" 	||
			self.model == "models/weapons/nebelhandgranate.tik"){
			self delete
			end
		}
	}
	
	thread removeAdditionalStartAmmo
	
	//store parm.other that is updated on specific events, such as playerspawn:
	//https://github.com/openmoh/openmohaa/blob/54355278307a64d2e62e68f8450aeb3cdf7651b3/code/game/player.cpp#L4252
	//-----
	//as parm.other is a global var for ALL threads and is never cleared (only reset on further events),
	//and because items can spawn before/after a playerspawn event and NOT be attached to a player,
	//that means this is a POTENTIAL owner. However, the only use we have for this (checking player weapons)
	//means this will be right for the items we want to check.
	group.itemOwner 	= parm.other
	group.itemSpawnTime = level.time

	wait game.ms 							//so entities have properly initialised
	wait game.ms                            //two, so aihandler executes first if it is needed
											//(otherwise, when actors spawn, the weapon is handled first)
	if(!self){ end }

	//only init this once
	if(!level.coop_initItemHandler){
		level.coop_initItemHandler = game.true
		if (!level.coop_aaMap){
			level.coop_noDropHealth = game.true //don't conflict with maps that actually don't want health drops
		}else{
			level.nodrophealth = game.true 		//otherwise, no engine health drops needed as we do this ourselves now
		}
		setcvar "g_healrate" "100000" 			//this didn't seem to work in config. adding it here does
		setcvar "g_healthdrop" "0"				//we really don't need big health kits dropping in coop
	}

	//if we don't allow health items, delete them and end here
	if (self.classname == "Health" && level.coop_disableHealthItems && (self.targetname == "health" || self.targetname == "")){
		self remove
		end
	}
	//if we don't allow ammo items, delete them and end here
	if (self.classname == "AmmoEntity" && level.coop_disableAmmoItems && self.targetname == ""){
		self remove
		end
	}

	//store the weapon name on the weapon (passed in from tikis)
	self.flags["coop_weaponName"] = local.arg2

	//don't reinitialise respawned items
	if (self.flags["coop_respawnedItem"]){ end }

	//[user 2026-09-28] HARDCORE: enemies drop no health - the only medkits are the ones the map placed.
	//Every Health kit runs this thread (its .tik execs this file), so this is the one door both kinds of enemy
	//drop come through: the coop drop (dropItem flags it coop_droppedItem) and the engine's own
	//(Sentient::DropInventoryItems: a forcedrophealth actor, or the kill counter once a map script sets
	//level.nodrophealth back to 0). Item::Drop throws a kit up out of the corpse, so two frames after it
	//spawns a dropped kit is still moving; a placed kit (BSP, or spawned by a map script) is planted with
	//MOVETYPE_NONE and never moves. Only a moving or flagged kit is removed - every placed kit stays.
	if (level.coop_hardcore == 1 && self.classname == "Health"){
		if (self.flags["coop_droppedItem"] == 1 || self.velocity != (0 0 0)){
			local.physObject = self.flags["coop_itemPhysicsObject"]
			if (local.physObject){ local.physObject remove }
			println ( "^~^~^ COOPHC nodrop " + self.model + " at " + self.origin )
			self remove
			end
		}
	}

	thread local.thread local.arg1 
}end

//this will do the required checks and fire off the required handlers.
//it allows us to discern world items, player items, and actor items.
//if it's a player weapon, we we set basic properties and add it to their inventory array and end.
//if it's an unused leftover player weapon we set basic properties and end.
//if it's an active actor weapon (in use) we set basic properties and end.
//if it's a deactive actor weapon (dropped) we properly initialise handlers for pickup.
//if it's a world item we properly initialise handlers for pickup.
//These are all so we only use handler threads when absolutely necessary,
//to avoid memory leaks.
//=========================================================================
initialiseItem local.ammotype:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/initialiseItem->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.threadName = "coop_mod/itemhandler.scr::initialiseItem"
	group.thread["initialiseItem"] = local

	group.item 							= self
	group.type 							= self.classname
	group.isActorWeapon 				= self.flags["coop_isActorWeapon"]		//NOTE: this is set in storeActorWeapon called from global/weapon.scr
	group.physObject 					= self.flags["coop_itemPhysicsObject"]  //NOTE: this is set in dropItem func
	group.itemFlags 					= self.flags 							//NOTE: just grab all flags to make it future proof
	group.item set_respawn 0 			//don't respawn automatically
	group.item nottriggerable

	if (group.type == "Weapon"){
		group.item.flags["coop_AmmoType"] 	= local.ammotype
		group.ammotype 						= local.ammotype
	}

	waitthread getItemWorldProperties

	//player weapons we spawn in
	if (group.item.flags["coop_playerNewWeapon"]){
		local.player = group.item.flags["coop_itemOwner"]
		if (isAlive local.player){
			//local.player.flags["coop_inventoryAmmo"][group.ammotype] = game.true
			thread addWeaponToInventory local.player group.item.model
		}
		end //we don't fully initialise player weapons as they cannot be dropped
	}

	if (!group.isActorWeapon && group.type == "Weapon"){
		//OK, no actor carries it, so might as well make it notdroppable.
		group.item notdroppable

		//Now check if it is an unused player weapon
		//this is needed because as soon as a player spawns, their default MP loadout will spawn
		//and they seem to 'bind' with our custom weapon loadout, so you can't remove them!
		//even though they are 'separate'.
		//so no point processing these weapons!
		//we need to make sure the item spawn time is the same as player spawn time
		if (group.angles == (0 0 0) && group.item.origin == (0 0 0)){ 										//non-active player weapons retain 0 properties
			if (group.itemOwner){
				local.offset = 0.001																		//because we wait at least 1ms before giving new weapons
				local.playerSpawnTime = group.itemOwner.flags["coop_spawnEventTime"]						//store the player's spawn time
				local.playerNum = group.itemOwner.entnum
				//as disguising can take time we add this time up
				while (group.itemOwner && group.itemOwner.flags["coop_startingDisguise"]){
					if (group.itemOwner.flags["coop_spawnTimeOffset"]){
						local.offset += group.itemOwner.flags["coop_spawnTimeOffset"]
						break
					}
					wait game.ms
				}
				if (group.itemSpawnTime - local.offset == local.playerSpawnTime){ 			//check if this item spawn time shares the parm.other spawn time
					end
				}
			}
			waitthread uninitialiseTimer //check to see if we should stop init of item
		}
		//any weapons that make it here will be those placed in the world via BSP or script

		waitthread setupGrenades //fix any nades laying around the level
	}else if (group.isActorWeapon && !group.item.flags["coop_initialiseMe"]){
		//OK, to cut down on threads i'll only handle actor weapon pickups``
		//when they are dropped from their owner's hands on death
		end
	}

	if (!group.item){ end }
	group.item triggerable

	thread waitTillPickupEvent			//initialises the pickup event checker
	thread itemDropCheck				//checks to see if this item was dropped
	thread droppedItemLife 				//start the garbage collection timer if this is a dropped item
	thread handleWeaponPickup           //if it's a weapon, do the pickup handler
}end

//this is the main weapon pickup handler. it waits for initial trigger events (use or touch)
//and then checks to see if the pickup event has fired (waitTillPickupEvent).
//if it hasn't, that means we weren't able to pick the weapon up.
//next we can check if the player is already carrying the same ammotype.
//if they are that means they have full ammo.
//if not we can pick it up with gametype 0 hack.
//=========================================================================
handleWeaponPickup:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/handleWeaponPickup->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.threadName = "coop_mod/itemhandler.scr::handleWeaponPickup"

	if (group.type != "Weapon"){ end }
	group.pickupHandlerThread = local

	if (!group.item || group.item.flags["coop_itemIsHandled"]){ end }
	group.item.flags["coop_itemIsHandled"] = game.true

	thread updateRespawnTime
	while (1){
		while (group.item){
			group.item waittill trigger 								//wait here until the weapon has been triggered
			local.player = parm.other
			
			waitthread getItemWorldProperties  							//grab latest properties
			
			local.isCarryingClass = waitthread isCarryingAmmoType local.player group.ammotype //[202][hotfix] Smithy - grab this for future use
											
			wait game.ms

			if ((!local.player || local.player.classname != "Player") && group.item){ continue }		

			if (!group.pickupEvent){ 										//a pickup event wasn't found. this means this weapon WAS NOT picked up
				if (!group.item){
					if (group.pickupEventThread){ group.pickupEventThread end }
					if (group.droppedItemLifeThread){ group.droppedItemLifeThread end }
					end
				}
				if (local.isCarryingClass){ //ok, no pickup found, check that he doesn't just have full ammo
					continue
				}

				if (!waitthread isWeaponAllowed local.player group.item){ //ok, now check if we are allowed this weapon
					continue
				}

				waitthread getItemWorldProperties 							//grab latest properties

				//ok, it wasn't picked up and he doesn't have full ammo... must be a new weapon. lets hack it in.
				waitthread coop_mod/main.scr::changeGameType 0 0
				group.item triggereffect local.player
				waitthread coop_mod/main.scr::changeGameType 2 0

				if (group.pickupEvent){
					group.pickupEvent = game.false
					if (group.item && group.isActorWeapon){
						group.item.flags["coop_weaponPickedUp"] = game.true
						group.item.flags["coop_playerNewWeapon"] = game.true
						group.item targetname ("player" + local.player.entnum + "Inventory")
					}
					break
				}else{
					println "(itemhandler.scr::handleWeaponPickup) *ERROR*: Weapon " group.item " with model " group.model " cannot be picked up by " local.player.netname
				}
			}else{
				//pickup event found straight away. hallelujah.
				group.pickupEvent = game.false
				if (group.item && group.isActorWeapon){
					group.item.flags["coop_weaponPickedUp"] = game.true
				}
				break
			}
		}
		
		thread addWeaponToInventory local.player group.model "pickup" group.ammotype //it's a pickup so check for ammo types

		if (group.pickupEventThread){ group.pickupEventThread end }

		//world weapons can be respawned
		if (!group.isActorWeapon){
			thread updateRespawnTime
			waitthread waitTillValidTime 				//waits here if respawn time is 0
			if (group.respawnTime < 0){ end }
			wait group.respawnTime
			thread respawnItem
			thread waitTillPickupEvent
		}else{
			//do some housekeeping - we don't want memory leaks!
			if (group.droppedItemLifeThread){ group.droppedItemLifeThread end }
			end
		}
	}
}end

//waits for a pickup event and then flags the player doing the picking up
//so that we can use this for any handleWeaponPickup events
//if it is a health or ammo item then handle the respawn here.
//=========================================================================
waitTillPickupEvent:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/waitTillPickupEvent->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.threadName = "coop_mod/itemhandler.scr::waitTillPickupEvent"

	group.pickupEventThread = local
	while (group.item && !group.item.flags["coop_weaponPickedUp"])
	{
		group.item waittill pickup
		local.player = parm.other

		if (group.type == "Weapon"){
			group.pickupEvent = game.true 											//flag pickup event to check in handleWeaponPickup
			if (group.item){
				group.item notdroppable
			}
		}
		if (group.physObject){
			group.physObject remove
		}
		if(!group.droppedByEntity && group.type != "Weapon"){ 				//world weapon respawns are handled in handleWeaponPickup
			thread updateRespawnTime
			waitthread waitTillValidTime 									//waits here if respawn time is 0
			if (group.respawnTime < 0){ end }
			wait group.respawnTime
			thread respawnItem
			continue
		}else if(group.droppedByEntity){ 									//dropped items never respawn
			if (group.droppedItemLifeThread){ group.droppedItemLifeThread end }
			end
		}
	}
}end

//if the item is still at default (0 0 0) origin it means it's probably not used
//=========================================================================
uninitialiseTimer:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/uninitialiseTimer->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	wait 3
	if ((group.item && group.item.angles == (0 0 0) && group.item.origin == (0 0 0)) || !group.item){
		group.thread["initialiseItem"] end //we now kill thread via group as parm.previousthread, like parm.other, is a global var that can change due to external thread calls
	}
}end

//this will remove any threads to do with pickup handling after an item's life has ended.
//just in case a weapon is never picked up and gets despawned by the engine.
//such as enemy weapon or health kit drops.
//it also removes our custom items so it behaves like the engine
//=========================================================================
droppedItemLife:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/droppedItemLife->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.threadName = "coop_mod/itemhandler.scr::droppedItemLife"

	if (!group.droppedByEntity){ end }

	group.droppedItemLifeThread = local

	wait (int(getcvar "g_droppeditemlife")) 				//this cvar is set to 30 seconds by default.

	if(group.item && group.item.flags["coop_droppedItem"]){	//these are our script items that drop
		group.item remove
	}
	if (group.physObject){
		group.physObject remove
	}
	if (group.pickupEventThread) 	{ group.pickupEventThread end }
	if (group.pickupHandlerThread) 	{ group.pickupHandlerThread end }
}end

//looks for item velocity or if it has an explicit flag, to determine
//if it was dropped from an entity.
//=========================================================================
itemDropCheck:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/itemDropCheck->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (group.item && ((group.item.flags["coop_droppedItem"]) || (group.item.velocity != (0 0 0) && group.item.angles != (0 0 0)))){
		group.droppedByEntity = game.true
	}else{
		group.droppedByEntity = game.false
	}
}end

//updates the respawn time if it has changed in the interim
//=========================================================================
updateRespawnTime:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/updateRespawnTime->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (group.itemFlags["coop_itemRespawnTime"] != NIL){
		group.respawnTime = group.itemFlags["coop_itemRespawnTime"]
		end
	}
	if (group.type == "Health"){
		group.respawnTime = level.coop_healthRespawnTime
	}else{
		group.respawnTime = level.coop_ammoRespawnTime
	}
}end

//updates the respawn time if it has changed in the interim
//=========================================================================
waitTillValidTime:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/waitTillValidTime->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	while (group.respawnTime == 0){
		wait 5
		thread updateRespawnTime
	}
}end

//gets a snapshot of item location and properties
//=========================================================================
getItemWorldProperties:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/getItemWorldProperties->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (!group.item){ end }
	group.model 		= group.item.model
	group.angles 		= group.item.angles
	group.scale 		= group.item.scale
	group.angle 		= group.item.angle
	group.origin 		= group.item.origin
}end

//duh
//=========================================================================
respawnItem:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/respawnItem->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	group.item 								= spawn group.model
	group.item.flags["coop_respawnedItem"] 	= game.true 			//dont reprocess this item
	group.item angles 						group.angles
	group.item scale 						group.scale
	group.item origin 						group.origin
	group.item set_respawn 0
}end

//this is called from the global/weapon.scr when an actor gets a weapon.
//this includes those they spawn with and any that are given via script post-spawn.
//it allows us to know which weapons are carried by actors,
//so that they can be droppable and processed by player pickup events.
//an example of this being called post-spawn is if a weapon is given to an actor via script
//(e.g. Grillo picking up an MP40).
//NOTE: the engine calls global/weapon.scr automatically.
//=========================================================================
storeActorWeapon:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/storeActorWeapon->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	self weaponcommand "dual" targetname ("actorGun" + self.entnum) //grab any gun in either hand (dual) and then give it a unique targetname
	local.weap = $("actorGun" + self.entnum) 						//with this new targetname we can now store it in a var
	if (local.weap){                                                //you never know, the AI could be unarmed!
		local.weap.flags["coop_isActorWeapon"] 	= game.true 		//flag it as an actor's weapon
		self.flags["coop_mainActorWeapon"] 		= local.weap 		//store it on the actor so we can enable it later
		local.weap.targetname 					= ""                //undefine the targetname (DONT SET TO NIL, EMPTY STRING INSTEAD!)
	}else{
		self.flags["coop_mainActorWeapon"] = NULL
	}
}end

//this is called from the aihandler when an actor dies
//it makes the weapon that is dropped from a dead guy triggerable (thus usable).
//it also fully initialises the weapon for pickup handling
//=========================================================================
enableWeapon:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/enableWeapon->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (!self){ end }
	local.weapon = self.flags["coop_mainActorWeapon"]
	self.flags["coop_mainActorWeapon"] = NULL
	if (local.weapon){
		local.weapon.flags["coop_initialiseMe"] 	= game.true 		//it is an actor's weapon but it can now be initialised
		local.weapon.flags["coop_droppedItem"] 		= game.true         //don't do drop checks as we know that it will fall from their hands
		local.weapon triggerable
		local.weapon thread initialiseItem local.weapon.flags["coop_AmmoType"]
	}
}end

//restores grenade counts for all AI to match default SP behavior
//this is called every time AI get a new weapon (global/weapon.scr)
//=========================================================================
restoreNadeCount:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/restoreNadeCount->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	waitframe
	if (!isAlive self || self.classname != "Actor" || !self.gun){ end }
	//iprintlnbold_noloc("weapontype is " + self.weapontype)

	//check weapons
	switch (self.weapontype){
		case "rifle":
			switch (self.gun){
				case "mauser kar 98k":
				case "m1 garand":
				case "enfield":
				case "carcano":
				case "mosin nagant rifle":
					local.grencount = -4; break
				case "g 43":
				case "mauser kar 98d sniper":
				case "springfield '03 sniper":
				case "svt 40":
				case "enfield l42a1":
					local.grencount = -1; break
			}
			break
		case "smg":
		case "mg":
			local.grencount = -2; break
		case "heavy":
			switch (self.gun){
				case "shotgun":
					local.grencount = -2; break
				default:
					local.grencount = -1; break
			}
			break
		default:
			local.grencount = self.ammo_grenade; break
	}

	//iprintlnbold_noloc("gren count is " + local.grencount)

	if (local.grencount != NIL && self.ammo_grenade > 0){
		self ammo_grenade local.grencount
	}

	//iprintlnbold_noloc("ACTOR HAS " + self.ammo_grenade + " GRENADES")

}end

//do our own enemy health drops so we know it is a dropped item
//(internal use only)
//=========================================================================
handleHealthDrop:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/handleHealthDrop->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (level.coop_healthDropFreq <= 0){ end }
	if (level.coop_hardcore == 1){ end }				//[user 2026-09-28] HARDCORE: enemies drop no health (hardcore.scr)
	wait 0.001
	if (!self){ 																		//deleted guys don't drop health...
		end
	}else{
		if (!self.fact || self.fact.attacker == $world || self.team == "american"){ 	//don't drop health if they die from world or if they are allies
			end
		}
		//reset death count if we reached limit
		if (!level.coop_actorDeathCount || level.coop_actorDeathCount == level.coop_healthDropFreq){
			level.coop_actorDeathCount = 0
		}
		level.coop_actorDeathCount++
		if (level.coop_actorDeathCount == level.coop_healthDropFreq){
			thread dropItem "items/item_25_healthbox.tik" 1 "droppedHealth" NIL 1200
		}
	}
}end

//drops an item of specified model from an entity
//(can be used externally)
//=====================================================================
dropItem local.model local.doVelocity local.targetname local.angles local.mass:{
//=====================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/dropItem->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (!local.model){ end }

	if (local.angles){
		local.dropAngles = local.angles
	}else{
		local.dropAngles = self.angles
	}

	if(!local.mass){
		local.mass = 900
	}

	//[200] Smithy - check if this is a custom item (has a prefix of 'spawn')
	local.customPrefix = "spawn"
	local.isCustomItem = game.true
	for (local.i = 0; local.i <= (local.customPrefix.size - 1); local.i++){
		local.isCustomItem = local.isCustomItem && local.model[local.i] == local.customPrefix[local.i]
	}

	if (local.isCustomItem){
		local.item = thread coop_mod/custom_items.scr::local.model  //[200] Smithy - spawn our custom item	
	}else{
		local.item = spawn local.model targetname local.targetname  //this is the actual item
	}

	local.item.flags["coop_droppedItem"] = game.true
	local.item angles local.dropAngles
	local.item origin (self.origin + (0 0 40))
	local.item show
	local.item triggerable

	local.physObject = spawn ScriptSlave 				//this is so our new item can be physically simulated by gluing the item to it
	local.physObject origin local.item.origin
	local.physObject notsolid
	local.item.flags["coop_itemPhysicsObject"] = local.physObject
	local.item glue local.physObject

	local.physObject mass local.mass
	local.physObject physics_on 1 						//turn the physics on but don't collide with the corpse

	if (local.doVelocity){
		thread calculateDropVelocity 					//calculate velocity - this replicates the engine
		local.physObject.velocity = group.velocity 		//give it an impulse
	}
}end

//replicates engine calculcation for drop velocity:
//velocity = owner->velocity * 0.5 + Vector( G_CRandom( 50 ), G_CRandom( 50 ), 100 );
//(internal use only)
//=====================================================================
calculateDropVelocity:{
//=====================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/calculateDropVelocity->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	group.velocity 		= self.velocity
	group.velocity[0] 	= (group.velocity[0] * 0.5) + randomint(50)
	group.velocity[1] 	= (group.velocity[1] * 0.5) + randomint(50)
	group.velocity[2] 	= (group.velocity[2] * 0.5) + 100
}end

//check if this weapon is forced on player
//=====================================================================
isWeaponAllowed local.player local.item:{
//=====================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/isWeaponAllowed->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (local.player.flags["coop_PrimaryWeapon"] || local.player.flags["coop_SecondaryWeapon"]){
		if (local.player.flags["coop_PrimaryWeapon"] == local.item.model){
			end(game.true)
		}
		if (local.player.flags["coop_SecondaryWeapon"] == local.item.model){
			end(game.true)
		}
	}else{
		end(game.true)
	}
}end(game.false)

//force a weapon on all players
//=====================================================================
forceWeaponOnAll local.model:{
//=====================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/forceWeaponOnAll->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if ($player){
		for (local.i = 1; local.i <= $player.size; local.i++){
			thread forceWeaponOnPlayer $player[local.i] local.model
		}
	}
	if (waitthread isPrimaryWeapon local.model){
		level.coop_playerPrimaryWeapon = local.model
	}else{
		level.coop_playerSecondaryWeapon = local.model
	}
	//[user 2026-10-05] use-to-loot: a forced-weapon map refuses every other gun (isWeaponAllowed), so the engine's
	//loot prompt offers an enemy gun's AMMO only while this is set, never a gun the map would refuse. Read by TYPE.
	level.coop_lootNoPickup = 1
}end

//force a weapon on player
//=====================================================================
forceWeaponOnPlayer local.player local.model:{
//=====================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/forceWeaponOnPlayer->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (waitthread isPrimaryWeapon local.model){
		local.player.flags["coop_PrimaryWeapon"] = local.model
	}else{
		local.player.flags["coop_SecondaryWeapon"] = local.model
	}
}end

//stop forcing weapon of type ('primary' or 'secondary') on all
//=====================================================================
stopForceWeaponOnAll local.type:{
//=====================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/stopForceWeaponOnAll->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if ($player){
		for (local.i = 1; local.i <= $player.size; local.i++){
			thread stopForceWeaponOnPlayer $player[local.i] local.type
		}
	}
	if (local.type == "primary"){
		level.coop_playerPrimaryWeapon = NIL
	}else{
		level.coop_playerSecondaryWeapon = NIL
	}
	//[user 2026-10-05] use-to-loot: nothing forced any more = enemy guns can be taken again
	if (level.coop_playerPrimaryWeapon == NIL && level.coop_playerSecondaryWeapon == NIL){
		level.coop_lootNoPickup = NIL
	}
}end

//stop forcing weapon of type ('primary' or 'secondary') on player
//=====================================================================
stopForceWeaponOnPlayer local.player local.type:{
//=====================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/stopForceWeaponOnPlayer->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (local.type == "primary"){
		local.player.flags["coop_PrimaryWeapon"] = NIL
	}else{
		local.player.flags["coop_SecondaryWeapon"] = NIL
	}
}end

//handles the player spawn and weapon loadout logic
//also handles player diguises on spawn
//(internal use only)
//=========================================================================
managePlayerInventory:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/managePlayerInventory->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	group.player = self
	group.thread["managePlayerInventory"] = local
	group.player.flags["coop_loRegiveQueued"] = NIL	//[user 2026-08-18] a full (re)spawn give supersedes any queued revive re-kick
	//[user 2026-10-04, bug-3305] first give after a TRUE death: the kit alone. Whatever else the player
	//held was dropped at the body (coop_deathDropPickups), so neither the retain set nor the picks
	//carry-over may hand it back - that would be the duplicate. One-shot; read before any early exit.
	group.coop_kitOnly = 0
	if( group.player.flags["coop_diedKitOnly"] == 1 ){
		group.player.flags["coop_diedKitOnly"] = NIL
		group.coop_kitOnly = 1
	}
	group.player.flags["coop_deathDropDone"] = NIL	//alive again: the next death may drop

	//set some default flags for unused weapon offset calcs
	group.player.flags["coop_spawnEventTime"] 	= level.time
	group.player.flags["coop_spawnTimeOffset"] 	= 0
	group.player.flags["coop_startingDisguise"] = game.false

	//remove any previous inventory weapons from the game for this player if any exist
	thread deletePreviousInvWeapons
	group.player takeall

	//[user 2026-08-09] STEALTH RESPAWN PAPERS - must sit ABOVE the coop_noWeapon early-exit
	//below: during a stealth window (m2l2a papers-only route) that exit ends this thread, so the
	//papers re-give that used to live further down never ran for a mid-stealth respawner or late
	//joiner - marked as having papers while holding none (research 04 correction 2). Runs after
	//the takeall above so the give survives it. Gated on the stealth flags, which are NIL on
	//every other map (e1l3 sets coop_noWeapon but never coop_startUnarmed), so the cost
	//elsewhere is one false test. level.coop_itemPapers is papers2-aware (givePapersFlagToAll
	//overwrites it at the level-2 pickup) and is only non-NIL after a pickup, by which point
	//global/items.scr has set level.papers in the same cooperative frame.
	if( level.coop_noWeapon && level.coop_startUnarmed == 1 ){
		//[user 2026-08-09] Keep the spawn disguise-give alive under the early-exit below - it is
		//what grants the ENGINE latch (has_disguise via the changeGameType window in giveDisguise),
		//and before the map-load arming it ran for every pre-pickup spawn because coop_noWeapon was
		//still NIL until the uniform pickup. Without it the unarmed walk to the papers would play
		//without engine teammate-sensing, and a mid-stealth respawner's fresh body would depend on
		//weaponstate transitions alone (research 04 gap 2). Empty hands are safe here:
		//deactivatePlayerWeapon and activatePlayerWeapon both no-op when no Weapon is active.
		if (level.coop_enableDisguises && !group.player.is_disguised){
			waitthread giveDisguiseOnSpawn group.player
		}
		if( level.coop_itemPapers != NIL && level.coop_itemPapers != "" ){
			if( level.papers >= 1 && isAlive group.player && group.player.dmteam != "spectator" ){
				group.player item level.coop_itemPapers
				//givePapersFlag = the pickup recipe: sets coop_hasPapers + starts coop_papersAnytime
				//(guarded one instance per player), so a late joiner can also show papers at will.
				thread givePapersFlag group.player
				if( level.coop_forcePapersEquip ){
					//equip path - papers IN HAND (main.scr waits two frames, then uses the item)
					group.player thread coop_mod/main.scr::forcePapersInHand
				}
			}
		}
	}

	//[user 2026-10-05] bug-3399 LATE JOINER / RESPAWNER INTO A LIVE STEALTH WINDOW.
	//Player report: "if a player joins late, it breaks stealth when they spawn. They aren't auto given
	//the disguise." The no-weapon exit below ends this label BEFORE the uniform re-give further down,
	//so on every papers-only map (m2l2a, m6l1c, e1l3, m6l2a with coop_stealthHolster 0) a joiner
	//spawned in his own Allied model; and on e1l3, which sets coop_noWeapon without
	//coop_startUnarmed, the stealth branch above never ran either, so he had no disguise at all.
	//Same recipe the squad got at the pickup (giveUniformToAll + giveDisguiseToAll +
	//coop_stealthStripWeapons' setIsDisguised/hold watchdog), applied to one player, and only while
	//coop_stealthLive says the mission is still quiet - a loud mission spawns him loud, as before.
	if (level.coop_noWeapon){
		if( isAlive group.player && group.player.dmteam != "spectator" ){
			if( waitthread coop_stealthLive ){
				if( group.player.has_disguise != 1 ){
					waitthread giveDisguiseOnSpawn group.player
				}
				if( group.player.has_disguise == 1 ){
					if( level.coop_uniformOnSpawn == 1 ){
						thread giveUniformToPlayer group.player
					}
					//as coop_stealthStripWeapons does: giveWeaponLoadout never runs on this path, so the
					//flag is otherwise unset and coop_stealthHoldDisguise's `.classname` read throws on it
					group.player.flags["coop_activeWeapon"] = NULL
					waitthread setIsDisguised group.player game.true game.true
					if( level.coop_startUnarmed == 1 ){
						group.player thread coop_stealthHoldDisguise group.player
					}
				}
			}
		}
		if( group.player != NULL ){ group.player.flags["coop_startingDisguise"] = game.false }
		end
	}

	//[200] Smithy - check if this is a briefing mission. if so, don't allow weapons
	if (level.coop_mapname[0] == "b"){
		local.mapPrefix 	= "briefing"
		local.isBriefing 	= game.true
		for (local.i = 0; local.i <= (local.mapPrefix.size - 1); local.i++){
			local.isBriefing = local.isBriefing && level.coop_mapname[local.i] == local.mapPrefix[local.i]
		}
		if (local.isBriefing){ end }
	}

	//lets take advantage of having no weapons to give player a disguise if they need one
	//[user 2026-08-11] ...but ONLY once the map has actually ISSUED a uniform. Without that test this
	//hands a free disguise to every player at spawn the moment a map sets coop_enableDisguises, which
	//is exactly what happened when m6l1c opted in: the probe showed eng_has=1 eng_is=1 on a fresh
	//boot with uniOnSpawn=(NIL), i.e. players were already disguised before reaching the $suit
	//pickup - on a mission whose own objective reads "Infiltrate the base (Hint: find a disguise)".
	//coop_uniformOnSpawn is the honest "a uniform exists for this squad" flag: giveUniformToAll sets
	//it at the pickup (itemhandler.scr:900), e1l4 sets it at map load because players legitimately
	//START disguised there, and m2l2a sets it FALSE for the same reason this guard exists.
	//m2l2a never reached this line anyway - its stealth route sets coop_noWeapon, and the early exit
	//at :745 ends the label first. That is why the defect only appeared on the first ARMED disguise
	//map, and why it was invisible until tonight.
	//[user 2026-08-11] bug-1703 DO NOT RE-GRANT A DISGUISE THE PLAYER ALREADY HAS.
	//`!is_disguised` conflated two different states. is_disguised is the ENGINE flag, recomputed
	//every frame, and player.cpp:5541 forces it FALSE whenever any actor has the player as its
	//enemy, is attacking, and carries real threat - i.e. whenever somebody is genuinely shooting
	//at you. That is not a failed grant, it is 'you have been made', and it can persist for as
	//long as the firefight does.
	//This label runs from managePlayerInventory, which the per-player manage loop calls
	//repeatedly (player.scr:1061), so the false reading re-ran the whole grant about once a
	//second. Each run calls resetEnemyThinkstates then setEnemyAttackStates, which resets and
	//restores the think state of every german in the actor array - measured at 13-14 restores per
	//second, sustained, on a map with ~13 of them. That is the AI stutter: their think state was
	//being torn down and rebuilt continuously.
	//has_disguise is the right question. It is the mod-owned fact 'this player has been given a
	//disguise', it is what the grant actually sets, and it does not move when a rifle points at
	//you. The model-refresh branch immediately below already handles the re-spawn case, so
	//nothing is lost by not re-granting here.
	//[user 2026-10-05] bug-3399 and never while the alarm is up - a loud mission spawns you loud. e1l3
	//raises level.alarm without takeAllDisguises, so the two level flags alone still read "quiet" there.
	if (level.coop_enableDisguises && level.coop_uniformOnSpawn && !group.player.is_disguised && !group.player.has_disguise && level.alarm != 1){
		waitthread giveDisguiseOnSpawn group.player
	}
	//as player models reset on spawn re-give them the uniform if they need one
	if (level.coop_enableDisguises && level.coop_uniformOnSpawn && group.player.flags["coop_hasDisguise"] && group.player.has_disguise && level.alarm != 1){
		thread giveUniformToPlayer group.player
	}else{
		thread takeUniformFromPlayer group.player
	}
	//if it's a new player and they do not have the papers flag
	if (level.coop_itemPapers && !group.player.flags["coop_hasPapers"]){
		thread givePapersFlag group.player
	}
	//[user 2026-08-09] The papers-ITEM re-give that lived here was unreachable on the one map it
	//was written for: the coop_noWeapon early-exit above ends this thread during a stealth window
	//(research 04 correction 2). It now sits at the top of this label, above that exit. Outside a
	//stealth window the re-give is covered by main.scr::itemGetAll on every spawn - the papers
	//route through replace.scr::item (global/items.scr) into level.coop_playerItemN.

	//either give them a default loadout or give them their old one
	//[user 07-16] ARMORY PICKS ARE AUTHORITATIVE: coop_retainInventory (default ON) re-gave the
	//accumulated pickup set (coop_inventoryWeapons) on every spawn, which IGNORES the player's
	//loadout picks - so a spectate->rejoin (or any spawn once the retain set was populated) came
	//back WITHOUT the picked kit ("spectated and came back in and didnt have my loadout"). When the
	//player HAS armory picks, force the DEFAULT path (spawnInventory reads coop_loWeapons there).
	//No picks -> unchanged retain/default behavior.
	local.useDefault = !(level.coop_retainInventory && waitthread playerHasInventory group.player)
	if( group.player.flags["coop_loWeapons"].size > 0 && level.coop_loadoutLocked != 1 ){
		local.useDefault = game.true
	}
	if( group.coop_kitOnly == 1 ){ local.useDefault = game.true }	//bug-3305 death respawn: kit only
	//[user 2026-08-08] The stealth start does NOT belong here. It was written as a takeall in this
	//branch, which strips ITEMS as well as weapons and so wiped the uniform (bug-1604). e1l3 already
	//solves this properly with level.coop_noWeapon - checked at every grant site in this file
	//(the spawn-loadout early-exit above, the auto-raise fallback, coop_backfillPrimaries,
	//coop_giveSidearmPick) so the loadout is never granted in the first place, nothing is ever
	//taken away, and the disguise survives. m2l2a now sets that flag instead. The project rule is to
	//find the working recipe and copy it; inventing a parallel one cost three broken symptoms.
	thread giveWeaponLoadout local.useDefault
}end

//[202] Smithy - improved to swap to previous uniform
//=========================================================================
takeUniformFromPlayer local.player:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/takeUniformFromPlayer->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
/*
	if (local.player.flags["coop_hasEnemyUniform"]){
		if (local.player.flags["coop_alliedUniform"]){
			local.uniform = local.player.flags["coop_alliedUniform"]
			local.model = local.player.flags["coop_alliedModel"]
		}else{
			local.uniform = "american_army"
			local.model = "models/player/american_army.tik"
		}
		local.player.flags["coop_hasEnemyUniform"] = game.false
		local.player stufftext ("dm_playermodel " + local.uniform)
		local.player.model = local.model
		end
	}else{
		local.uniform = waitthread getPlayerUniform local.player
		local.player stufftext ("dm_playermodel " + local.uniform)
	}
*/
//[203] chrissstrahl - reactivating Smithy code to allow other allied models
	if (waitthread playerHasEnemyUniform local.player local.uniform){ //set a default uniform if they somehow manage to have an exis one.
		println "PLAYER HAS ENEMY UNIFORM - NOT ALLOWED!"
		local.uniform = "american_army"
		local.model = "models/player/"+local.uniform+".tik"
		//[203] chrissstrahl - make sure the command is not send if already in progress
		local.commandResetFov = ";vstr g_m2l1"
		if(local.player.flags["coopFovIsResetting"]){
			local.commandResetFov = ""
		}else{
			local.player.flags["coopFovIsResetting"] = 1			
		}
		
		local.player stufftext ("dm_playermodel "+local.uniform+""+local.commandResetFov) //[203] chrissstrahl - fix fov being reset on uinform change
		local.player.model = local.model
	}else{		
		local.model = local.player.model
		
		//[203] chrissstrahl - make sure the command is not send if already in progress
		if(!(local.player.flags["coopFovIsResetting"])){
			local.player.flags["coopFovIsResetting"] = 1
			local.player stufftext ("vstr g_m2l1") //[203] chrissstrahl - fix fov being reset on uinform change
		}
	}
}end

//[202] Smithy
//=========================================================================
playerHasEnemyUniform local.player local.uniform:{
//=========================================================================
	local.isGerman = waitthread game.main::containsText local.uniform "german"
	local.isItalian = waitthread game.main::containsText local.uniform "_AX_"
}end(local.isGerman || local.isItalian)

//=========================================================================
giveUniformToPlayer local.player:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/giveUniformToPlayer->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (!level.coop_disguiseUniform){
		local.uniform = "german_waffenss_officer"
	}else{
		local.uniform = level.coop_disguiseUniform
	}
	
	//[202] Smithy [203] chrissstrahl - reactivated to allow player selecting any allied model
	local.player.flags["coop_hasEnemyUniform"] = game.true
	if (!local.player.flags["coop_alliedUniform"]){
		local.player.flags["coop_alliedModel"] = local.player.model
		local.player.flags["coop_alliedUniform"] = waitthread getPlayerUniform local.player
	}

	local.model = "models/player/" + local.uniform + ".tik"
	local.player.model = (local.model)
	local.player stufftext ("dm_playermodel " + local.uniform+";vstr g_m2l1") //[203] chrissstrahl - fix fov being reset on uinform change
}end

//=========================================================================
getPlayerUniform local.player:{
//=========================================================================
	local.uniform = ""
	local.model = local.player.model
	local.s = 0
	for (local.i = 0; local.i <= local.model.size; local.i++){
		if (local.model[local.i] == "/") local.s++
		if (local.s == 2){	
			for (local.j = local.i + 1; local.j <= local.model.size; local.j++){							
				if (local.model[local.j] == ".") end(local.uniform)
				local.uniform += local.model[local.j]
			}	
		}	
	}
}end(local.uniform)

//gives all players the german officer's uniform as their player model
//also turns on uniforms on spawn
//=========================================================================
giveUniformToAll:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/giveUniformToAll->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	level.coop_uniformOnSpawn = game.true
	for (local.i = 1; local.i <= $player.size; local.i++){
		thread giveUniformToPlayer $player[local.i]
	}
}end

//gives a player the diguise on first spawn (connection),
//so no tallies are needed.
//(internal)
//=========================================================================
giveDisguiseOnConnect:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/giveDisguiseOnConnect->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	thread giveDisguise group.player
}end

//gives a player the diguise and tallies up time spent
//in alternate gametype. this is so unused weapon loadouts can be
//processed.
//(internal)
//=========================================================================
giveDisguiseOnSpawn local.player:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/giveDisguiseOnSpawn->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.start = level.time
	local.player.flags["coop_startingDisguise"] = game.true

	waitthread giveDisguise local.player

	local.end = level.time
	local.player.flags["coop_spawnTimeOffset"] += (local.end - local.start)
}end

//gives a player the diguise
//see _disguisenotes.txt for more info on what im bypassing in engine
//see giveDisguiseToAll below for more info
//=========================================================================
giveDisguise local.player:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/giveDisguise->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.threadName = "coop_mod/itemhandler.scr::giveDisguise"

	//make sure this isn't a concurrent func
	//may help stop any issues with gametype swap
	if (level.coop_disguisingInProgress){
		while (level.coop_disguisingInProgress){
			wait game.ms
		}
		if (!isAlive local.player || local.player.dmteam == "spectator"){
			group.thread["managePlayerInventory"] end //stop any outstanding external threads (managePlayerInventory)
			local end //stop this thread
		}
	}

	level.coop_disguisingInProgress = game.true

	//temporarily force enemies into idle thinkstate so engine allows us to disguise properly (criterion 1)
	if (thread coop_mod/aihandler.scr::anyEnemiesInAttackState){
		local.resetAttackStates = game.true
		waitthread coop_mod/aihandler.scr::resetEnemyThinkstates
	}

	//temporarily deactivate player weapon so engine allows us to disguise properly (criterion 2)
	local.player thread deactivatePlayerWeapon

	waitthread coop_mod/main.scr::changeGameType 0 0
	local.player.has_disguise 				= game.true
	local.player.flags["coop_hasDisguise"] 	= game.true
	waitthread coop_mod/main.scr::changeGameType 2 game.ms

	local.player thread activatePlayerWeapon

	//make previously attacking enemies aggressive again
	if (local.resetAttackStates){
		thread coop_mod/aihandler.scr::setEnemyAttackStates
	}

	level.coop_disguisingInProgress = game.false
}end

//gives all players the diguise
//we have to do some hackery to get this working but it works nonetheless
//firstly we force all enemies into idle state (if they aren't already)
//second we deactivate all unholstered player weapons
//then we give them disguise
//then we reactivate weapons and make previously attacking enemies attack you again
//you will see your weapon unholster and holster quickly, but this is the nicest
//it's gonna get. just pretend it's the guy quickly putting their disguise on :P
//you won't notice enemies going into idle as it happens very quickly
//see _disguise.txt in /notes for more info on what im bypassing in engine
//=========================================================================
giveDisguiseToAll:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/giveDisguiseToAll->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.threadName = "coop_mod/itemhandler.scr::giveDisguiseToAll"

	if (level.coop_enableDisguises || level.alarm){ end }
	level.coop_enableDisguises = game.true

	if (!$player){ end }

	//temporarily force enemies into idle thinkstate so engine allows us to disguise properly (criterion 1)
	if (thread coop_mod/aihandler.scr::anyEnemiesInAttackState){
		local.resetAttackStates = game.true
		waitthread coop_mod/aihandler.scr::resetEnemyThinkstates
	}

	//temporarily deactivate player weapons so engine allows us to disguise properly (criterion 2)
	thread deactivateAllPlayerWeapons

	waitthread coop_mod/main.scr::changeGameType 0 0
	for (local.i = 1; local.i <= $player.size; local.i++){
		local.player = $player[local.i]
		local.player.flags["coop_hasDisguise"] 	= game.true
		local.player.has_disguise 				= game.true
	}
	waitthread coop_mod/main.scr::changeGameType 2 game.ms

	//give players their previously active weapon (if they had one)
	thread activateAllPlayerWeapons

	//make previously attacking enemies aggressive again
	if (local.resetAttackStates){
		thread coop_mod/aihandler.scr::setEnemyAttackStates
	}

	level.coop_enableDisguises = game.true

	//[user 2026-08-11] bug-1701 v2 THE RETRY MUST ASK WHETHER THE GRANT LANDED.
	//This was anyPlayerNotDisguised, which reads the ENGINE flag is_disguised. That flag is
	//false in two completely different situations and this branch treated them the same:
	//  (a) the grant genuinely failed          <- worth retrying
	//  (b) the grant worked, but the engine is vetoing it - player.cpp:5522 needs an empty
	//      hand, and :5541 additionally forces false while ANY actor has the player as enemy,
	//      is attacking, and carries real threat. Somebody shooting at you. NOT retryable, and
	//      it lasts as long as the firefight does.
	//In case (b) the failure branch cleared coop_enableDisguises - its own re-entry guard - wiped
	//coop_hasDisguise off every player and re-threaded itself, at frame rate, forever. Each pass
	//ran resetEnemyThinkstates then setEnemyAttackStates over the whole german array (measured:
	//13-14 restores/sec sustained) and flipped the gametype twice via changeGameType, which is
	//what stuttered the player's own viewmodel and HUD, not just the AI.
	//The first fix only removed weapons-in-hand, so it held right up until somebody fired a shot.
	//has_disguise is the mod-owned fact the grant actually sets, and no rifle can move it.
	local.anyPlayerNotDisguised = thread coop_anyDisguiseGrantFailed
	if (local.anyPlayerNotDisguised && level.coop_enableDisguises && !level.alarm){

		//disguising failed... try again
		//[user 2026-08-11] BOUNDED. This is a self-re-threading retry with no wait in it, so any
		//predicate that stays true burns a core until the map ends. Three attempts, then give up
		//and leave the flags alone - a disguise that will not take is a gameplay problem, never a
		//reason to spin. Reset per arm so a later legitimate grant still gets its three tries.
		if( level.coop_disgTries == NIL ){ level.coop_disgTries = 0 }
		level.coop_disgTries++
		if( level.coop_disgTries > 3 ){
			println "^~^~^ DISGUISE grant gave up after 3 attempts"
		}else{
			level.coop_enableDisguises = game.false
			for (local.i = 1; local.i <= $player.size; local.i++){
				$player[local.i].flags["coop_hasDisguise"] = game.false
			}
			wait game.ms
			thread giveDisguiseToAll
		}
	}else if (!local.anyPlayerNotDisguised && level.coop_enableDisguises && !level.alarm){

		level.coop_disgTries = 0
		iprintlnbold_noloc("You are now disguised!")
		wait game.ms

		//now set their initial isDisguised flag
		for (local.i = 1; local.i <= $player.size; local.i++){
			local.player = $player[local.i]
			local.item = thread returnActiveWeapon local.player
			thread setIsDisguised local.player (local.item == NULL || local.item.classname != "Weapon")
		}

		//we can now enable the handler for AI behavior
		thread coop_mod/aihandler.scr::disguiseHandler

	}else if (level.alarm){
		iprintlnbold_noloc("The alarm was raised. You can no longer disguise!")
		level.coop_enableDisguises = game.false
	}
}end

//=========================================================================
//[user 2026-08-11] Did the GRANT land? Unlike anyPlayerNotDisguised (which reads the engine's
//live is_disguised opinion) this asks only whether every live player carries the disguise the
//mod handed them. Spectators and the dead are skipped - they cannot be disguised and must not
//hold the whole squad's grant hostage. anyPlayerNotDisguised is left in place untouched; other
//callers legitimately want the engine's view.
//=========================================================================
coop_anyDisguiseGrantFailed:{
//=========================================================================
	for (local.i = 1; local.i <= $player.size; local.i++){
		local.p = $player[local.i]
		if (local.p == NULL || local.p == NIL){ continue }
		if (local.p.dmteam == "spectator"){ continue }
		if (!isAlive local.p){ continue }
		if (!local.p.has_disguise){
			end (game.true)
		}
	}
}end (game.false)

//=========================================================================
anyPlayerNotDisguised:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/anyPlayerNotDisguised->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	//[user 2026-08-11] bug-1717 SKIP PLAYERS WHO CANNOT BE DISGUISED.
	//This walked $player raw, so a SPECTATOR counted as "an undisguised player" - and the answer
	//gates alarms on every disguise map. Measured on m6l2a: the second client sat in spectator the
	//whole session, this returned true forever, and the alarm path stayed open no matter how well
	//the live player was disguised. A dead or DBNO player had the same effect.
	//A player who is spectating, dead, or not yet fully in the world is not a person the Germans
	//can see out of uniform, so none of them belong in this answer.
	for (local.i = 1; local.i <= $player.size; local.i++){
		local.p = $player[local.i]
		if (local.p == NULL || local.p == NIL){ continue }
		if (local.p.dmteam == "spectator"){ continue }
		if (!isAlive local.p){ continue }
		if (!local.p.is_disguised){
			end (game.true)
		}
	}
}end (game.false)

//=========================================================================
deactivateAllPlayerWeapons:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/deactivateAllPlayerWeapons->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	for (local.i = 1; local.i <= $player.size; local.i++){
		local.player = $player[local.i]
		local.player thread deactivatePlayerWeapon
	}
}end

//=========================================================================
activateAllPlayerWeapons:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/activateAllPlayerWeapons->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	for (local.i = 1; local.i <= $player.size; local.i++){
		local.player = $player[local.i]
		local.player thread activatePlayerWeapon
	}
}end

//deactivates any weapons in the player's hand.
//this is needed if we want to disguise the player post spawn,
//as we only enable SP engine disguise checks for 1 ms (gametype hack).
//and the engine checks to see if an active weapon is in a player's hand
//before setting is_disguised to true. we want it to be true!
//=========================================================================
deactivatePlayerWeapon:
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/deactivatePlayerWeapon->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.player = self
	if (!isAlive local.player || local.player.dmteam == "spectator"){
		end
	}

	local.item = waitthread returnActiveWeapon local.player
	if (local.item == NULL || local.item.classname != "Weapon"){
		local.player.flags["coop_lastActiveWeapon"] = NULL
		end
	}

	local.player.flags["coop_lastActiveWeapon"] = local.item
	local.player.flags["coop_activeWeapon"] 	= NULL
	local.player deactivateweapon "dual"
	local.player correctweaponattachments
end

//reactivates the previously deactivated weapon
//=========================================================================
activatePlayerWeapon:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/activatePlayerWeapon->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.player = self
	if (!isAlive local.player || local.player.dmteam == "spectator" || local.player.flags["coop_lastActiveWeapon"] == NULL){
		end
	}

	local.weapon 		= local.player.flags["coop_lastActiveWeapon"]
	local.weaponName 	= local.weapon.flags["coop_weaponName"]

	local.player use local.weaponName
	wait game.ms
	local.player activatenewweapon "dual"
	local.player.flags["coop_activeWeapon"] 	= local.player.flags["coop_lastActiveWeapon"]
	local.player.flags["coop_lastActiveWeapon"] = NULL
}end

//takes diguises from all players permanently
//(external)
//=========================================================================
takeAllDisguises:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/takeAllDisguises->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (!level.coop_enableDisguises){ end } //[202] Smithy - don't bother doing this if all disguises are already taken

	local.threadName = "coop_mod/itemhandler.scr::takeAllDisguises"
	level.coop_enableDisguises 	= game.false
	level.coop_uniformOnSpawn 	= game.false

	if (!$player){ end }
	waitthread coop_mod/main.scr::changeGameType 0 0
	for (local.i = 1; local.i <= $player.size; local.i++){
		$player[local.i].has_disguise 				= game.false
		$player[local.i].flags["coop_hasDisguise"] 	= game.false
		$player[local.i].flags["coop_isDisguised"] 	= game.false //remove isDisguised too...
	}
	waitthread coop_mod/main.scr::changeGameType 2 game.ms

	//[user 2026-08-08] COVER BLOWN -> ARM EVERYONE. On a map running the stealth start
	//(level.coop_startUnarmed), losing the disguise is the moment the mission stops being a stealth
	//mission, so the loadout the player picked in the armory arrives right then. Hooked HERE because
	//takeAllDisguises is the single choke point for "the disguise is gone for good" - it is called
	//from global/alarm_system.scr:666, global/items.scr:477 and e1l4's ship scripts alike, so one
	//hook covers every way a cover gets blown rather than one per map.
	thread coop_armOnBlown
}end


//=========================================================================
// [user 2026-08-08] ONE PASS COVERS THE SQUAD. Called from anim/disguise_accept.scr when a guard
// accepts a player`s papers. Retail clears the papers prompt on self.enemy alone - the one man who
// showed them - which is correct for single player and wrong for four: the other three would each
// have to be interrogated in turn by the same guard, and any of them could fail it.
//
// type_disguise "none" is what actually retires him: it is the same value m2l2a uses to mark a
// guard who does not challenge anyone (m2l2a.scr:194-196), so he stays in place and in character,
// he just stops asking. Per-guard, so every OTHER checkpoint still has to be talked past.
//=========================================================================
coop_paperPassAll local.guard:{
	if( local.guard == NULL || local.guard == NIL ){ end }
	if( local.guard.coop_paperPass == 1 ){ end }
	local.guard.coop_paperPass = 1

	//[user 2026-08-10] bug-1631 FREEZE ARM DELETED (master plan v2 Step 1, commit A1).
	//This line was `local.guard type_disguise "none"`. The SETTHINK probe caught it firing 50ms
	//into the guard's ACCEPT state (oldthink=11 SENTRY -> newthink=14 NONE, curstate=6 DISGUISE):
	//swapping the disguise think out from under a live disguise state tears down the sentry think
	//mid-animation, and THINK_DISGUISE_NONE installs no Begin/ThinkState functions, so nothing
	//ever drives that actor again. He freezes in the "my mistake, sorry" pose for the rest of the
	//map. Every recorded freeze has "PAPERS guard satisfied" immediately before it.
	//It bought nothing: State_Disguise_Accept (actor_disguise_common.cpp:159-167) already does
	//SetThinkState(IDLE) + SetThink(THINKSTATE_DISGUISE, THINK_DISGUISE_SALUTE) permanently, so an
	//accepting sentry is demoted to a saluter by the engine itself. Deletion, not deferral: all
	//three deferral designs polled `thinkstate`, which reports the TOP think level and therefore
	//lies while a disguise think is merely suspended by pain or grenade - they would have
	//recreated the freeze by a new route.
	//NOTE for Phase C Step 21: the coop_paperPass latch above is permanent and cleared nowhere.
	//Under D1 (recoverable alarm) that is DELIBERATE - a guard who already accepted the squad's
	//papers stays satisfied across an alarm cycle. Do not add a clear without deciding it.

	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p.flags["coop_isActive"] == 1 ){
			local.p.flags["coop_clickablePapersEnabled"] = game.false
		}
		local.i = local.i + 1
	}
	//[user 2026-08-17] TEAM award: this site does not know WHO showed the papers - it clears the
	//flag for the whole squad because the guard is satisfied with all of them - so pay all of them.
	local.pi = 1
	while( local.pi <= $player.size ){
		local.pp = $player[local.pi]
		local.pi = local.pi + 1
		if( local.pp == NIL ){ continue }
		if( local.pp == NULL ){ continue }
		thread coop_mod/xp.scr::xp_stealth_act local.pp "papers"
	}
	println "^~^~^ PAPERS guard satisfied - whole squad waved through"
}end


//=========================================================================
// [bug-2059] the show-papers sound the user reported as "on and off" is fired by the retail
// papers TIK, not by us - but this is the loop that decides a papers presentation happens at all,
// so a scene record here brackets it.
// [user 2026-08-08] SHOW PAPERS ON DEMAND. enableClickablePapers only runs while a guard is
// actively interrogating you (its sole caller is anim/disguise_papers.scr), so outside that window
// nothing listened for the button - and on m2l2a the guards run disguise_SALUTE, so it never fired
// there at all. This is the same primaryfire-while-unarmed test, but running for as long as you
// hold papers, so you can present them whenever you like as well as when asked.
//
// Unarmed is the gate, which is what keeps it from fighting anything else: with a weapon out,
// primary fire shoots. NULL *and* NIL, because a player who never had a weapon has never had the
// flag assigned (bug-1603).
// One guarded instance per player.
//=========================================================================
coop_papersAnytime local.player:{
	if( local.player == NULL ){ end }
	if( local.player.flags["coop_papersAnyRun"] == 1 ){ end }
	local.player.flags["coop_papersAnyRun"] = 1

	local.nextHintScan = 0
	while( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		//[user 2026-08-10] FIRST-CONTACT OFFICER ADVISORY LIVES HERE BECAUSE THIS LOOP ACTUALLY RUNS.
		//It was written into coop_stealthArmOnHurt, which turns out to have NO CALLER ANYWHERE -
		//defined at itemhandler.scr:1423 and threaded by nothing, in the mod or in any map script.
		//That is why the warning never appeared: its host has never once executed. (The dead
		//watchdog is a separate and more serious defect - it is the thing that is supposed to arm an
		//unarmed player who is being shot - and is logged rather than switched on mid-playtest, since
		//enabling damage-triggered arming that has never run in a shipped session is not a change to
		//make blind.) coop_papersAnytime is proven live: it is the loop that was eating the trigger
		//during a bust, which is how we know it ticks.
		//
		//Fires at coop_bustHintRange (400u, far wider than the 112u bash range - a warning delivered
		//at bash range is a caption) and on a 2D distance plus a 96u vertical band, so being directly
		//above him on another floor does not count as "in his radius".
		//THROTTLED to 2Hz: this walks the german array and the loop below ticks every frame.
		if( level.time >= local.nextHintScan ){
			local.nextHintScan = level.time + 0.5
			if( local.player.flags["coop_bustHintShown"] != 1 && level.coop_bustEverContained != 1 && level.coop_bustLoud != 1 && level.coop_stealthMap == 1 && getcvar( "coop_stealthStart" ) != "0" && isAlive local.player ){
				local.hr = int( getcvar "coop_bustHintRange" )
				if( local.hr <= 0 ){ local.hr = 400 }
				local.garr = level.coop_actorArray["german"]
				if( local.garr != NIL ){
					local.gi = 1
					while( local.gi <= local.garr.size ){
						local.g = local.garr[local.gi]
						if( local.g != NULL && local.g != NIL ){
							if( isAlive local.g && local.g.type_disguise == "officer" ){
								local.hz = local.g.origin[2] - local.player.origin[2]
								if( local.hz < 0 ){ local.hz = 0 - local.hz }
								//Horizontal distance via vector_length on flattened points, not
								//hand-rolled pythagoras - see the note in
								//maps/m2l2a.scr::coop_naxosSabotage for what was measured and what
								//is still unexplained. vector_length was right on every sample.
								local.flatG = ( local.g.origin[0] local.g.origin[1] 0 )
								local.flatP = ( local.player.origin[0] local.player.origin[1] 0 )
								local.h2 = vector_length( local.flatG - local.flatP )
								if( local.h2 <= local.hr && local.hz <= 96 ){
									local.player.flags["coop_bustHintShown"] = 1
									//SHORT. The first draft ran off the screen - user: "The text was
									//also too long warning about the officer... it ran off the
									//screen". The DBNO line is centred with auto width, so an
									//over-long string overflows both edges; keep to ~45 characters.
									//[2026-09-25, bug-2906] claim on show, re-send the hide
									//(coop_mod/hudresend.scr, TRAPS T8)
									waitthread coop_mod/hudresend.scr::claim local.player 250 250
									ihuddraw_virtualsize local.player 250 1
									ihuddraw_align       local.player 250 center center
									ihuddraw_font        local.player 250 "verdana-12"
									ihuddraw_color       local.player 250 1 1 1
									ihuddraw_rect        local.player 250 0 -58 0 0
									ihuddraw_string      local.player 250 "Avoid the Officer. Contain him only when alone."
									ihuddraw_alpha       local.player 250 1
									local.player.flags["coop_bustHintT"] = level.time + 6
									println( "^~^~^ CONTAIN advisory shown e" + local.player.entnum + " officer=" + local.g.targetname + " d2=" + local.h2 + " dz=" + local.hz )
									local.gi = local.garr.size + 1
								}
							}
						}
						local.gi++
					}
				}
			}
			if( local.player.flags["coop_bustHintT"] != NIL ){
				if( level.time >= local.player.flags["coop_bustHintT"] ){
					local.player.flags["coop_bustHintT"] = NIL
					ihuddraw_alpha  local.player 250 0
					ihuddraw_string local.player 250 ""
					thread coop_mod/hudresend.scr::resend local.player 250 250 1
				}
			}
		}

		if( level.coop_itemPapers == NIL ){ break }
		//[user 2026-08-10] A BUSTED PLAYER IS NEVER PRESENTING PAPERS - they are in a gunfight.
		//THIS LOOP WAS THE "he just doesn't shoot" BUG, and it is a nastier version of the one
		//coop_bustArm already fixed for enableClickablePapers. Measured by the BUSTWEAP probe: during
		//a bust the active weapon alternates pistol -> (none) -> pistol, because the loadout arrives
		//as asynchronous pickup entities and each raise leaves a brief unarmed gap. The player is
		//mashing FIRE to kill the officer; in one of those gaps this test passes, so instead of a
		//shot they get the PAPERS equipped - and then `wait 2` plus the press-swallow below eats the
		//trigger for the next two seconds, at which point the pistol hold yanks the gun back and the
		//cycle repeats. User: "I got the gun with the papers stuck inside and it would not shoot at
		//all". coop_bustArm clears coop_clickablePapersEnabled, but that only stops the OTHER papers
		//loop (enableClickablePapers) - this one is persistent and per-player and was never gated.
		//main.scr::forcePapersInHand:1029 already carries exactly this guard; this is the third
		//papers path and the last one that lacked it.
		if( local.player.flags["coop_hasPapers"] == 1 && isAlive local.player && local.player.flags["coop_busted"] != 1 ){
			local.aw = local.player.flags["coop_activeWeapon"]
			if( local.player.primaryfireheld && ( local.aw == NULL || local.aw == NIL ) ){
				local.player use level.coop_itemPapers
				//hold them up for a beat, and swallow the press so one tap is one presentation
				wait 2
				while( local.player != NULL && local.player.primaryfireheld ){ waitframe }
			}
		}
		waitframe
	}
	if( local.player != NULL ){ local.player.flags["coop_papersAnyRun"] = NIL }
}end


//=========================================================================
// [user 2026-08-08] bug-1605. Strip the weapons a player is ALREADY carrying when the disguise is
// put on mid-level. coop_noWeapon only stops weapons being GRANTED on a future spawn - it does
// nothing about the rifle already in your hands, so you could simply scroll back to it and pull a
// gun in full uniform.
//
// e1l3 solves this by naming the models (FinalEscape.scr:711-719), which works there because the
// loadout is fixed. It is useless on m2l2a, where the armory can hand out any of 69 guns. Taking
// by CLASS covers every one of them - the nine classes isWeaponClass recognises are the whole set.
// Items are untouched, so the uniform and papers survive (that was bug-1604).
//=========================================================================
coop_stealthStripWeapons:{
	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p.flags["coop_isActive"] == 1 ){
			//[user 2026-08-08] bug-1607. WAITTHREAD, not thread. These were fired asynchronously and
			//the setIsDisguised below raced them - it could run while a weapon was still in hand,
			//which clears the disguise flag again. Entity-waitthread with ONE argument is the proven
			//form in this codebase (entity-thread with TWO arguments is what broke the blueprints).
			//
			//And each class is drained in a LOOP: getWeaponOfClassFromPlayer returns the FIRST match,
			//so one call removes ONE weapon of that class. A player carrying two rifles kept one -
			//which is exactly the "two weapons still in my slots" the user saw. Four passes covers
			//any realistic loadout; the calls are harmless once the class is empty.
			local.pass = 1
			while( local.pass <= 4 ){
				local.p waitthread takePlayerWeapon "pistol"
				local.p waitthread takePlayerWeapon "heavy"
				local.p waitthread takePlayerWeapon "mg"
				local.p waitthread takePlayerWeapon "shotgun"
				local.p waitthread takePlayerWeapon "rifle"
				local.p waitthread takePlayerWeapon "smg"
				local.p waitthread takePlayerWeapon "landmine"
				local.p waitthread takePlayerWeapon "grenade"
				local.p waitthread takePlayerWeapon "agrenade"
				local.pass = local.pass + 1
			}
			local.p.flags["coop_activeWeapon"] = NULL

			//AFTER the strip, never before - coop_isDisguised is the only flag AI detection reads
			//(aihandler.scr::canseeUndisguisedPlayers) and it is otherwise only ever set as a side
			//effect of a holster transition, which removing a weapon is not. forceState because it is
			//gated on coop_hasDisguise, which may not be set yet at pickup time.
			waitthread setIsDisguised local.p game.true game.true
			local.p thread coop_stealthHoldDisguise local.p
			//[user 2026-08-08] FULL state, not just the one flag. isDisguised reads 1 and the guards
			//still attack, so the aggro is arriving by some path other than canseeUndisguisedPlayers -
			//most likely the ENGINE side (has_disguise), which is a different field from the mod flag
			//and can only be set inside a changeGameType 0 window.
			//ONE LINE. A continuation line beginning with a binary operator is a T1 parse killer and
			//kills the WHOLE file - linecheck.py caught it before this shipped.
			println( "^~^~^ STEALTH " + local.p.netname + " isDisguised=" + local.p.flags["coop_isDisguised"] + " hasDisguise=" + local.p.flags["coop_hasDisguise"] + " engine_has=" + local.p.has_disguise + " engine_is=" + local.p.is_disguised + " enableDisg=" + level.coop_enableDisguises + " alarm=" + level.alarm )
		}
		local.i = local.i + 1
	}
	println "^~^~^ STEALTH weapons stripped (items kept)"
}end


//=========================================================================
// [user 2026-08-08] bug-1604. self = a player spawned unarmed by the stealth start. The moment
// they take a hit, the pretence is over - arm everyone. Watches HEALTH rather than a damage
// event because a scripted or explosive hit does not always route through one, and this must
// never miss: being unarmed in a fight you cannot leave is unwinnable.
//=========================================================================
//=========================================================================
// [user 2026-08-08] HOLD THE DISGUISE. Every fix so far has set the state correctly at one moment
// and then something later cleared it - weapon-state transitions, respawns, engine re-evaluation.
// Rather than chase each clearer, this re-asserts it while the stealth route is active and the
// player is carrying no weapon. Cheap (2 Hz) and it cannot fight anything legitimate: the moment
// coop_startUnarmed is cleared - which coop_armOnBlown does the instant the cover breaks - it
// stops and never touches the flags again.
//=========================================================================
coop_stealthHoldDisguise local.player:{
	if( local.player == NULL ){ end }
	if( local.player.flags["coop_holdDisgRun"] == 1 ){ end }
	local.player.flags["coop_holdDisgRun"] = 1
	local.sw = 0
	while( local.player != NULL && level.coop_startUnarmed == 1 ){
		//[user 2026-08-09] Same inventory-item rule as weaponstate.scr. This watchdog only re-asserted
		//a cleared disguise when the hands were EMPTY - but on the papers-only route the hands are
		//never empty, so the one safety net that should have caught the flip was disabled by exactly
		//the condition it needed to cover.
		local.hw = local.player.flags["coop_activeWeapon"]
		if( isAlive local.player && ( local.hw == NULL || local.hw.classname != "Weapon" ) ){
			if( local.player.flags["coop_isDisguised"] != game.true ){
				waitthread setIsDisguised local.player game.true game.true
				println "^~^~^ STEALTH re-asserted a cleared disguise"
			}
		}
		//[user 2026-08-09] ENGINE-FLAG WATCH. Everything the probes have called "disguised" so far is
		//the MOD flag coop_isDisguised - but setIsDisguised only ever writes that, and the engine AI
		//reads m_bIsDisguised (actorenemy.cpp:164, PassesTransitionConditions_Attack), which script
		//cannot set at all (is_disguised is EV_GETTER only). It is refreshed solely inside a
		//changeGameType 0 window. So mod_is can read 1 while eng_is is 0 and the AI attacks anyway.
		//Also counting actors ALREADY in attack thinkstate: the engine gates ENTERING attack, it does
		//not pacify an actor that is already there, which would look identical from outside.
		local.sw = local.sw + 1
		if( local.sw >= 4 && getcvar( "coop_aggroDebug" ) == "1" ){
			local.sw = 0
			local.natk = 0
			local.garr = level.coop_actorArray["german"]
			for( local.gi = 1; local.gi <= local.garr.size; local.gi++ ){
				if( local.garr[local.gi] == NULL ){ continue }
				if( local.garr[local.gi].thinkstate == "attack" ){ local.natk = local.natk + 1 }
			}
			//[user 2026-08-09] THINKSTATE CENSUS. The papers guard flip-flops between his normal
			//animation and "suspicious". Disguise and Curious transitions read the SAME two inputs
			//with opposite signs (EnemyIsDisguised + IsEnemyConfirmed) and re-evaluate every 200ms, so
			//a flickering confirmation oscillates him instead of letting the papers sequence run.
			//Count who is in which state so the flapping is measurable rather than eyeballed.
			local.ndis = 0
			local.ncur = 0
			local.nidl = 0
			for( local.gi = 1; local.gi <= local.garr.size; local.gi++ ){
				if( local.garr[local.gi] == NULL ){ continue }
				local.ts = local.garr[local.gi].thinkstate
				if( local.ts == "disguise" ){ local.ndis = local.ndis + 1 }
				if( local.ts == "curious" ){ local.ncur = local.ncur + 1 }
				if( local.ts == "idle" ){ local.nidl = local.nidl + 1 }
			}
			//[user 2026-08-09] WHO is attacking? The census counts attackers but the papers-checker
			//oscillation diagnosis needs their identity - officers vs scientists vs someone else.
			if( local.natk > 0 ){
				local.who = ""
				local.nw = 0
				for( local.gi = 1; local.gi <= local.garr.size; local.gi++ ){
					if( local.garr[local.gi] == NULL ){ continue }
					if( local.garr[local.gi].thinkstate != "attack" ){ continue }
					if( local.nw >= 6 ){ continue }
					local.nw = local.nw + 1
					local.tn = local.garr[local.gi].targetname
					if( local.tn == NIL || local.tn == NULL ){ local.tn = "?" }
					local.who = local.who + " " + local.tn + "#" + local.garr[local.gi].entnum
				}
				println( "^~^~^ STEALTHWHO" + local.who )
			}
			println( "^~^~^ STEALTHWATCH eng_is=" + local.player.is_disguised + " eng_has=" + local.player.has_disguise + " mod_is=" + local.player.flags["coop_isDisguised"] + " attackers=" + local.natk + " of=" + local.garr.size + " disguise=" + local.ndis + " curious=" + local.ncur + " idle=" + local.nidl + " alarm=" + level.alarm )
		}
		wait 0.5
	}
	if( local.player != NULL ){ local.player.flags["coop_holdDisgRun"] = NIL }
}end

//=========================================================================
// [user 2026-10-05] bug-3399 IS THE MISSION STILL QUIET? One answer for every disguise map, read by
// the spawn path so a joiner or respawner gets the state the squad is in right now.
//  - coop_enableDisguises: the map runs the disguise layer (set at load on m2l2a/m2l2b/e1l4, at the
//    uniform pickup elsewhere). takeAllDisguises - the single "cover blown for good" choke point the
//    alarm, the uniform removal and bust.scr all reach - clears it.
//  - level.alarm: e1l3 goes loud without takeAllDisguises, and the engine itself refuses a disguise
//    while it is set (player.cpp m_bAlarm), so a spawn in that state is loud whatever the flags say.
//  - a uniform has been issued (coop_uniformOnSpawn) or the papers-only start is still running
//    (coop_startUnarmed, m2l2a before the pickup) - otherwise the map has nothing to give yet
//    (m6l1c "find a disguise", e1l3 before the escape).
// `!= 1` / `== 1` only: these are read before some maps ever assign them (TRAPS T17).
//=========================================================================
coop_stealthLive:{
	if( level.gametype == 0 ){ end (0) }
	if( level.alarm == 1 ){ end (0) }
	if( level.coop_enableDisguises != 1 ){ end (0) }
	if( level.coop_uniformOnSpawn == 1 ){ end (1) }
	if( level.coop_startUnarmed == 1 ){ end (1) }
}end (0)

//=========================================================================
// [user 2026-10-05] bug-3399 THE SPAWN MUST NOT TRIP THE BASE. Called from
// player.scr::manageAliveSpawning BEFORE the player is placed. The disguise lands a few frames later
// (managePlayerInventory -> giveDisguise runs a changeGameType window, and on an armed disguise map
// the engine's MP auto-raise puts a rifle in his hand for ~0.25s before giveWeaponLoadout holsters
// it). In that gap the engine reads him as an undisguised Allied soldier and any german with line of
// sight acquires him - and an actor in attack thinkstate never re-checks a disguise. The original
// squad never had this gap: they spawn before the AI is awake, or get the disguise all at once with
// empty hands at the pickup.
// So hold FL_NOTARGET (gates ENTRY into attack, actor.cpp) and the script aggro funnel
// (coop_stealthBlocksAggro reads coop_stealthSpawnGuard) until the engine itself reports him
// disguised, then let go. Shared-flag rules copied from player.scr::coop_notargetWatch (bug-2064/2068):
// read the flag back, write only on a real disagreement, release only what WE acquired. Bounded.
// No wait before the acquire: the caller waitthreads this, so the flag is on before placement.
//=========================================================================
coop_stealthSpawnGuard local.player:{
	if( local.player == NULL || local.player == NIL ){ end }
	if( local.player.dmteam == "spectator" ){ end }
	if( !(waitthread coop_stealthLive) ){ end }
	local.player.flags["coop_stealthSpawnGuard"] = 1
	local.player.flags["coop_stealthSpawnT"] = level.time
	//ownership lives on the PLAYER, not in a thread local: a fast respawn re-enters here while the
	//previous release loop still runs, reads notarget=1 (our own claim) and must not lose track of it
	local.have = 0 - 1		//-1 survives when the getter is absent (older game.dll)
	local.have = local.player.notarget
	if( local.have == 0 ){
		local.player notarget 1
		local.player.flags["coop_stealthNtHeld"] = 1
	}
	local.held = local.player.flags["coop_stealthNtHeld"]
	if( local.held != 1 ){ local.held = 0 }
	if( getcvar( "coop_aggroDebug" ) == "1" ){
		println( "^~^~^ STEALTHSPAWN guard on " + local.player.entnum + " notargetHeld=" + local.held )
	}
	if( local.player.flags["coop_stealthSpawnRun"] == 1 ){ end }	//a live hold loop will release it
	local.player.flags["coop_stealthSpawnRun"] = 1
	local.player thread coop_stealthSpawnRelease local.player
}end

//=========================================================================
// bug-3399 companion: lets go once the ENGINE says disguised (has + is, i.e. empty hands or papers),
// once the mission goes loud, or after 6s whatever happens - a player who will not take a disguise
// must never be left untargetable. Re-arm on a fast respawn just restarts the clock.
//=========================================================================
coop_stealthSpawnRelease local.player:{
	local.ok = 0
	local.el = 0
	while( local.player != NULL && isAlive local.player ){
		local.el = level.time - local.player.flags["coop_stealthSpawnT"]
		if( local.el >= 6 ){ break }
		if( !(waitthread coop_stealthLive) ){ break }
		if( local.el >= 1 && local.player.has_disguise == 1 && local.player.is_disguised == 1 ){
			local.ok = local.ok + 1
			if( local.ok >= 2 ){ break }	//two consecutive reads: past the spawn-burst flicker
		}else{
			local.ok = 0
		}
		wait 0.25
	}
	if( local.player == NULL ){ end }
	local.player.flags["coop_stealthSpawnGuard"] = NIL
	local.player.flags["coop_stealthSpawnRun"] = NIL
	if( local.player.flags["coop_stealthNtHeld"] == 1 ){
		local.player.flags["coop_stealthNtHeld"] = NIL
		local.player notarget 0
	}
	if( getcvar( "coop_aggroDebug" ) == "1" ){
		println( "^~^~^ STEALTHSPAWN guard off " + local.player.entnum + " has=" + local.player.has_disguise + " is=" + local.player.is_disguised + " t=" + local.el )
	}
}end


//=========================================================================
// coop_stealthArmOnHurt WAS HERE, and it never ran once (bug-1688, closed 2026-08-30).
//=========================================================================
// It was the 'arm an unarmed player who is being shot' watchdog. Defined here and threaded by
// NOTHING - not in the mod, not in any map script, not in any cfg - for its whole life, so
// bug-1674 diagnosed a race THROUGH it and bug-1676 shipped a fix INTO it, both reasoning about
// code that had never executed. aimaneuver.scr:147 cites it as the reason to re-test a guard
// where the damage is done. Deleted rather than wired, on evidence:
//  * it could never have covered e1l3, the one papers-only map with no watcher of its own. Its
//    loop condition and coop_armOnBlown BOTH require level.coop_startUnarmed, which e1l3 never
//    sets - see the note at :716. Wiring it there would have shipped inert.
//  * on the three maps that DO set coop_startUnarmed a live map-local watcher already runs, all
//    named coop_blownOnDamage (maps/m2l2a.scr, maps/m6l1c.scr, maps/m6l2a.scr), each carrying an
//    attacking-german-within-1600u filter this label lacked - so wiring it would have armed the
//    whole squad on FALL DAMAGE, and on m6l2a bypassed that map's own alarm cascade.
//
// e1l3 is NOT covered and deliberately stays that way: its designed response to blown cover is
// courtyard.scr::enableEnemyOnAll, which re-arms from the loadout snapshot AND fails the
// mission. A watcher that armed WITHOUT failing would delete the papers (global/items.scr:461-464
// sets level.papers = 0) and the truck sentry's engine disguise check
// (actor_disguise_common.cpp:112) would then deny forever, so $playerProducedPapers could never
// fire and driveAway (maps/e1l3/FinalEscape.scr:571) would block for the rest of the session.
// Arming the player on e1l3 makes the map UNWINNABLE. Do not add one.
//
// THE ONE THING THIS LABEL KNEW THAT THE LIVE COPIES DO NOT: a player carrying
// flags['coop_busted'] is mid-contain, and arming the squad globally for him is the bug-1676
// race. If a blown-on-damage watcher is touched again, that exemption is the part worth carrying.
// The stale 'FIRST-CONTACT OFFICER ADVISORY' header that used to sit here described code that
// had already been moved out: the live advisory is at :1338-1345.
//=========================================================================


//=========================================================================
// [user 2026-08-08] Give every active player their loadout because the cover just broke, and clear
// the stealth-start flag so later spawns arm normally.
//=========================================================================
coop_armOnBlown:{
	if( level.coop_startUnarmed != 1 ){ end }
	level.coop_startUnarmed = 0
	//clear BOTH halves of the papers-only lockout before re-arming, or coop_noWeapon makes
	//giveWeaponLoadout early-exit and the kit never arrives - which is exactly the "spotted with no
	//weapons" case that made the mission unwinnable.
	level.coop_noWeapon = game.false
	level.coop_forcePapersEquip = game.false

	//[user 2026-08-12] BIN THE PAPERS. "It equips my loadout with papers attached to my guns and it's
	//almost like it cycles between papers and guns... should be a clean loadout swap as soon as I am
	//spotted, it's over and I should be immediately ready to fight."
	//Clearing coop_forcePapersEquip only stops them being FORCED back; the ITEM stayed in inventory,
	//so coop_papersAnytime and the engine's own weapon selection could still raise it and fight
	//spawnWeaponAssert for the hands - that is the cycling. Re-asserting the gun is a race, not a fix;
	//removing the item ends the race outright.
	//A blown cover makes papers worthless by definition. remove_item also zeroes level.papers
	//(global/items.scr:464/469), which is the engine's own disguise-level gate.
	waitthread global/items.scr::remove_item "papers_level1"
	waitthread global/items.scr::remove_item "papers_level2"
	level.coop_itemPapers = NIL

	for( local.i = 1; local.i <= $player.size; local.i++ ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p.flags["coop_isActive"] == 1 && isAlive local.p ){
			//[user 2026-08-10] "when it happened i only got m1 garand with one mag, not my full
			//loadout." A player who was mid-BUST when the situation escalated is still holding the
			//silenced pistol and still carries flags["coop_busted"]. Two consequences, both bad:
			// * the armory SIDEARM cannot land - silencedpistol.tik is ammotype "pistol", so the
			//   picked Colt is a same-class duplicate and the give is refused. That is exactly "only
			//   the garand".
			// * coop_busted keeps the bust-time exemptions alive (main.scr::forcePapersInHand,
			//   coop_stealthBlocksAggro) for a player who is now in an open firefight.
			//The bust is OVER once it has gone loud - it resolved as escalation - so clear the flag
			//and take the stealth tool back before issuing the real kit.
			//[bug-1736] there are now three other removers - coop_bustDisarm (CONTAINED),
			//coop_bustStaggerRecover (guard SURVIVED) and the coop_bustAnyoneWatch healer - so this is
			//no longer the sole cleanup path it used to describe. Clear the arming latch with it, so
			//the pair is released together everywhere it is released at all.
			if( local.p.flags["coop_busted"] == 1 ){
				local.p.flags["coop_busted"] = NIL
				local.p.flags["coop_bustArmed"] = NIL
				local.p take "models/weapons/silencedpistol.tik"
			}
			group.player = local.p
			local.useDefault = game.true
			if( local.p.flags["coop_loWeapons"].size > 0 && level.coop_loadoutLocked != 1 ){
				local.useDefault = game.true
			}
			//[user 2026-08-10] PROBE: "im not sure if its giving us our actual loadout or the mission
			//default weapons". Report what this player actually has picked and what is about to be honoured.
			//NOTE local.default=true does NOT mean "mission default": giveWeaponLoadout:1463 uses it to enter
			//the branch that copies coop_inventoryWeapons from the armory picks. So true is correct here -
			//but the redundant if above (both arms assign game.true) is the shape of a half-finished edit,
			//so measure before touching it.
			if( getcvar( "coop_aggroDebug" ) == "1" ){
				local.nPicks = local.p.flags["coop_loWeapons"].size
				if( local.nPicks == NIL ){ local.nPicks = -1 }
				local.nInv = local.p.flags["coop_inventoryWeapons"].size
				if( local.nInv == NIL ){ local.nInv = -1 }
				local.lk = level.coop_loadoutLocked
				if( local.lk == NIL ){ local.lk = -1 }
				println( "^~^~^ BLOWNKIT e" + local.p.entnum + " picks=" + local.nPicks + " inv=" + local.nInv + " locked=" + local.lk + " useDefault=" + local.useDefault )
			}
			waitthread giveWeaponLoadout local.useDefault
			//[user 2026-08-08] TAKE THE PAPERS OUT OF THEIR HANDS. Clearing coop_forcePapersEquip only
			//stops them being re-drawn on the NEXT spawn - the item is still the active in-hand
			//"weapon" right now, so drawing a rifle left the papers rendering attached to it. Raise a
			//real weapon explicitly, which displaces them.
			wait game.ms
			//[user 2026-08-10] THE LOUD KIT ARRIVED HOLSTERED. This was `local.p thread
			//activatePlayerWeapon`, which opens with `if (... flags["coop_lastActiveWeapon"] == NULL){
			//end }` (:1121) - it REACTIVATES a weapon that was deactivated earlier. On the stealth start
			//the player has never held a weapon at all, so that flag is NULL, the label ended on its
			//first line, and nothing was ever raised: the whole loadout landed on the player holstered.
			//spawnWeaponAssert is the path the bust already uses and it demonstrably wins - it re-asserts
			//the desired gun over 5 frames plus a late 0.8s fallback raise, which is what beats the
			//engine's MP auto-pick and the papers still being the in-hand item this frame (bug-802/924).
			//Desired gun chosen exactly the way giveWeaponLoadout:1571-1573 chooses it, so the armory
			//pick comes up rather than whatever the engine grabs first.
			local.desired = local.p.flags["coop_loSlot1"]
			local.coop_dslot = 1
			if (local.desired == NIL){
				local.desired = local.p.flags["coop_loSlot2"]
				local.coop_dslot = 2
			}
			//[user 2026-08-18] apply-trace F1: raise the RESOLVED tik - with a finish/variant applied
			//the kit holds only the variant, and use on a non-owned gun is a silent engine no-op.
			if (local.desired != NIL){
				local.desired = waitthread coop_mod/loadoutpick.scr::loadout_finResolve local.p local.coop_dslot local.desired
			}
			if (level.coop_loadoutLocked == 1){ local.desired = NIL }
			thread spawnWeaponAssert local.p local.desired
			//[user 2026-08-10] "...with one mag". giveInventory DOES call loadout_ammoTopup
			//(itemhandler.scr:2155), but it is reached through `thread giveInventory` (:1643) - i.e.
			//asynchronously - so on the cover-blown path there is no guarantee it has run by the time
			//the player is holding the gun and pulling the trigger. Call it directly here as well:
			//it is idempotent and never LOWERS a value ("max(map, standard)"), so a second call
			//cannot take ammo away, and it tops up exactly the classes the player's picks need.
			waitthread coop_mod/loadoutpick.scr::loadout_ammoTopup local.p
			//PROBE: if the kit is still short, this says whether the picks were there to honour.
			if( getcvar( "coop_aggroDebug" ) == "1" ){
				local.nP = local.p.flags["coop_loWeapons"].size
				if( local.nP == NIL ){ local.nP = -1 }
				println( "^~^~^ BLOWNARM e" + local.p.entnum + " picks=" + local.nP + " s1=" + local.p.flags["coop_loSlot1"] + " s3=" + local.p.flags["coop_loSlot3"] + " desired=" + local.desired + " noWeapon=" + level.coop_noWeapon )
			}
			local.p iprint "Cover blown - weapons free!" 1
		}
	}
	println "^~^~^ STEALTH cover blown, loadouts issued"
}end


//gives the player the default level loadout
//=========================================================================
giveWeaponLoadout local.default:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/giveWeaponLoadout->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	group.invTargetname = ("player" + group.player.entnum + "Inventory") 	//e.g. player0Inventory

	//[user 07-19] bug-897 SECOND-PRIMARY LOSS: when the player has armory picks the respawn path is
	//forced down the picks-only kit (managePlayerInventory), which reads coop_loWeapons and ignores
	//coop_inventoryWeapons - so a 2nd primary the player picked up IN LEVEL (recorded only in
	//coop_inventoryWeapons) is dropped by the takeall and never re-given. Snapshot what the player is
	//actually carrying BEFORE resetPlayerWeapons nils coop_inventoryWeapons, into a fresh independent
	//array (deep copy - never a live reference into the flag), so spawnInventory can carry the in-level
	//pickups over on top of the authoritative picks. Only the picks path needs this; other paths leave
	//group.loCarry NIL and merge nothing.
	group.loCarry = NIL
	//[user 07-19] bug-897 v2: clear the stashed kit up front so a spawnInventory early-return (no
	//loadout found) cannot leave a STALE kit from a previous spawn for coop_backfillPrimaries to re-give.
	group.coop_intendedKit = NIL
	//[user 07-28] bug-1204: how many pickup entities spawnInventory actually put in the world for THIS
	//give. 0 = do not touch $(group.invTargetname) at all (that lookup returns a NULL listener and every
	//command on it is a script error - see the waitthread note below).
	group.coop_kitEntN = 0
	if (local.default){
		//[bug-3305] no carry-over after a true death - the extras were dropped at the body
		if( group.player.flags["coop_loWeapons"].size > 0 && level.coop_loadoutLocked != 1 && group.coop_kitOnly != 1 ){
			local.src = group.player.flags["coop_inventoryWeapons"]
			group.loCarry[1] = NIL
			local.ci = 0
			for( local.i = 1; local.i <= local.src.size; local.i++ ){
				if( local.src[local.i] != NIL ){
					local.ci++
					group.loCarry[local.ci] = local.src[local.i]
				}
			}
		}
		thread resetPlayerWeapons group.player
	}
	//spawn them in first and flag them as playerWeapon
	//[user 07-28] bug-1204 THE WHOLE KIT WAS NEVER GIVEN: this used to be `thread spawnInventory` and
	//the very next line read $(group.invTargetname). A MOHAA `waitthread` SUSPENDS its caller - the
	//woken thread is put back on the scheduler timer list (engine: ScriptThread::StoppedWaitFor with
	//name==0 -> StartTiming, and ScriptMaster::ExecuteRunning returns early while stackCount != 0), so
	//it does NOT return inline. Once bug-897 put `waitthread mergeCarryWeapons` inside spawnInventory
	//(armory-picks path only) spawnInventory gave up the frame BEFORE its spawn loop ran; control came
	//back here with ZERO pickup entities in the world, group.weapons resolved to NULL, and every use of
	//it errored - including the ACTUAL GIVE, `group.weapons triggereffect group.player` in giveInventory.
	//Net effect for anyone with armory picks: no pistol, no grenade, no kit at all; only the bare `item`
	//gives in coop_backfillPrimaries landed, and those were filtered to primaries. Waiting for
	//spawnInventory to finish is the fix - the pickups exist before we look them up.
	waitthread spawnInventory local.default

	//store the targetname array into weapons var
	group.weapons = $(group.invTargetname)
	if (group.coop_kitEntN > 0){
		group.weapons notdroppable 			//don't allow players to drop weapons
		group.weapons set_respawn 0
	}

	wait game.ms 							//makes sure the default weapons spawned by engine are processed separately to our new ones
											//0.0005 translates to 1ms in the engine: 0.0005 -> (int)( time * 1000.0f + 0.5f ) -> 1
											//this is why we take AT LEAST 1ms from group.itemSpawnTime (local.offset)

	thread giveInventory 					//actually give them the weapons and default ammo

	//[user 2026-08-11] SILENCED PISTOL ON A DISGUISE MISSION - ADDITIVE, on top of whatever kit the
	//player actually got. Requested for m6l1c and m2l2b: "give the player a silenced pistol AS well
	//as their loadout at the start of this mission".
	//WHY IT IS NEEDED NOW even though both maps already list it: loadout.scr puts silencedpistol in
	//level.coop_weaponLoadout for m6l1c (:421) and m2l2b, but that is the MAP DEFAULT KIT, and armory
	//picks REPLACE the default kit (spawnInventory tier 2 / the useDefault branch at :796). Since
	//bug-1675/1678 seeds every new player with Garand + Colt, effectively everyone now has picks - so
	//the map's silenced pistol was being dropped for exactly the players the stealth route needs it.
	//A bare `give` rather than a pickup entity: Weapon::PickupWeapon refuses a second primary in a
	//team gametype, while Sentient::giveItem bypasses that guard entirely and a re-give of something
	//already held is a no-op (the bug-1204 mechanism). Ammo granted explicitly for the same reason
	//bug-1683 needed it - a map that never stocks the pistol class hands over an empty gun.
	//ORDER MATTERS, and my own bug-1692 is the evidence: holding the silenced pistol made the armory
	//Colt be REFUSED on the cover-blown path ("only got m1 garand"). giveInventory above is THREADED,
	//so the picked kit arrives asynchronously - giving the silenced pistol inline would beat the kit
	//and could cost the player the sidearm they actually chose. Deferred instead, so the picks land
	//first and the silenced pistol is added on top by a bare give that bypasses the pickup guard.
	if( level.coop_silencedOnSpawn == 1 ){
		thread coop_giveSilencedExtra group.player
	}

	//[user 07-28] bug-1204: same NULL-listener guard as above - never command an unresolved lookup.
	if (group.coop_kitEntN > 0){
		group.weapons origin group.player.origin
		group.weapons hide
		group.weapons notsolid
		group.weapons nottriggerable
	}

	//improve spawning when in disguise mission! 
	if (group.player.has_disguise){ 
		thread setIsDisguised group.player game.true //set initial disguise to true	
		wait 0.25
		if (isAlive group.player){
			group.player thread deactivatePlayerWeapon
		}
		thread setIsDisguised group.player game.true //again, just to be sure after wait
		if (!group.player.flags["coop_holsterHint"]){
			group.player iprint "Keep your weapon holstered when in disguise." game.true
			group.player.flags["coop_holsterHint"] = game.true //duh, set it as hinted
		}
	}else{
		//[user 07-18] bug-802 INSTANT SPAWN WEAPON: raise the correct gun in the SAME frame the kit is
		//given - no wait at all (was `wait 0.25`, then 0.1 - both a visible empty-hands/default-rifle
		//window; the wait only existed to let the engine's MP auto-`use` fire FIRST so it could be
		//deactivated again). Desired gun priority: last-held weapon if it is in the new kit (respawn
		//carry-over + exact-ammo path unchanged) > the armory-picked PRIMARY (first spawn with picks)
		//> the map's primary class. The engine's late auto-use can still clobber a few frames in, so
		//spawnWeaponAssert (threaded below) re-asserts ONLY while the active weapon is WRONG - no
		//blind deactivate, so an already-correct raise is never restarted (no holster/raise blip).
		local.desired = NIL
		//[user 2026-08-11] bug-1706 SILENCED PISTOL DRAWN, WITHOUT A SECOND ASSERT.
		//First cut gave the pistol on a 1.5s delay and then threaded its OWN spawnWeaponAssert.
		//That left two asserts running against each other - this block's, aiming at the loadout
		//primary, and the pistol's - and the loser desynced the client: the reported 'silenced
		//pistol with my m1 garand skin over top of it'. The comment right above this line already
		//warns why (an already-correct raise must never be restarted).
		//So: give it HERE, before the desired-weapon choice, and make it the desired weapon. One
		//assert, one raise, and the engine's late auto-use gets re-asserted over exactly as it is
		//for every other spawn weapon. Additive - the loadout is untouched and still in the pack.
		if( level.coop_silencedDrawn == 1 && isAlive group.player ){
			group.player give "models/weapons/silencedpistol.tik"
			group.player ammo "pistol" 40
			group.player.flags["coop_silencedGiven"] = 1
			local.desired = "models/weapons/silencedpistol.tik"
		}
		local.last = group.player.flags["coop_lastWeapon"]
		if (local.last && local.desired == NIL){ //[200] Smithy - allow the game to know their last active weapon on respawn (suggested by Chris)
			if (waitthread playerHasWeapon group.player local.last){
				local.desired = local.last
			}else if (waitthread coop_mod/loadoutpick.scr::loadout_isPicked group.player local.last){
				//useDefault-with-picks respawns reset coop_inventoryWeapons this frame (registration
				//lands next frame) - membership in the picks array is the same truth, available NOW
				local.desired = local.last
			}
		}
		if (local.desired == NIL && group.player.flags["coop_loWeapons"].size > 0 && level.coop_loadoutLocked != 1){
			local.desired = group.player.flags["coop_loSlot1"]
			local.coop_dslot = 1
			if (local.desired == NIL){
				local.desired = group.player.flags["coop_loSlot2"]
				local.coop_dslot = 2
			}
			//[user 2026-08-18] apply-trace F1: raise the RESOLVED tik, not the base - after a
			//finish/variant regive only the variant is in the kit and use on a non-owned gun
			//silently no-ops; the player stood empty-handed (or with the engine auto-pick)
			//while the toast said applied. THE core of "my hands never change".
			if (local.desired != NIL){
				local.desired = waitthread coop_mod/loadoutpick.scr::loadout_finResolve group.player local.coop_dslot local.desired
			}
		}
		if (isAlive group.player){
			if (local.desired != NIL){
				group.player use local.desired
			}else if (level.coop_weaponUse){ //[201] Smithy
				group.player useweaponclass level.coop_weaponUse
			}
			group.player activatenewweapon "dual" 				//unholster the right weapon as quickly as possible
		}
		thread spawnWeaponAssert group.player local.desired
		//[user 07-19] bug-897 v2: re-issue any 2nd+ PRIMARY the engine's team-mode pickup rule drops
		//(see coop_backfillPrimaries). Read the stashed kit into a local and pass player + kit as
		//params so a concurrent spawn on another player cannot race the shared `group`.
		local.backfillKit = group.coop_intendedKit
		thread coop_backfillPrimaries group.player local.backfillKit
	}
	//reset disguise offset stuff
	if (group.player){
		group.player.flags["coop_startingDisguise"] = game.false
		group.player.flags["coop_activeWeapon"] = waitthread returnActiveWeapon group.player //duh, initialise activeWeapon flag (will return weapon or NULL)
		if (group.player.flags["coop_activeWeapon"]){
			group.player.flags["coop_lastWeapon"] = group.player.flags["coop_activeWeapon"].model
		}	 
	}
}end

//[user 07-18] bug-802: post-spawn weapon watcher (companion to the instant-use spawn give in
//giveWeaponLoadout). Frame 1: one unconditional re-assert of the desired gun (the proven
//"assert twice, fast" recipe - beats the engine MP auto-pick racing the same frame). Then for
//a few more frames correct the active weapon ONLY if the engine's late auto-use raised the
//WRONG gun - conditional, so a correct raise is never restarted and there is no visible blip.
//=========================================================================
spawnWeaponAssert local.player local.desired:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/spawnWeaponAssert->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	waitframe
	if (local.player == NULL){ end }
	if (!(isAlive local.player)){ end }
	if (local.desired != NIL){
		local.player use local.desired
	}
	local.player activatenewweapon "dual"
	if (local.desired == NIL){ goto swa_latecheck }		//class-use path: any raised weapon is acceptable, but still verify SOMETHING raised (bug-924)
	for (local.i = 1; local.i <= 5; local.i++){
		waitframe
		if (local.player == NULL){ end }
		if (!(isAlive local.player)){ end }
		local.active = waitthread returnActiveWeapon local.player
		if (local.active != NULL && local.active.classname == "Weapon" && local.active.model != local.desired){
			local.player use local.desired
			local.player activatenewweapon "dual"
		}
	}
swa_latecheck:
	//[user 07-20] bug-924: LATE fallback raise. The respawn kit is handed out asynchronously
	//(reissue first, pickups after) and useWeapon refuses ammo-less weapons until the exact-ammo
	//restore lands at ~0.5s - the stock 0.3s auto-raise can miss ALL of it, leaving the player
	//bare-handed with an "invisible" gun ("No active weapon in slot 0" forever). Re-check well
	//after the restore and force a raise if the hand is still empty.
	wait 0.8
	if (local.player == NULL){ end }
	if (!(isAlive local.player)){ end }
	if (level.coop_noWeapon){ end }
	local.active = waitthread returnActiveWeapon local.player
	if (local.active == NULL){
		if (local.desired != NIL){
			local.player use local.desired
		}else{
			local.player useweaponclass rifle
		}
		local.player activatenewweapon "dual"
	}
}end

//[user 07-19] bug-897 v2: POST-GIVE PRIMARY BACKFILL. Root cause of the lost 2nd primary: in a team
//gametype (coop = g_gametype 2) the engine's Weapon::PickupWeapon REFUSES a non-secondary (primary:
//rifle/smg/mg/heavy) weapon when the sentient already holds ANY primary and does not already own that
//weapon's class (the HasPrimaryWeapon guard in weapon.cpp). spawnInventory issues the kit as spawned
//PICKUP entities, so the engine keeps only ONE primary and silently drops the rest - which is why
//bug-897's array-level mergeCarryWeapons fix did not stick. A bare `item` give (giveItem -> AddItem)
//BYPASSES that pickup guard, and re-giving a weapon already held is a no-op (Item::Add just caps the
//item's own amount; it does NOT touch the ammo pool, post GiveStartingAmmo, or duplicate), so we can
//safely re-issue EVERY primary in the kit. self unused; player + kit are params to avoid racing the
//shared `group` on a concurrent spawn.
//[user 07-28] bug-1204 SIDEARM TOO: this used to be primaries-ONLY (coop_isPrimaryClass explicitly
//excludes pistols), which is why the armory-picked handgun never came back on any spawn while the two
//picked primaries did. Backfilling a pistol is safe and cannot collide with the one-primary rule:
//WEAPON_CLASS_SECONDARY = WEAPON_CLASS_PISTOL | WEAPON_CLASS_GRENADE (bg_public.h:388), and
//Weapon::PickupWeapon's guard (weapon.cpp:3136) is `!IsSecondaryWeapon() && sen->HasPrimaryWeapon()` -
//a pistol short-circuits it. The bare `item` give path (Sentient::giveItem, sentient.cpp:1280) does not
//consult that guard at all and posts EV_Weapon_GiveStartingAmmo for a fresh weapon, so the pistol
//arrives loaded. Gate is now "2+ primaries OR a sidearm in the kit".
//=========================================================================
coop_backfillPrimaries local.player local.kit:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/coop_backfillPrimaries->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (level.gametype == 0){ end }			//SP: engine allows multiple primaries, no pickup guard
	if (level.coop_noWeapon){ end }			//papers-only / disguise lockout: no weapons to backfill
	if (local.kit == NIL){ end }
	if (local.player == NULL){ end }

	//count primaries AND sidearms first - a kit with one primary and no pistol needs nothing re-issued,
	//so it still incurs no gametype churn (bug-897 v2's original reason for counting).
	local.primaries = 0
	local.sidearms  = 0
	for (local.i = 1; local.i <= local.kit.size; local.i++){
		local.w = local.kit[local.i]
		if (local.w != NIL){
			if (waitthread notStartGrenade local.w){
				local.cls = waitthread getAmmoType local.w
				if (waitthread coop_isPrimaryClass local.cls){ local.primaries++ }
				if (local.cls == "pistol"){ local.sidearms++ }
			}
		}
	}
	//[user 07-28] bug-1204: a lone sidearm is reason enough to run - the picked handgun is the exact
	//thing that used to fall through every give path.
	if (local.primaries < 2 && local.sidearms < 1){ end }

	//let the pickup-based give (giveInventory triggereffect) settle before re-issuing
	waitframe
	waitframe
	if (local.player == NULL){ end }
	if (!(isAlive local.player)){ end }
	if (local.player.dmteam == "spectator"){ end }

	//[user 07-19] bug-897 v2 DIAGNOSTIC (gated: set coop_missionItemDebug 1): BEFORE re-issuing, probe
	//which primaries the ENGINE actually holds so the next run is black-and-white about removed-vs-
	//holstered. `use` each primary then read the active weapon (returnActiveWeapon only returns Weapons):
	//a name match = PRESENT (was merely holstered), no match = ABSENT (the engine pickup rule dropped it
	//from inventory). The concurrent spawnWeaponAssert re-raises the correct gun within a few frames, so
	//this only perturbs a diagnostic session; off by default = zero effect on normal play.
	if( getcvar( "coop_missionItemDebug" ) == "1" ){
		for (local.pi = 1; local.pi <= local.kit.size; local.pi++){
			local.pw = local.kit[local.pi]
			if (local.pw != NIL){
				if (waitthread notStartGrenade local.pw){
					local.pcls = waitthread getAmmoType local.pw
					if (waitthread coop_isPrimaryClass local.pcls){
						local.player use local.pw
						wait game.ms
						local.paw = waitthread returnActiveWeapon local.player
						local.pawm = "none"
						local.pverdict = "ABSENT"
						if (local.paw != NULL){
							local.pawm = local.paw.model
							local.pwn = waitthread makeWeaponStringValid local.pw
							local.pan = waitthread makeWeaponStringValid local.pawm
							local.pc1 = waitthread coop_mod/main.scr::containsText local.pan local.pwn 0
							local.pc2 = waitthread coop_mod/main.scr::containsText local.pwn local.pan 0
							if (local.pc1 || local.pc2){ local.pverdict = "PRESENT" }
						}
						println ( "^~^~^ KITHOLD player=" + local.player.netname + " want=" + local.pw + " verdict=" + local.pverdict + " active=" + local.pawm )
					}
				}
			}
		}
	}

	//[user 2026-08-21, bug-2027] PRE-FLIGHT: "it gives you the loadout again... and it lags my
	//game". This label's guard (primaries<2 && sidearms<1) is satisfied by virtually every kit,
	//so the expensive path - the gametype 0->2 flip plus bare item gives (a model load when the
	//kit carries a variant tik) - ran on EVERY spawn, including the common case where the engine
	//dropped nothing and there was nothing to backfill. coop_hasitem (game.dll, Sentient::
	//FindItem) reads the inventory without touching the hands - unlike the KITHOLD diagnostic,
	//which had to USE each weapon to probe it. Nothing missing = no flip, no gives, no hitch.
	local.missing = 0
	for (local.pi2 = 1; local.pi2 <= local.kit.size; local.pi2++){
		local.pw2 = local.kit[local.pi2]
		if (local.pw2 == NIL){ continue }
		if (!(waitthread notStartGrenade local.pw2)){ continue }
		local.pc2 = waitthread getAmmoType local.pw2
		local.isP2 = 0
		if (waitthread coop_isPrimaryClass local.pc2){ local.isP2 = 1 }
		if (local.isP2 != 1 && local.pc2 != "pistol"){ continue }
		local.have2 = local.player coop_hasitem local.pw2
		if (local.have2 != 1){ local.missing++ }
	}
	if (local.missing == 0){
		println ( "^~^~^ KITBACKFILL skip player=" + local.player.netname + " kit fully present" )
		end
	}

	local.n = 0
	local.sn = 0
	waitthread coop_mod/main.scr::changeGameType 0 0
	for (local.i = 1; local.i <= local.kit.size; local.i++){
		local.w = local.kit[local.i]
		if (local.w != NIL){
			if (waitthread notStartGrenade local.w){
				local.cls = waitthread getAmmoType local.w
				local.isPrim = 0
				local.isSide = 0
				if (waitthread coop_isPrimaryClass local.cls){ local.isPrim = 1 }
				if (local.cls == "pistol"){ local.isSide = 1 }
				if (local.isPrim || local.isSide){
					//[bug-2027] per-item: re-give only what is actually absent - re-giving a
					//variant tik the player already holds is a pointless model load mid-frame.
					local.have3 = local.player coop_hasitem local.w
					if (local.have3 == 1){ continue }
					local.player item local.w
					thread addWeaponToInventory local.player local.w	//[user 07-19] bug-912: the bare-item backfill bypasses pickup registration, so the 2nd primary never entered coop_inventoryWeapons and every revive re-give (which reads that registry) dropped it. Register here; addWeaponToInventory is idempotent.
					if (local.isSide){
						local.sn++
						//[user 07-28] bug-1204: machine-parseable proof the picked handgun reached the player.
						println ( "^~^~^ LOADOUTPISTOL give " + local.w + " to " + local.player.netname )
					}else{
						local.n++
						println ( "^~^~^ KITBACKFILL give " + local.w + " to " + local.player.netname )
					}
				}
			}
		}
	}
	waitthread coop_mod/main.scr::changeGameType 2 0
	println ( "^~^~^ KITBACKFILL done player=" + local.player.netname + " primaries=" + local.n + " sidearms=" + local.sn )
}end

//[user 07-19] bug-897 v2: the engine's "primary" weapon classes (subject to the one-primary pickup
//rule - i.e. not pistol, not grenade, not an inventory item). Mirrors getAmmoType's class strings.
//=========================================================================
coop_isPrimaryClass local.class:{
//=========================================================================
	switch (local.class){
		case "rifle":
		case "smg":
		case "mg":
		case "heavy":
		case "shotgun":
			end(game.true)
	}
}end(game.false)

//[user 07-28] bug-1204 SIDEARM RESTORE: re-issue the player's ARMORY-PICKED handgun (per-player flag
//coop_loSlot3, set by loadoutpick.scr::loadout_setBody). Used by the DBNO / medkit stand-up revive
//chains, which re-give the REGISTERED inventory first and stop there (local.gave = 1) - so a pistol
//that never made it into coop_inventoryWeapons was silently skipped and the revived player came back
//with primaries only ("after I die in DBNO I lose my secondary").
//SAFE BY ENGINE RULE: a pistol is WEAPON_CLASS_PISTOL, part of WEAPON_CLASS_SECONDARY
//(bg_public.h:388), so Weapon::PickupWeapon's one-primary guard (weapon.cpp:3136, gated on
//!IsSecondaryWeapon()) never rejects it, and the bare `item` give (Sentient::giveItem,
//sentient.cpp:1280) skips that path entirely - on an already-held weapon it degrades to
//Item::Add (no duplicate, no ammo-pool change), so calling this twice costs nothing.
//local.noWrap 1 = the caller is ALREADY inside a changeGameType-0 give window (do not nest one).
//=========================================================================
coop_giveSidearmPick local.player local.noWrap:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/coop_giveSidearmPick->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (local.player == NIL){ end }			//NIL != NULL in MOHAA - guard BOTH before touching .flags
	if (local.player == NULL){ end }
	if (level.gametype == 0){ end }			//SP: the map script owns the kit
	if (level.coop_noWeapon){ end }			//papers-only / disguise lockout
	if (level.coop_loadoutLocked == 1){ end }	//scripted-kit map - armory picks are not applied there
	local.gun = local.player.flags["coop_loSlot3"]
	if (local.gun == NIL || local.gun == ""){ end }
	if (local.noWrap != 1){ waitthread coop_mod/main.scr::changeGameType 0 0 }
	local.player item local.gun
	thread addWeaponToInventory local.player local.gun	//register it, else the NEXT revive re-give drops it again (the bug-912 lesson)
	if (local.noWrap != 1){ waitthread coop_mod/main.scr::changeGameType 2 0 }
	println ( "^~^~^ LOADOUTPISTOL revive " + local.gun + " to " + local.player.netname )
}end

//spawns the inventory in
//=========================================================================
spawnInventory local.default:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/spawnInventory->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if ((!level.coop_weaponLoadout || level.coop_weaponLoadout.size == 0) && !level.coop_playerPrimaryWeapon && !level.coop_playerSecondaryWeapon){
		//println "(coop_mod/itemhandler.scr::spawnInventory): *ERROR* - no weapon loadout found!"
		end
	}

	local.weaponArray[1] = NIL
	//[user 2026-09-28, bug-3208] which picks list this give issued - NIL unless the armory-picks branch
	//below runs. Read by loadoutpick.scr::loadout_regiveWatch to skip re-issuing an identical kit.
	group.player.flags["coop_loGivenSig"] = NIL

	if (level.coop_playerPrimaryWeapon || level.coop_playerSecondaryWeapon){
		if (level.coop_playerPrimaryWeapon){
			local.weaponArray[local.weaponArray.size + 1] = level.coop_playerPrimaryWeapon
			group.player.flags["coop_PrimaryWeapon"] = level.coop_playerPrimaryWeapon
		}
		if (level.coop_playerSecondaryWeapon){
			local.weaponArray[local.weaponArray.size + 1] = level.coop_playerSecondaryWeapon
			group.player.flags["coop_SecondaryWeapon"] = level.coop_playerSecondaryWeapon
		}
	}else{
		if (local.default){
			//[310] armory picks: a player's own loadout (coop_mod/loadoutpick.scr) replaces the
			//map default kit. Force-weapon maps (branch above) and locked maps keep priority.
			//[user 08-02] LOADOUT-SOURCE DIAGNOSTIC. The player reported spawning with the MAP kit
			//(t3l1 Soviet weapons) instead of their armory picks, while the log showed
			//"Armory: your loadout has been applied" - i.e. the log and the observed result disagree.
			//Print which branch actually wins, and why, so the next run settles it instead of guessing.
			//[user 08-02] DIAGNOSTIC REMOVED - it was the bug, twice over, and this is the note so it
			//is never reintroduced casually.
			//  1st attempt: the println was wrapped across six lines with continuations starting with
			//     '+'. MOHAA allows multi-line statements only when the OPERATOR ENDS the line, so the
			//     whole FILE failed to compile ("Script 'coop_mod/itemhandler.scr' was not properly
			//     loaded") - taking the entire loadout system with it.
			//  2nd attempt: on one line, but it concatenated level.coop_loadoutLocked, which is NIL on
			//     any map that never sets it. "string + none" throws at RUNTIME, and a script error
			//     ABORTS THE THREAD - so spawnInventory died right here, one line before the armory
			//     picks branch, and the player kept whatever the earlier pass had given them (the map
			//     default kit). Both times the reported symptom was "I only have the map default
			//     weapons", and both times the instrumentation caused it rather than revealing it.
			//ANY future probe here must NIL-guard every term before concatenating, e.g. copy each
			//value into a local and substitute a literal when it is NIL. Cheaper still: read the
			//branch taken from behaviour, not from a println inside the hot path.
			if (group.player.flags["coop_loWeapons"].size > 0 && level.coop_loadoutLocked != 1){
				//[user 07-19] bug-897: picks stay authoritative, but ALSO carry over any weapon the player
				//picked up in-level (a 2nd primary etc.) that lives in coop_inventoryWeapons yet is not one
				//of the picks - otherwise this picks-only respawn kit silently drops it. group.loCarry is the
				//pre-reset snapshot captured in giveWeaponLoadout. The merge builds a FRESH array (never
				//mutates the shared picks array) and is class-deduped so no ammo class is ever doubled.
				local.weaponArray = waitthread mergeCarryWeapons group.player.flags["coop_loWeapons"] group.loCarry
				//[user 2026-09-28, bug-3208] stamp the picks list this spawn issued. MUST stay byte-identical
				//to loadoutpick.scr::loadout_kitSig; inline (no waitthread) so it adds no suspension point to the
				//shared-`group` give (bug-1204).
				local.gsSrc = group.player.flags["coop_loWeapons"]
				local.gsSig = ""
				for (local.gsi = 1; local.gsi <= local.gsSrc.size; local.gsi++){
					if (local.gsSrc[local.gsi] != NIL){ local.gsSig = local.gsSig + local.gsSrc[local.gsi] + "|" }
				}
				group.player.flags["coop_loGivenSig"] = local.gsSig
			}else{
				local.weaponArray = level.coop_weaponLoadout 				//the default level loadout
			}
		}else{
			local.weaponArray = group.player.flags["coop_inventoryWeapons"]	//all the weapons the player has ever picked up
		}
	}
	
	//[user 07-16] MISSION ITEMS (bug-620): map-issued critical gear (e1l2 minedetector etc.)
	//must survive EVERY loadout source - registered inventory, armory picks, and map default all
	//passed through takeall without it. Registered via addMissionItemToEveryone; appended to a
	//COPY of the array (appending in place would permanently grow the shared level/picks arrays).

	if (level.coop_missionItems.size > 0){
		local.combined[1] = NIL
		for (local.mi = 1; local.mi <= local.weaponArray.size; local.mi++){
			local.combined[local.mi] = local.weaponArray[local.mi]
		}
		local.mbase = local.weaponArray.size
		for (local.mi = 1; local.mi <= level.coop_missionItems.size; local.mi++){
			local.combined[local.mbase + local.mi] = level.coop_missionItems[local.mi]
		}
		local.weaponArray = local.combined
	}

	//[user 07-19] bug-897 v2 SECOND-PRIMARY LOSS: stash the full intended kit (deep copy into a fresh
	//array) so the post-give backfill (giveWeaponLoadout -> coop_backfillPrimaries) can re-issue any
	//2nd+ PRIMARY the engine's team-mode one-primary PICKUP rule silently drops. spawnInventory hands
	//the kit out as spawned PICKUP entities, and in g_gametype 2 the engine's Weapon::PickupWeapon
	//REFUSES a second primary (rifle/smg/mg/heavy) when the player already holds one - so a correct
	//weaponArray is not enough (this is why bug-897's array-level mergeCarryWeapons fix did not stick).
	//A bare `item` give (giveItem -> AddItem) bypasses that pickup guard. Fresh array so a later spawn
	//re-points group.coop_intendedKit rather than mutating this one.
	group.coop_intendedKit = NIL
	group.coop_intendedKit[1] = NIL
	local.ikn = 0
	for (local.iki = 1; local.iki <= local.weaponArray.size; local.iki++){
		if (local.weaponArray[local.iki] != NIL){
			local.ikn++
			group.coop_intendedKit[local.ikn] = local.weaponArray[local.iki]
		}
	}

	//[202] Smithy - spawn them backwards so the grenade start tiks are done first
	//so additionalStartAmmo is removed from weaps, otherwise we can end up with 0 nades that are still usable
	//[user 07-20] bug-939: track every pickup entity spawned by THIS invocation (locals only, so a
	//concurrent spawn of another player is never touched) and sweep the leftovers once the give has
	//settled. Since the reissue-first respawn ordering (bug-897/bug-924), most kit items are ALREADY
	//OWNED by the time giveInventory triggereffects these pickups, and the engine's PickupWeapon
	//REFUSES them silently (second primary: the team-mode one-primary rule; owned weapon with full
	//ammo: the bSameAmmo / no-ammo returns) - the refused pickup ENTITIES then linger at the player's
	//spawn origin until the NEXT respawn (deletePreviousInvWeapons), visibly floating there. They are
	//script-spawned pickups, not Drop()-path items, so g_droppeditemlife never cleans them.
	//[user 07-28] bug-1204 CORRECTION to the paragraph above: on the ARMORY-PICKS path the pickups were
	//not being "refused" at all - giveInventory's triggereffect was running on a NULL listener and never
	//touched them (see the waitthread note in giveWeaponLoadout), which is why the whole kit floated.
	//The sweep is still correct for genuinely refused items (already-owned gear from the reissue path).
	local.spawnedPickups[1] = NIL
	local.spawnedNum = 0
	for (local.i = local.weaponArray.size; local.i > 0; local.i--){ 	//do the spawning
		local.weapon = spawn local.weaponArray[local.i] targetname group.invTargetname tracerfrequency 0
		local.weapon.flags["coop_playerNewWeapon"] 	= game.true
		local.weapon.flags["coop_itemOwner"] 		= group.player
		local.weapon thread removeAdditionalStartAmmo
		local.spawnedNum++
		local.spawnedPickups[local.spawnedNum] = local.weapon
	}
	//[user 07-28] bug-1204: publish the real count so giveWeaponLoadout / giveInventory only touch
	//$(group.invTargetname) when it can actually resolve. Machine-parseable so a playtest can prove
	//the kit reached the world at all (ents=0 or a missing line = spawnInventory bailed early).
	group.coop_kitEntN = local.spawnedNum
	println ( "^~^~^ KITSPAWN player=" + group.player.netname + " ents=" + local.spawnedNum )
	thread coop_cleanupSpawnedPickups local.spawnedPickups
}end

//[user 07-20] bug-939 LEFTOVER PICKUP SWEEP: delete any kit pickup entity from ONE spawnInventory
//invocation that the engine give (giveInventory triggereffect) did not consume. Consumed pickups
//are removed by the engine, so their references read NULL here (guarded); refused ones (already-
//owned weapons, second primaries) would otherwise float at the spawn point until the player's next
//respawn. The 2 second delay is well past the whole give chain (triggereffect at ~1ms, primary
//backfill a few frames later, exact-ammo restore at 0.5s, late weapon assert at 0.8s - none of
//which touch the pickup entities after the triggereffect). The array is per-invocation locals, so
//other players' concurrent spawns and their pickups are never affected.
//=========================================================================
coop_cleanupSpawnedPickups local.items:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/coop_cleanupSpawnedPickups->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	wait 2
	for (local.i = 1; local.i <= local.items.size; local.i++){
		if (local.items[local.i] != NIL && local.items[local.i] != NULL){
			local.items[local.i] delete
		}
	}
}end

//[user 07-19] bug-897 SECOND-PRIMARY CARRY-OVER: merge in-level pickups (local.carry, the pre-reset
//coop_inventoryWeapons snapshot) onto the authoritative pick list (local.picks) without doubling an
//ammo class or mutating the shared pick array. Returns a fresh array = picks + surviving extras.
//An extra is kept only if it is a real weapon (not a start-grenade marker), is not already in the
//array, and no existing entry shares its ammo class. Uses a skip flag (no break/continue) for parse
//safety.
//=========================================================================
mergeCarryWeapons local.picks local.carry:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/mergeCarryWeapons->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.out[1] = NIL
	local.n = 0
	for( local.i = 1; local.i <= local.picks.size; local.i++ ){
		if( local.picks[local.i] != NIL ){
			local.n++
			local.out[local.n] = local.picks[local.i]
		}
	}
	if( local.carry == NIL ){ end(local.out) }
	for( local.i = 1; local.i <= local.carry.size; local.i++ ){
		local.w = local.carry[local.i]
		if( local.w != NIL ){
			if( waitthread notStartGrenade local.w ){
				local.skip = 0
				//[user 08-02] NEVER carry the MAP DEFAULT kit across into a picks loadout.
				//This merge exists to preserve weapons the player FOUND in the level (bug-897).
				//It cannot otherwise tell those apart from the weapons the map default handed
				//them at spawn, so the map kit rode in as "carry" and the player ended up with
				//their armory picks AND the map kit - reported on t3l1 as "I get my loadout now
				//but it also gives me the default map weapons too (ppsh, etc)". The class dedup
				//below does not catch it reliably, because the mod's extended weapons report a
				//different ammo class than their retail equivalents (xw_thompson50 vs ppsh).
				//Anything present in level.coop_weaponLoadout was issued by the default path,
				//not found in the world, so it is excluded here by name.
				for( local.k = 1; local.k <= level.coop_weaponLoadout.size; local.k++ ){
					if( level.coop_weaponLoadout[local.k] == local.w ){ local.skip = 1 }
				}
				for( local.j = 1; local.j <= local.out.size; local.j++ ){
					if( local.out[local.j] == local.w ){ local.skip = 1 }
				}
				if( local.skip == 0 ){
					local.wClass = waitthread getAmmoType local.w
					for( local.j = 1; local.j <= local.out.size; local.j++ ){
						if( waitthread notStartGrenade local.out[local.j] ){
							if( (waitthread getAmmoType local.out[local.j]) == local.wClass ){ local.skip = 1 }
						}
					}
				}
				if( local.skip == 0 ){
					local.n++
					local.out[local.n] = local.w
				}
			}
		}
	}
}end(local.out)

//this is what actually gives the players their weapons
//uses our gametype hack
//=========================================================================
giveInventory:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/giveInventory->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.threadName = "coop_mod/itemhandler.scr::giveInventory"
	
	waitthread coop_mod/main.scr::changeGameType 0 0
	//[user 07-28] bug-1204: THIS is the give. Re-resolve the kit entities here rather than trusting the
	//snapshot giveWeaponLoadout took - changeGameType above can wait several frames when another give
	//holds the lock, and that stale snapshot was exactly what used to be NULL. Guarded on the spawn
	//count so an empty kit can never hit a NULL listener again.
	if (group.coop_kitEntN > 0){
		group.weapons = $(group.invTargetname)
		group.weapons triggereffect group.player
		println ( "^~^~^ KITGIVE player=" + group.player.netname + " ents=" + group.coop_kitEntN )
	}
	for (local.i = 1; local.i <= level.coop_ammoLoadout.size; local.i++){
		//[HZM coop 2026-07-22] skip ammo types with no configured loadout amount:
		//level.coop_ammoLoadout[<type>] reads NIL for an unconfigured class and the
		//engine cannot cast 'none' to int (25x storm on respawn/loadout). NIL-skip is
		//safest - do not hand out ammo that was never configured.
		if( level.coop_ammoLoadout[level.coop_ammoType[local.i]] != NIL ){
			group.player ammo level.coop_ammoType[local.i] level.coop_ammoLoadout[level.coop_ammoType[local.i]]
		}
	}
	//[310] armory picks: top up the picked guns' ammo classes (some maps zero whole
	//classes and would hand out a dry picked weapon). Never lowers a map value.
	if (group.player.flags["coop_loWeapons"].size > 0 && level.coop_loadoutLocked != 1){
		waitthread coop_mod/loadoutpick.scr::loadout_ammoTopup group.player
	}
	waitthread coop_mod/main.scr::changeGameType 2 0

	//ok, stop the text showing on the screen by pushing it up...
	for (local.i = 1; local.i <= 5; local.i++){ group.player iprint "" }
}end

//checks if a player holds a coop inventory
//=========================================================================
playerHasInventory local.player:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/playerHasInventory->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
}end (local.player.flags["coop_inventoryWeapons"].size > 0)

//[user 07-16] MISSION ITEM registration (bug-620): critical map gear (minedetector etc.) that
//must be issued on TOP of any loadout source and survive regives/DBNO. Gives to current
//players immediately and registers for every future spawn (spawnInventory appends the list).
//=========================================================================
addMissionItemToEveryone local.model:{
//=========================================================================
	if (level.gametype == 0){
		$player item local.model
		end
	}
	//[user 07-19] bug-898: IDEMPOTENT registration - do not append a duplicate if this exact model is
	//already on the mission-item list (this hook can now be reached more than once). We still (re)give
	//it to all current players below.
	local.already = 0
	for (local.di = 1; local.di <= level.coop_missionItems.size; local.di++){
		if (level.coop_missionItems[local.di] == local.model){ local.already = 1 }
	}
	if (local.already == 0){
		local.n = level.coop_missionItems.size + 1
		if( local.n < 1 ){ local.n = 1 }	//[user 07-19] bug-909: empty MOHAA array .size is -1 so size+1=0 put the first mission item at [0], skipped by every 1-indexed consumer loop (detector never re-given on revive). Force first index to 1.
		level.coop_missionItems[local.n] = local.model
	}
	//[user 07-19] bug-898 INSTRUMENT: LOUD + UNCONDITIONAL - proves the mission item (e1l2 detector)
	//actually got registered and shows the resulting list size (coop_reissueMissionItems is gated on
	//size>0, so a size of 0 there means this registration never ran).
	println ( "^~^~^ MISSIONITEM_REGISTER " + local.model + " already=" + local.already + " newsize=" + level.coop_missionItems.size )
	if ($player){
		for (local.i = 1; local.i <= $player.size; local.i++){
			if ($player[local.i] != NULL && isAlive $player[local.i]){
				$player[local.i] item local.model
			}
		}
	}
}end

//add weapon to everyone's inventory, whether current or future
//use this if you want the whole server to spawn with this weap
//=========================================================================
addWeaponToEveryone local.model:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/addWeaponToEveryone->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (level.gametype == 0){ end }
	thread addWeaponToAllInventories local.model
	thread addWeaponToLoadout local.model
}end

//remove weapon from everyone's inventory, whether current or future
//use this if you want to remove this weapon from all spawns
//=========================================================================
removeWeaponFromEveryone local.model:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/removeWeaponFromEveryone->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (level.gametype == 0){ end }
	thread removeWeaponFromAllInventories local.model
	thread removeWeaponFromLoadout local.model
}end

//add weapon to the inventories of all active players
//=========================================================================
addWeaponToAllInventories local.model:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/addWeaponToAllInventories->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (level.gametype == 0){ end }

	if ($player){
		for (local.i = 1; local.i <= $player.size; local.i++){
			if (waitthread playerHasInventory $player[local.i]){
				thread addWeaponToInventory $player[local.i] local.model
			}	
		}	
	}
}end

//adds weapon model to their inventory array
//=========================================================================
addWeaponToInventory local.player local.model local.pickup local.ammo:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/addWeaponToInventory->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (level.gametype == 0){ end }

	if (waitthread playerHasWeapon local.player local.model){
		end
	}
	if (local.pickup && waitthread isCarryingAmmoType local.player local.ammo){
		end //this stops weapons of same ammo type being removed from our inv if we pick one up in level
	}

	local.model = waitthread makeWeaponStringValid local.model

	if (waitthread notStartGrenade local.model){
		local.ammoType = waitthread getAmmoType local.model
	}
	
	for (local.i = 1; local.i <= local.player.flags["coop_inventoryWeapons"].size; local.i++){
		local.invWeapon = local.player.flags["coop_inventoryWeapons"][local.i]
		if (waitthread notStartGrenade local.invWeapon){
			if (local.ammoType == (waitthread getAmmoType local.invWeapon)){ //we can't have two weapons of the same ammo type
				//[310] armory picks: two PICKED weapons may share an ammo class (e.g. two rifles) -
				//without this the second picked same-class gun would be silently dropped on respawn
				local.bothPicked = 0
				if (waitthread coop_mod/loadoutpick.scr::loadout_isPicked local.player local.model){
					if (waitthread coop_mod/loadoutpick.scr::loadout_isPicked local.player local.invWeapon){
						local.bothPicked = 1
					}
				}
				if (local.bothPicked == 0){
					//println "REMOVING " local.invWeapon
					waitthread removeWeaponFromInventory local.player local.invWeapon
					break
				}
			}
		}
	}
	local.weaponIndex = (local.player.flags["coop_inventoryWeapons"].size + 1)
	if( local.weaponIndex < 1 ){ local.weaponIndex = 1 }	//[user 07-19] bug-909: empty array .size is -1 -> first weapon at [0], skipped by 1-indexed re-give loops -> 2nd primary lost on revive. Force first index to 1.
	local.player.flags["coop_inventoryWeapons"][local.weaponIndex] = local.model	
}end

//new, more robust version
//=========================================================================
isCarryingAmmoType local.player local.ammoType:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/isCarryingAmmoType->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (waitthread playerHasInventory local.player){
		for (local.i = 1; local.i <= local.player.flags["coop_inventoryWeapons"].size; local.i++){
			local.weap = local.player.flags["coop_inventoryWeapons"][local.i]
			if (waitthread notStartGrenade local.weap){
				if ((waitthread getAmmoType local.weap) == local.ammoType){
 					end(game.true)
				}
			}
		}
	}
}end(game.false)

//add weapon to the inventories of all active players
//=========================================================================
removeWeaponFromAllInventories local.model:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/removeWeaponFromAllInventories->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (level.gametype == 0){ end }

	if ($player){
		for (local.i = 1; local.i <= $player.size; local.i++){
			thread removeWeaponFromInventory $player[local.i] local.model
		}	
	}
}end

//removes weapon model from their inventory array
//=========================================================================
removeWeaponFromInventory local.player local.model:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/removeWeaponFromInventory->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (level.gametype == 0){ end }

	if (!waitthread playerHasWeapon local.player local.model){
		end
	}

	local.model = waitthread makeWeaponStringValid local.model

	local.oldArray 		= local.player.flags["coop_inventoryWeapons"]
	local.newArray[1] 	= NIL
	local.j = 1
	for(local.i = 1; local.i <= local.oldArray.size; local.i++){
		local.weaponModel = local.oldArray[local.i]
		if(local.weaponModel != local.model){
			local.newArray[local.j] = local.weaponModel
			local.j++
		}
	}
	local.player.flags["coop_inventoryWeapons"] = local.newArray
	
}end

//removes weapon from the loadout array.
//this is to change default spawn loadouts for fresh spawns if a map
//requires this. 
//=========================================================================
removeWeaponFromLoadout local.model:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/removeWeaponFromLoadout->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (level.gametype == 0){ end }

	if (waitthread isWeaponClass local.model){
		local.class = local.model
		local.model = waitthread returnWeaponClassFromLoadout local.class
		if (!local.model){
			println "(coop_mod/itemhandler.scr::removeWeaponFromLoadout): no weapon of class " local.class " in loadout array"
			end
		}
	}else{
		local.model = waitthread makeWeaponStringValid local.model
	}

	local.oldArray 		= level.coop_weaponLoadout
	local.newArray[1] 	= NIL
	local.j = 1
	for(local.i = 1; local.i <= local.oldArray.size; local.i++){
		local.weaponModel = local.oldArray[local.i]
		if(local.weaponModel != local.model){
			local.newArray[local.j] = local.weaponModel
			local.j++
		}
	}
	level.coop_weaponLoadout = local.newArray

	if (level.coop_weaponLoadout.size == 0){
		println "(coop_mod/itemhandler.scr::removeWeaponFromLoadout): *ERROR* - there are no weapons in loadout!"
	}
}end

//adds weapon to the loadout array.
//this is to change default spawn loadouts for fresh spawns if a map
//requires this. 
//=========================================================================
addWeaponToLoadout local.model:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/addWeaponToLoadout->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (level.gametype == 0){ end }

	local.model = waitthread makeWeaponStringValid local.model

	local.ammoType = waitthread getAmmoType local.model

	for (local.i = 1; local.i <= level.coop_weaponLoadout.size; local.i++){
		if (level.coop_weaponLoadout[local.i] == local.model){
			end
		}
	}
	for (local.i = 1; local.i <= level.coop_weaponLoadout.size; local.i++){
		if (waitthread notStartGrenade level.coop_weaponLoadout[local.i]){
			if (local.ammoType == (waitthread getAmmoType level.coop_weaponLoadout[local.i])){
				waitthread removeWeaponFromLoadout level.coop_weaponLoadout[local.i]		
				break
			}		
		}
	}

	local.weaponIndex = (level.coop_weaponLoadout.size + 1)
	level.coop_weaponLoadout[local.weaponIndex] = local.model
}end

//adds ammo to the default loadout array for future players
//=========================================================================
addAmmoToLoadout local.ammoType local.amount:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/addAmmoToLoadout->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (level.coop_ammoLoadout[local.ammoType] == NIL){
		level.coop_ammoLoadout[local.ammoType] = 0
	}
	level.coop_ammoLoadout[local.ammoType] += local.amount

	if (level.coop_ammoLoadout[local.ammoType] < 0){
		level.coop_ammoLoadout[local.ammoType] = 0
	}
}end

//we need to have these - never remove!
//=========================================================================
notStartGrenade local.model:
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/notStartGrenade->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
end (local.model != "models/weapons/m2frag_grenade_sp_start.tik" && 
	local.model != "models/weapons/steilhandgranate_start.tik" &&
	local.model != "models/weapons/it_w_bomba_sp_start.tik") //[202] Smithy - some BT maps use this

//=========================================================================
returnWeaponClassFromLoadout local.class:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/returnWeaponClassFromLoadout->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	for (local.i = 1; local.i <= level.coop_weaponLoadout.size; local.i++){
		local.invWeapon = level.coop_weaponLoadout[local.i]
		if (waitthread notStartGrenade local.invWeapon){
			if (waitthread getAmmoType local.invWeapon == local.class){
				end(local.invWeapon)
			}
		}
	}
}end(NULL)

//make sure the weapon string is the correct format
//=========================================================================
makeWeaponStringValid local.model:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/makeWeaponStringValid->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.model = waitthread coop_mod/strings.scr::to_lower local.model //convert it to lowercase

	//make sure the models folder is included in the name
	if (!waitthread coop_mod/main.scr::containsText local.model "models"){
		local.model = ("models/" + local.model)
	}
}end(local.model)

//checks if a player holds this weapon
//=========================================================================
playerHasWeapon local.player local.model:{ 
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/playerHasWeapon->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.weaponArray = local.player.flags["coop_inventoryWeapons"]
	for (local.i = 1; local.i <= local.weaponArray.size; local.i++){
		if (local.weaponArray[local.i] == local.model){
			end(1)
		}
	}
}end(0)

//remove any remaining inventory entities if we have them
//=========================================================================
deletePreviousInvWeapons:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/deletePreviousInvWeapons->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.inventory = $("player"+group.player.entnum+"Inventory")
	if (local.inventory){
		local.inventory delete
	}
}end

//initialises/resets all the weapon inventory flags for a player
//=========================================================================
resetPlayerWeapons local.player:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/resetPlayerWeapons->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (!local.player || local.player.classname != "Player"){ end }
	local.player.flags["coop_inventoryWeapons"] 		= NIL
	local.player.flags["coop_inventoryWeapons"][1]	= NIL
}end

//makes grenades work when picking them up by turning them into an AmmoEntity.
//they now provide grenade ammo. but more specifically, their particular grenade ammo
//(internal use only)
//TODO: add any more ?
//=========================================================================
setupGrenades:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/setupGrenades->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (!group.item){ end }
	
	switch (group.model){
		case "models/weapons/steilhandgranate.tik":
			local.isGrenade 	= game.true
			local.model 		= "weapons/steilhandgranate.tik"
			local.name 			= "grenade" 	//axis nades
			local.pickupSound 	= "steilhandgranate_snd_pickup_ammo"
			break
		case "models/weapons/m2frag_grenade_sp.tik":
		case "models/weapons/m2frag_grenade.tik":
			local.isGrenade 	= game.true
			local.model 		= "weapons/m2frag_grenade.tik"
			local.name 			= "agrenade"	//american nades
			local.pickupSound 	= "m2frag_snd_pickup_ammo"
			break
		case "models/weapons/it_w_bomba.tik":
			local.isGrenade 	= game.true
			local.model 		= "weapons/it_w_bomba.tik"
			local.name 			= "grenade" 	//axis nades
			local.pickupSound 	= "sovietgrenade_snd_pickup_ammo"
			break
		default:
			local.isGrenade 	= game.false
			break
	}

	if (local.isGrenade){

		local.item 		= group.item
		local.velocity 	= local.item.velocity

		local.granate 			= spawn AmmoEntity
		local.granate.model 	= local.model
		local.granate name local.name
		local.granate amount 1
		local.granate pickupsound local.pickupSound
		local.granate.origin 	= group.origin
		local.granate.angles 	= group.angles
		local.granate.scale 	= group.scale

		if (local.velocity != (0 0 0)){
			local.granate glue local.item
			local.granate.flags["coop_droppedItem"] = game.true
			local.item hide
			local.item nottriggerable
			group.thread["initialiseItem"] end 		//stop the processing of the item even though the item still exists
			waitthread waitTillLanded local.item

		}
		if (local.item){
			local.item remove
		}
		waitframe
	}
}end

//waits for an item to lose velocity (which means it has landed on something)
//=========================================================================
waitTillLanded local.item:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/waitTillLanded->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	while (local.item && local.item.velocity != (0 0 0)){
		waitframe
	}
}end

//drop specified item from actor on death
//=========================================================================
dropItemOnDeath local.item local.angles local.mass:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/dropItemOnDeath->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	self waittill death
	waitframe

	if (self){
		thread dropItem local.item 1 "droppedItem" local.angles local.mass
	}
}end

//sets the isDisguised flag.
//this is called from weaponstate.scr when raising/putting away weapons
//this is actually how it works in the engine.
//hasDisguise is used to tell engine that the player is flagged for it.
//isDisguised is whether they are ACTUALLY disguised.
//isDisguised will turn on and off depending on whether they have a
//weapon in their hand or not (plus other criteria like actor thinkstates)
//=========================================================================
setIsDisguised local.player local.bool local.forceState:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/setIsDisguised->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (local.player.flags["coop_hasDisguise"] || local.forceState){
		local.player.flags["coop_isDisguised"] = local.bool
	}
}end

//takes a diguise from a player
//=========================================================================
takeDisguise local.player:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/takeDisguise->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.threadName = "coop_mod/itemhandler.scr::takeDisguise"

	if (local.player.has_disguise && local.player.flags["coop_hasDisguise"]){
		waitthread coop_mod/main.scr::changeGameType 0 0
		local.player.has_disguise 				= game.false
		local.player.flags["coop_isDisguised"] 	= game.false
		waitthread coop_mod/main.scr::changeGameType 2 game.ms
	}
}end

//returns the weapon (if any) that a sentient is currently holding
//only returns weapons - any other item (e.g. papers) will return NULL
//=========================================================================
returnActiveWeapon local.sentient:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/returnActiveWeapon->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.entnum = local.sentient.entnum
	if (local.sentient.classname == "Player"){
		local.tempName 	= ("player" + local.entnum + "ActiveItem")
		local.reset 	= ("player" + local.entnum + "Inventory")
	}else{
		local.tempName 	= ("actor" + local.entnum + "ActiveItem")
		local.reset 	= ""
	}
	local.sentient weaponcommand "dual" targetname local.tempName //as actors can sometimes have weapons in either hand when doing cover behavior
	local.item = $(local.tempName)
	if (local.item){
		if (local.item.classname == "Weapon"){
			local.item targetname local.reset
		}else{
			local.item targetname ""
			local.item = NULL
		}		
	}else{
		local.item = NULL
	}
}end (local.item)

//creates a sound event emanating from specified entity
//=========================================================================
broadcastSound local.entity local.event local.radius:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/broadcastSound->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling

	local.entity ai_event local.event local.radius

	/*
	Events to choose from:
		"weapon_fire"
		"weapon_impact"
		"explosion"
		"american_voice"
		"german_voice"
		"american_urgent"
		"german_urgent"
		"misc"
		"misc_loud"
		"footstep"
		"grenade"

	source: https://github.com/openmoh/openmohaa/blob/54355278307a64d2e62e68f8450aeb3cdf7651b3/code/game/g_utils.cpp#L1984
	*/
}end



//=========================================================================
// Disguise maps: the silenced pistol IN ADDITION to the player's own loadout. [user 2026-08-11]
//=========================================================================
// "we should have the silence pistol plus whatever sidearm they have in their loadout on those maps"
//
// Deferred deliberately. The kit is handed out as spawned PICKUP entities by a THREADED
// giveInventory, so it lands over the following moments; a same-frame give of a second pistol can
// make the picked sidearm lose (bug-1692 measured exactly that in the other direction). Waiting lets
// the player's own choice arrive first, then adds the silenced pistol on top via a bare `give` -
// Sentient::giveItem, which does not consult Weapon::PickupWeapon's guard at all, and which is a
// no-op when the weapon is already held.
// Ammo granted explicitly for the bug-1683 reason: a map that does not stock the pistol class hands
// over a gun that cannot fire.
//=========================================================================
coop_giveSilencedExtra local.player:{
	if( local.player == NULL || local.player == NIL ){ end }
	wait 1.5
	if( local.player == NULL ){ end }
	if( !isAlive local.player ){ end }
	if( local.player.dmteam == "spectator" ){ end }
	if( level.coop_noWeapon ){ end }		//papers-only window: no weapons at all, by design
	//[user 2026-08-11] bug-1706: when coop_silencedDrawn is set the spawn block already gave
	//this and made it the desired weapon, so re-giving here would fight the raise that is
	//already in flight. This deferred path now only covers the additive-but-NOT-drawn case.
	if( local.player.flags["coop_silencedGiven"] == 1 ){ end }
	local.player give "models/weapons/silencedpistol.tik"
	local.player ammo "pistol" 40
	if( getcvar( "coop_aggroDebug" ) == "1" ){
		println( "^~^~^ SILENCED extra given to " + local.player.netname )
	}
}end

//gives a player the papers flag
//=========================================================================
givePapersFlag local.player:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/givePapersFlag->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.player.flags["coop_hasPapers"] = game.true
	//[user 2026-08-08] and let them present the papers whenever they like, not only when asked
	thread coop_papersAnytime local.player
}end

//flags players that they have the papers. also stores papers in level var
//for use on new players.
//=========================================================================
givePapersFlagToAll local.papers:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/givePapersFlagToAll->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	level.coop_itemPapers = local.papers
	for (local.i = 1; local.i <= $player.size; local.i++){
		thread givePapersFlag $player[local.i]
	}
}end

//allows a player to click to open papers, but only when being asked for them.
//this is called from the anim/disguise scripts on the player being interrogated
//and if papers are accepted or declined (or the guard dies) stop this.
//this is just a bonus feature because messing with num keys can be a pain.
//it will also stop any bugs that can happen when holding multiple items.
//e.g when you have binoculars AND papers, pressing 7 opens binocs.
//=========================================================================
enableClickablePapers local.guard local.player:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/enableClickablePapers->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (local.player == NULL || local.guard == NULL){ end }

	//[user 2026-08-12] TWO GUARDS, BOTH AT THE FUNCTION - not at a call site.
	//This label now has FOUR callers: anim/disguise_papers.scr (a guard challenging you), the m6l1c
	//and m6l2a radio errands, the silent-patroller watcher, and coop_bustAnyoneWatch. Each sets
	//coop_clickablePapersEnabled true on entry and loops on it; coop_bustArm clears it ONCE as the
	//handshake that ends the papers loop when a bash starts. So N live loops means the clear stops
	//exactly one and the rest keep force-equipping papers into the hand holding the drawn pistol -
	//the gun alternates with (none) and the player cannot shoot.
	//Guarding one caller was not enough: a measured run showed THREE entries from the challenge path
	//plus one from the watcher, and clickPapers stayed 1 for the whole bust.
	//  1. one loop per player, ever - the flag IS the 'a loop is running' state, and every exit path
	//     below already clears it, so this cannot deadlock.
	//  2. never start one for a player mid-contain - coop_bustArm has deliberately just cleared the
	//     flag and is about to put a pistol in his hands.
	if (local.player.flags["coop_clickablePapersEnabled"]){ end }
	if (local.player.flags["coop_busted"] == 1){ end }

	//[user 2026-08-08] NOTE: this label is threaded from anim/disguise_papers.scr ONLY - i.e. while a
	//guard is actively asking. coop_mod/main.scr::forcePapersInHand is the other half and is what
	//lets you hold them the rest of the time; see level.coop_forcePapersEquip.

	//=====================================================================================
	//[user 2026-08-10] PHASE C - PLAYER-INITIATED CONTAIN. Hosted HERE deliberately.
	//=====================================================================================
	//This loop is ALREADY the "an officer has stopped this player" tracker: it starts when the
	//challenge starts, and ends when he accepts, denies, dies, or the player dies. A separate watcher
	//would have to re-derive every one of those conditions and could then drift out of step with the
	//thing it is shadowing. Sharing the loop means the prompt cannot outlive the challenge.
	//
	//The prompt is offered BEFORE the papers are shown - it is an ALTERNATIVE to the papers check,
	//not a consequence of failing one.
	local.canContain = 0
	if (level.coop_stealthMap == 1 && getcvar( "coop_stealthStart" ) != "0"){
		//OFFICERS ONLY. User: "The only people i think need contained really are the officers".
		//type_disguise is the map-authored role (m2l2a entity data: officer / sentry / salute / none).
		//A sentry who stops you is not worth containing - he just raises it.
		if (local.guard.type_disguise == "officer"){ local.canContain = 1 }
		//[user 2026-08-12] PER-MAP: sentries too. m6l2a's set-2 radio distraction pulls
		//alarm2_officer_patroller, who is a SENTRY (he has to be - officers can never accept papers,
		//and he guards the route to the train schedule). Officer-only meant that distraction created
		//perfect isolation and then offered nothing to do with it. Opt-in, so m2l2a and m6l1c keep
		//the original rule: a sentry who merely stops you there is not worth containing.
		if (level.coop_bustAllowSentry == 1 && local.guard.type_disguise == "sentry"){ local.canContain = 1 }
		//[user 2026-08-12] CONTAIN ANYONE. The role gate above assumes the prompt can only be raised
		//by a man who STOPPED you, because anim/disguise_papers.scr is its only caller in the vanilla
		//flow. It is not the only caller any more - the radio errand and the silent-patroller watcher
		//both call this directly on men who never challenge - so the role is no longer the right
		//question. With coop_bustAnyone the answer is simply yes, and the RISK carries the design:
		//coop_bustAssaultWatch (seen during the stagger), coop_bustMonitor's clear window (seen just
		//after), coop_bustBodyWatch (the corpse is found) and the alarm all already punish it.
		if (level.coop_bustAnyone == 1){ local.canContain = 1 }
	}
	local.range = int( getcvar "coop_bustUseRange" )
	//[user 2026-08-12] PER-MAP TIGHTENING. "I accidentally contained a guard when trying to open a
	//door" - at 112u the grab reaches further than you expect, and USE is the same key you press for
	//doors, ladders and everything else. A map that offers the contain on ANY german (coop_bustAnyone)
	//has far more chances to catch one by accident than one that only offers it during a challenge,
	//so it gets a shorter reach. Per-map rather than a cvar change: m2l2a and m6l1c are signed off at
	//112 and there is no reason to re-tune them.
	if( level.coop_bustUseRangeMap != NIL ){
		if( level.coop_bustUseRangeMap > 0 ){ local.range = level.coop_bustUseRangeMap }
	}
	if (local.range <= 0){ local.range = 112 }

	//The papers half must no longer be able to suppress the contain prompt: being stopped WITHOUT
	//papers is precisely when the option matters most. Previously this was a bare early-exit.
	local.hasPapers = 0
	if (local.player.flags["coop_hasPapers"]){ local.hasPapers = 1 }
	if (local.hasPapers == 0 && local.canContain == 0){ end }

	if (local.hasPapers == 1 && !local.player.flags["coop_clickPapersHint"]){
		local.player.flags["coop_clickPapersHint"] = game.true
		local.player iprint ("When being asked for papers, you can press (PRIMARY FIRE) to show them.") 1
	}

	//[user 2026-08-10] THE SQUAD-WIDE PASS, finally consumed. "other players are not required to
	//flash their papers to the paper guards that ask for it if another player has already done it.
	//They just get a free pass at that point."
	//coop_paperPassAll (itemhandler.scr:1176) already latches `local.guard.coop_paperPass = 1` when a
	//checker accepts, and Phase A hoisted that call out from under an always-true branch so it fires
	//- but NOTHING EVER READ THE LATCH. All it did was hide the prompt; the guard still stopped the
	//next player and interrogated them exactly as before.
	//Consumed HERE, and by presenting the papers automatically rather than by touching the engine's
	//disguise state machine. That restraint is deliberate: the last attempt to shortcut this state
	//from script set `type_disguise "none"` mid-accept and froze the guard for the rest of the map
	//(bug-1631). Auto-`use` of the papers item is the same call the player's own primary-fire makes
	//three lines below, so the engine still runs its normal accept path - the player just does not
	//have to do anything.
	if (local.hasPapers == 1 && local.guard.coop_paperPass == 1 && level.coop_itemPapers != NIL){
		local.player use level.coop_itemPapers
		println( "^~^~^ PAPERS free pass e" + local.player.entnum + " - " + local.guard.targetname + " already accepted the squad" )
	}

	//HUD slot 250. MUST be >= 100 or the engine multiplies its alpha by s_hudFadeAlpha whenever the
	//player is calm (cg_drawtools.cpp:651-653) - and standing still in front of an officer holding
	//your papers out is the definition of calm. That trap has now cost six features (revive HUD,
	//blueprint ack, XP popup, cover prompt, ammo prompt, and this one if it had gone below 100).
	//250 rather than 149: 149 carries the squad-wide "Situation Escalated" banner, and player 2 can
	//legitimately have THIS prompt up at the moment player 1 escalates. Measured the whole 100-255
	//band before claiming it - the fade-exempt band is nearly full and 250/254/255 are the only true
	//spares left (_research/hud_slot_map.md was stale; the code was the oracle).
	local.shown = 0
	if (local.canContain == 1){
		ihuddraw_virtualsize local.player 250 1
		ihuddraw_align       local.player 250 center center
		ihuddraw_font        local.player 250 "verdana-12"
		ihuddraw_color       local.player 250 1 1 1
		ihuddraw_rect        local.player 250 0 -58 0 0
		ihuddraw_string      local.player 250 ""
		ihuddraw_alpha       local.player 250 0
	}

	//PROBE FIRST, then the feature. If the prompt does not appear, this says WHICH gate refused
	//rather than leaving it to be reasoned about - the bug-1665 lesson (eight attempts reasoning
	//about which filter rejected the player; the ninth printed all four fields and settled it in one
	//run). Prints once per challenge, on coop_aggroDebug only, so it costs nothing in normal play.
	if (getcvar( "coop_aggroDebug" ) == "1"){
		local.dbgRole = local.guard.type_disguise
		if (local.dbgRole == NIL){ local.dbgRole = "(none)" }
		println( "^~^~^ CONTAIN challenge by=" + local.guard.targetname + " role=" + local.dbgRole + " stealth=" + getcvar( "coop_stealthStart" ) + " canContain=" + local.canContain + " papers=" + local.hasPapers + " range=" + local.range + " dist=" + (vector_length( local.guard.origin - local.player.origin )) + " e" + local.player.entnum )
	}

	local.player.flags["coop_clickablePapersEnabled"] = game.true
	while (isAlive local.player && local.player.flags["coop_clickablePapersEnabled"] && isAlive local.guard){
		if (local.hasPapers == 1){
			//[user 2026-08-08] NIL *and* NULL. "No weapon in hand" can be either: NULL when a weapon was
			//holstered, NIL when the player never had one at all (the stealth start). Testing only NULL
			//made papers unusable for an unarmed player. This is the documented NIL != NULL guard.
			//[user 2026-08-12, bug-1732] NOT DURING A CONTAINMENT. This is why the silenced pistol
			//"would not fire": holding fire is what TOOK THE GUN AWAY. Measured, not reasoned - the
			//engine FIREPROBE showed a real Weapon in hand (item=0), clip=8, firelock=0, and two clean
			//press edges, yet the clip never moved; the hand alternated Papers/pistol on a 3s cadence
			//that matches the `wait 3` below exactly, and coop_bustPistolHold restoring it 0.25s later.
			//It is a self-sustaining deadlock: the bust hands you the pistol, its RAISE_WEAPON notify
			//never completes because the next papers equip stomps it, so weaponstate.scr never latches
			//coop_activeWeapon, so this test still reads "nothing in hand", so holding fire equips the
			//papers again. The player cannot fire because firing is what disarms him.
			//
			//This is TRAPS T20-A again: coop_activeWeapon answers two questions - "is the hand empty"
			//and "did a raise ever finish" - and this site wanted the first. coop_busted is the flag
			//our own code sets for exactly this window, which is what T20 says to prefer.
			if (local.player.primaryfireheld && local.player.flags["coop_busted"] != 1 && (local.player.flags["coop_activeWeapon"] == NULL || local.player.flags["coop_activeWeapon"] == NIL)){
				local.player use level.coop_itemPapers
				/*
				wait game.ms
				local.player weaponcommand dual targetname ("player" + local.player.entnum + "papers")
				local.papers = $("player" + local.player.entnum + "papers")
				local.papers surface papers "-nodraw"
				*/
				wait 3
			}
		}

		if (local.canContain == 1){
			local.want = 0
			if (level.coop_bustLoud != 1 && local.player.flags["coop_busted"] != 1){
				if (vector_length( local.guard.origin - local.player.origin ) <= local.range){ local.want = 1 }
			}
			if (local.want != local.shown){
				local.shown = local.want
				if (local.want == 1){
					//[user 2026-08-10] the FIRST-CONTACT advisory used to live here and no longer
					//does. It fired off `local.want`, i.e. inside coop_bustUseRange - the BASH
					//range, deliberately tight - so the warning only arrived once the player was
					//"right on top of him", which is far too late to act on. It now has its own
					//proximity watcher with its own, wider, floor-aware range:
					//coop_stealthOfficerHint below.
					//[2026-09-25, bug-2906] claim on show, re-send every hide (coop_mod/hudresend.scr)
					waitthread coop_mod/hudresend.scr::claim local.player 250 250
					ihuddraw_string local.player 250 "Press [USE] to Contain The Situation"
					ihuddraw_alpha  local.player 250 1
				}else{
					ihuddraw_alpha  local.player 250 0
					ihuddraw_string local.player 250 ""
					thread coop_mod/hudresend.scr::resend local.player 250 250 1
				}
			}
			//Polled every frame, not on a 0.1s tick. `useheld` is the raw BUTTON_USE bit off the last
			//processed usercmd (player.cpp:12549 / :5338), so it reads as bursty when sampled slowly -
			//dbno.scr measured 11 hits in 200 samples at 10Hz across a continuous 5s hold, which is why
			//its CHANNEL needs a grace window. A one-shot press does not: cover.scr and ammobox.scr both
			//take a single per-frame sample and both are shipped and working.
			if (local.want == 1 && local.player.useheld == 1){
				ihuddraw_alpha  local.player 250 0
				ihuddraw_string local.player 250 ""
				thread coop_mod/hudresend.scr::resend local.player 250 250 1
				local.shown = 0
				//Hand the two entities over by NUMBER. A player or actor passed across a thread boundary
				//has arrived NIL three times in this project (bugs 1624, 1632, 1665); numbers always bind,
				//so both halves are parked in a level dict keyed by entnum and re-read on the other side.
				level.coop_bustEnt[ "p" + local.player.entnum ] = local.player
				level.coop_bustEnt[ "g" + local.player.entnum ] = local.guard
				waitthread coop_mod/bust.scr::coop_bustBash local.player.entnum
			}
		}

		waitframe
	}

	//Tear the prompt down on EVERY exit path, including the ones this label does not own (the guard
	//dying, the player dying, disguise_deny clearing the enable flag). A HUD element left drawn is
	//not a cosmetic problem - ihuddraw state persists on the client until something overwrites it.
	if (local.player){
		if (local.canContain == 1){
			ihuddraw_alpha  local.player 250 0
			ihuddraw_string local.player 250 ""
			thread coop_mod/hudresend.scr::resend local.player 250 250 1
		}
		local.player.flags["coop_clickablePapersEnabled"] = game.false
	}
}end

//used to replace taking weapons from players (take commands)
//this is so we can keep track of their inventory
//this is called from replace.scr::takePlayerWeapon
//=========================================================================
takePlayerWeapon local.model:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/takePlayerWeapon->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.threadName = "coop_mod/itemhandler.scr::takePlayerWeapon"
	local.player = self

	//ok, we can take weapon of particular class from player now
	if (waitthread isWeaponClass local.model){
		local.class = local.model
		local.model = waitthread getWeaponOfClassFromPlayer local.player local.class
		if (!local.model){
			println "(" local.threadName "): " local.player.netname " is not holding a weapon of class " local.class
			end //this means the player isn't holding a weapon of this class - so it's safe to give him a weapon!
		}
	}

	local.activeWeapon = thread returnActiveWeapon local.player
	if (local.activeWeapon){
		local.activeModel = local.activeWeapon.model
	}
	
	if (local.activeModel && local.activeModel == local.model){
		local.player.flags["coop_takenActiveWeapon"] = game.true
	}

	local.player take local.model

	//take the weapon from everyone's inventories and default loadout so current and future players will not have this
	//thread removeWeaponFromEveryone local.model
	thread removeWeaponFromInventory local.player local.model
}end

//used to replace giving weapons to players via scripts (item and give commands)
//this is so we can use gametype hack and keep track of their inventory
//this is called from replace.scr::givePlayerWeapon
//=========================================================================
givePlayerWeapon local.model:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/givePlayerWeapon->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.threadName = "coop_mod/itemhandler.scr::givePlayerWeapon"
	local.player = self

	//check that the player is not already holding a weapon of this class
	local.class = waitthread getAmmoType local.model
	if (waitthread isCarryingAmmoType local.player local.class){
			println "(" local.threadName "): " local.player.netname " is already holding a weapon of class " local.class " - you must take this from him first!"
			end //we can't have two weapons of the same ammo type in their inventory
	}
	
	local.item 	= spawn local.model targetname ("player" +  local.player.entnum + "Inventory")
	local.item notsolid
	local.item nottriggerable
	local.item hide
	local.item.flags["coop_playerNewWeapon"] = game.true
	local.item.flags["coop_itemOwner"] = local.player
	local.item notdroppable

	wait game.ms

	if (!isAlive local.player || local.player.isSpectator){ 
		local.item remove    //stop any potential memory leaks
		end 
	}
	
	local.item triggerable
	waitthread coop_mod/main.scr::changeGameType 0 0
	local.item triggereffect local.player
	waitthread coop_mod/main.scr::changeGameType 2 0

	//give the weapon to everyone's inventories and default loadout so current and future players will have this
	//thread addWeaponToEveryone local.model
	if (waitthread playerHasInventory local.player){
		thread addWeaponToInventory local.player local.model
	}	
}end

//makes a player use a weapon with optional delay
//we've abstracted it so delays are 'multithreaded'
//=========================================================================
usePlayerWeapon local.model local.wait:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/usePlayerWeapon->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.player = self
	local.player.flags["coop_takenActiveWeapon"] = game.false

	if (local.wait){ wait (float(local.wait)) }
	
	if (isAlive local.player && local.player.dmteam == "allies"){
		local.player use local.model
	}
}end

//Get the weapon type of this weapon
//=========================================================================
getAmmoType local.model:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/getAmmoType->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	local.model = waitthread makeWeaponStringValid local.model

	//[user 2026-08-18] apply-trace F2: classify a FINISHED/VARIANT gun as its BASE. The switch
	//below knows only base tiks, so a variant classified "unknown", failed coop_isPrimaryClass,
	//and the second-primary backfill silently skipped it - a finished primary that lost the
	//engine pickup race was gone for that life. The reverse map is generated from the skin
	//table on every build (gen_skinbase.py); keys are lowercase like makeWeaponStringValid output.
	if( level.coop_skinBaseInit != 1 ){ waitthread coop_mod/loadoutskins_base.scr::main }
	local.coop_bs = level.coop_skinBase[local.model]
	if( local.coop_bs != NIL && local.coop_bs != "" ){ local.model = local.coop_bs }

	switch (local.model){
		case "models/weapons/colt45.tik":
		case "models/weapons/p38.tik":
		case "models/weapons/silencedpistol.tik":
		case "models/weapons/webley_revolver.tik":
		case "models/weapons/it_w_beretta.tik":
		case "models/weapons/nagant_revolver.tik":
		case "models/weapons/delisle.tik":
			end("pistol")
		case "models/weapons/bazooka.tik":
		case "models/weapons/panzerschreck.tik":
		case "models/weapons/uk_w_piat.tik":
			end("heavy")
		case "models/weapons/mp44.tik":
		case "models/weapons/bar.tik":
		case "models/weapons/uk_w_vickers.tik":
		case "models/weapons/it_w_breda.tik":
			end("mg")
		case "models/weapons/shotgun.tik":
			end("shotgun")
		case "models/weapons/springfield.tik":
		case "models/weapons/kar98.tik":
		case "models/weapons/kar98sniper.tik":
		case "models/weapons/m1_garand.tik":
		case "models/weapons/it_w_carcano.tik":
		case "models/weapons/svt_rifle.tik":
		case "models/weapons/mosin_nagant_rifle.tik":
		case "models/weapons/g43.tik":
		case "models/weapons/enfield.tik":
		case "models/weapons/uk_w_l42a1.tik":
			end("rifle")
		case "models/weapons/thompsonsmg.tik":
		case "models/weapons/mp40.tik":
		case "models/weapons/sten.tik":
		case "models/weapons/ppsh_smg.tik":
		case "models/weapons/it_w_moschetto.tik":
			end("smg")
		case "models/weapons/us_w_minedetector.tik":
		case "models/weapons/gr_w_minedetector.tik":
			end("landmine")
		case "models/weapons/it_w_bomba.tik":
		case "models/weapons/steilhandgranate.tik":
			end("grenade")
		case "models/weapons/m2frag_grenade.tik":
			end("agrenade")
		//[310] armory roster additions (GENERATED by scratchpad/gen_loadout.py)
		//mills mirrors m2frag (allied frag coexists with an axis stick); smokes get their
		//own class so a smoke never dedups a frag out of the inventory
		case "models/weapons/mills_grenade.tik":
			end("agrenade")
		case "models/weapons/nebelhandgranate.tik":
		case "models/weapons/m18_smoke_grenade.tik":
			end("smokegrenade")
		case "models/weapons/mp44scoped.tik":
		case "models/weapons/30calportable.tik":
		case "models/weapons/mg42portable.tik":
			end("mg")
		case "models/weapons/colt_silenced.tik":
		case "models/weapons/p38silenced.tik":
		case "models/weapons/berettasilenced.tik":
		case "models/weapons/lugerp08.tik":
		case "models/weapons/lugerp08silenced.tik":
		case "models/weapons/ppk.tik":
		case "models/weapons/tt33.tik":
		case "models/weapons/tt33silenced.tik":
		case "models/weapons/nambu.tik":
		case "models/weapons/welrod.tik":
			end("pistol")
		case "models/weapons/carbine.tik":
		case "models/weapons/springfield_unscoped.tik":
		case "models/weapons/arisaka.tik":
		case "models/weapons/garand_silenced.tik":
		case "models/weapons/garand_scoped.tik":
		case "models/weapons/g43sniper.tik":
		case "models/weapons/enfieldsniper.tik":
		case "models/weapons/carcanosniper.tik":
		case "models/weapons/arisakasniper.tik":
		case "models/weapons/nagant_sniper.tik":
		case "models/weapons/nagant_snipersilenced.tik":
		case "models/weapons/kar98snipersilenced.tik":
		case "models/weapons/fg42.tik":
		case "models/weapons/coop_fg42_irons.tik":
			end("rifle")
		case "models/weapons/thompson50.tik":
		case "models/weapons/mp40silenced.tik":
		case "models/weapons/ppsh43silenced.tik":
		case "models/weapons/greasegun.tik":
		case "models/weapons/greasegun_silenced.tik":
		case "models/weapons/moschetto.tik":
		case "models/weapons/type100smg.tik":
			end("smg")
	}
	println "(coop_mod/itemhandler.scr::getAmmoType): *WARNING* - " local.model " not on list. Add it!"
}end("unknown")

//check if the string is a weapon class
//=========================================================================
isWeaponClass local.string:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/isWeaponClass->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	switch (local.string){
		case "pistol":
		case "heavy":
		case "mg":
		case "shotgun":
		case "rifle":
		case "smg":
		case "landmine":
		case "grenade":
		case "agrenade":
			end(game.true)
	}
}end(game.false)

//returns the weapon of class specified from player inventory if he has one
//=========================================================================
getWeaponOfClassFromPlayer local.player local.class:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/getWeaponOfClassFromPlayer->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (waitthread playerHasInventory local.player){
		for (local.i = 1; local.i <= local.player.flags["coop_inventoryWeapons"].size; local.i++){
			local.invWeapon = local.player.flags["coop_inventoryWeapons"][local.i]
			if (waitthread notStartGrenade local.invWeapon){
				if (waitthread getAmmoType local.invWeapon == local.class){
					end(local.invWeapon)
				}
			}
		}
	}
}end(NULL)

