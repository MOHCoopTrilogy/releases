	}
}end(game.false)

//disable weapons on the weapon select menu
//=========================================================================
disableAllWeaponsOnMenu:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/disableAllWeaponsOnMenu->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	/*
	4194304 //rifle (1 << 22) 
	8388608 //sniper (1 << 23)
	16777216 //smg (1 << 24)
	33554432 //mg (1 << 25)
	67108864 //rocket (1 << 26)
	134217728 //shotgun (1 << 27)
	268435456 //landmine (1 << 28)
	*/
	setcvar dmflags 532676608
}end

//remove any start ammo that is added by the default tiki
//=========================================================================
removeAdditionalStartAmmo:{
//=========================================================================
if(level.cMTE_coop_itemhandler){if(!level.cMTE){level.cMTE=0}; level.cMTE++; println( "-#-#- thread itemhandler/removeAdditionalStartAmmo->"+level.cMTE+"" )} //[202] chrissstrahl - this is to debug the coop mod thread handling
	if (self.classname != "Weapon" || !waitthread notStartGrenade self.model){ end }
	//the coop signal smoke is a one-off reward weapon, not a loadout pickup. Its pickup
	//must NOT run the start-ammo juggle below: that juggle touches the "grenade" ammo
	//pool and was stripping the player's German grenades (ammotype "grenade") the moment
	//they walked over the smoke.
	if (self.model == "models/weapons/coop_smoke_grenade.tik"){ end }
	if (self.flags["coop_removedStartAmmo"]){ end }

	self.flags["coop_removedStartAmmo"] = game.true
	
	self additionalstartammo "grenade" 6
	self additionalstartammo "smokegrenade" 6
	self additionalstartammo "grenade" (0 - 6)
	self additionalstartammo "smokegrenade" (0 - 6)
}end

//=========================================================================
// coop_ammoSnapshotLoop [user 07-09] - EXACT-AMMO RESPAWN (self = player)
// While the player is alive and NOT downed, continuously record the exact
// reserve ammo of every COMBAT ammo type so we can hand it straight back on
// respawn. Reward-item pools (binocstrike / smokegrenade) are deliberately
// left OUT - those items drop on death and must not respawn.
// Requires the HZM engine "getammo" event (game.dll 07-09+).
//=========================================================================
coop_ammoSnapshotLoop:{
//=========================================================================
	//[user 2026-10-04, bug-3305] the loop no longer ends when coop_exactAmmo is 0: it also keeps the
	//held-weapon snapshot the death drop reads (coop_deathDropPickups). Only the ammo part is gated.
	local.exact = 1
	if( getcvar( "coop_exactAmmo" ) == "0" ){ local.exact = 0 }

	local.types[1] = "pistol"
	local.types[2] = "rifle"
	local.types[3] = "smg"
	local.types[4] = "mg"
	local.types[5] = "heavy"
	local.types[6] = "grenade"
	local.types[7] = "shotgun"
	local.types[8] = "agrenade"
	local.types[9] = "landmine"

	while( self ){
		//only snapshot while upright and holding their own kit; while dead
		//(health<=0) or downed (dbno_pistol) the pools are not representative
		//[user 2026-10-04, bug-3305] ROOT CAUSE of "lose weapon when you respawn" (every map, every
		//respawn): health > 0 is NOT "alive and armed". A dead team player DEATH-SPECTATES until the
		//respawn - Player::Spectator() sets health = max_health and FreeInventory()s - so this loop
		//kept running through the whole death wait and saved ZERO for every pool. coop_ammoRestore
		//then wrote those zeros over the fresh kit 0.5s after the respawn: kit in hand, 0 rounds in
		//every gun and no grenades (measured: saved 0/0/0 at every respawn, live pools 0 at +1s).
		//The v1.10.6 arm watch hid it by accident - it re-gave the whole kit 2.5s later with default
		//ammo on every spawn, because it read the setter-only `.weapon` (always NIL). Snapshot only a
		//deployed, coop-active, non-spectating player; the last upright values survive the death wait.
		local.up = 0
		if( self.health > 0 && self.flags["coop_dbno_active"] != 1 && self.flags["coop_ammoRestorePending"] != 1 ){	//[user 07-19] bug-913: pending gate - a revive/respawn hands out DEFAULT ammo, and a snapshot tick in that window would clobber the down-moment values before coop_ammoRestore applies them
			if( self.isSpectator != 1 && self.dmteam != "spectator" && self.flags["coop_isActive"] == 1 ){ local.up = 1 }
		}
		if( local.up == 1 && local.exact == 1 ){
			local.i = 1
			while( local.i <= 9 ){
				local.type = local.types[local.i]
				local.key = "coop_ammoSaved_" + local.type
				self.flags[local.key] = self getammo local.type
				local.i++
			}
			//[user 08-02] IDLE-SPECTATE RESTORE: also snapshot the non-ammo state, because
			//Player::Spectator() destroys ALL of it in the engine before any script sees the
			//transition (it sets health = max_health and calls FreeInventory()). Snapshotting
			//here is the only way to have the values later.
			self.flags["coop_hpSaved"]      = self.health
			self.flags["coop_medkitsSaved"] = self.flags["coop_medkits"]
			self.flags["coop_coverSaved"]   = self.flags["coop_cover_placements"]
			self.flags["coop_ammoSaved_valid"] = 1
		}
		//[bug-3305] what the player is holding, for the death drop + the revive registry. LAST in the
		//tick on purpose: a waitthread returns on a later scheduler pass (bug-1204), and a suspension
		//between the gate above and the ammo writes let a revive's takeall land in between - the
		//snapshot then saved zeros (measured on the first cut of this fix).
		if( local.up == 1 ){
			waitthread coop_heldSnapshot self 0 1
		}
		//[bug-3305] death-drop fallback. The drop is normally armed by player.scr::manageDead, but that
		//runs off the torso statemap's KILLED entry, and some deaths never reach it (measured: every
		//death on t2l1 and e2l1 in the headless runs - no playerdeath, no coop_respawning). Seeing the
		//player dead (not downed, not yet death-spectating) with a live snapshot is enough; the latch in
		//coop_deathDropPickups makes the two triggers one drop.
		if( self.health <= 0 && self.flags["coop_dbno_active"] != 1 && self.isSpectator != 1 && self.flags["coop_heldWeapons"] != NIL && self.flags["coop_deathDropDone"] != 1 ){
			thread coop_deathDropPickups self
		}
		wait 0.5
	}
}end

//=========================================================================
// [user 2026-10-04, bug-3305] DEATH DROP. User spec: on respawn the player ALWAYS gets their own kit
// (armory picks, or the map default kit when they have none); weapons they picked up that are NOT in
// that kit drop on death as world pickups - retrievable, never lost, never duplicated.
// coop_heldSnapshot records the Weapon models a player holds (live inventory, not the coop registry:
// a pickup the itemhandler failed to register is still a real gun in the hand). The snapshot loop
// above calls it every 0.5s while the player is deployed; playerDeathEvent calls it once more at the
// moment of death (keepIfEmpty 1: the engine's dmdeathdrop FreeInventory()s 0.1s after Killed, and an
// empty read there must not erase the last good snapshot).
//=========================================================================
coop_heldSnapshot local.p local.keepIfEmpty local.register:{
//=========================================================================
	if( local.p == NULL || local.p == NIL ){ end }
	if( local.keepIfEmpty == 1 && local.p.flags["coop_deathDropDone"] == 1 ){ end }	//this death already dropped
	local.inv = local.p.inventory
	local.n = 0
	local.out[1] = NIL
	if( local.inv != NIL ){
		for( local.i = 1; local.i <= local.inv.size; local.i++ ){
			local.e = local.inv[local.i]
			if( local.e != NULL && local.e != NIL ){
				if( local.e.classname == "Weapon" ){
					local.m = local.e.model
					if( local.m != NIL && local.m != "" ){
						local.n++
						local.out[local.n] = local.m
					}
				}
			}
		}
	}
	if( local.n == 0 && local.keepIfEmpty == 1 ){ end }
	if( local.n == 0 ){
		local.p.flags["coop_heldWeapons"] = NIL
	}else{
		local.p.flags["coop_heldWeapons"] = local.out
	}
	if( local.register != 1 ){ end }
	//[bug-3305] REGISTRY RECONCILE. Every DBNO/medkit revive re-gives coop_inventoryWeapons after its
	//takeall, but a gun the itemhandler pickup path failed to register ("*ERROR*: Weapon ... cannot be
	//picked up" while the engine did hand it over - measured with an mp40 taken at the feet) is in the
	//hand and NOT in the registry, so the revive silently deleted it. Append any held gun the registry
	//lacks (appended directly: addWeaponToInventory's one-per-ammo-class rule would evict a kit gun).
	for( local.i = 1; local.i <= local.n; local.i++ ){
		local.m = local.out[local.i]
		if( !(waitthread playerHasWeapon local.p local.m) ){
			local.mv = waitthread makeWeaponStringValid local.m
			if( !(waitthread playerHasWeapon local.p local.mv) ){
				if( !(waitthread coop_deathDropExcluded local.mv) ){
					local.wi = local.p.flags["coop_inventoryWeapons"].size + 1
					if( local.wi < 1 ){ local.wi = 1 }	//bug-909: an empty array's .size is -1
					local.p.flags["coop_inventoryWeapons"][local.wi] = local.mv
					println ( "^~^~^ HELDREG e" + local.p.entnum + " " + local.mv )
				}
			}
		}
	}
}end

//[bug-3305] the kit a DEATH respawn hands out (managePlayerInventory with coop_diedKitOnly): the map's
//forced weapons, else the armory picks (coop_loWeapons = the finish-resolved tiks, sidearm and grenade
//slot included), else the map default kit - plus mission items and the map's additive silenced pistol.
//Normalised with makeWeaponStringValid so it compares against an entity .model.
//=========================================================================
coop_respawnKit local.p:{
//=========================================================================
	local.src[1] = NIL
	local.n = 0
	if( level.coop_playerPrimaryWeapon || level.coop_playerSecondaryWeapon ){
		if( level.coop_playerPrimaryWeapon ){
			local.n++
			local.src[local.n] = level.coop_playerPrimaryWeapon
		}
		if( level.coop_playerSecondaryWeapon ){
			local.n++
			local.src[local.n] = level.coop_playerSecondaryWeapon
		}
	}else if( local.p.flags["coop_loWeapons"].size > 0 && level.coop_loadoutLocked != 1 ){
		local.a = local.p.flags["coop_loWeapons"]
		for( local.i = 1; local.i <= local.a.size; local.i++ ){
			if( local.a[local.i] != NIL ){
				local.n++
				local.src[local.n] = local.a[local.i]
			}
		}
		for( local.s = 1; local.s <= 4; local.s++ ){
			local.g = local.p.flags["coop_loSlot" + local.s]
			if( local.g != NIL && local.g != "" ){
				local.n++
				local.src[local.n] = local.g
			}
		}
	}else{
		for( local.i = 1; local.i <= level.coop_weaponLoadout.size; local.i++ ){
			if( level.coop_weaponLoadout[local.i] != NIL ){
				local.n++
				local.src[local.n] = level.coop_weaponLoadout[local.i]
			}
		}
	}
	for( local.i = 1; local.i <= level.coop_missionItems.size; local.i++ ){
		if( level.coop_missionItems[local.i] != NIL ){
			local.n++
			local.src[local.n] = level.coop_missionItems[local.i]
		}
	}
	if( level.coop_silencedOnSpawn == 1 || level.coop_silencedDrawn == 1 ){
		local.n++
		local.src[local.n] = "models/weapons/silencedpistol.tik"
	}
	//map-issued gear (replace.scr::item -> level.coop_playerItem1-6) that main.scr::itemGetAll re-gives
	//on EVERY spawn - e.g. t2l1's "all players ready Thompson". Measured: without these it dropped at
	//the body AND came back with the respawn, one more Thompson on the ground per death.
	local.pi[1] = level.coop_playerItem1
	local.pi[2] = level.coop_playerItem2
	local.pi[3] = level.coop_playerItem3
	local.pi[4] = level.coop_playerItem4
	local.pi[5] = level.coop_playerItem5
	local.pi[6] = level.coop_playerItem6
	for( local.i = 1; local.i <= 6; local.i++ ){
		if( local.pi[local.i] != NIL && local.pi[local.i] != "" ){
			local.n++
			local.src[local.n] = local.pi[local.i]
		}
	}
	local.out[1] = NIL
	for( local.i = 1; local.i <= local.n; local.i++ ){
		local.out[local.i] = waitthread makeWeaponStringValid local.src[local.i]
	}
}end local.out

//[bug-3305] never dropped: grenades (start tiks and thrown kinds), items (binoculars, papers), the
//mine detector and placeable mines - all re-issued by their own systems, or not a gun at all.
//=========================================================================
coop_deathDropExcluded local.m:{
//=========================================================================
	if( !(waitthread notStartGrenade local.m) ){ end 1 }
	if( waitthread coop_mod/main.scr::containsText local.m "models/items/" ){ end 1 }
	if( waitthread coop_mod/main.scr::containsText local.m "grenade" ){ end 1 }
	if( waitthread coop_mod/main.scr::containsText local.m "granate" ){ end 1 }
	if( waitthread coop_mod/main.scr::containsText local.m "bomba" ){ end 1 }
	if( waitthread coop_mod/main.scr::containsText local.m "smoke" ){ end 1 }
	if( waitthread coop_mod/main.scr::containsText local.m "binoc" ){ end 1 }
	if( waitthread coop_mod/main.scr::containsText local.m "paper" ){ end 1 }
	if( waitthread coop_mod/main.scr::containsText local.m "mine" ){ end 1 }
}end 0

//[bug-3305] called once per TRUE death (player.scr::manageDead, the branch that arms the respawn - a
//DBNO bleed-out reaches it too). Drops every held weapon that the respawn kit will not give back, at
//the body, as a permanent pickup (coop_itemRespawnTime -1: no timed expiry like an engine drop, and no
//world respawn once taken). Kit weapons are never dropped - the respawn re-issues them - so nothing is
//duplicated; the snapshot is consumed so a second call cannot drop it twice. coop_diedKitOnly tells the
//next managePlayerInventory to hand out the kit alone (no retain set, no carry-over merge).
//=========================================================================
coop_deathDropPickups local.player:{
//=========================================================================
	if( local.player == NULL || local.player == NIL ){ end }
	if( local.player.flags["coop_deathDropDone"] == 1 ){ end }	//one drop per death (manageDead + the snapshot-loop fallback)
	local.player.flags["coop_deathDropDone"] = 1
	local.held = local.player.flags["coop_heldWeapons"]
	local.player.flags["coop_heldWeapons"] = NIL
	local.player.flags["coop_diedKitOnly"] = 1
	if( level.gametype == 0 ){ end }
	if( local.held == NIL ){ end }
	local.org = local.player.origin
	local.kit = waitthread coop_respawnKit local.player
	local.done[1] = NIL
	local.d = 0
	for( local.i = 1; local.i <= local.held.size; local.i++ ){
		if( local.held[local.i] != NIL ){
			local.mv = waitthread makeWeaponStringValid local.held[local.i]
			local.skip = waitthread coop_deathDropExcluded local.mv
			for( local.k = 1; local.k <= local.kit.size; local.k++ ){
				if( local.kit[local.k] == local.mv ){ local.skip = 1 }
			}
			for( local.k = 1; local.k <= local.d; local.k++ ){
				if( local.done[local.k] == local.mv ){ local.skip = 1 }
			}
			if( local.skip == 0 ){
				local.d++
				local.done[local.d] = local.mv
				local.ox = ( local.d * 14 ) - 14
				local.yaw = local.d * 70
				local.w = spawn local.mv
				local.w.flags["coop_itemRespawnTime"] = 0 - 1
				local.w.flags["coop_deathDrop"] = 1
				local.w set_respawn 0
				local.w.origin = local.org + ( local.ox 0 24 )
				local.w.angles = ( 0 local.yaw 0 )
				println ( "^~^~^ DEATHDROP e" + local.player.entnum + " " + local.mv + " at " + local.w.origin )
			}
		}
	}
}end

//=========================================================================
// coop_ammoRestore [user 07-09] - EXACT-AMMO RESPAWN (self = player)
// Called on a RESPAWN after the inventory has been rebuilt. Waits for the
// async loadout-give (giveWeaponLoadout -> giveInventory) to finish handing
// out DEFAULT ammo, then overwrites each combat ammo pool with the exact
// amount the player was carrying when they went down. Uses the HZM engine
// "setammo" event (exact set; the stock "ammo" event only ADDs).
//=========================================================================
coop_ammoRestore:{
//=========================================================================
	//[user 2026-08-02] bug-1293 - CLEAR THE GUARD ON EVERY EXIT. The revive paths now raise
	//coop_ammoRestorePending BEFORE their takeall (so a snapshot tick cannot save the zeroed pools),
	//which means this function no longer owns the only place it is set - and both early exits below
	//used to return WITHOUT clearing it. Left set, the snapshot loop in coop_ammoSnapshot is gated
	//off permanently and the player's ammo is never saved again for the rest of the map. Clear first,
	//then re-raise for the duration of the restore itself.
	if( getcvar( "coop_exactAmmo" ) == "0" ){ self.flags["coop_ammoRestorePending"] = NIL; end }
	if( self.flags["coop_ammoSaved_valid"] != 1 ){ self.flags["coop_ammoRestorePending"] = NIL; end }
	self.flags["coop_ammoRestorePending"] = 1	//[user 07-19] bug-913: block snapshot ticks until the restore lands

	//let the async loadout-give finish setting default ammo first
	wait 0.5
	if( !self ){ end }
	if( self.health <= 0 ){ self.flags["coop_ammoRestorePending"] = NIL; end }

	local.types[1] = "pistol"
	local.types[2] = "rifle"
	local.types[3] = "smg"
	local.types[4] = "mg"
	local.types[5] = "heavy"
	local.types[6] = "grenade"
	local.types[7] = "shotgun"
	local.types[8] = "agrenade"
	local.types[9] = "landmine"

	local.i = 1
	while( local.i <= 9 ){
		local.type = local.types[local.i]
		local.key = "coop_ammoSaved_" + local.type
		if( self.flags[local.key] != NIL ){
			local.amount = self.flags[local.key]
			self setammo local.type local.amount
		}
		local.i++
	}
	self.flags["coop_ammoRestorePending"] = NIL	//[user 07-19] bug-913: restore applied - snapshotting may resume
}end


//=========================================================================
// PHASE C - THE BUST (local, recoverable). NOT going loud.
//=========================================================================
// User spec 2026-08-10: "if a guard does catch me (likely an officer), I should be given my loadout
// PLUS SILENCED PISTOL, which should be the first weapon that comes out (not the weapon start kit),
// not lose my papers/uniform, be able to kill him quickly, and if no one saw his death, it will say
// Situation Contained ... and then auto go back to just having the uniforms and paper."
// Loud instead if: someone LITERALLY SEES THE BODY, an alarm is raised, or you get spotted. And if
// the guard is not killed he raises it himself, so the situation simply never contains.
//
// SAFETY - read before wiring these in. Both labels are NEW and are currently called by NOTHING, so
// they cannot affect anything already verified working. When they are wired, the call sites MUST be
// gated on `getcvar "coop_stealthStart" == "1"`, which is 0 today, so the whole bust loop stays
// dormant until deliberately switched on - the same gate m2l2a.scr:64/875 already uses.
//
// DELIBERATELY NOT coop_armOnBlown: that is the LOUD path. It clears level.coop_startUnarmed for the
// entire level, arms every player and announces "Cover blown". Here the squad stays unarmed - the
// user was explicit that the other player only changes state IF it escalates and is not contained.
// So this arms ONE player and mutates no level flag permanently.
//
// Papers and uniform are KEPT on purpose. takeAllDisguises is the "gone for good" choke point; call
// it here and the bust becomes unrecoverable, which kills the containment loop outright.
//=========================================================================
coop_bustArm local.player:{
	if( local.player == NULL ){ end }
	if( !isAlive local.player ){ end }
	//[user 2026-08-12, bug-1735] IDEMPOTENCE NEEDS ITS OWN FLAG. This guard used to read
	//coop_busted, which was fine while THIS function was the only thing that set it. bust.scr:919
	//now sets coop_busted before calling us (so aggro is suppressed during the bash, which lands
	//first) - and that turned this line into an unconditional `end`. coop_bustArm has been DEAD
	//since: line ~3617's `give silencedpistol` never ran, so the contain stopped issuing the pistol
	//and only appeared to work while the player still happened to own one from an earlier bust
	//(coop_bustPistolHold `use`s an owned weapon; it cannot give one). The first contain after a
	//disarm therefore came up empty-handed.
	//Third instance today of TRAPS T20-A: coop_busted was answering "a bust is running" AND
	//"already armed", and this site wanted the second. Split them.
	if( local.player.flags["coop_bustArmed"] == 1 ){ end }		//already armed for this bust
	local.player.flags["coop_bustArmed"] = 1
	local.player.flags["coop_busted"] = 1
	//[user 2026-08-19] cut-content: the nearest German shouts HANDS UP at the busted spy
	thread coop_mod/aivoice.scr::aivoice_handsupNear local.player

	//[user 2026-08-12] TAKE THE PAPERS FOR THE DURATION. Three separate papers paths
	//(enableClickablePapers, coop_papersAnytime, main.scr::forcePapersInHand) are each gated on
	//coop_busted, and the symptom SURVIVED all three guards: pistol out, will not fire, then the gun
	//with papers welded into it. Rather than hunt a fourth path, remove what they are competing to
	//equip - an item that is not in the inventory cannot be raised by anything.
	//Safe because the contain already restores them: coop_bustDisarm threads main.scr::itemGetAll,
	//which re-gives papers through the shared path, and a blown cover removes them for good anyway.
	//This is the same reasoning as the blown-cover fix earlier today, applied one step sooner.
	if( level.coop_itemPapers != NIL ){
		local.player take "models/items/papers.tik"
		local.player take "models/items/papers2.tik"
	}
	//[user 2026-08-10] KILL THE PAPERS PROMPT for this player. itemhandler.scr:2580 runs a loop while
	//a guard is challenging: press fire with no active weapon and it equips the papers. So pressing
	//fire to SHOOT the officer put the papers back in your hands instead - user: "I pull out silenced
	//pistol automatically, then switch back to papers". disguise_enemy.scr:37 already clears this on
	//the ATTACK path, but not when the checker runs for the alarm instead, which is the case here.
	local.player.flags["coop_clickablePapersEnabled"] = game.false

	//Lift the papers-only lockout for THIS give only, then put it back exactly as it was.
	//giveWeaponLoadout early-exits on level.coop_noWeapon, and that flag is what keeps the REST of the
	//squad unarmed - leaving it cleared would silently arm everyone, which is the opposite of the spec.
	local.savedNoWeapon    = level.coop_noWeapon
	local.savedForcePapers = level.coop_forcePapersEquip
	level.coop_noWeapon         = game.false
	level.coop_forcePapersEquip = game.false

	group.player = local.player
	//[user 2026-08-12] SKIP THE GIVE WHEN HE IS ALREADY ARMED. Measured with the engine fire probe:
	//276 frames with the silenced pistol in hand, clip=8, fire held, no fire lock - and no shot. Also
	//36 frames where the M1 GARAND was in hand and equally dead. So it was never papers and never the
	//pistol: the HANDS KEEP CHANGING, and a weapon swapped every few frames never finishes its raise,
	//so nothing is ever ready to fire.
	//Cause: this give exists because the strip model (m2l2a, m6l1c) leaves the player with NOTHING, so
	//a contain has to arm him. m6l2a's holster model leaves his whole loadout in place, so re-giving
	//it kicks off weapon selection that fights spawnWeaponAssert below for the same hands.
	if( level.coop_stealthHolsterMode != 1 ){
		waitthread giveWeaponLoadout game.true
	}

	//the silenced pistol is ADDITIVE - on top of the loadout, not instead of it
	local.player give "models/weapons/silencedpistol.tik"
	//[user 2026-08-10, run 3] "got my handgun, couldn't shoot it". A bare `give` hands over the
	//WEAPON; the rounds come from the map's ammo table, and a stealth map has no reason to stock
	//pistol ammo - loadoutpick.scr::loadout_ammoTopup exists for exactly this class of defect
	//("some maps zero whole classes and would hand out a dry picked gun"). silencedpistol.tik is
	//ammotype "pistol", clipsize 8, startammo 8 (read from the retail tik), so grant the pistol
	//pool explicitly. 40 matches what the armory hands a COLT M1911 (loadoutroster.scr case "48").
	//Without this the bust arms you with a gun you cannot fire, which is worse than not arming you.
	local.player ammo "pistol" 40

	//Restoring coop_forcePapersEquip below is REQUIRED (the rest of the squad must stay papers-only)
	//but on its own it re-armed the enforcement that rips the pistol back out. main.scr::
	//forcePapersInHand and the spawn-time force both now early-exit on flags["coop_busted"], which is
	//set above and cleared by coop_bustDisarm - so the exemption lasts exactly as long as the bust.
	level.coop_noWeapon         = local.savedNoWeapon
	level.coop_forcePapersEquip = local.savedForcePapers

	//...and it must be the weapon IN HAND. spawnWeaponAssert is the proven recipe: it re-asserts over
	//5 frames, which is what beats both the loadout switch picking a primary and the papers still
	//being the active in-hand item at this moment.
	waitthread spawnWeaponAssert local.player "models/weapons/silencedpistol.tik"

	println( "^~^~^ BUST armed e" + local.player.entnum + " pistol-first, disguise KEPT" )
}end


//=========================================================================
// CONTAINMENT: nobody saw the body. Take the guns back, return to uniform+papers.
// User: the pistol "does get taken back".
//=========================================================================
coop_bustDisarm local.player:{
	if( local.player == NULL ){ end }
	if( local.player.flags["coop_busted"] != 1 ){ end }
	local.player.flags["coop_busted"] = NIL
	//[bug-1735] release the arming latch too, or the NEXT contain finds coop_bustArmed still set and
	//early-exits exactly the way coop_busted used to make it.
	local.player.flags["coop_bustArmed"] = NIL
	if( !isAlive local.player ){ end }

	local.player takeall
	//Re-give the papers through the SAME path every other route uses (keyitems.scr:88,
	//loadoutpick.scr:223, player.scr:1013) so the two states cannot drift apart. It is an ENTITY
	//thread - self IS the player - which is also why it is not called with a parameter.
	//NOTE an earlier draft of this called a coop_giveKeyItemsBack that DOES NOT EXIST; in Morpheus
	//that silently does nothing, so containment would have left the player armed with no error.
	local.player thread coop_mod/main.scr::itemGetAll

	println( "^~^~^ BUST contained e" + local.player.entnum + " disarmed, papers restored" )
}end
