		case "models/weapons/carcanosniper.tik":
		case "models/weapons/arisakasniper.tik":
		case "models/weapons/nagant_sniper.tik":
		case "models/weapons/nagant_snipersilenced.tik":
		case "models/weapons/kar98snipersilenced.tik":
		case "models/weapons/delisle.tik":
		case "models/weapons/thompson50.tik":
		case "models/weapons/mp40silenced.tik":
		case "models/weapons/ppsh43silenced.tik":
		case "models/weapons/greasegun.tik":
