//=========================================================================
// TEST-ONLY overlay driver (alarm vehicle 2026-10-18) - NEVER shipped. Installed as coop_mod/coop_selftest_xp.scr.
// Commands arrive in cvar ai_cmd (ai_realism harness protocol: prints "^~^~^ AI did <cmd>"); arguments in ai_x ai_y ai_z ai_yaw ai_pit.
//=========================================================================
st_xp_run:{
	println "^~^~^ AI armed"
	setcvar "ai_cmd" "0"
	thread av_trace
	while( 1 ){
		local.c = getcvar( "ai_cmd" )
		if( local.c != "0" && local.c != "" ){
			setcvar "ai_cmd" "0"
			waitthread av_do local.c
			println ( "^~^~^ AI did " + local.c )
		}
		waitframe
	}
}end

av_s local.v:{
	local.r = "-"
	if( local.v != NIL ){ local.r = "" + local.v }
}end local.r

av_gnd local.p:{
	local.t = trace ( local.p + ( 0 0 200 ) ) ( local.p + ( 0 0 -600 ) )
}end local.t

// camera pin (ap_drv.scr recipe): the player is held at a position and view angle
av_pin local.pos local.va:{
	level.avt_pos = local.pos
	level.avt_va = local.va
	if( level.avt_pinOn == 1 ){ end }
	level.avt_pinOn = 1
	thread av_pinloop
}end

av_pinloop:{
	while( level.avt_pinOn == 1 ){
		local.p = $player[1]
		if( local.p != NULL && local.p != NIL ){
			if( level.avt_follow == 1 && level.av_ent != NULL && level.av_ent != NIL ){
				// chase camera: behind and to the left of the vehicle, looking at it
				local.fw = angles_toforward level.av_ent.angles
				local.lf = angles_toleft level.av_ent.angles
				level.avt_pos = level.av_ent.origin - ( local.fw * level.avt_back ) + ( local.lf * level.avt_side ) + ( 0 0 level.avt_up )
				level.avt_va = vector_toangles ( ( level.av_ent.origin + ( 0 0 50 ) ) - level.avt_pos )
			}
			local.p origin level.avt_pos
			local.p.viewangles = level.avt_va
			if( local.p.health > 0 ){
				if( local.p.health < 750 ){
					if( level.avt_lost == NIL ){ level.avt_lost = 0 }
					level.avt_lost = level.avt_lost + ( 750 - local.p.health )
				}
				local.p.health = 750
			}
		}
		waitframe
	}
}end

// one line per second about the live vehicle (only while level.avt_trace == 1)
av_trace:{
	while( 1 ){
		wait 1
		if( level.avt_trace == 1 ){
			local.v = level.av_ent
			if( local.v == NULL || local.v == NIL ){
				println ( "^~^~^ AVT t=" + level.time + " live=" + ( waitthread av_s level.av_live ) + " ent=none lost=" + ( waitthread av_s level.avt_lost ) )
			} else {
				println ( "^~^~^ AVT t=" + level.time + " live=" + ( waitthread av_s level.av_live ) + " org=" + local.v.origin + " lost=" + ( waitthread av_s level.avt_lost ) + " ang=" + local.v.angles + " hp=" + local.v.health + " arr=" + ( waitthread av_s local.v.av_arrT ) + " leaving=" + ( waitthread av_s local.v.av_leaving ) )
			}
		}
	}
}end

av_do local.c:{
	local.p = $player[1]
	if( local.p == NULL ){ end }
	local.x = getcvar( "ai_x" )
	if( local.c == "here" ){ println ( "^~^~^ AI here " + local.p.origin ) }

	// camera: ai_x ai_y ai_z = position, ai_yaw / ai_pit = view; "look" variant aims at the vehicle stop (ai_lx ai_ly ai_lz)
	if( local.c == "pin" ){
		local.pos = ( 0 0 0 )
		local.pos[0] = float( getcvar( "ai_x" ) )
		local.pos[1] = float( getcvar( "ai_y" ) )
		local.pos[2] = float( getcvar( "ai_z" ) )
		local.tgt = ( 0 0 0 )
		local.tgt[0] = float( getcvar( "ai_lx" ) )
		local.tgt[1] = float( getcvar( "ai_ly" ) )
		local.tgt[2] = float( getcvar( "ai_lz" ) )
		local.va = vector_toangles ( local.tgt - local.pos )
		waitthread av_pin local.pos local.va
		println ( "^~^~^ AVT pinned at " + local.pos + " looking " + local.va )
	}
	if( local.c == "nofollow" ){ level.avt_follow = 0 }
	if( local.c == "follow" ){
		level.avt_back = float( getcvar( "ai_x" ) )
		level.avt_side = float( getcvar( "ai_y" ) )
		level.avt_up = float( getcvar( "ai_z" ) )
		level.avt_follow = 1
		println "^~^~^ AVT follow cam on"
	}
	if( local.c == "fillseed" ){ waitthread av_fillseed }
	// ring of seeds round a point (ai_x ai_y ai_z): radii 500 1000 1600, every 45 degrees (blocked ones are dropped by the fill)
	if( local.c == "ringseed" ){
		local.cx = float( getcvar( "ai_x" ) )
		local.cy = float( getcvar( "ai_y" ) )
		local.cz = float( getcvar( "ai_z" ) )
		for( local.r = 500; local.r <= 1600; local.r = local.r + 550 ){
			for( local.a = 0; local.a < 360; local.a = local.a + 45 ){
				local.dv = angles_toforward ( 0 local.a 0 )
				if( level.avf_ns == NIL ){ level.avf_ns = 0 }
				level.avf_ns++
				level.avf_sx[level.avf_ns] = local.cx + ( local.dv[0] * local.r )
				level.avf_sy[level.avf_ns] = local.cy + ( local.dv[1] * local.r )
				level.avf_sz[level.avf_ns] = local.cz
			}
		}
		println ( "^~^~^ SCF ring seeds total " + level.avf_ns )
	}
	if( local.c == "fill" ){ thread av_fill }
	if( local.c == "playerseed" ){
		setcvar "ai_x" ( "" + local.p.origin[0] )
		setcvar "ai_y" ( "" + local.p.origin[1] )
		setcvar "ai_z" ( "" + local.p.origin[2] )
		waitthread av_fillseed
	}
	if( local.c == "trace" ){ level.avt_trace = 1 }
	if( local.c == "notrace" ){ level.avt_trace = 0 }

	// fake a live alarm, then run the vehicle hook exactly as alarm.scr::alm_start does
	if( local.c == "arm" ){
		if( level.coop_alarmPulls == NIL ){ level.coop_alarmPulls = 0 }
		level.coop_alarmLive = 1
		level.coop_alarmPulls++
		level.coop_alarmStartT = level.time
		println ( "^~^~^ AVT armed pull=" + level.coop_alarmPulls + " map=" + level.coop_mapname )
		thread coop_mod/alarmveh.scr::av_pull
	}
	if( local.c == "alarmoff" ){
		level.coop_alarmLive = 0
		println "^~^~^ AVT alarm off"
	}
	// a rocket hit on the live vehicle (means of death 16 = MOD_ROCKET)
	if( local.c == "rocket" ){
		local.v = level.av_ent
		if( local.v == NULL || local.v == NIL ){
			println "^~^~^ AVT rocket: no vehicle"
			end
		}
		println ( "^~^~^ AVT rocket on hp=" + local.v.health )
		local.v damage local.p 400 local.p local.v.origin ( 0 0 0 ) ( 0 0 0 ) 0 0 16 0
		wait 0.5
		println ( "^~^~^ AVT rocket after hp=" + ( waitthread av_s local.v.health ) )
	}
	if( local.c == "grenade" ){
		local.v = level.av_ent
		if( local.v == NULL || local.v == NIL ){
			println "^~^~^ AVT grenade: no vehicle"
			end
		}
		println ( "^~^~^ AVT grenade on hp=" + local.v.health )
		local.v damage local.p 200 local.p local.v.origin ( 0 0 0 ) ( 0 0 0 ) 0 0 14 0
		wait 0.3
		println ( "^~^~^ AVT grenade after hp=" + ( waitthread av_s local.v.health ) )
	}
	if( local.c == "bullet" ){
		local.v = level.av_ent
		if( local.v == NULL || local.v == NIL ){
			println "^~^~^ AVT bullet: no vehicle"
			end
		}
		println ( "^~^~^ AVT bullet on hp=" + local.v.health )
		local.v damage local.p 100 local.p local.v.origin ( 0 0 0 ) ( 0 0 0 ) 0 0 18 0
		wait 0.3
		println ( "^~^~^ AVT bullet after hp=" + ( waitthread av_s local.v.health ) )
	}
	if( local.c == "hp" ){
		if( level.av_ent != NULL && level.av_ent != NIL ){
			level.av_ent.health = float( getcvar( "ai_x" ) )
			println ( "^~^~^ AVT hp set to " + level.av_ent.health )
		}
	}
	// cover round the stop: 8 rays at chest height, radius 320; blocked ones are walls/crates the squad can use
	if( local.c == "covercheck" ){
		local.sp = level.av_p[( 1 * 100 ) + level.av_n[1]]
		local.blocked = 0
		for( local.a = 0; local.a < 360; local.a = local.a + 45 ){
			local.dv = angles_toforward ( 0 local.a 0 )
			local.tr = traced ( local.sp + ( 0 0 50 ) ) ( local.sp + ( 0 0 50 ) + ( local.dv * 320 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 1
			if( local.tr["fraction"] < 1.0 ){ local.blocked++ }
		}
		println ( "^~^~^ AVT cover rays blocked=" + local.blocked + " of 8 at stop " + local.sp )
	}
	// stand at the crate spot looking at the vehicle stop (eye height 60), for the screenshot proof
	if( local.c == "cratecam" ){
		local.cp = level.av_crateAt[1]
		local.sp = level.av_p[( 1 * 100 ) + level.av_n[1]]
		if( local.cp == NIL ){
			println "^~^~^ AVT cratecam: no crate"
		} else {
			local.va = vector_toangles ( ( local.sp + ( 0 0 60 ) ) - ( local.cp + ( 0 0 60 ) ) )
			waitthread av_pin local.cp local.va
			println ( "^~^~^ AVT cratecam at " + local.cp + " looking at stop " + local.sp + " dist=" + int( vector_length ( local.sp - local.cp ) ) )
		}
	}
	// ---- m3l3 full-sequence harness (church hold -> paradrop -> Nebelwerfer fight) ----
	if( local.c == "m3church" ){
		level.coop_chDur = 45
		level.halftrack_alive = 0
		local.p origin ( 1551 -2370 -255 )
		println "^~^~^ AVT m3church: phase start requested, hold 45 s"
		setcvar "coop_chStart" "1"
	}
	if( local.c == "m3status" ){
		println ( "^~^~^ AVT m3 chDone=" + ( waitthread av_s level.coop_chDone ) + " chOver=" + ( waitthread av_s level.coop_chOver ) + " dropped=" + ( waitthread av_s level.coop_paradrop_dropped ) + " scene7=" + ( waitthread av_s level.coop_scene7Started ) + " bombcount=" + ( waitthread av_s level.scene7_bombcount ) + " t=" + level.time )
	}
	if( local.c == "m3plant" ){
		local.bn = int( getcvar( "ai_x" ) )
		thread maps/m3l3.scr::scene7_bombplant local.bn
		println ( "^~^~^ AVT m3plant " + local.bn )
	}
	if( local.c == "m3nebel" ){
		thread coop_mod/m3l3_nebel.scr::nb_hold_done
		thread maps/m3l3.scr::scene7
		println "^~^~^ AVT m3nebel: hook + scene7 started"
	}
	if( local.c == "m3to" ){
		// stand the player at x y z (ai_x ai_y ai_z) facing yaw ai_lx
		local.tv = ( 0 0 0 )
		local.tv[0] = float( getcvar( "ai_x" ) )
		local.tv[1] = float( getcvar( "ai_y" ) )
		local.tv[2] = float( getcvar( "ai_z" ) )
		local.p origin local.tv
	}
	if( local.c == "offdrop" ){
		println ( "^~^~^ AVT officer smoke_drop flag=" + ( waitthread av_s level.coop_officer_smoke_drop ) + " binoc_feature=" + ( waitthread av_s level.coop_feature_binoc ) )
		for( local.q = 0; local.q < 6; local.q++ ){
			thread coop_mod/officer.scr::coop_officer_death_drops ( 1551 -2370 -255 )
			wait 1
		}
	}
	// overlook score of a candidate stop (ai_x ai_y ai_z): how many of 9 points on the church -> Nebelwerfer 1 line it sees from gunner height
	if( local.c == "ovlc" ){
		local.sv = ( 0 0 0 )
		local.sv[0] = float( getcvar( "ai_x" ) )
		local.sv[1] = float( getcvar( "ai_y" ) )
		local.sv[2] = float( getcvar( "ai_z" ) )
		local.a = ( 1551 -2370 -255 )
		local.b = ( -1834 -5160 -173 )
		local.n = 0
		for( local.i = 2; local.i <= 10; local.i++ ){
			local.pt = local.a + ( ( local.b - local.a ) * ( local.i / 10 ) )
			local.t = traced ( local.sv + ( 0 0 90 ) ) ( local.pt + ( 0 0 56 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 1
			if( local.t["fraction"] >= 1.0 ){ local.n++ }
		}
		println ( "^~^~^ OVL " + local.sv[0] + " " + local.sv[1] + " " + local.sv[2] + " " + local.n )
	}
	// find the paratroopers' .30 cal (any entity whose model has 30cal, nearest the church) and put the camera behind it
	if( local.c == "find30" ){
		local.best = NIL
		local.bd = 999999
		for( local.e = 1; local.e < 1600; local.e++ ){
			local.o = getentbyentnum local.e
			if( local.o == NULL || local.o == NIL ){ continue }
			if( local.o.model == NIL ){ continue }
			if( ( waitthread coop_mod/main.scr::containsText local.o.model "30cal" 0 ) != 1 ){ continue }
			local.d = vector_length ( local.o.origin - ( 1551 -2370 -255 ) )
			println ( "^~^~^ AVT 30cal ent" + local.e + " class=" + local.o.classname + " org=" + local.o.origin + " ang=" + local.o.angles + " dist_church=" + int( local.d ) )
			if( local.d < local.bd ){
				local.bd = local.d
				local.best = local.o
			}
		}
		if( local.best != NIL ){
			local.fw = angles_toforward local.best.angles
			local.cp = local.best.origin - ( local.fw * 260 ) + ( 0 0 70 )
			local.va = vector_toangles ( ( local.best.origin + ( 0 0 20 ) ) - local.cp )
			waitthread av_pin local.cp local.va
			println ( "^~^~^ AVT 30cal camera behind the gun at " + local.cp + " gun faces yaw " + local.best.angles[1] )
		}
	}
	if( local.c == "pcount" ){ println ( "^~^~^ AVT players=" + ( waitthread coop_mod/coop_counter.scr::counter_players ) ) }
	// alarm-man counters (crew are tagged coop_waveSrc alarm)
	if( local.c == "men" ){ println ( "^~^~^ AVT alarm men alive=" + ( waitthread coop_mod/coop_counter.scr::counter_alive "alarm" ) ) }
	// the crate (atsupply) state
	if( local.c == "crate" ){ println ( "^~^~^ AVT atSupplyN=" + ( waitthread av_s level.coop_atSupplyN ) + " crateOk1=" + ( waitthread av_s level.av_crateOk[1] ) ) }
}end

//=========================================================================
// ROUTE SCOUT (alarm vehicle routes, 2026-10-19): flood-fill the area a truck hull can drive. Seeds are added with `fillseed`
// (ai_x ai_y ai_z), `fill` runs it: 128 u grid, 4-neighbours, each step needs a ground (|dz| <= 48) and a clear sweep of the Opel
// hull box. Prints ^~^~^ SCF <ix> <iy> <z> <surfaceFlags> per free cell and ^~^~^ SCF done <n>.
//=========================================================================
av_fillseed:{
	if( level.avf_ns == NIL ){ level.avf_ns = 0 }
	level.avf_ns++
	level.avf_sx[level.avf_ns] = float( getcvar( "ai_x" ) )
	level.avf_sy[level.avf_ns] = float( getcvar( "ai_y" ) )
	level.avf_sz[level.avf_ns] = float( getcvar( "ai_z" ) )
	println ( "^~^~^ SCF seed " + level.avf_ns )
}end

av_cellkey local.x local.y:{
	local.ix = int( ( local.x + 64 ) / 128 )
	if( local.x < 0 ){ local.ix = int( ( local.x - 64 ) / 128 ) }
	local.iy = int( ( local.y + 64 ) / 128 )
	if( local.y < 0 ){ local.iy = int( ( local.y - 64 ) / 128 ) }
	local.k = ( ( local.ix + 500 ) * 1000 ) + ( local.iy + 500 )
}end local.k

// cells keep their EXACT positions (a seed's own x/y, then +-128 steps from it); the lattice index is only the visited key
av_fill:{
	local.step = 128
	local.maxc = int( getcvar( "ai_lx" ) )
	if( local.maxc < 100 ){ local.maxc = 7000 }
	level.avf_h = 1
	level.avf_r1 = 0
	level.avf_r2 = 0
	level.avf_r3 = 0
	level.avf_t = 0
	level.avf_cnt = 0
	for( local.s = 1; local.s <= level.avf_ns; local.s++ ){
		local.sx = level.avf_sx[local.s]
		local.sy = level.avf_sy[local.s]
		local.sz = level.avf_sz[local.s]
		local.gt = traced ( local.sx local.sy ( local.sz + 200 ) ) ( local.sx local.sy ( local.sz - 300 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 1
		if( local.gt["startSolid"] == 1 || local.gt["fraction"] >= 1.0 ){
			println ( "^~^~^ SCF seed blocked noground " + local.s )
			continue
		}
		local.sz = local.gt["endpos"][2]
		local.found = 0
		for( local.n = 0; local.n < 9 && local.found == 0; local.n++ ){
			local.ox = 0
			local.oy = 0
			if( local.n == 1 ){ local.ox = 48 }
			if( local.n == 2 ){ local.ox = -48 }
			if( local.n == 3 ){ local.oy = 48 }
			if( local.n == 4 ){ local.oy = -48 }
			if( local.n == 5 ){
				local.ox = 96
				local.oy = 96
			}
			if( local.n == 6 ){
				local.ox = -96
				local.oy = 96
			}
			if( local.n == 7 ){
				local.ox = 96
				local.oy = -96
			}
			if( local.n == 8 ){
				local.ox = -96
				local.oy = -96
			}
			local.tx = local.sx + local.ox
			local.ty = local.sy + local.oy
			local.hb = traced ( local.tx local.ty ( local.sz + 26 ) ) ( local.tx local.ty ( local.sz + 27 ) ) 1023 ( -64 -52 0 ) ( 64 52 64 ) 466945
			if( local.hb["startSolid"] != 1 && local.hb["allSolid"] != 1 ){ local.found = 1 }
		}
		if( local.found == 0 ){
			println ( "^~^~^ SCF seed blocked hull " + local.s + " at " + local.sx + " " + local.sy + " " + local.sz )
			continue
		}
		local.k = waitthread av_cellkey local.tx local.ty
		if( level.avf_vis[local.k] == 1 ){ continue }
		level.avf_vis[local.k] = 1
		level.avf_t++
		level.avf_qx[level.avf_t] = local.tx
		level.avf_qy[level.avf_t] = local.ty
		level.avf_qz[level.avf_t] = local.sz
		level.avf_cnt++
		println ( "^~^~^ SCF " + local.tx + " " + local.ty + " " + local.sz + " 0 " + local.tx + " " + local.ty )
	}
	local.per = 0
	while( level.avf_h <= level.avf_t && level.avf_cnt < local.maxc ){
		local.cx = level.avf_qx[level.avf_h]
		local.cy = level.avf_qy[level.avf_h]
		local.cz = level.avf_qz[level.avf_h]
		level.avf_h++
		for( local.d = 0; local.d < 4; local.d++ ){
			local.wx = local.cx
			local.wy = local.cy
			if( local.d == 0 ){ local.wx = local.cx + local.step }
			if( local.d == 1 ){ local.wx = local.cx - local.step }
			if( local.d == 2 ){ local.wy = local.cy + local.step }
			if( local.d == 3 ){ local.wy = local.cy - local.step }
			local.k = waitthread av_cellkey local.wx local.wy
			if( level.avf_vis[local.k] == 1 ){ continue }
			level.avf_vis[local.k] = 1
			local.g = traced ( local.wx local.wy ( local.cz + 100 ) ) ( local.wx local.wy ( local.cz - 100 ) ) 1023 ( 0 0 0 ) ( 0 0 0 ) 1
			if( local.g["startSolid"] == 1 || local.g["fraction"] >= 1.0 ){ level.avf_r1++; continue }
			local.gz = local.g["endpos"][2]
			local.dz = local.gz - local.cz
			if( local.dz < 0 ){ local.dz = 0 - local.dz }
			if( local.dz > 48 ){ level.avf_r2++; continue }
			local.h = traced ( local.cx local.cy ( local.cz + 26 ) ) ( local.wx local.wy ( local.gz + 26 ) ) 1023 ( -64 -52 0 ) ( 64 52 64 ) 466945
			if( local.h["startSolid"] == 1 || local.h["allSolid"] == 1 || local.h["fraction"] < 1.0 ){ level.avf_r3++; continue }
			level.avf_t++
			level.avf_qx[level.avf_t] = local.wx
			level.avf_qy[level.avf_t] = local.wy
			level.avf_qz[level.avf_t] = local.gz
			level.avf_cnt++
			println ( "^~^~^ SCF " + local.wx + " " + local.wy + " " + local.gz + " " + local.g["surfaceFlags"] + " " + local.cx + " " + local.cy )
		}
		local.per++
		if( local.per >= 12 ){
			local.per = 0
			waitframe
		}
	}
	println ( "^~^~^ SCF rejects noground=" + level.avf_r1 + " dz=" + level.avf_r2 + " hull=" + level.avf_r3 )
	println ( "^~^~^ SCF done " + level.avf_cnt )
}end
