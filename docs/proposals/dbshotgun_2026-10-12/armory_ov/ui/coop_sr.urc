{
ordernumber 50
name "bg0"
rect 80 8 480 462
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
enabledcvar "coop_srP0"
shader "textures/mohmenu/coop_sr_p0.tga"
}

