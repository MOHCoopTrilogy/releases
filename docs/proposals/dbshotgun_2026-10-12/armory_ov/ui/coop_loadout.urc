// HZM coop - ARMORY v3 loadout screen (GENERATED by scratchpad/gen_loadout3.py).
// v2 interaction model kept: slot card click = activate slot (s<n>sel.cfg); weapon click =
// inspect + equip into the active slot (t<id>.cfg -> p<id>.cfg + vstr coop_loCcur).
// v3: layout-contract grid, per-class preview widgets (coop_loPvC0..5), tab-aware padlocks
// (coop_loLkV<id>), dedicated REQ row, MAG strip re-grid, tab/open bus tokens ,w0t / ,w0o.
// v3.2: padlocks + helmet/skin previews driven CLIENT-side (ui/loadout/lktab*, helm/*, skin/*)
// so they work from the cold main menu with no server; buttons run vstr chain + name-bus token.
menu "coop_loadout" 640 480 NONE 1
borderstyle NONE
bgcolor 0 0 0 0
align centerx centery
virtualres 1
fullscreen 0

direction from_top 0

resource
Label
{
ordernumber 50
name "bg"
rect 0 0 640 480
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
shader "textures/mohmenu/coop_lo_bg2.tga"
}

resource
Button
{
name "closeBtn"
title "DONE"
rect 560 8 72 16
fgcolor 0.85 0.83 0.78 1.00
bgcolor 0.08 0.09 0.11 0.94
borderstyle "3D_BORDER"
font "verdana-12"
clicksound "sound/menu/back.wav"
stuffcommand "popmenu 0 ; append name ,w0x ; exec ui/loadout/fitunbind.cfg"
}

resource
Label
{
ordernumber 20
name "charRender"
rect 12 82 134 312
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
linkcvar "coop_loChar"
modelxformcvar "coop_loXfmC"
rendermodel 1
modelattachcvar "coop_loHelm"
modelattachtag "Bip01 Head"
modelattachcvar2 "coop_loPrev"
modelattachtag2 "tag_weapon_right"
modelspincvar "coop_loCharSpin"
modelanimcvar "coop_loCharAnim"
modeloffset "78 0 -18"
modelrotateoffset "0 0 0"
modelangles "0 200 0"
modelscale 1.0
modelanim coop_loadout_idle
}

resource
Label
{
name "skinCapLbl"
title "SKIN"
rect 14 396 56 12
fgcolor 0.55 0.54 0.50 1.00
bgcolor 0.00 0.00 0.00 0.00
font "verdana-12"
}

resource
