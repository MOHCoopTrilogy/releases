// [user 08-07] the unlock caption (cosLk/cosReq1-3 below) used to sit at y332-381, INSIDE the
// character model viewer's rect (12 46 134 348) - fine while the model stood still, but the user
// found the giveaway: rotating the model with the mouse draws it straight over the text. A
// rendermodel widget is composited after plain 2D widgets regardless of ordernumber, so no
// backing panel or z-order value can win (two attempts at that failed - the discarded cosReqBg
// panel, first at a tied ordernumber 20, then at an explicit 15). The only real fix is to leave
// the model's box: the caption now lives at y444+, below the helmet prev/next buttons (which end
// at y441) in the otherwise-empty bottom-left corner, where the model can never reach it.
resource
Label
{
ordernumber 8
name "cosLk"
rect 14 46 12 12
fgcolor 1.00 1.00 1.00 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
enabledcvar "coop_loCosLk"
shader "textures/mohmenu/coop_lo_lock.tga"
}

resource
Label
{
ordernumber 10
name "cosReq1"
rect 30 46 114 11
fgcolor 0.91 0.80 0.53 1.00
bgcolor 0.00 0.00 0.00 0.00
borderstyle "NONE"
font "verdana-12"
dontlocalize
textalign left
enabledcvar "coop_loCosLk"
linkcvar "coop_loCosReq"
}

