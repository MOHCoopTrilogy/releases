//[user, earlier ask, found by the audit sweep 2026-09-02] challenge targets capped at 750.
//The generator was capped when the user asked; four HAND-WRITTEN chal_def lines were missed and
//still shipped at 1000/2500/5000. q_500/q_1000/q_2500 are an escalating LADDER, so they are
//re-spaced 250/500/750 rather than all flattened to the cap - three identical rungs would have
//been a worse answer than the one the user complained about.
//still shipped above it, one sitting on the literal 1000 the user objected to. Descriptions are
//rewritten with the number too, since they name it in the text the player reads.
// [303] HZM CHALLENGES / ACHIEVEMENTS SYSTEM - Phase 1 (tracking + persistence + unlocks + HUD toast + review)
// Mirrors coop_mod/xp.scr (identity, persistence, HUD-emblem patterns). Every progress bump funnels
// through chal_bump -> chal_apply (single entry point). Adding a challenge = ONE chal_def line in chal_init.
//
// Identity:    reuses the XP identity (self.flags["coop_xp_id"] from xp.scr::xp_identify; guid, or
//              "n_"+netname fallback). If XP is disabled we derive the same id locally so challenges
//              still work standalone. Keyed as self.flags["coop_chal_id"].
// Persistence: write-through server cvar coop_chal_<id> (survives map transitions) +
//              fs_write_content file coop_mod/save/chal_<id>.dat (survives server restarts).
//              Serialized as "cid:progress|cid:progress|..." (zeros omitted). Unlocks are stored
//              SEPARATELY (companion) so a future loadout picker can read "which rewards did this
//              player unlock": cvar coop_unlocks_<id> + file coop_mod/save/unlocks_<id>.dat,
//              a "|"-delimited list of reward ids (weapon tik paths or symbolic perk/cosmetic ids).
// Per-player:  self.flags["coop_chal_id" / "coop_chal_loaded" / "coop_chal_unlocks"] +
//              self.flags["coop_chalP_<cid>"] (progress) + self.flags["coop_chalD_<cid>"] (done).
// HUD slots:   76 header, 77 title, 78 subtitle (completion toast; clear of XP 62-75, build 54-59).
// Review:      name-append bind index 34 (",chx") -> chal_review; prints the full list to the
//              player's console (grouped by category, [progress/target], done/locked).
// Cvar gate:   coop_challenges (default 1). coop_xp_enabled conventions respected where sensible.

//=========================================================================
// Init - threaded from main.scr::main right after xp_init. Builds the DATA table
// (no wait/waitframe -> completes in the init frame) and starts the autosave loop.
//=========================================================================
chal_init:{
	if( level.coop_chal_init == 1 ){ end }
	level.coop_chal_init = 1

	//[user 2026-08-14] SHARED "was the alarm EVER raised on this map" latch. Five of the unwired
	//feats are some form of "do X without the alarm going off", and checking level.alarm at the
	//END would pass a run where the alarm was raised and later cleared - which is the normal
	//behaviour of alarm_system.scr and e1l4alarm.scr, both of which reset it. Latching means once
	//it goes off, it stays off for scoring purposes, which is what the challenge text promises.
	//A 2s poll rather than hooking the ~6 places that raise it: those live in vanilla global
	//scripts that per-map copies override, so a hook would silently not apply on some maps.
	level.coop_chalAlarmEver = 0
	thread chal_alarm_watch

	level.coop_chal_enabled = 1
	if( getcvar "coop_challenges" == "" ){ setcvar "coop_challenges" "1" }
	if( getcvar "coop_challenges" == "0" ){ level.coop_chal_enabled = 0 }

	level.coop_chal_count = 0

	// [user 07-11] weapon-CLASS lookup for the pistol-only / bolt-only feats (keys = the wids chal_weaponId
	// returns, line ~670-713). Pistols include the bolt-action sidearm (welrod); bolt rifles are the
	// manual-cycle rifles only (NOT the semi-autos garand/g43/svt).
	level.coop_chal_isPistol["colt"]      = 1
	level.coop_chal_isPistol["webley"]    = 1
	level.coop_chal_isPistol["welrod"]    = 1
	level.coop_chal_isPistol["luger"]     = 1
	level.coop_chal_isPistol["nambu"]     = 1
	level.coop_chal_isPistol["p38"]       = 1
	level.coop_chal_isPistol["ppk"]       = 1
	level.coop_chal_isPistol["tt33"]      = 1
	level.coop_chal_isPistol["beretta"]   = 1
	level.coop_chal_isBolt["kar98"]       = 1
	level.coop_chal_isBolt["mosin"]       = 1
	level.coop_chal_isBolt["enfield"]     = 1
	level.coop_chal_isBolt["carcano"]     = 1
	level.coop_chal_isBolt["arisaka"]     = 1
	level.coop_chal_isBolt["springfield"] = 1

	// ============================ WEAPON MASTERY ============================
	// stat "wpn_<id>" is bumped by chal_ai_killed from the killer's active weapon.
	// One family per real weapon (variants/scoped/KUN fold in); base + elite tier
	// share the stat. Category = weapon class so the menu pages by class.
	// ---- RIFLES ----
	waitthread chal_def "wpn_garand" "rifles" "Greatest Battle Implement" "Get 50 kills with the M1 Garand" "wpn_garand" 50 ""
	waitthread chal_def "wpn_garand_e" "rifles" "The Tell-Tale Ping" "Get 150 kills with the M1 Garand (Elite)" "wpn_garand" 150 "models/player/american_28th_private.tik"	//[user 2026-08-23, bug-2079] was american_army.tik, the FREE default uniform, so this paid nothing: the rifleman's rifle -> a plain rifleman (was rank 9 only)
	waitthread chal_def "wpn_kar98" "rifles" "Their Own Mauser" "Get 50 kills with the Kar98k" "wpn_kar98" 50 ""
	waitthread chal_def "wpn_kar98_e" "rifles" "Mauser Meister" "Get 150 kills with the Kar98k (Elite)" "wpn_kar98" 150 "models/player/american_army_sergeant.tik"
	waitthread chal_def "wpn_g43" "rifles" "Hitler's Semi-Auto" "Get 40 kills with the Gewehr 43" "wpn_g43" 40 ""
	waitthread chal_def "wpn_g43_e" "rifles" "Gewehr Grognard" "Get 120 kills with the Gewehr 43 (Elite)" "wpn_g43" 120 "models/player/american_major.tik"
	waitthread chal_def "wpn_enfield" "rifles" "The Mad Minute" "Get 40 kills with the Lee-Enfield" "wpn_enfield" 40 ""
	waitthread chal_def "wpn_enfield_e" "rifles" "Bolt-Action Ballet" "Get 120 kills with the Lee-Enfield (Elite)" "wpn_enfield" 120 "models/player/allied_british_tank_corporal.tik"
