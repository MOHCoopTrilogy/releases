	//[dbshotgun 2026-10-13] VARIANT UNLOCK CHAIN (see the block above): kills with the shotgun unlock its sibling, the double barrel.
	//Rides the existing wpn_shotgun kill stat - the double barrel's own kills count on it too (chal_widFromModel).
	//LAST definition on purpose: the export index of every challenge above stays what it was.
	waitthread chal_def "wpn_shotgun_v" "support_weapons" "Both Barrels" "Get 60 kills with the Shotgun" "wpn_shotgun" 60 "models/weapons/coop_dbshotgun.tik"

	//[user 2026-08-26] PER-VARIANT WEAPON SKINS. Generated, never hand-written - see
	//docs/tools/variant_challenges.py. Must run BEFORE the Service Record stamp below, or the
	//stamp counts a challenge list the pages do not contain.
	waitthread coop_mod/mvchal_gen.scr::main

	//[user 2026-08-18] DEPLOYED-TRUTH SELF-TEST: the generated stamp was compiled from the same
	//challenge list as the Service Record pages. If the live count disagrees, the RUNNING game is
	//serving a mixed deployment (stale pk3, shadowing pak, partial copy) - a state no tree-level
	//build gate can see. Machine-parseable so the boot harness fails on it.
	waitthread coop_mod/gen_sr_stamp.scr::main
	if( level.coop_srRowsBaked != NIL && level.coop_srRowsBaked != level.coop_chal_count ){
		println( "^~^~^ SELFTEST FAIL: challenges live " + level.coop_chal_count + " vs SR pages baked " + level.coop_srRowsBaked + " - MIXED DEPLOYMENT" )
	}else{
		println( "^~^~^ SELFTEST OK: SR stamp " + level.coop_srGenBaked + " rows " + level.coop_chal_count )
	}

	// category display order + labels for the review printout
	level.coop_chal_catOrder[0] = "rifles"
	level.coop_chal_catOrder[1] = "snipers"
	level.coop_chal_catOrder[2] = "smgs"
	level.coop_chal_catOrder[3] = "pistols"
	level.coop_chal_catOrder[4] = "support_weapons"
	level.coop_chal_catOrder[5] = "combat"
	level.coop_chal_catOrder[6] = "fireteam"
	level.coop_chal_catOrder[7] = "vehicles"
	level.coop_chal_catOrder[8] = "campaign"
	level.coop_chal_catOrder[9] = "discovery"
	level.coop_chal_catOrder[10] = "axis"	//[user 2026-08-04] bug-1346 - faction kill tracking
	level.coop_chal_catN = 11
	level.coop_chal_catLabel["rifles"]	= "RIFLES"
	level.coop_chal_catLabel["axis"]	= "AXIS FORCES"
	level.coop_chal_catLabel["snipers"]	= "MARKSMAN"
	level.coop_chal_catLabel["smgs"]	= "SUBMACHINE GUNS"
	level.coop_chal_catLabel["pistols"]	= "SIDEARMS"
	level.coop_chal_catLabel["support_weapons"]	= "SUPPORT WEAPONS"
	level.coop_chal_catLabel["combat"]	= "COMBAT"
	level.coop_chal_catLabel["fireteam"]	= "FIRETEAM"
	level.coop_chal_catLabel["vehicles"]	= "ARMOR & VEHICLES"
	level.coop_chal_catLabel["campaign"]	= "CAMPAIGN"
	level.coop_chal_catLabel["discovery"]	= "STEALTH & FEATS"

	// ---- menu page map: sub-paginate each category into pages of 18 rows so the
	// fixed 18-slot ihuddraw block never overflows (pistol=22, campaign=39, etc.).
	// pageCat/pageOff/pageSub/pageSubN are indexed by a FLAT page number 0..pageN-1.
	level.coop_chal_pageN = 0
	local.rpp = 18
	local.c = 0
	while( local.c < level.coop_chal_catN ){
		local.cat = level.coop_chal_catOrder[local.c]
		local.n = 0
		local.i = 0
		while( local.i < level.coop_chal_count ){
			if( level.coop_chal_cat[local.i] == local.cat ){ local.n++ }
			local.i++
		}
		local.pages = int( ( local.n + local.rpp - 1 ) / local.rpp )
		local.s = 0
		while( local.s < local.pages ){
			local.k = level.coop_chal_pageN
			level.coop_chal_pageCat[local.k]  = local.cat
			level.coop_chal_pageOff[local.k]  = local.s * local.rpp
			level.coop_chal_pageSub[local.k]  = local.s + 1
			level.coop_chal_pageSubN[local.k] = local.pages
			level.coop_chal_pageN = local.k + 1
			local.s++
		}
		local.c++
	}

	//[user 2026-09-13, bug-2564] MULTIPLAYER GETS THE DEFINITIONS AND THE UNLOCK RECORD, NOT THE LOOPS. On a stock MP
	//map coop_mod/mp.scr commits armory picks through loadout_set, whose unlock gate reaches chal_init via
	//chal_ensure once coop_lockLoadout is "1" (a coop map ran earlier in this server process). The table above is
	//needed there for the lock text; these loops are not, and two are wrong in PvP: chal_pin_monitor re-seta's every
	//client's saved Service Record pin cvars every 3 s, and autosave + the vehicle-kill monitor would let deathmatch
	//play write coop progression. level.coop_mpRun is set ONLY by mp.scr, which refuses to run when coop is loaded,
	//and level vars reset per map - so on every coop map this is never true and chal_init is unchanged.
	//Enforced by docs/tools/check_mp_isolation.py; build.ps1 aborts if it goes missing.
	if( level.coop_mpRun == 1 ){ end }
	thread chal_autosave_loop
	thread coop_vehKill_monitor
	//[user 2026-08-11] sticky was-the-base-ever-alerted latch for the U-529 pair (level.alarm is a toggle).
	thread chal_alarm_ever_watch
	thread chal_pin_init
	thread chal_pin_monitor
	if( level.coop_mapname == "m5l3" ){ thread chal_m5l3_tank_watch }		// [batch 3] Day of the Tiger - watch the King Tiger's health
}end


//=========================================================================
// Append one challenge definition + register it in the per-stat reverse index.
// No waits -> callable synchronously from chal_init's init frame.
//
// [user 08-07] bug-1523 - a git-tree-only audit (grep chal_def reward strings against
// hzm-mohaa-coop-mod/models/player/) will flag ~48 rewards as "missing" (rifleman.tik,
// submachine_gunner*.tik, support_gunner*.tik, american_army_29id*.tik, american_ranger_winter*.tik,
// allied_wheathers/allied_us_mask/allied_us_tank/allied_tanker2/allied_russian_crazy_boris.tik, etc.).
// REFUTED - these are not broken. Those basenames ship in zzzzz_geared_soldiers.pk3 and the six
// zzzzzz(z)-HRRTM_Pak*.pk3 add-on packs, which the auto-updater has deployed to every player's
// home/maintt/ as MANDATORY content since manifest v1.1.0 (verified: manifests/manifest-1.1.0.json
// through latest.json v1.2.1 all list them with no optional flag; both are physically present in
// this box's G:\GOG\...\maintt\ and %APPDATA%\openmohaa\maintt\). They are deliberately NOT
// git-tracked in models/player/ - same delivery mechanism as the AA_HD_Project/hd_* texture packs -
// so a repo-only file check always misses them. All 48 basenames are already fully wired in
// helmet.scr's coop_armorySkins[]/coop_cosmeticGatedTok[] and lobby.scr's coop_lobbySkins[]; the
// unlock->armory_skin_applyIdx->`model` chain resolves them fine at runtime because the engine's pk3
// search covers every mounted pak, not just the mod's own three. Before re-flagging any of this list,
// check the manifest and the deployed maintt folder, not just this git tree. See T11 (docs/TRAPS.md).
//=========================================================================
chal_def local.id local.cat local.title local.desc local.stat local.target local.reward:{
	local.i = level.coop_chal_count
	level.coop_chal_id[local.i]     = local.id
	level.coop_chal_cat[local.i]    = local.cat
	level.coop_chal_title[local.i]  = local.title
	level.coop_chal_desc[local.i]   = local.desc
	level.coop_chal_stat[local.i]   = local.stat
	level.coop_chal_target[local.i] = local.target
	level.coop_chal_reward[local.i] = local.reward
	level.coop_chal_idx[local.id]    = local.i	//cid -> index; pins store cids, not indices

	if( level.coop_chal_statN[local.stat] == NIL ){ level.coop_chal_statN[local.stat] = 0 }
	local.k = level.coop_chal_statN[local.stat]
	level.coop_chal_statIdx[local.stat][local.k] = local.i
	level.coop_chal_statN[local.stat] = local.k + 1

	level.coop_chal_count = local.i + 1
}end


//=========================================================================
// 30s autosave (plus flushes on completion and mission complete).
//=========================================================================
chal_autosave_loop:{
	if( level.coop_chal_autosave == 1 ){ end }
	level.coop_chal_autosave = 1
	while( 1 ){
		wait 30
		waitthread chal_flush
		//[user 08-06] bug-1508 - "Wuss.pk3": per-player (each client has its OWN sound table, so
		//this is a personal stat, not a team one - chal_bump, not chal_team_bump). coop_wussCount is
		//CVAR_USERINFO (cg_view.c CG_SyncWussPk3Count, throttled to one resend/10s), so this is
		//always reading whatever the client last synced - a few seconds of staleness against this
		//30s loop is irrelevant for a "did you cross 700 at some point this session" check.
		local.wi = 1
		while( local.wi <= $player.size ){
			local.wp = $player[local.wi]
			if( local.wp != NULL && local.wp.flags["coop_isActive"] == 1 ){
				local.wc = info_valueforkey local.wp.userinfo "coop_wussCount"
				if( local.wc != NIL && local.wc != "" && int( local.wc ) >= 700 ){
					waitthread chal_bump local.wp "cc_wuss_pk3" 1
				}
			}
			local.wi++
		}
	}
}end


//=========================================================================
// Ensure a player is identified + loaded. Reuses the XP id; derives it locally
// if XP is off. Singleton per player (a bump can race the first load).
//=========================================================================
chal_ensure local.player:{
	if( level.coop_chal_init != 1 ){ waitthread chal_init }
	if( level.coop_chal_enabled != 1 ){ end }
	if( local.player == NULL ){ end }
	if( local.player.flags["coop_chal_loaded"] == 1 ){ end }
	if( local.player.flags["coop_chal_loading"] == 1 ){
		while( local.player != NULL && local.player.flags["coop_chal_loading"] == 1 ){
			wait 0.25
		}
		end
	}
	local.player.flags["coop_chal_loading"] = 1

	// identity: reuse the XP id (waits out the guid). Harmless no-op if XP is disabled.
	if( local.player.flags["coop_xp_id"] == NIL ){
		waitthread coop_mod/xp.scr::xp_identify local.player
	}
	if( local.player == NULL ){ end }
	local.id = local.player.flags["coop_xp_id"]
	if( local.id == NIL || local.id == "" ){
		// XP disabled or no id yet - derive the same identity standalone
		local.id = local.player.coop_guid
		if( local.id == NIL || local.id == "" ){ local.id = "n_" + local.player.netname }
	}
	if( local.id == NIL || local.id == "" ){
		local.player.flags["coop_chal_loading"] = NIL
		end
	}
	local.player.flags["coop_chal_id"] = local.id

	// progress: session cvar first (survives map transitions), then the file
	local.data = getcvar( "coop_chal_" + local.id )
	if( local.data == "" ){
		local.data = fs_read_content ( "coop_mod/save/chal_" + local.id + ".dat" )
	}
	if( local.data != NIL && local.data != "" ){
		waitthread chal_deserialize local.player local.data
	}

	// unlocks: session cvar first, then the file
	local.u = getcvar( "coop_unlocks_" + local.id )
	if( local.u == "" ){
		local.u = fs_read_content ( "coop_mod/save/unlocks_" + local.id + ".dat" )
	}
	if( local.u != NIL && local.u != "" ){
		local.player.flags["coop_chal_unlocks"] = local.u
	} else {
		local.player.flags["coop_chal_unlocks"] = ""
	}

	//[user 07-18] LOBBY UNLOCK LIST: pending "NEW UNLOCKS" display names queued by chal_add_unlock,
	//shown for the whole next lobby stay (lobby.scr::lobbyUnlockList), cleared at campaign launch.
	//Same channel pattern as the unlocks above: session cvar first, then the file. Missing (all
	//pre-feature saves) = empty - fully backward compatible.
	local.pd = getcvar( "coop_pend_" + local.id )
	if( local.pd == "" ){
		local.pd = fs_read_content ( "coop_mod/save/pend_" + local.id + ".dat" )
	}
	if( local.pd != NIL && local.pd != "" ){
		local.player.flags["coop_unlockPend"] = local.pd
	} else {
		local.player.flags["coop_unlockPend"] = ""
	}

	// mark done flags for anything already complete (silent, no toast/regrant)
	local.i = 0
	while( local.i < level.coop_chal_count ){
		local.cid = level.coop_chal_id[local.i]
		local.p = local.player.flags["coop_chalP_" + local.cid]
		if( local.p != NIL && local.p >= level.coop_chal_target[local.i] ){
			local.player.flags["coop_chalD_" + local.cid] = 1
		}
		local.i++
	}

	local.player.flags["coop_chal_loaded"]  = 1
	local.player.flags["coop_chal_loading"] = NIL

	//[user 2026-09-13, bug-2564] MULTIPLAYER STOPS AT THE UNLOCK RECORD. Everything below writes saved client cvars -
	//the pin restore and push (seta coop_pinCount, set coop_cp<i>d) and the medal pass - and a server that has never
	//seen this player would push an empty Service Record over the one his own coop server built. The armory only
	//needs coop_chal_unlocks, loaded above. Never true on a coop map; see the matching guard at chal_init's tail.
	if( level.coop_mpRun == 1 ){ end }
	//[user 2026-08-04] pinned challenges: restore this player's pins and publish the HUD rows
	waitthread chal_pin_load local.player
	//[user 08-06] bug-1503 - then let a DISCONNECTED-menu pin choice (sent via userinfo) override
	//the file-restored one above, since userinfo is always at least as fresh. Must run before the
	//push/markAll below so both UIs reflect the reconciled result, not the pre-import one.
	waitthread chal_pin_importUserinfo local.player
	waitthread chal_pin_push local.player
	waitthread chal_pin_markAll local.player

	//[401] HZM MEDALS - load this player's earned set now that coop_chal_id is resolved. Also
	//catches anything that finished retroactively (e.g. a category's last challenge unlock was
	//never actually re-checked against medals before this feature existed).
	waitthread coop_mod/medals.scr::medal_load local.player
	waitthread coop_mod/medals.scr::medal_checkAll local.player

	// [user 07-17] CRITICAL "Server disconnected" on campaign start (bug-670): this join-time
	// chal_ui_export streams 2 reliable stufftext setas PER challenge (coop_uiB<i>/coop_uiN<i>).
	// With ~187 challenges that is ~373 reliable commands fired at SPAWN, while the client is still
	// loading the map and NOT acking. The client reliable-command ring is MAX_RELIABLE_COMMANDS=512
	// (qcommon.h); combined with the loadout resend + configstrings the join burst hit 514 and the
	// ring cycled out an unacked command -> the client self-drops ("Server disconnected for unknown
	// reason", cl_main.cpp:247). These are ARCHIVED (seta) cvars for the DISCONNECTED Service Record
	// menu, so they persist from last session and DO NOT need re-pushing on join. chal_autosave_loop
	// (chal_flush every 30s) refreshes them safely during play, once the client is interactive. So
	// the join push was both the crash source AND redundant - removed.
	// local.player thread chal_ui_export   // <- REMOVED (join-time reliable-command flood)
}end


//=========================================================================
// Parse "cid:progress|cid:progress|..." into per-challenge progress flags.
//=========================================================================
chal_deserialize local.player local.data:{
	if( local.player == NULL ){ end }
	if( local.data == NIL || local.data == "" ){ end }
	local.field = ""
	local.cid   = ""
	local.mode  = 0		// 0 = reading cid, 1 = reading progress
	local.i = 0
	local.n = local.data.size
	while( local.i < local.n ){
		local.c = local.data[local.i]
		if( local.c == ":" ){
			local.cid   = local.field
			local.field = ""
			local.mode  = 1
		} else if( local.c == "|" ){
			if( local.cid != "" && local.field != "" && local.mode == 1 ){
				local.player.flags["coop_chalP_" + local.cid] = int( local.field )
			}
			local.field = ""
			local.cid   = ""
			local.mode  = 0
		} else {
			local.field += local.c
		}
		local.i++
	}
	// trailing entry (no terminating "|")
	if( local.cid != "" && local.field != "" && local.mode == 1 ){
		local.player.flags["coop_chalP_" + local.cid] = int( local.field )
	}
}end


//=========================================================================
// Serialize a player's non-zero progress into "cid:progress|..."
//=========================================================================
chal_serialize local.player:{
	local.out = ""
	local.i = 0
	while( local.i < level.coop_chal_count ){
		local.cid = level.coop_chal_id[local.i]
		local.p = local.player.flags["coop_chalP_" + local.cid]
		if( local.p != NIL && local.p > 0 ){
			if( local.out == "" ){
				local.out = local.cid + ":" + local.p
			} else {
				local.out = local.out + "|" + local.cid + ":" + local.p
			}
		}
		local.i++
	}
}end(local.out)


//=========================================================================
// Persist one player (session cvar + file).
//=========================================================================
chal_save_player local.player:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( local.player == NULL ){ end }
	if( local.player.flags["coop_chal_id"] == NIL ){ end }
	local.out = waitthread chal_serialize local.player
	local.id = local.player.flags["coop_chal_id"]
	//[srvperf 2026-10-04] unchanged since our last save -> skip the cvar + synchronous file write (up to
	//~2.3 ms in one server frame per player, every 30 s chal_flush, measured on m1l1). Changed data always writes.
	if( local.player.flags["coop_chal_saved"] != local.out ){
		setcvar ( "coop_chal_" + local.id ) local.out
		fs_write_content ( "coop_mod/save/chal_" + local.id + ".dat" ) local.out
		local.player.flags["coop_chal_saved"] = local.out
	}
	waitthread chal_pin_save local.player
}end


//=========================================================================
// Persist every loaded player.
//=========================================================================
chal_flush:{
	if( level.coop_chal_enabled != 1 ){ end }
	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p.flags["coop_chal_id"] != NIL ){
			waitthread chal_save_player local.p
			//[user 2026-08-10] bug-1670 leftover: STAGGER the per-player exports. The diff gate means a
			//steady-state flush sends ~0 commands, but the FIRST export after a map load is still ~1000
			//per player, and this loop previously threaded them all in the same frame so N players
			//stacked their queues on top of each other. One frame apart is enough to interleave them.
			local.p thread chal_ui_export		// refresh the menu's last-known progress cvars
			waitframe
		}
		local.i++
	}
}end

//=========================================================================
// LAST-KNOWN PROGRESS BRIDGE: publish this player's per-challenge progress as a bucketed fill-bar
// SHADER name into SAVED (archived) client cvars coop_uiB<index> (index = catalog order 0..count-1).
// The disconnected menu (ui/coop_sr_*.urc per-category pages) binds each bar Label to its cvar via
// linkcvar + linkcvartoshader, so it shows the player's real progress from their last session even
// with no server/player present.
// [user 2026-08-10] bug-1670: this line used to read "Paced so the 61 stufftext setas never overflow
// the command buffer" - stale by ~16x. The catalogue is now 335 challenges x 3 commands = ~1005 per
// player per export, against MAX_RELIABLE_COMMANDS 1024 (qcommon.h:215), and the client is DROPPED at
// the ceiling with "Server command overflow" (sv_main.c:208). Worse, every unacked command is
// re-serialised into every snapshot (sv_snapshot.c:249-259), so it diverges rather than merely being
// tight. Invisible to a listen HOST because loopback gets FRAGMENT_SIZE 9900 and skips the rate gate
// (net_chan.c:52) - but every REMOTE client, on a listen server just as much as a dedicated one, is
// exposed. Now dirty-tracked (unchanged rows send nothing) and paced on commands sent.
//=========================================================================
chal_ui_export:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( self == NULL ){ end }
	//[user 2026-08-10] bug-1670. Re-entrancy guard: chal_flush threads this for EVERY player and is
	//called every 30s AND at mission complete, so two exports for the same player could otherwise
	//overlap and double the command rate.
	if( self.flags["coop_uiExporting"] == 1 ){ end }
	self.flags["coop_uiExporting"] = 1
	local.i = 0
	local.pace = 0
	local.sent = 0
	while( local.i < level.coop_chal_count && self != NULL ){
		local.n = waitthread chal_ui_writeOne self local.i
		if( local.n == NIL ){ local.n = 0 }
		local.sent = local.sent + local.n
		local.i++
		//PACE ON COMMANDS ACTUALLY SENT, not on rows visited. An unchanged row now costs nothing, so
		//a steady-state export finishes almost instantly, while a first/changed export is spread at
		//~24 commands per 0.25s = ~96/sec - slow enough that a remote client acks faster than we
		//queue. The old code paced 24 commands per WAITFRAME = ~960/sec at sv_fps 40.
		local.pace = local.pace + local.n
		if( local.pace >= 24 ){ local.pace = 0; wait 0.25 }
	}
	if( self != NULL ){ self.flags["coop_uiExporting"] = NIL }
	if( getcvar( "coop_aggroDebug" ) == "1" ){
		println( "^~^~^ CHALUI export sent=" + local.sent + " rows=" + level.coop_chal_count )
	}
}end

chal_ui_writeOne local.player local.i:{
	//[user 2026-08-10] bug-1670: DIRTY-TRACKED. Returns the number of reliable commands it actually
	//sent (0 or 3) so the caller can pace on real traffic. Previously this emitted 3 stufftext per
	//row unconditionally, 335 rows per player, every 30 seconds - ~1005 against a 1024 ring.
	//The signature covers EXACTLY the values that appear in the three commands, so a row can only be
	//skipped when the client already holds identical values.
	local.r = 0
	if( local.player == NULL ){ end local.r }
	local.cid = level.coop_chal_id[local.i]
	local.tgt = level.coop_chal_target[local.i]
	local.p   = local.player.flags["coop_chalP_" + local.cid]
	if( local.p == NIL ){ local.p = 0 }
	local.done = 0
	if( local.player.flags["coop_chalD_" + local.cid] == 1 ){ local.done = 1 }

	local.b = 0
	if( local.done != 1 ){
		if( local.tgt > 0 ){ local.b = int( local.p * 10 / local.tgt ) }
		if( local.b > 10 ){ local.b = 10 }
		if( local.p > local.tgt ){ local.p = local.tgt }
	}

	local.sig = "" + local.done + ":" + local.b + ":" + local.p + ":" + local.tgt
	if( local.player.flags["coop_uiSig" + local.i] == local.sig ){ end local.r }
	local.player.flags["coop_uiSig" + local.i] = local.sig

	if( local.done == 1 ){
		local.player stufftext ( "seta coop_uiB" + local.i + " textures/hud/coop_bfd" )
		local.player stufftext ( "seta coop_uiN" + local.i + " " + local.tgt + "/" + local.tgt )
		//[user 08-07] failsafe: a finished challenge cannot be pinned (nothing left to track) - this
		//archived per-row "done" flag is what both the disconnected client (CL_PinToggle_f) and the
		//server (chal_pin_toggle/chal_pin_byIndex) refuse a new pin against, and it drives the
		//checkmark that replaces the pin checkbox on a done row (gen_service_record.py).
		local.player stufftext ( "seta coop_uiD" + local.i + " 1" )
		local.r = 3
		end local.r
	}
	//[user 08-07] BOX STATE as a SHADER PATH, exactly like the progress bar: the server writes a
	//texture path and the widget renders it with linkcvar+linkcvartoshader, archived, so it survives
	//with no client-side computation. The checkbox previously used enabledcvar, which needs an
	//INTEGER somebody has to compute, and that computation (CL_SyncSR_f) never ran - which is why the
	//tick was wrong every time. Same channel as the bar now, so the box cannot disagree with it.
	local.player stufftext ( "seta coop_uiD" + local.i + " 0" )
	local.player stufftext ( "seta coop_uiB" + local.i + " textures/hud/coop_bf" + local.b )
	local.player stufftext ( "seta coop_uiN" + local.i + " " + local.p + "/" + local.tgt )
	local.r = 3
	end local.r
}end


//=========================================================================
// THE progress entry point. Increments every challenge tracking local.stat.
//=========================================================================
chal_bump local.player local.stat local.amount:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( local.player == NULL ){ end }
	if( local.player.classname != "Player" ){ end }
	if( local.amount == NIL || local.amount <= 0 ){ end }

	waitthread chal_ensure local.player
	if( local.player == NULL ){ end }
	if( local.player.flags["coop_chal_id"] == NIL ){ end }

	local.cnt = level.coop_chal_statN[local.stat]
	if( local.cnt == NIL || local.cnt <= 0 ){ end }
	local.j = 0
	while( local.j < local.cnt ){
		local.idx = level.coop_chal_statIdx[local.stat][local.j]
		waitthread chal_apply local.player local.idx local.amount
		local.j++
	}
}end


//=========================================================================
// Apply progress to one challenge index; clamp, mark done once, grant unlock.
//=========================================================================
chal_apply local.player local.idx local.amt:{
	if( local.player == NULL ){ end }
	local.cid  = level.coop_chal_id[local.idx]
	local.dkey = "coop_chalD_" + local.cid
	if( local.player.flags[local.dkey] == 1 ){ end }		// already complete

	local.pkey = "coop_chalP_" + local.cid
	local.p = local.player.flags[local.pkey]
	if( local.p == NIL ){ local.p = 0 }
	local.old = local.p
	local.p = local.p + local.amt

	local.tgt = level.coop_chal_target[local.idx]
	if( local.p > local.tgt ){ local.p = local.tgt }
	local.player.flags[local.pkey] = local.p

	// quarter-progress popup: mini HD bar on the left at each 25/50/75% milestone (100% is
	// covered by the CHALLENGE COMPLETE toast instead). Only for counters (target >= 4).
	//[user 08-07] PINNED-ONLY: originally fired for every in-progress counter, which meant several
	//weapon-kill challenges could compete for the same left-edge popup during a firefight. Now gated
	//to the player's own pinned set (chal_pin_isPinned) so it tracks only what they chose to watch.
	if( local.tgt >= 4 && local.p < local.tgt ){
		if( int( local.p * 4 / local.tgt ) > int( local.old * 4 / local.tgt ) ){
			if( waitthread chal_pin_isPinned local.player local.cid ){
				thread chal_progress_popup local.player level.coop_chal_title[local.idx] local.p local.tgt
			}
		}
	}

	if( local.p >= local.tgt ){
		local.player.flags[local.dkey] = 1
		waitthread chal_grant local.player local.idx
	}
}end


//=========================================================================
// A challenge just completed: record the unlock, toast the player, persist.
//=========================================================================
chal_grant local.player local.idx:{
	if( local.player == NULL ){ end }
	local.reward = level.coop_chal_reward[local.idx]
	local.title  = level.coop_chal_title[local.idx]
	waitthread chal_add_unlock local.player local.reward
	thread chal_notify local.player local.title
	waitthread chal_save_player local.player
	//[user 08-07] failsafe: nothing left to track once a challenge is done - if it happened to be
	//pinned already, drop it automatically (frees the slot; chal_pin_toggle's own unpin branch
	//fires here since it's currently pinned, this call always removes rather than adds).
	local.cid = level.coop_chal_id[local.idx]
	if( waitthread chal_pin_isPinned local.player local.cid ){
		waitthread chal_pin_toggle local.player local.cid
	}
	//[user 2026-08-18] a completed ELITE may carry a MODEL VARIANT (the strip's fid 8).
	//Queue a pseudo-reward through the SAME pipeline as every other unlock, so it gets the
	//live toast, the lobby NEW UNLOCKS list and the mission-end debrief card for free.
	//The store entry is inert (nothing equips by it); the strip's real gate re-checks the
	//Elite completion flag itself.
	waitthread coop_mod/loadoutskins.scr::skin_init
	local.mv = level.coop_skinMvByElite[local.cid]
	if( local.mv != NIL && local.mv != "" ){
		waitthread chal_add_unlock local.player ("mv_" + local.cid)
		thread chal_notify local.player ("Variant unlocked: " + local.mv)
	}

	//[401] HZM MEDALS - a completed challenge may just have finished its whole category
	thread coop_mod/medals.scr::medal_checkAll local.player
	//[user 07-16] a just-earned weapon lights up the armory without a reconnect
	if( local.reward != NIL && local.reward != "" ){
		thread coop_mod/loadoutpick.scr::loadout_ui_exportUnlocks local.player
	}
}end


//=========================================================================
// Record an unlock id into the player's unlock set (dedup) + persist to the
// companion cvar/file that a future loadout picker reads.
//=========================================================================
//=========================================================================
chal_reqText local.token:{
//=========================================================================
// [user 2026-08-23, bug-2078] NAME THE REQUIREMENT. "some unlock conditions said unlock through
// challenges or rank but don't specify which challenge or rank for unlock conditions."
// They were right, and it was three separate messages all shrugging the same way:
// helmet.scr's helmet_lockNotice and its skin twin both said "earn it via challenges/ranks", and
// loadoutpick.scr's gun deny said "see its requirement in the inspect panel" - which is only
// useful if the panel knows, and it did not either.
//
// The requirement was ALWAYS knowable. It is just split across two files that never met:
// challenges.scr's chal_def rewards (challenge -> tik) and xp.scr's coop_xp_rankUnlock (rank ->
// tik). Nothing joined them, so no code anywhere could answer "why is this locked".
// docs/tools/armory_unlocks.py joins them and emits coop_mod/unlockreq_gen.scr, so the answer is
// SWEPT out of the two authorities rather than hand-written next to them - a hand-written copy
// would drift the first time a challenge reward changed, and drift silently.
//
// The audit that generates it also proved the set is sound: 0 of 247 gated items are
// unobtainable, and 0 rewards point at an item no armory page lists. So every one of these
// strings names something a player can actually do.
	waitthread coop_mod/unlockreq_gen.scr::main
	local.t = level.coop_unlockReq[local.token]
	if( local.t == NIL || local.t == "" ){ end "earned through challenges or rank" }
	end local.t
}end ""

chal_add_unlock local.player local.reward:{
	if( local.player == NULL ){ end }
	if( local.reward == NIL || local.reward == "" ){ end }
	//[user 07-18 lobby-unlock-list] load the persisted unlock set BEFORE the dedup below - without
	//it a connect-time rank backfill (xp.scr::xp_rank_unlock 0..rank, threaded from xp_identify)
	//can race the load, see an empty set, treat every re-grant as new and flood the pending
	//NEW UNLOCKS queue on every reconnect. chal_ensure early-outs once loaded, so this costs
	//nothing on the normal (already-ensured) chal_grant/armory paths.
	waitthread chal_ensure local.player
	if( local.player == NULL ){ end }
	local.u = local.player.flags["coop_chal_unlocks"]
	if( local.u == NIL ){ local.u = "" }

	// membership test with delimiters so "bar" != "bar.tik" collisions can't happen
	local.probe = "|" + local.reward + "|"
	local.hay   = "|" + local.u + "|"
	if( waitthread coop_mod/main.scr::containsText local.hay local.probe 0 ){ end }

	if( local.u == "" ){ local.u = local.reward }
	else { local.u = local.u + "|" + local.reward }
	local.player.flags["coop_chal_unlocks"] = local.u

	local.id = local.player.flags["coop_chal_id"]
	if( local.id != NIL && local.id != "" ){
		setcvar ( "coop_unlocks_" + local.id ) local.u
		fs_write_content ( "coop_mod/save/unlocks_" + local.id + ".dat" ) local.u
	}

	//[user 07-18] LOBBY UNLOCK LIST: reaching here means the reward passed the dedup above =
	//genuinely NEW. Queue its human display name for the lobby's "NEW UNLOCKS" list (persists
	//across the mission->lobby map change; drawn by lobby.scr::lobbyUnlockList; cleared for good
	//at campaign launch via chal_pend_clear).
	local.nm = waitthread chal_unlock_displayName local.reward
	waitthread chal_pend_append local.player local.nm

	//[user 07-18 debrief-unlock-list] PER-MAP accumulator (SEPARATE from the lobby pending queue above):
	//record this genuinely-new unlock's display name for the END-OF-MISSION debrief card
	//(xp.scr::xp_card_unlocks). Per-player to match the unlock scoping (unlocks land on one player, not
	//the team). NOT persisted to cvar/file, so it dies with the map. Auto-resets per map via the mapname
	//stamp (same trick as coop_wentDownMap): the first unlock of a new map - or the debrief on a map that
	//had none - sees a stale stamp and treats the list as empty. No explicit clear needed and no leak even
	//if player.flags were to survive a transition. "~" separator (display names contain spaces, not "~").
	if( local.player != NULL && local.nm != NIL && local.nm != "" ){
		if( local.player.flags["coop_mapUnlockStamp"] != level.coop_mapname ){
			local.player.flags["coop_mapUnlockStamp"] = level.coop_mapname
			local.player.flags["coop_mapUnlockList"]  = ""
		}
		local.ml = local.player.flags["coop_mapUnlockList"]
		if( local.ml == NIL || local.ml == "" ){ local.ml = local.nm }
		else { local.ml = local.ml + "~" + local.nm }
		local.player.flags["coop_mapUnlockList"] = local.ml
	}

	//[user 07-18 pre-release] SHOW-ALL-WITH-LOCK: a new PLAYER-SKIN unlock changes this player's
	//armory lock icons - re-push the per-page lock state so the picker unlocks it immediately
	//(diff-only; the path probe skips non-skin rewards). Covers challenge rewards AND xp.scr rank
	//grants (both funnel through here).
	if( waitthread coop_mod/main.scr::containsText local.reward "models/player/" 0 ){
		thread coop_mod/helmet.scr::armory_skin_exportLocks local.player
	}
	//[user 07-18 pre-release] same for a new HELMET unlock (diff-only; path probe skips non-helmet
	//rewards).
	if( waitthread coop_mod/main.scr::containsText local.reward "models/coop_helmets/" 0 ){
		thread coop_mod/helmet.scr::armory_helmet_exportLocks local.player
	}
	//[bug-2082] GLOVES NEED THEIR OWN BRANCH. This call sat inside the helmet test above, which only
	//fires when the reward path contains "models/coop_helmets/" - and a glove reward is a bare token
	//(glv_wool), so it could never match. Earning a glove therefore never refreshed its padlock: the
	//armory kept showing it locked until the next join.
	if( waitthread coop_mod/main.scr::containsText local.reward "glv_" 0 ){
		thread coop_mod/gloves.scr::armory_glove_exportLocks local.player
	}
}end


//=========================================================================
// Team-wide bump (objectives / mission complete). Active players only.
//=========================================================================
chal_team_bump local.stat local.amount:{
	if( level.coop_chal_enabled != 1 ){ end }
	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p.flags["coop_isActive"] == 1 ){
			waitthread chal_bump local.p local.stat local.amount
		}
		local.i++
	}
}end


//=========================================================================
// Award a campaign feat ONLY to active players who never went down THIS map.
// dbno.scr (on DBNO entry) and player.scr (on death) stamp self.coop_wentDownMap
// with the current level.coop_mapname; since that string differs on the next map,
// the disqualification auto-resets per map with no explicit clear, and retries
// within the same map stay disqualified. Used by the "no-down" campaign feats.
//=========================================================================
cc_award_clean local.stat:{
	if( level.coop_chal_enabled != 1 ){ end }
	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		if( local.p != NULL && local.p.flags["coop_isActive"] == 1 && local.p.coop_wentDownMap != level.coop_mapname ){
			waitthread chal_bump local.p local.stat 1
		}
		local.i++
	}
}end


//=========================================================================
// Identify the killer's active weapon -> short id ("garand"/"thompson"/...).
// Returns "" when holstered/unknown. Most-specific substrings first.
//=========================================================================
chal_weaponId local.player:{
	local.wid = ""
	if( local.player == NULL ){ end "" }
	// [user 07-18] RE-QUERY the actual held weapon fresh instead of the cached coop_activeWeapon flag.
	// The flag is maintained by weaponstate.scr on RAISE_WEAPON, but IMPORTED weapons (.30cal, mg42
	// portable, xw guns) don't always refresh it - so killing with them credited the PREVIOUS carried
	// gun (e.g. .30cal kills -> Gewehr challenge). The kill fires immediately after the fatal hit, so the
	// player is still holding the killing weapon; returnActiveWeapon reads it authoritatively. Flag = fallback.
	local.w = waitthread coop_mod/itemhandler.scr::returnActiveWeapon local.player
	if( local.w == NULL || local.w == NIL ){ local.w = local.player.flags["coop_activeWeapon"] }
	if( local.w == NULL || local.w == NIL ){ end "" }
	local.m = local.w.model
	if( local.m == NIL || local.m == "" ){ end "" }

	local.wid = waitthread chal_widFromModel local.m
}end(local.wid)

//=========================================================================
//[user 2026-08-18] The model->wid chain, callable with a MODEL PATH. Moved verbatim out of
//chal_weaponId so the finish strip's mastery gate keys on exactly the same mapping as the
//kill-stat writers - a finish can never gate on a different spelling than the challenge
//that counts its kills. chal_weaponId now derives the model and calls this.
//=========================================================================
chal_widFromModel local.m:{
	local.wid = ""
	if( local.m == NIL || local.m == "" ){ end "" }
	//[user 2026-08-17] East imports. Placed at the TOP of the chain deliberately: this is an
	//ordered substring match, so an entry added at the bottom can be pre-empted by any earlier
	//token that happens to appear in the path. Verified neither path contains any of the other
	//45 tokens, but position is the cheap guarantee.
	if( waitthread coop_mod/main.scr::containsText local.m "mauser_c96" 0 ){ local.wid = "c96" }
	else if( waitthread coop_mod/main.scr::containsText local.m "dp28" 0 ){ local.wid = "dp28" }
	else if( waitthread coop_mod/main.scr::containsText local.m "m10_revolver" 0 ){ local.wid = "m10" }
	else if( waitthread coop_mod/main.scr::containsText local.m "johnson" 0 ){ local.wid = "johnson" }
	else if( waitthread coop_mod/main.scr::containsText local.m "nagant_revolver" 0 ){ local.wid = "nagantrev" }
	else if( waitthread coop_mod/main.scr::containsText local.m "silencedpistol" 0 ){ local.wid = "silenced" }
	else if( waitthread coop_mod/main.scr::containsText local.m "nagant_sniper" 0 ){ local.wid = "mosinsniper" }
	else if( waitthread coop_mod/main.scr::containsText local.m "carcanosniper" 0 ){ local.wid = "carcanosniper" }
	else if( waitthread coop_mod/main.scr::containsText local.m "arisakasniper" 0 ){ local.wid = "arisakasniper" }
	else if( waitthread coop_mod/main.scr::containsText local.m "panzerschreck" 0 ){ local.wid = "panzerschreck" }
	else if( waitthread coop_mod/main.scr::containsText local.m "springfield" 0 ){ local.wid = "springfield" }
	else if( waitthread coop_mod/main.scr::containsText local.m "kar98sniper" 0 ){ local.wid = "kar98sniper" }
	else if( waitthread coop_mod/main.scr::containsText local.m "g43sniper" 0 ){ local.wid = "g43sniper" }
	else if( waitthread coop_mod/main.scr::containsText local.m "greasegun" 0 ){ local.wid = "greasegun" }
	else if( waitthread coop_mod/main.scr::containsText local.m "moschetto" 0 ){ local.wid = "moschetto" }
	else if( waitthread coop_mod/main.scr::containsText local.m "thompson" 0 ){ local.wid = "thompson" }
	else if( waitthread coop_mod/main.scr::containsText local.m "enfield" 0 ){ local.wid = "enfield" }
	else if( waitthread coop_mod/main.scr::containsText local.m "carcano" 0 ){ local.wid = "carcano" }
	else if( waitthread coop_mod/main.scr::containsText local.m "arisaka" 0 ){ local.wid = "arisaka" }
	else if( waitthread coop_mod/main.scr::containsText local.m "delisle" 0 ){ local.wid = "delisle" }
	else if( waitthread coop_mod/main.scr::containsText local.m "type100" 0 ){ local.wid = "type100" }
	else if( waitthread coop_mod/main.scr::containsText local.m "beretta" 0 ){ local.wid = "beretta" }
	else if( waitthread coop_mod/main.scr::containsText local.m "bar.tik" 0 ){ local.wid = "bar" }
	else if( waitthread coop_mod/main.scr::containsText local.m "bar_kun" 0 ){ local.wid = "bar" }
	else if( waitthread coop_mod/main.scr::containsText local.m "vickers" 0 ){ local.wid = "vickers" }
	else if( waitthread coop_mod/main.scr::containsText local.m "shotgun" 0 ){ local.wid = "shotgun" }
	else if( waitthread coop_mod/main.scr::containsText local.m "bazooka" 0 ){ local.wid = "bazooka" }
	else if( waitthread coop_mod/main.scr::containsText local.m "garand" 0 ){ local.wid = "garand" }
	else if( waitthread coop_mod/main.scr::containsText local.m "colt45" 0 ){ local.wid = "colt" }
	else if( waitthread coop_mod/main.scr::containsText local.m "webley" 0 ){ local.wid = "webley" }
	else if( waitthread coop_mod/main.scr::containsText local.m "welrod" 0 ){ local.wid = "welrod" }
	else if( waitthread coop_mod/main.scr::containsText local.m "kar98" 0 ){ local.wid = "kar98" }
	else if( waitthread coop_mod/main.scr::containsText local.m "mosin" 0 ){ local.wid = "mosin" }
	else if( waitthread coop_mod/main.scr::containsText local.m "l42a1" 0 ){ local.wid = "l42a1" }
	else if( waitthread coop_mod/main.scr::containsText local.m "luger" 0 ){ local.wid = "luger" }
	else if( waitthread coop_mod/main.scr::containsText local.m "nambu" 0 ){ local.wid = "nambu" }
	else if( waitthread coop_mod/main.scr::containsText local.m "30cal" 0 ){ local.wid = "thirtycal" }
	else if( waitthread coop_mod/main.scr::containsText local.m "breda" 0 ){ local.wid = "breda" }
	else if( waitthread coop_mod/main.scr::containsText local.m "mp44" 0 ){ local.wid = "stg44" }
	else if( waitthread coop_mod/main.scr::containsText local.m "mp40" 0 ){ local.wid = "mp40" }
	else if( waitthread coop_mod/main.scr::containsText local.m "sten" 0 ){ local.wid = "sten" }
	else if( waitthread coop_mod/main.scr::containsText local.m "ppsh" 0 ){ local.wid = "ppsh" }
	else if( waitthread coop_mod/main.scr::containsText local.m "tt33" 0 ){ local.wid = "tt33" }
	else if( waitthread coop_mod/main.scr::containsText local.m "mg42" 0 ){ local.wid = "mg42" }
	else if( waitthread coop_mod/main.scr::containsText local.m "piat" 0 ){ local.wid = "piat" }
	else if( waitthread coop_mod/main.scr::containsText local.m "g43" 0 ){ local.wid = "g43" }
	else if( waitthread coop_mod/main.scr::containsText local.m "svt" 0 ){ local.wid = "svt" }
	else if( waitthread coop_mod/main.scr::containsText local.m "p38" 0 ){ local.wid = "p38" }
	else if( waitthread coop_mod/main.scr::containsText local.m "ppk" 0 ){ local.wid = "ppk" }
}end(local.wid)


//=========================================================================
// [user 07-11] PER-LEVEL PLAYSTYLE TRACKER (Pistol Pete / Stalingrad Rifle-Only / Schoolgirls /
// Freeze-Tag / Earn This). Per-player flags are lazily reset the first time they are touched on a NEW
// map (compared by name, so respawns WITHIN a level do not reset them). The no-down source is the
// existing coop_wentDownMap flag set by dbno.scr.
//=========================================================================
chal_lvl_touch local.player:{
	if( local.player == NULL ){ end }
	if( local.player.coop_chalL_map == level.coop_mapname ){ end }
	local.player.coop_chalL_map           = level.coop_mapname
	local.player.coop_chalL_kills         = 0
	local.player.coop_chalL_usedNonPistol = 0
	local.player.coop_chalL_usedNonBolt   = 0
	local.player.coop_chalL_usedAim       = 0
	local.player.coop_chalL_healed        = 0
	local.player.coop_chalL_revives       = 0
}end


//=========================================================================
// Per-player aim watcher: any use of ADS (coopadsheld, engine-exposed) marks the level "aim used", which
// fails the Schoolgirls feat. One guarded instance per player, started per (re)spawn from
// player.scr::manageAliveSpawning. Polls at 5 Hz - cheap, and it re-touches so it re-arms each new map.
//=========================================================================
chal_lvl_aim_monitor local.player:{
	if( local.player == NULL ){ end }
	if( level.coop_chal_enabled != 1 ){ end }
	if( local.player.coop_chalL_aimMonRun == 1 ){ end }
	local.player.coop_chalL_aimMonRun = 1
	//[user 2026-08-08] this loop also stamps coop_lastHurtT ("Field Hospital": revive an ally while
	//you are yourself under fire). Deliberately NOT dbno.scr's dbno_monitor, which already tracks
	//per-frame health drops but is gated on the coop_dbno cvar and disabled outright on the jeep
	//maps - the stat would have died silently wherever DBNO is off. This monitor only needs
	//coop_chal_enabled, which is the same thing the challenge itself needs. 5 Hz is plenty of
	//resolution for a 3-second window.
	local.prevHp = local.player.health
	while( local.player != NULL && local.player.flags["coop_isActive"] == 1 ){
		waitthread chal_lvl_touch local.player
		if( isAlive local.player && local.player.coopadsheld == 1 ){
			local.player.coop_chalL_usedAim = 1
		}
		if( isAlive local.player ){
			if( local.prevHp != NIL && local.player.health < local.prevHp ){
				local.player.coop_lastHurtT = level.time
			}
			local.prevHp = local.player.health
		}
		wait 0.2
	}
	if( local.player != NULL ){ local.player.coop_chalL_aimMonRun = NIL }
}end


//=========================================================================
// HOOK: a player started healing with a medkit. Threaded from medkit.scr. Fails Earn This for that player.
//=========================================================================
chal_on_heal local.player:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( local.player == NULL ){ end }
	waitthread chal_lvl_touch local.player
	local.player.coop_chalL_healed = 1
}end


//=========================================================================
// HOOK: AI killed. Threaded from aihandler.scr::addKillToPlayer.
// Reclassifies the kill exactly like xp.scr::xp_ai_killed (headshot/wallbang/
// melee/savior/long/blindfire/reinf/downed + means-of-death families) and the
// killer's specific weapon. Every path is a threaded bump so a bug here can
// never block the kill path.
//=========================================================================
chal_ai_killed local.victim local.killer:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( local.killer == NULL || local.killer.classname != "Player" ){ end }
	if( local.victim == NULL ){ end }
	//[user 07-17] bug-721 (audit): only ENEMY kills advance the kill family. Without this, teamkilling an
	// allied escort/paratrooper bumped total kills, headshots, melee, weapon mastery - every kill challenge.
	if( local.victim.team != "german" ){ end }

	waitthread chal_bump local.killer "kill" 1
	//[user 2026-08-18] theater kill stats for the camo finishes. Map sets, by prefix:
	//US campaign = the whole AA m-series; snow = Norway (m2), Ardennes (m5, t2);
	//North Africa = Arzew (m1) and Kasserine (e1). A map can pay more than one lane
	//(m2 pays both US and snow) - that is intended, they are separate stats.
	if( waitthread coop_mod/main.scr::containsText level.coop_mapname "m" 0 ){
		if( level.coop_aaMap == 1 ){ waitthread chal_bump local.killer "kill_us" 1 }
	}
	if( (waitthread coop_mod/main.scr::containsText level.coop_mapname "m2" 1) || (waitthread coop_mod/main.scr::containsText level.coop_mapname "m5" 1) || (waitthread coop_mod/main.scr::containsText level.coop_mapname "t2" 1) ){ waitthread chal_bump local.killer "kill_snow" 1 }
	if( (waitthread coop_mod/main.scr::containsText level.coop_mapname "m1" 1) || (waitthread coop_mod/main.scr::containsText level.coop_mapname "e1" 1) ){ waitthread chal_bump local.killer "kill_desert" 1 }

	//[user 2026-08-04] bug-1346 - AXIS FACTION tracking, classified from the victim model
	local.fac = waitthread chal_factionOf local.victim.model
	if( local.fac != "" ){
		waitthread chal_bump local.killer local.fac 1
		//[user 2026-08-14] DISTINCT-FACTION counter, latched per faction per player, so it counts
		//how many different Axis units you have fought rather than how many men you have killed.
		//This replaces the two Fallschirmjaeger challenges, which counted a unit that has no model
		//anywhere in the trilogy and so could never be earned by anyone. Reusing the kill hook that
		//is already classifying the victim costs one flag lookup and needs no new plumbing.
		if( local.killer.flags[ "coop_chalFac_" + local.fac ] != 1 ){
			local.killer.flags[ "coop_chalFac_" + local.fac ] = 1
			waitthread chal_bump local.killer "fac_variety" 1
		}
		//[user 2026-08-14] COMBINED ITALIAN counter. Replaces the two Bersaglieri challenges: the
		//trilogy ships no Bersaglieri model, so they were mapped onto the Italian paratrooper - which
		//is never placed on any map, making both unearnable by anyone. Rather than invent placements
		//for a unit the games do not have, the pair now counts Italians of ANY unit, which is the
		//same theme and is backed by 173 real actors (150 Regio Esercito + 23 militia volunteers).
		if( local.fac == "fac_regio" || local.fac == "fac_carab" ){
			waitthread chal_bump local.killer "fac_italy" 1
		}
	}

	// weapon mastery
	local.wid = waitthread chal_weaponId local.killer
	if( local.wid != "" ){ waitthread chal_bump local.killer ( "wpn_" + local.wid ) 1 }

	// [user 07-11] per-level playstyle tracking (Pistol Pete / Stalingrad Rifle-Only). A kill with anything
	// outside the class fails that feat for the rest of the level; chal_mission_complete checks the flags.
	waitthread chal_lvl_touch local.killer
	local.killer.coop_chalL_kills = local.killer.coop_chalL_kills + 1
	if( level.coop_chal_isPistol[local.wid] != 1 ){ local.killer.coop_chalL_usedNonPistol = 1 }
	if( level.coop_chal_isBolt[local.wid] != 1 ){ local.killer.coop_chalL_usedNonBolt = 1 }

	// campaign feat "Sniper's Last Stand": sniper-rifle kills on Sniper Town (m5l1a)
	if( level.coop_mapname == "m5l1a" && ( local.wid == "springfield" || local.wid == "kar98sniper" ) ){
		waitthread chal_bump local.killer "cc_snipers_alley" 1
	}

	// discovery feat "Look, I Washed For Supper" (m3l1b). The five are tagged by the map script.
	// Reaching here at all means a player did it, so the "no despawn kills" rule needs no check.
	// Awarded to everyone connected - it is a team race against their 2s self-remove.
	if( local.victim.coop_washedTag != NIL && local.victim.coop_washedTag == 1 ){
		local.victim.coop_washedTag = 0
		level.coop_washed_kills = level.coop_washed_kills + 1
		if( level.coop_washed_kills >= 5 ){
			local.wi = 1
			while( local.wi <= $player.size ){
				local.wp = $player[local.wi]
				if( local.wp != NULL ){ waitthread chal_bump local.wp "cc_washed_supper" 1 }
				local.wi = local.wi + 1
			}
		}
	}

	// pain-fact classification (mirrors xp.scr)
	if( local.victim.fact != NIL && local.victim.fact != NULL ){
		if( local.victim.fact.location != NIL && local.victim.fact.location >= 0 && local.victim.fact.location <= 2 ){
			waitthread chal_bump local.killer "headshot" 1
		}
		local.mod = local.victim.fact.meansofdeath
		if( local.mod == 26 ){ waitthread chal_bump local.killer "melee" 1 }			// MOD_BASH
		if( local.mod == 14 ){ waitthread chal_bump local.killer "grenade" 1 }		// MOD_GRENADE
		if( local.mod == 16 ){ waitthread chal_bump local.killer "rocket" 1 }			// MOD_ROCKET
		if( local.victim.fact.enemyAtPain != NIL && local.victim.fact.enemyAtPain != NULL ){
			if( local.victim.fact.enemyAtPain != local.killer && local.victim.fact.enemyAtPain.classname == "Player" ){
				waitthread chal_bump local.killer "savior" 1
			}
		}
	}

	// "Scripted Havoc": kill 2+ enemies with a single exploding barrel. The engine (barrels.cpp)
	// attributes the barrel's RadiusDamage to the player that shot it, so victims that die from a
	// BarrelObject inflictor with MOD_EXPLOSION (9) share this killer within the same blast. Count
	// barrel kills per killer inside a ~1.0s window; pay out once when the second kill lands.
	if( local.victim.fact != NIL && local.victim.fact != NULL ){
		if( local.victim.fact.meansofdeath == 9 && local.victim.fact.inflictor != NIL && local.victim.fact.inflictor != NULL && local.victim.fact.inflictor.classname == "BarrelObject" ){
			//[user 07-17] key on the SPECIFIC barrel (inflictor entity): a NEW blast starts the count on
			// a different barrel or after the window, so "2 kills from ONE barrel" can't be faked with two
			// separate barrels fired within 1s (bug-714). All victims of one blast share the inflictor + frame.
			if( local.killer.coop_barrelBurstT == NIL || (level.time - local.killer.coop_barrelBurstT) > 1.0 || local.killer.coop_barrelBurstInf != local.victim.fact.inflictor ){
				local.killer.coop_barrelBurstT    = level.time
				local.killer.coop_barrelBurstInf  = local.victim.fact.inflictor
				local.killer.coop_barrelBurstN    = 1
				local.killer.coop_barrelBurstPaid = 0
			} else {
				local.killer.coop_barrelBurstN = local.killer.coop_barrelBurstN + 1
			}
			if( local.killer.coop_barrelBurstN >= 2 && local.killer.coop_barrelBurstPaid != 1 ){
				local.killer.coop_barrelBurstPaid = 1
				waitthread chal_bump local.killer "scripted_havoc" 1
			}
		}
	}

	if( local.victim.coop_wallbang == 1 ){ waitthread chal_bump local.killer "wallbang" 1 }
	if( vector_length( local.killer.origin - local.victim.origin ) > 2000 ){ waitthread chal_bump local.killer "longshot" 1 }
	//[user 2026-08-08] blindfire OR cover kill, never both - the SAME precedence xp.scr:642 uses, so
	//the challenge stat and the XP award can never disagree about which one a kill was. Before this,
	//xp.scr computed isCoverKill and paid for it while chal_ai_killed had no cover stat at all.
	if( local.killer.coop_bf_t != NIL && (level.time - local.killer.coop_bf_t) < 0.75 ){ waitthread chal_bump local.killer "blindfire" 1 }
	else {
		local.inCov = 0
		//coop_incover: 0 none / 1 requested-no-pose / 2 back-to-wall / 3 crouched low cover. Only the
		//real poses (2,3) count - the same >= 2 test bug-fixed in xp.scr on 08-07.
		if( local.killer.coop_incover >= 2 ){ local.inCov = 1 }
		else { local.inCov = waitthread coop_mod/xp.scr::xp_nearDeployedCover local.killer }
		if( local.inCov == 1 ){
			waitthread chal_bump local.killer "coverkill" 1
			if( waitthread chal_nearOwnCover local.killer ){ waitthread chal_bump local.killer "coverown" 1 }
		}
	}
	//[user 2026-08-08] "Mit den Fischen schlafen": ANY player kill on m2l2b before the charges go
	//loses it. level.playerisnotinsub looked like the right boundary but it is set only inside an
	//`if(level.gametype == 0)` block (m2l2b.scr:612), so it never becomes 1 in coop - the
	//explosion is the only reliable divider, and the whole map up to it IS the infiltration.
	if( level.coop_mapname == "m2l2b" && level.coop_m2l2b_blown != 1 ){ level.coop_m2l2b_handKill = 1 }
	if( local.victim.coop_xpClass == "reinf" ){ waitthread chal_bump local.killer "reinf" 1 }
	if( local.killer.flags["coop_dbno_active"] == 1 ){ waitthread chal_bump local.killer "downedkill" 1 }
}end


//=========================================================================
// [user 2026-08-08] "Dug In": within 96 units of a sandbag THIS player deployed. Same radius and
// registry walk as xp.scr::xp_nearDeployedCover, but filtered on level.coop_cover_owner (added to
// cover.scr in the same batch). Entity comparison, not entnum, so a reconnected client with a
// recycled slot cannot inherit someone else's sandbags.
//=========================================================================
chal_nearOwnCover local.player:{
	local.r = 0
	if( local.player == NULL ){ end local.r }
	if( level.coop_cover_count == NIL ){ end local.r }
	local.i = 1
	while( local.i <= level.coop_cover_count ){
		local.vis = level.coop_cover_visual[local.i]
		local.own = level.coop_cover_owner[local.i]
		if( local.vis != NIL && local.vis != NULL && local.own != NIL && local.own == local.player ){
			if( vector_length( local.player.origin - local.vis.origin ) < 96 ){ local.r = 1; end local.r }
		}
		local.i++
	}
	end local.r
}end


//=========================================================================
// [user 2026-08-08] "Ring of Steel": every active player standing in deployed cover at the moment
// the officer calls reinforcements in. Threaded from officer.scr::coop_call_reinforcements, past
// its cooldown guard, so a refused (still-cooling-down) call cannot trigger it.
// Needs 2+ players - a solo player in one sandbag is not a ring - and at least one placed piece.
//=========================================================================
chal_ring_of_steel:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( level.coop_cover_count == NIL || level.coop_cover_count < 1 ){ end }
	if( $player.size < 2 ){ end }
	local.i = 1
	while( local.i <= $player.size ){
		local.p = $player[local.i]
		if( local.p == NULL || local.p.flags["coop_isActive"] != 1 ){ end }
		if( !isAlive local.p ){ end }
		if( !( waitthread coop_mod/xp.scr::xp_nearDeployedCover local.p ) ){ end }
		local.i++
	}
	waitthread chal_team_bump "cc_ring_steel" 1
}end


//=========================================================================
// HOOK: Officer killed. Threaded from officer.scr::coop_officer_death_monitor.
//=========================================================================
chal_officer_killed local.officer:{
	if( level.coop_chal_enabled != 1 ){ end }
	local.killer = NULL
	if( local.officer != NULL && local.officer.fact != NIL && local.officer.fact != NULL ){
		if( local.officer.fact.attacker != NULL && local.officer.fact.attacker.classname == "Player" ){
			local.killer = local.officer.fact.attacker
		}
	}
	if( local.killer == NULL ){ end }
	waitthread chal_bump local.killer "officer" 1

	// [user 07-11] Hell Let Loose: the officer wave (officer + bodyguards + battalion) is broken when the
	// officer finally dies, which happens after his escort/reinforcements. Award every player who has not
	// gone down this map (cc_award_clean tests coop_wentDownMap per player).
	waitthread cc_award_clean "cc_hell_let_loose"
}end


//=========================================================================
// HOOK: support call. Threaded from officer.scr (airstrike) + paradrop.scr (reinforce).
//=========================================================================
chal_support_call local.player local.kind:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( local.player == NULL ){ end }
	if( local.kind == "airstrike" ){ waitthread chal_bump local.player "airstrike" 1 }
	else if( local.kind == "reinforce" ){ waitthread chal_bump local.player "reinforce" 1 }
}end


//=========================================================================
// HOOK: primary objective completed. Threaded from global/objectives.scr.
// Skips the coop side-objective push (it pays via chal_radio_done) using the
// same guard xp uses; one-shot per objective index per map.
//=========================================================================
chal_primary_done local.index:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( level.coop_xp_sideObjPush == 1 ){ end }
	if( local.index == NIL ){ local.index = 0 }
	if( level.coop_chal_objPaid[local.index] == 1 ){ end }
	level.coop_chal_objPaid[local.index] = 1
	waitthread chal_team_bump "objective" 1

	// campaign feats keyed on (map, objective index). Central + parse-safe: every AA-style
	// objective completion routes through here, so most feats need NO map-script edit.
	waitthread cc_objFeat level.coop_mapname local.index
}end


//=========================================================================
// Campaign-feat dispatch: award a feat when a specific objective completes on a
// specific map. Keyed "map:index". No-down feats go through cc_award_clean; timed
// / stealth feats add a guard. Indices verified against each map's add_objectives.
// Maps whose objectives do NOT route through global/objectives.scr (SH/BT t*/e*
// maps, the Omaha beach maps) are handled by their own map hooks, not here.
//=========================================================================
cc_objFeat local.map local.index:{
	if( level.coop_chal_enabled != 1 ){ end }
	local.k = local.map + ":" + local.index
	// --- Omaha / D-Day ---
	if( local.k == "m3l1a:4" ){ waitthread cc_award_clean "cc_finest_hour" }			// bangalores, nobody down
	else if( local.k == "m3l1a:2" ){
		if( level.time - level.coop_mapStartTime < 90 ){ waitthread chal_team_bump "cc_longest_day" 1 }	// reach shingle < 90s
		//[user 2026-08-08] "Four Abreast": the seawall reached with a FULL four-player squad, all
		//alive. Same objective as Across Dog Green, different bar - that one is a stopwatch, this one
		//is a headcount. Gated on size == 4 so a smaller server cannot earn it by default.
		if( $player.size == 4 ){
			local.alive4 = 1
			local.fi = 1
			while( local.fi <= 4 ){
				if( $player[local.fi] == NULL ){ local.alive4 = 0 }
				else if( !isAlive $player[local.fi] ){ local.alive4 = 0 }
				local.fi++
			}
			if( local.alive4 == 1 ){ waitthread chal_team_bump "cc_four_abreast" 1 }
		}
	}
	else if( local.k == "m3l1b:3" ){ waitthread chal_team_bump "cc_pointe_du_hoc" 1 }	// all gun emplacements
	else if( local.k == "m3l2:1" ){ waitthread cc_award_clean "cc_rangers_house" }		// clear house, nobody down
	else if( local.k == "m3l2:6" ){ waitthread chal_team_bump "cc_rangers_flak" 1 }		// flak 88s airstrike
	// --- Mission 1 ---
	else if( local.k == "m1l1:4" ){ waitthread cc_award_clean "cc_torch" }				// hold reinforcements, nobody down
	else if( local.k == "m1l3c:1" ){ waitthread chal_team_bump "cc_lights_out" 1 }
	else if( local.k == "m1l3c:3" ){ waitthread chal_team_bump "cc_signal_fleet" 1 }
	else if( local.k == "m1l2a:6" ){ waitthread chal_team_bump "cc_the_rescue" 1 }
	// --- Mission 2 ---
	else if( local.k == "m2l1:2" ){ waitthread chal_team_bump "cc_special_cargo" 1 ; waitthread chal_team_bump "cc_secret_service" 1 ; waitthread chal_team_bump "cc_gamespy" 1 }
	else if( local.k == "m2l2a:2" ){ waitthread chal_team_bump "cc_naxos" 1 }
	else if( local.k == "m2l2a:3" ){ waitthread chal_team_bump "cc_das_boot_stealth" 1 }	// reach 2nd U-boat (disguise/stealth level)
	else if( local.k == "m2l3:2" ){
		waitthread cc_award_clean "cc_end_of_line"		// train station, whole squad up
		//[user 2026-08-14] BOTH feats hang off this one objective and must co-fire - a second
		//else-if on the same key could never be reached. cc_end_of_line is a nobody-went-down
		//test, obj_ghost_ductwork an alarm test; they are independent and either, both or
		//neither can be true on a given run.
		waitthread chal_quiet_feat "obj_ghost_ductwork"
	}
	// --- Mission 4 ---
	else if( local.k == "m4l1:2" ){ waitthread chal_team_bump "cc_rough_landing" 1 }
	// --- Mission 5 ---
	//[user 2026-08-08] cc_king_tiger's own description is "Steal the King Tiger with the tank crew
	//still alive", but this bumped on objective 4 unconditionally - the crew was never checked, so it
	//paid out even after you lost them. m5l1b:786 sets flags[tankcrewdead] when level.engineers drops
	//below 2, which is the map's own "you lost too many of your tank crew" fail state.
	else if( local.k == "m5l1b:4" ){ if( level.flags[tankcrewdead] != 1 ){ waitthread chal_team_bump "cc_king_tiger" 1 } }
	else if( local.k == "m5l3:4" ){ waitthread chal_team_bump "cc_the_bridge" 1 }
	// --- Mission 6 ---
	else if( local.k == "m6l1a:1" ){ waitthread chal_team_bump "cc_nordwind" 1 }
	else if( local.k == "m6l2a:1" ){ if( level.alarmactive != 1 ){ waitthread chal_team_bump "cc_under_radar" 1 } }	// wire post undetected
	else if( local.k == "m6l1c:2" ){ waitthread chal_team_bump "cc_welded_steel" 1 }	// [batch 2] StG44 blueprints acquired
	else if( local.k == "m6l1c:3" ){ waitthread chal_team_bump "cc_first_of_kind" 1 }	// [batch 3] StG44 stolen (First of Its Kind)
	//[user 2026-08-14] ALARM-GATED FEATS, wired via chal_quiet_feat so they pay only if the alarm
	//was never raised at any point - not merely quiet at the moment the objective ticks. Indices
	//read from each map's own add_objectives calls rather than assumed:
	//  m6l1c:4 "Destroy the weapons stockpile" is the LAST of the three the challenge names
	//          (2 blueprints, 3 the StG44, 4 the stockpile), so it is the completion point.
	//  m2l3:2  "Meet up with allies at train station" - the train station the feat asks for.
	//  m4l2:1  "Infiltrate the tank park" - reaching the tank park.
	//[user 2026-08-14] Two nobody-went-down feats, both via cc_award_clean like their neighbours.
	//  m3l1a:8 "Infiltrate the bunker" is the bunker at the TOP of Omaha, strictly later than
	//          m3l1a:4 (the bangalores) which cc_finest_hour already uses - so the two measure
	//          different stretches of the same landing and can both be true.
	//  m3l2:3  "Defend the front of the house" - the house is only held once BOTH doors are, and
	//          the front is objective 3 of 3 (1 search, 2 back, 3 front), so this is that moment.
	//[user 2026-08-14] Two more, on objectives whose indices are known from each map's own
	//add_objectives calls. e3l3:2 is "Destroy the Munitions Convoy"; t3l2:3 is "Defend the Bridge
	//Until Air Support Arrives" - the last bridge the feat names.
	else if( local.k == "e3l3:2" ){ waitthread chal_quiet_feat "obj_nothing_gets_through" }
	else if( local.k == "t3l2:3" ){ waitthread cc_award_clean "obj_running_on_fumes" }
	else if( local.k == "m3l1a:8" ){ waitthread cc_award_clean "obj_dog_green_present" }
	else if( local.k == "m3l2:3" ){ waitthread cc_award_clean "obj_both_doors" }
	else if( local.k == "m6l1c:4" ){ waitthread chal_quiet_feat "obj_no_bells_nordwind" }
	else if( local.k == "m4l2:1" ){ waitthread chal_quiet_feat "obj_rode_it_in" }
	else if( local.k == "m6l3d:2" ){ waitthread chal_team_bump "cc_gas_gas_gas" 1 }
	// --- Spearhead ---
	else if( local.k == "t1l2:1" ){ waitthread chal_team_bump "cc_nijmegen" 1 }			// both Flak 88s destroyed
	else if( local.k == "t2l2:1" ){ waitthread chal_team_bump "cc_convoy" 1 }
	else if( local.k == "t2l3:6" ){ waitthread cc_award_clean "cc_nuts" }				// Bastogne waves, nobody down
	else if( local.k == "t3l1:7" ){ waitthread chal_team_bump "cc_berlin_safe" 1 }
}end


//=========================================================================
// HOOK: radio side objective destroyed. Threaded from coop_mod/objectives.scr.
//=========================================================================
chal_radio_done:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( level.coop_chal_radioPaid == 1 ){ end }
	level.coop_chal_radioPaid = 1
	waitthread chal_team_bump "sideobj" 1
}end


//=========================================================================
// HOOK: teammate revived a downed player. Threaded from dbno.scr.
//=========================================================================
chal_revive local.reviver:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( local.reviver == NULL ){ end }
	waitthread chal_bump local.reviver "revive" 1

	// [user 07-11] Freeze-Tag Only: three revives in a single level (per-level count, resets each map)
	waitthread chal_lvl_touch local.reviver
	local.reviver.coop_chalL_revives = local.reviver.coop_chalL_revives + 1
	if( local.reviver.coop_chalL_revives == 3 ){ waitthread chal_bump local.reviver "cc_freeze_tag" 1 }

	//[user 2026-08-08] "Simultaneous Salvation": two DIFFERENT revivers inside a 10s window. Keyed on
	//the reviver rather than the level counter so one player picking up two people in quick
	//succession does not earn it - the feat is coordination, not speed. Both players get it.
	if( level.coop_chal_lastRevT != NIL && level.coop_chal_lastRev != NULL ){
		if( level.coop_chal_lastRev != local.reviver && (level.time - level.coop_chal_lastRevT) < 10 ){
			waitthread chal_bump local.reviver "cc_simul_salv" 1
			waitthread chal_bump level.coop_chal_lastRev "cc_simul_salv" 1
		}
	}
	level.coop_chal_lastRev  = local.reviver
	level.coop_chal_lastRevT = level.time
}end


//=========================================================================
// [user 2026-08-08] "Field Promotion": revive the SAME teammate three times in one mission.
// Threaded from dbno.scr alongside chal_revive, which does not know who was picked up. Per-map
// per-(reviver,target) tally, keyed on the target's entnum and stamped with the map name so it
// cannot carry across a map change on a persistent player entity.
//=========================================================================
chal_revive_target local.reviver local.target:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( local.reviver == NULL || local.target == NULL ){ end }
	if( local.reviver == local.target ){ end }
	if( local.reviver.coop_chalRT_map != level.coop_mapname ){
		local.reviver.coop_chalRT_map = level.coop_mapname
		local.reviver.coop_chalRT     = NIL
	}
	local.k = local.target.entnum
	if( local.reviver.coop_chalRT[local.k] == NIL ){ local.reviver.coop_chalRT[local.k] = 0 }
	local.reviver.coop_chalRT[local.k] = local.reviver.coop_chalRT[local.k] + 1
	if( local.reviver.coop_chalRT[local.k] == 3 ){ waitthread chal_bump local.reviver "cc_field_promo" 1 }
}end


//=========================================================================
// HOOK: a PLAYER destroyed a drivable vehicle (tank/halftrack/armored car). Threaded from
// coop_vehKill_monitor (which consumes the engine's per-map level.coop_vehKills counter set
// in DrivableVehicle::Killed). Team-wide "vehicle" stat.
//=========================================================================
chal_vehicle_killed:{
	if( level.coop_chal_enabled != 1 ){ end }
	waitthread chal_team_bump "vehicle" 1
}end


//=========================================================================
// HOOK: an officer was blown up by his OWN reinforcements. Threaded from
// officer.scr::coop_officer_death_monitor when the officer's death fact is an explosive
// kill by a non-player AI. Team-wide (funny) one-shot.
//=========================================================================
chal_mein_kampf:{
	if( level.coop_chal_enabled != 1 ){ end }
	waitthread chal_team_bump "cc_mein_kampf" 1
}end


//=========================================================================
// Per-map monitor: the engine bumps level.coop_vehKills each time a player destroys a drivable
// vehicle; award each increment once (challenge + XP). Started from chal_init (runs per map).
//=========================================================================
coop_vehKill_monitor:{
	if( level.coop_vehKillMonRun == 1 ){ end }
	level.coop_vehKillMonRun = 1

	//[user 2026-08-04] bug-1371 - MUST assign this before anything reads it, or NO drivable
	//vehicle on any map can ever be destroyed. DrivableVehicle::Killed (fgame/vehicle.cpp:7184)
	//does:  ScriptVariable *pv = level.vars->GetVariable("coop_vehKills");
	//       int n = pv ? pv->intValue() : 0;
	//Merely READING level.coop_vehKills in script (the loop below) CREATES the variable with
	//type 'none'. pv is then non-NULL so the guard passes, and intValue() throws
	//"Cannot cast 'none' to int" - which aborts Killed() before the explosion, the wreck and
	//the remove. The tank sits at negative health with deadflag 2, the coop VEHZOMBIE rescue
	//revives it for the next hit, and the whole cycle repeats: the tank reads as invincible.
	//Assigning 0 here makes it a real int, so intValue() succeeds and the death completes.
	level.coop_vehKills = 0

	local.seen = 0
	while( 1 ){
		waitframe
		local.n = level.coop_vehKills
		if( local.n == NIL ){ local.n = 0 }
		while( local.seen < local.n ){
			local.seen++
			//[user 08-07] the XP award used to go to every active player regardless of who dealt
			//the kill - now attributed to the specific attacker. entnum comes from
			//DrivableVehicle::Killed (vehicle.cpp); resolve it back to a player entity here since
			//C++ only has an int to hand off, not a script entity reference.
			local.killerNum = level.coop_vehKillerNum
			local.killer = NULL
			if( local.killerNum != NIL ){
				local.i = 1
				while( local.i <= $player.size ){
					if( $player[local.i] != NULL && $player[local.i].entnum == local.killerNum ){
						local.killer = $player[local.i]
						break
					}
					local.i++
				}
			}
			waitthread chal_vehicle_killed
			thread coop_mod/xp.scr::xp_vehicle_killed local.killer
		}
	}
}end


//=========================================================================
// [batch 3] Day of the Tiger: on m5l3 (The Bridge) the player defends in a captured King Tiger ($playertank).
// coop_chal_tigerOk starts 1 and is cleared the moment the tank drops below 85% of its effective health
// (or is destroyed); chal_mission_complete awards cc_tiger_defense if it's still 1 at the end. Effective
// health = playertank.health - level.healthoffset (both set in maps/m5l3.scr; guarded until they exist).
//=========================================================================
chal_m5l3_tank_watch:{
	if( level.coop_chal_enabled != 1 ){ end }
	level.coop_chal_tigerOk = 1
	local.tank = $playertank
	if( local.tank == NULL ){ end }
	while( local.tank != NULL ){
		if( !isAlive local.tank ){
			level.coop_chal_tigerOk = 0
			end
		}
		if( level.tankhealthmax != NIL && level.healthoffset != NIL ){
			local.maxEff = level.tankhealthmax - level.healthoffset
			if( local.maxEff > 0 ){
				local.frac = ( local.tank.health - level.healthoffset ) / local.maxEff
				if( local.frac < 0.85 ){ level.coop_chal_tigerOk = 0 }
			}
		}
		wait 1
	}
}end


//=========================================================================
// QUARTER-PROGRESS POPUP: a small HD bar on the LEFT edge with the challenge title + N/T,
// shown when a PINNED counter challenge crosses 25/50/75% (100% is the CHALLENGE COMPLETE
// toast). Per-player, gated by cvar coop_chalPopup AND chal_pin_isPinned (08-07: was every
// counter challenge, restricted to pins only so simultaneous weapon-kill counters can't
// compete for the same slot). Draws once on slots 84-87 then a single fader (coop_chalPopRun
// guard) handles the timed fade; a new milestone overwrites + resets the timer.
//=========================================================================
chal_progress_popup local.player local.title local.p local.tgt:{
	if( local.player == NULL ){ end }
	if( getcvar "coop_chalPopup" == "0" ){ end }

	local.w = 150
	// [user 07-18 bug-805] fill spans the plate GROOVE, not the whole plate: the old fill (x22 w<=150 h8)
	// started 6px LEFT of the channel (painted the frame bevel every showing), could overrun the plate's
	// right edge (22+150=172 > 168) and overshot the channel bottom. Groove on a 150x14 plate = the
	// debrief-approved fractions (x-inset 16/216 -> 11, width 194/216 -> 134, y+4 h6): x29 y213 w<=134 h6.
	local.fw = 134
	if( local.tgt > 0 ){ local.fw = int( 134 * local.p / local.tgt ) }
	if( local.fw < 2 ){ local.fw = 2 }
	if( local.fw > 134 ){ local.fw = 134 }

	//[2026-09-25, bug-2906] claim on show, re-send the hide (coop_mod/hudresend.scr, TRAPS T8)
	waitthread coop_mod/hudresend.scr::claim local.player 84 87
	// HD track = the rank-up bar's beveled brass-on-steel plate
	ihuddraw_shader      local.player 84 "textures/hud/xpbar/xpbar_base"
	ihuddraw_virtualsize local.player 84 1
	ihuddraw_align       local.player 84 left top
	ihuddraw_rect        local.player 84 18 209 local.w 14
	ihuddraw_color       local.player 84 1 1 1
	ihuddraw_alpha       local.player 84 0.95

	// glossy brass fill (same xpbar_fill as the rank-up bar), inset in the plate
	ihuddraw_shader      local.player 85 "textures/hud/xpbar/xpbar_fill"
	ihuddraw_virtualsize local.player 85 1
	ihuddraw_align       local.player 85 left top
	ihuddraw_rect        local.player 85 29 213 local.fw 6
	ihuddraw_color       local.player 85 0.98 0.85 0.5
	ihuddraw_alpha       local.player 85 1

	// title
	ihuddraw_virtualsize local.player 86 1
	ihuddraw_align       local.player 86 left top
	ihuddraw_font        local.player 86 "verdana-12"
	ihuddraw_color       local.player 86 1 0.90 0.60
	ihuddraw_rect        local.player 86 18 195 0 0
	ihuddraw_string      local.player 86 local.title
	ihuddraw_alpha       local.player 86 1

	// count N/T
	ihuddraw_virtualsize local.player 87 1
	ihuddraw_align       local.player 87 left top
	ihuddraw_font        local.player 87 "verdana-12"
	ihuddraw_color       local.player 87 0.85 0.87 0.95
	ihuddraw_rect        local.player 87 174 209 0 0
	ihuddraw_string      local.player 87 ( local.p + "/" + local.tgt )
	ihuddraw_alpha       local.player 87 1

	local.player playsound coop_ui_click
	local.player.coop_chalPopUntil = level.time + 3.5
	thread chal_progress_fade local.player
}end

chal_progress_fade local.player:{
	if( local.player == NULL ){ end }
	if( local.player.coop_chalPopRun == 1 ){ end }
	local.player.coop_chalPopRun = 1
	while( local.player != NULL && level.time < local.player.coop_chalPopUntil ){ wait 0.2 }
	local.a = 10
	while( local.a > 0 && local.player != NULL ){
		local.f = local.a * 0.1
		ihuddraw_alpha local.player 84 ( local.f * 0.85 )
		ihuddraw_alpha local.player 85 local.f
		ihuddraw_alpha local.player 86 local.f
		ihuddraw_alpha local.player 87 local.f
		local.a--
		wait 0.05
	}
	if( local.player != NULL ){
		ihuddraw_alpha local.player 84 0
		ihuddraw_alpha local.player 85 0
		ihuddraw_alpha local.player 86 0
		ihuddraw_alpha local.player 87 0
		local.player.coop_chalPopRun = NIL
		thread coop_mod/hudresend.scr::resend local.player 84 87 0
	}
}end


//=========================================================================
// HOOK: mission complete. Threaded from missioncomplete.scr::main (before the
// XP debrief, so it runs during the debrief's blocking waits and persists
// before the level transition wipes state). Awards per-map + total-missions
// (chapter/campaign) challenges to every active player.
//=========================================================================
chal_mission_complete local.mapname:{
	if( level.coop_chal_enabled != 1 ){ end }
	//[user 07-17] bug-722 (audit): BRIEFINGS + LOBBIES are not missions. briefing1-6 route through
	// missioncomplete passing the NEXT map's name (e.g. "m1l1"), so watching a briefing bumped
	// "missions" and paid map_<next> before the mission was even played. Gate on the REAL current map.
	if( waitthread coop_mod/main.scr::containsText level.coop_mapname "briefing" 0 ){ end }
	if( level.coop_lobbyMap == 1 ){ end }
	if( waitthread coop_mod/main.scr::containsText level.coop_mapname "co_lobby" 0 ){ end }
	if( level.coop_chal_missionPaid == 1 ){ end }
	level.coop_chal_missionPaid = 1
	if( local.mapname == NIL || local.mapname == "" ){ local.mapname = level.coop_mapname }
	if( local.mapname != NIL && local.mapname != "" ){
		waitthread chal_team_bump ( "map_" + local.mapname ) 1
	}
	waitthread chal_team_bump "missions" 1

	//[user 2026-08-18] CHROME finish: per-player deathless mission. coop_wentDownMap is
	//stamped with the map name by player.scr on death AND dbno.scr on going down - the same
	//source the no-down feat below trusts - so surviving upright end-to-end is exactly
	//"its stamp is not this map".
	local.pi = 1
	while( local.pi <= $player.size ){
		local.p = $player[local.pi]
		if( local.p != NULL && local.p.flags["coop_isActive"] == 1 && local.p.coop_wentDownMap != level.coop_mapname ){
			waitthread chal_bump local.p "nodeath" 1
		}
		local.pi++
	}

	//[user 2026-08-14] "The Quiet Type" - finish a mission without the alarm ever being raised.
	//Counted here because this is the one point that already knows a REAL mission just ended:
	//briefings and lobbies are filtered out above, and coop_chal_missionPaid guards against the
	//same completion paying twice.
	//NOTE ON WORDING: the challenge originally said five DIFFERENT missions, and that is not
	//enforceable here - level.* resets on every map change, so nothing at this point remembers
	//which maps have already paid. Rather than ship a description the code does not honour, the
	//text now says five missions and the code delivers exactly that. Making it truly distinct
	//needs a persisted per-map record, which is a bigger change than this feat is worth.
	if( level.coop_chalAlarmEver != 1 ){
		waitthread chal_team_bump "obj_the_quiet_type" 1
		println( "^~^~^ CHAL quiet mission completed: " + local.mapname )
	}

	// [user 07-11] per-player PLAYSTYLE feats, evaluated once at mission complete. Skip lobby maps. The
	// weapon-only feats need at least one kill (you must actually fight the level with that weapon).
	if( !level.coop_lobbyMap ){
		local.mstart = level.coop_mapStartTime
		if( local.mstart == NIL ){ local.mstart = 0 }
		local.elapsed = level.time - local.mstart
		local.pi = 1
		while( local.pi <= $player.size ){
			local.pp = $player[local.pi]
			if( local.pp != NULL && local.pp.flags["coop_isActive"] == 1 && local.pp.coop_chalL_map == local.mapname ){
				local.downed = 0
				if( local.pp.coop_wentDownMap == local.mapname ){ local.downed = 1 }

				// BreakTheGame.SCR: first completion of each stand.scr map. Keyed per map on the
				// player, so replaying one map 13 times cannot finish it.
				if( waitthread chal_btg_isMap local.mapname ){
					local.bkey = "coop_btg_" + local.mapname
					if( local.pp.flags[local.bkey] != 1 ){
						local.pp.flags[local.bkey] = 1
						waitthread chal_bump local.pp "cc_breakthegame" 1
					}
				}
				// Pistol Pete: every kill this level was with a sidearm (>=1 kill)
				if( local.pp.coop_chalL_kills > 0 && local.pp.coop_chalL_usedNonPistol != 1 ){
					waitthread chal_bump local.pp "cc_pistol_pete" 1
				}
				// Stalingrad Rifle-Only: every kill this level was with a bolt-action rifle (>=1 kill)
				if( local.pp.coop_chalL_kills > 0 && local.pp.coop_chalL_usedNonBolt != 1 ){
					waitthread chal_bump local.pp "cc_stalingrad" 1
				}
				// I've Seen French Schoolgirls Shoot Better: never aimed (ADS/scope/over-shoulder) all level
				if( local.pp.coop_chalL_usedAim != 1 ){
					waitthread chal_bump local.pp "cc_schoolgirls" 1
				}
				// Kings Push: Diverting the Enemy (m4l2) completed in under 5 minutes
				if( local.mapname == "m4l2" && local.elapsed < 300 ){
					waitthread chal_bump local.pp "cc_kings_push" 1
				}
				// Earn This.: the bridge mission (m5l3) beaten with no medkit heal and no down
				if( local.mapname == "m5l3" && local.pp.coop_chalL_healed != 1 && local.downed != 1 ){
					waitthread chal_bump local.pp "cc_earn_this" 1
				}

				//[user 2026-08-14] MISSION-COMPLETE FEATS, replacing conditions that could not be
				//measured. Each of these shipped asking for something nothing in the game tracks -
				//fire damage, repair-barrel touches, a named tank killed by a named weapon, a
				//three-bunker hold state - so all ten sat at 0 forever. Each now reads a signal
				//this block ALREADY computes for every map: elapsed time, whether this player went
				//down, and the per-level weapon-class flags. That means no map-script edits, and
				//nothing new to keep in step. Every one stays on its original mission, and nine of
				//the twelve replacements kept their original name because the measurable version
				//says close enough to what the text already promised.
				//Where a name changed, the original condition was the unmeasurable part:
				//  Not a Blister    -> Ahead of the Flames  (fire damage      -> beat the clock)
				//  Running on Fumes -> Not One Step Back    (barrel touches   -> nobody down)
				//  Crunchy Goodness -> Quiet Professionals  (PIAT tank kill   -> no alarm)
				//  Five Shells      -> Bolt Action Only     (schreck kill     -> weapon purity)
				//  Medic Over       -> House Call           (hidden hard-only branch, a known
				//                                            missioncomplete-void ship blocker)
				//  Look the Gas!    -> Gas Discipline       (a scripted gag moment)
				if( local.downed != 1 ){
					if( local.mapname == "t2l1" ){ waitthread chal_bump local.pp "obj_three_came_back" 1 }
					if( local.mapname == "e1l3" ){ waitthread chal_bump local.pp "obj_every_man_out" 1 }
					if( local.mapname == "e2l3" ){ waitthread chal_bump local.pp "obj_nine_tanks" 1 }
					if( local.mapname == "m5l1b" ){ waitthread chal_bump local.pp "obj_medic_over" 1 }
					if( local.mapname == "m6l3d" ){ waitthread chal_bump local.pp "evt_look_the_gas" 1 }
					if( local.mapname == "e3l4" ){ waitthread chal_bump local.pp "obj_able_baker_charlie" 1 }
				}
				// Ahead of the Flames: out of Fort Schmerzen inside six minutes
				if( local.mapname == "m6l3c" && local.elapsed < 360 ){
					waitthread chal_bump local.pp "obj_unburned" 1
				}
				// Seconds to Spare: clear of the castle inside eight minutes
				if( local.mapname == "e3l4" && local.elapsed < 480 ){
					waitthread chal_bump local.pp "evt_seconds_to_spare" 1
				}
				// Bolt Action Only: every kill on Stavelot with a bolt-action rifle (>=1 kill)
				if( local.mapname == "t2l1" && local.pp.coop_chalL_kills > 0 && local.pp.coop_chalL_usedNonBolt != 1 ){
					waitthread chal_bump local.pp "evt_five_shells" 1
				}
				// Quiet Professionals: the coastal battery taken with the alarm never raised
				if( local.mapname == "e3l1" && level.coop_chalAlarmEver != 1 ){
					waitthread chal_bump local.pp "evt_crunchy_goodness" 1
				}
				//[user 2026-08-14] The last two. Their original text named no mission anywhere - not
				//in the code, not in the proposal document - so rather than guess at the author's
				//intent they were given to maps that had no feat at all (15 still do). Both keep a
				//trackable condition and a distinct one, so they do not just add two more
				//nobody-went-down rows.
				// Turnabout: m4l3 beaten with a sidearm and nothing else (>=1 kill)
				if( local.mapname == "m4l3" && local.pp.coop_chalL_kills > 0 && local.pp.coop_chalL_usedNonPistol != 1 ){
					waitthread chal_bump local.pp "obj_turnabout" 1
				}
				// Top of the Class: the Spearhead opening with nobody going down
				if( local.mapname == "t1l1" && local.downed != 1 ){
					waitthread chal_bump local.pp "evt_back_of_the_class" 1
				}
			}
			local.pi++
		}
	}

	//=====================================================================
	// [user 2026-08-08] picked-batch mission-complete evaluations.
	//=====================================================================
	// "All Present and Correct": four players, all alive, none ever downed this map.
	if( $player.size == 4 ){
		local.apOk = 1
		local.ai = 1
		while( local.ai <= 4 ){
			local.ap = $player[local.ai]
			if( local.ap == NULL ){ local.apOk = 0 }
			else{
				if( !isAlive local.ap ){ local.apOk = 0 }
				if( local.ap.coop_wentDownMap == local.mapname ){ local.apOk = 0 }
			}
			local.ai++
		}
		if( local.apOk == 1 ){ waitthread chal_team_bump "cc_all_present" 1 }
	}

	// "Nobody Bled Out": at least one ally went down AND every one of them was picked back up.
	// The ">= 1 down" guard matters - without it every map with no ally squad at all would award it.
	if( level.coop_allyDownN != NIL && level.coop_allyDownN >= 1 ){
		if( level.coop_allyRevN != NIL && level.coop_allyRevN >= level.coop_allyDownN ){
			waitthread chal_team_bump "cc_nobody_bled" 1
		}
	}

	// "Weathered": one completion per DISTINCT weather theme. Per-player and keyed on the theme name
	// in the player's own flag store - the exact pattern cc_breakthegame uses to key per map above.
	// It cannot be a chal_team_bump: that label just fans out to chal_bump and keeps no team state,
	// so a level-scoped "already counted" marker would reset on the next map and the same theme would
	// pay out over and over.
	if( level.coop_weatherTheme != NIL && level.coop_weatherTheme != "" ){
		local.wkey = "coop_chalW_" + level.coop_weatherTheme
		local.wi = 1
		while( local.wi <= $player.size ){
			local.wp = $player[local.wi]
			if( local.wp != NULL && local.wp.flags["coop_isActive"] == 1 && local.wp.flags[local.wkey] != 1 ){
				local.wp.flags[local.wkey] = 1
				waitthread chal_bump local.wp "cc_weathered" 1
			}
			local.wi++
		}
	}

	// "Matching Set": the whole squad in the same helmet. Evaluated at mission complete rather than at
	// spawn - at map start the helmet system has not necessarily applied everyone's choice yet, and
	// "we all finished in the same lid" is the same joke without the race condition. Needs 2+ players:
	// a solo player trivially matches themselves.
	if( $player.size >= 2 ){
		local.hRef = NIL
		local.hOk  = 1
		local.hi = 1
		while( local.hi <= $player.size ){
			local.hp = $player[local.hi]
			if( local.hp == NULL || local.hp.flags["coop_isActive"] != 1 ){ local.hOk = 0 }
			else{
				local.hIdx = local.hp.flags["coop_helmetIdx"]
				if( local.hIdx == NIL ){ local.hOk = 0 }
				else if( local.hRef == NIL ){ local.hRef = local.hIdx }
				else if( local.hRef != local.hIdx ){ local.hOk = 0 }
			}
			local.hi++
		}
		if( local.hOk == 1 && local.hRef != NIL ){ waitthread chal_team_bump "cc_matching_set" 1 }
	}

	// t2l3 Bastogne: coop_line_breached (t2l3.scr:3425) accumulates level.coop_leaks - infantry
	// weight 1, vehicles 99. NIL means the map ran and nothing ever got through.
	if( local.mapname == "t2l3" ){
		local.leaks = level.coop_leaks
		if( local.leaks == NIL ){ local.leaks = 0 }
		if( local.leaks == 0 ){
			waitthread chal_team_bump "cc_not_one_yard" 1
			// tier two: no breach AND the allied squad intact
			if( level.coop_allyDownN == NIL || level.coop_allyRevN >= level.coop_allyDownN ){
				waitthread chal_team_bump "cc_held_line" 1
			}
		}
	}

	// "Eyes Open": Sniper Town cleared with the aim camera never used. Reuses coop_chalL_usedAim,
	// the same per-level flag cc_schoolgirls reads - this is that feat scoped to the scope level.
	if( local.mapname == "m5l1a" ){
		local.ei = 1
		while( local.ei <= $player.size ){
			local.ep = $player[local.ei]
			if( local.ep != NULL && local.ep.flags["coop_isActive"] == 1 && local.ep.coop_chalL_map == local.mapname ){
				if( local.ep.coop_chalL_usedAim != 1 ){ waitthread chal_bump local.ep "cc_eyes_open" 1 }
			}
			local.ei++
		}
	}

	// "The Long Way": the bocage house (m3l2 - $scene4_mg42, whose retail objective text literally
	// read "use the mounted machine gun") held without anyone mounting it. level.coop_m3l2_mgUsed is
	// stamped by the map's own turret hook.
	if( local.mapname == "m3l2" && level.coop_m3l2_mgUsed != 1 ){ waitthread chal_team_bump "cc_long_way" 1 }

	// "Crew Intact to City Hall": reached city hall with the crew still up. Distinct from
	// cc_king_tiger, which is the later objective-4 theft.
	if( local.mapname == "m5l1b" && level.flags[cityhall] == 1 && level.flags[tankcrewdead] != 1 ){
		waitthread chal_team_bump "cc_crew_cityhall" 1
	}

	//=====================================================================
	// [user 2026-08-08] bug-1596 group A: challenges that shipped in v1.2.1 with a definition and no
	// producer. These are the survival/end-state half - the event-driven ones are hooked in their own
	// map scripts. See docs/proposals/orphan_challenge_triage.md for the anchor behind each.
	//=====================================================================
	// "The Whole Section" - m1l1's four riflemen all route their death through one deathmessage
	// label, so a single flag there covers Richards, Wilson, Thomas and Allen.
	if( local.mapname == "m1l1" && level.coop_m1l1_sectionLost != 1 ){
		waitthread chal_team_bump "obj_whole_section" 1
	}

	// "Both Boys Home" - t1l2's two riflemen. They spawn nodamage and the map's own gags restore
	// takedamage, so this is a real survival check rather than a formality.
	if( local.mapname == "t1l2" ){
		local.b1 = 0
		local.b2 = 0
		if( level.friendly1 != NULL && level.friendly1 != NIL && isAlive level.friendly1 ){ local.b1 = 1 }
		if( level.friendly2 != NULL && level.friendly2 != NIL && isAlive level.friendly2 ){ local.b2 = 1 }
		if( local.b1 == 1 && local.b2 == 1 ){ waitthread chal_team_bump "obj_both_boys_home" 1 }
	}

	// "All Six Home" - Crete. $leroy carries the targetname "hudson" (e2l1.scr:184); the other five
	// are their own entities. NIL and NULL both have to be guarded: isalive on a NULL throws, and a
	// thrown statement is SKIPPED, which would silently delete the guard itself.
	if( local.mapname == "e2l1" ){
		local.six = 1
		if( $leroy == NULL || $leroy == NIL ){ local.six = 0 } else { if( !isAlive $leroy ){ local.six = 0 } }
		if( $mcmartin == NULL || $mcmartin == NIL ){ local.six = 0 } else { if( !isAlive $mcmartin ){ local.six = 0 } }
		if( $phillips == NULL || $phillips == NIL ){ local.six = 0 } else { if( !isAlive $phillips ){ local.six = 0 } }
		if( $johnson == NULL || $johnson == NIL ){ local.six = 0 } else { if( !isAlive $johnson ){ local.six = 0 } }
		if( $gobs == NULL || $gobs == NIL ){ local.six = 0 } else { if( !isAlive $gobs ){ local.six = 0 } }
		if( $michaels == NULL || $michaels == NIL ){ local.six = 0 } else { if( !isAlive $michaels ){ local.six = 0 } }
		if( local.six == 1 ){ waitthread chal_team_bump "obj_all_six_home" 1 }
	}

	// "The Bridge Still Stands" - m5l3 finished with the bridge intact, theirs or ours.
	if( local.mapname == "m5l3" && level.flags[Bridge_Is_Gone] != 1 ){
		waitthread chal_team_bump "obj_bridge_stands" 1
	}

	// "Save the Crab" - the Bizerte minesweeper tank. maps/e1l2/Crab.scr sets level.crabdead at two
	// sites (:124, :185); surviving to mission end with it still 0 is the feat.
	if( local.mapname == "e1l2" && level.crabdead != NIL && level.crabdead == 0 ){
		waitthread chal_team_bump "obj_save_the_crab" 1
	}

	// "Not a Scratch on Him" - the downed pilot delivered untouched. m4l1:135 sets him to full
	// health at handover, so anything below max means he took a hit somewhere.
	if( local.mapname == "m4l1" && level.pilot != NULL && level.pilot != NIL ){
		if( isAlive level.pilot && level.pilot.health >= level.pilot.maxhealth ){
			waitthread chal_team_bump "obj_not_a_scratch" 1
		}
	}

	// "Not a Single Bell" - the freighter scuttled without maps/e1l4/ship.scr::AlarmSounded ever
	// running.
	if( local.mapname == "e1l4" && level.coop_e1l4_alarmRang != 1 ){
		waitthread chal_team_bump "obj_not_a_single_bell" 1
	}

	//[user 2026-08-08] bug-1596 group B - defined in v1.2.1, never bumped.
	// "Not Today, Fritz": a Stuka dive AND an artillery barrage on the same map, survived without
	// going down. Per-player, because coop_wentDownMap is per-player - a squad where one man was
	// dropped should not award the whole team.
	if( level.coop_sawStuka == 1 && level.coop_sawArty == 1 ){
		waitthread cc_award_clean "evt_not_today_fritz"
	}

	// "Spotless Record": five missions completed with nobody going down. Reaching this label at
	// all means the mission completed, so the only extra condition is the no-down one - which is
	// exactly what cc_award_clean tests. Target is 5, so it accumulates across the campaign.
	waitthread cc_award_clean "obj_clean_sweep"

	// [user 07-11 batch 2] map-specific TEAM feats: mission completion + escort-alive checks
	if( local.mapname == "m2l1" ){ waitthread chal_team_bump "cc_blue_fox" 1 }			// finished Grillo's mission (sub-pen infiltration)
	if( local.mapname == "m5l1a" ){ waitthread chal_team_bump "cc_tooth_nail" 1 }		// cleared Sniper Town
	//[user 2026-08-13, bug-1773] MOVED TO m6l2b. "That One Map No One Played should actually be tied
	//to the following mission I confirmed." The train is boarded on The Schmerzen Express, not on the
	//Communications Blackout - m6l2a ends by escaping the town through a window.
	if( local.mapname == "m6l2b" ){ waitthread chal_team_bump "cc_no_one_played" 1 }	// boarded the train
	if( local.mapname == "m6l2a" && level.alarmactive != 1 ){ waitthread chal_team_bump "cc_silent_night" 1 }		// [batch 3] Comms Blackout completed with no alarm raised
	if( local.mapname == "m5l3" && level.coop_chal_tigerOk == 1 ){ waitthread chal_team_bump "cc_tiger_defense" 1 }	// [batch 3] King Tiger kept >=85% health through The Bridge
	if( local.mapname == "m3l3" && level.ramsey != NULL && isAlive level.ramsey ){ waitthread chal_team_bump "cc_win_war" 1 }
	if( local.mapname == "m5l1b" ){
		if( level.friendly1 != NULL && isAlive level.friendly1 ){ waitthread chal_team_bump "cc_m5l1b_glenn" 1 }
		if( level.friendly2 != NULL && isAlive level.friendly2 ){ waitthread chal_team_bump "cc_m5l1b_hammon" 1 }
		if( level.friendly3 != NULL && isAlive level.friendly3 ){ waitthread chal_team_bump "cc_m5l1b_campbell" 1 }
	}
	if( local.mapname == "t1l3" ){
		if( $friendlycaptain != NULL && isAlive $friendlycaptain ){ waitthread chal_team_bump "cc_t1l3_cappy" 1 }
		if( $friendlyprivate != NULL && isAlive $friendlyprivate ){ waitthread chal_team_bump "cc_t1l3_wilson" 1 }
		if( level.objective1 == 1 ){ waitthread chal_team_bump "cc_t1l3_hildebrandt" 1 }
	}
	if( local.mapname == "t2l3" && level.globalcaptainike != NULL && isAlive level.globalcaptainike ){ waitthread chal_team_bump "cc_t2l3_ike" 1 }
	if( local.mapname == "t2l4" && $cappy != NULL && isAlive $cappy ){ waitthread chal_team_bump "cc_t2l4_captain" 1 }
	if( local.mapname == "e1l3" ){
		if( $Claus != NULL && isAlive $Claus ){ waitthread chal_team_bump "cc_e1l3_claus" 1 }
		if( $cappy != NULL && isAlive $cappy ){ waitthread chal_team_bump "cc_e1l3_burton" 1 }
		if( $Boat1Rower != NULL && isAlive $Boat1Rower ){ waitthread chal_team_bump "cc_e1l3_gobbs" 1 }
	}
	if( local.mapname == "e3l2" && $medic != NULL && isAlive $medic ){ waitthread chal_team_bump "cc_e3l1_whittaker" 1 }
	if( local.mapname == "m3l2" ){
		local.abAlive = 0
		if( level.durden != NULL && isAlive level.durden ){ local.abAlive = 1 }
		if( level.paulsen != NULL && isAlive level.paulsen ){ local.abAlive = 1 }
		if( level.cobb != NULL && isAlive level.cobb ){ local.abAlive = 1 }
		if( local.abAlive == 1 ){ waitthread chal_team_bump "cc_close_contact" 1 }
	}
	//[user 08-06] bug-1505 - e2l3 finale feats. "Not One Stone" and "Bring the Bocage Boy Home" are
	//both gated on the same event (introhouse.scr's tank never landing a hit); "Bring the Boys Back
	//Home" is independent (Johnson/Hudson survival has no forced-kill anywhere in the map).
	if( local.mapname == "e2l3" ){
		if( level.e2l3_farmhouseHit != 1 ){ waitthread chal_team_bump "cc_not_one_stone" 1 }
		if( $driver != NULL && isAlive $driver ){ waitthread chal_team_bump "cc_bocage_boy" 1 }
		local.johnsonAlive = 0
		if( $ParatrooperLeader != NULL && isAlive $ParatrooperLeader ){ local.johnsonAlive = 1 }
		local.hudsonAlive = 0
		if( $battleAirborne_Commander != NULL && isAlive $battleAirborne_Commander ){ local.hudsonAlive = 1 }
		if( local.johnsonAlive == 1 && local.hudsonAlive == 1 ){ waitthread chal_team_bump "cc_boys_back_home" 1 }
		//[user 08-06] bug-1506 - level.e2l3_tankBattleActive is left at 1 if the map somehow reaches
		//mission-complete without $tanksRepelled ever firing (shouldn't happen - GiveMedal/
		//coop_missioncomplete only run after that trigger - but treat "window never closed" as a
		//fail-safe disqualifier rather than silently awarding an unfinished fight).
		if( level.e2l3_tankBattleCasualty != 1 && level.e2l3_tankBattleActive != 1 ){
			waitthread chal_team_bump "cc_boy_mans_job" 1
		}
	}

	waitthread chal_flush
}end


//=========================================================================
// COMPLETION TOAST (slots 76 header, 77 title, 78 subtitle). Queued so several
// completions in one frame show one at a time (never spammed).
//=========================================================================
chal_notify local.player local.title:{
	if( local.player == NULL ){ end }
	if( local.player.coop_chalTQN == NIL ){ local.player.coop_chalTQN = 0 }
	local.n = local.player.coop_chalTQN
	local.player.coop_chalTitleQ[local.n] = local.title
	local.player.coop_chalTQN = local.n + 1
	thread chal_toast_pump local.player
}end

chal_toast_pump local.player:{
	if( local.player == NULL ){ end }
	if( local.player.coop_chalTRun == 1 ){ end }
	local.player.coop_chalTRun = 1
	// [user 07-10] show only titles NOT yet shown. coop_chalTShown is a PERSISTENT high-water mark;
	// the old code restarted at index 0 every pump, so a new completion re-toasted every earlier one
	// ("same challenge pops up when I unlock a different one"). Now each title is shown exactly once.
	if( local.player.coop_chalTShown == NIL ){ local.player.coop_chalTShown = 0 }
	while( local.player != NULL && local.player.coop_chalTShown < local.player.coop_chalTQN ){
		local.title = local.player.coop_chalTitleQ[local.player.coop_chalTShown]
		waitthread chal_toast_show local.player local.title
		local.player.coop_chalTShown = local.player.coop_chalTShown + 1
	}
	if( local.player != NULL ){ local.player.coop_chalTRun = NIL }
}end

//=========================================================================
//[user 08-02] Challenge-complete cue: 5 key strikes then the carriage return.
//playlocalsound takes NO volume argument (fgame player.cpp), so level comes from the alias.
//Guarded against disconnect between waits.
//[user 08-07] bug-1264 named this as the gap: promotion got s_sfxduck (per-channel, music
//exempt, client whitelist - see xp.scr xp_ping_unduck), the typewriter cue never did, so it
//had to fight the full mix instead of sitting on top of it. Same treatment here: duck before
//the first stroke, stepped/guarded restore after the return - mirrors xp_ping_unduck exactly.
//=========================================================================
chal_typewriter local.player:{
//=========================================================================
	if( local.player == NULL ){ end }
	local.player stufftext "s_sfxduck 0.25"

	//[user 2026-08-04] bug-1357 - a fixed 0.11s gap on one sample reads as a machine, not a
	//typist. Real typing is uneven and the strokes are not identical: rotate three key
	//variants, jitter the gap, and let the last stroke breathe before the carriage returns.
	local.n = 0
	while( local.n < 7 ){
		if( local.player == NULL ){ end }
		//[user 2026-08-04] bug-1357 round 2 - RANDOM key per stroke (not a repeating 1-2-3 cycle,
		//which is still a pattern the ear picks up) across SIX samples that differ in pitch,
		//force, mechanism rattle and body thump. Wider gap spread plus an occasional hesitation
		//so it reads as someone typing rather than a machine ticking.
		local.k = randomint( 6 ) + 1
		if( local.k == 1 ){ local.player playlocalsound coop_type_key1 }
		else if( local.k == 2 ){ local.player playlocalsound coop_type_key2 }
		else if( local.k == 3 ){ local.player playlocalsound coop_type_key3 }
		else if( local.k == 4 ){ local.player playlocalsound coop_type_key4 }
		else if( local.k == 5 ){ local.player playlocalsound coop_type_key5 }
		else { local.player playlocalsound coop_type_key6 }
		local.n++
		//[user 2026-08-04] round 3 - SLOWER. 0.055-0.14s read as a machine-gun; a person typing
		//a service-record entry is deliberate. 0.13-0.26s, with a 1-in-4 longer pause.
		local.gap = 0.13 + randomfloat( 0.13 )
		if( randomint( 4 ) == 0 ){ local.gap = local.gap + randomfloat( 0.20 ) }
		wait local.gap
	}
	wait 0.22	//let the last stroke land before the carriage moves
	if( local.player == NULL ){ end }
	local.player playlocalsound coop_type_return

	//[user 08-07] stepped/guarded restore - same shape as xp.scr::xp_ping_unduck. s_sfxduck is
	//CVAR_ARCHIVE, so a disconnect mid-sequence must stop issuing stufftext (guard every wait),
	//not force a final restore through a possibly-freed entity. Shorter lead-in than the
	//promotion ping (0.35s vs 1.6s) - no reverb tail here, just letting the return-clack land.
	wait 0.35
	if( local.player == NULL ){ end }
	local.player stufftext "s_sfxduck 0.55"
	wait 0.3
	if( local.player == NULL ){ end }
	local.player stufftext "s_sfxduck 0.8"
	wait 0.3
	if( local.player == NULL ){ end }
	local.player stufftext "s_sfxduck 1"
}end

chal_toast_show local.player local.title:{
	if( local.player == NULL ){ end }
	//[user 2026-10-05] HUD declutter: mid-mission a completion is ONE quiet feed line (no toast, no typewriter); the
	//title is listed on the debrief card. An older cgame keeps the toast below.
	if( waitthread coop_mod/feed.scr::feed_capable local.player ){
		waitthread coop_mod/feed.scr::feed_chalDone local.player local.title
		end
	}

	//[user 07-12] shrunk (was facfont-20 / handle-23 - too big) + honest subtitle: rewards/loadouts
	//aren't built yet, so the toast only claims what actually happened (recorded in the Service Record).
	//[user 07-16] shrunk significantly again - the on-screen Service Record toast was too big.
	//CHALLENGE COMPLETE + title + subtitle all drop a tier; rects tightened to keep them stacked.
	//[2026-09-25, bug-2906] claim on show, re-send the hide (coop_mod/hudresend.scr, TRAPS T8). The pump
	//draws the NEXT queued toast in the same frame as this one's teardown; its claim stops the re-send.
	waitthread coop_mod/hudresend.scr::claim local.player 76 78
	ihuddraw_virtualsize local.player 76 1
	ihuddraw_align       local.player 76 center top
	ihuddraw_font        local.player 76 "verdana-10"
	ihuddraw_color       local.player 76 1 0.85 0.3
	ihuddraw_rect        local.player 76 0 100 0 0
	ihuddraw_string      local.player 76 "CHALLENGE COMPLETE"
	ihuddraw_alpha       local.player 76 1

	ihuddraw_virtualsize local.player 77 1
	ihuddraw_align       local.player 77 center top
	ihuddraw_font        local.player 77 "verdana-12"
	ihuddraw_color       local.player 77 1 1 1
	ihuddraw_rect        local.player 77 0 112 0 0
	ihuddraw_string      local.player 77 local.title
	ihuddraw_alpha       local.player 77 1

	ihuddraw_virtualsize local.player 78 1
	ihuddraw_align       local.player 78 center top
	ihuddraw_font        local.player 78 "verdana-10"
	ihuddraw_color       local.player 78 0.8 0.85 0.95
	ihuddraw_rect        local.player 78 0 126 0 0
	ihuddraw_string      local.player 78 "Recorded in your Service Record"
	ihuddraw_alpha       local.player 78 1

	//[user 08-02] Completing a challenge used the same generic coop_ui_click as menu paging and the
	//Service Record panel, so the moment had no payoff of its own. Give it a distinct cue: a short
	//typewriter burst that lands on "Recorded in your Service Record" above. Threaded so the ~0.7s
	//sequence does not eat into the 4s toast hold below. coop_ui_click stays on the menu paths, so
	//the completion sound remains unique to completion.
	thread chal_typewriter local.player

	wait 4

	local.a = 9
	while( local.a > 0 && local.player != NULL ){
		local.f = local.a * 0.1
		ihuddraw_alpha local.player 76 local.f
		ihuddraw_alpha local.player 77 local.f
		ihuddraw_alpha local.player 78 local.f
		local.a--
		wait 0.05
	}
	if( local.player != NULL ){
		ihuddraw_alpha  local.player 76 0
		ihuddraw_alpha  local.player 77 0
		ihuddraw_alpha  local.player 78 0
		ihuddraw_string local.player 76 ""
		ihuddraw_string local.player 77 ""
		ihuddraw_string local.player 78 ""
		thread coop_mod/hudresend.scr::resend local.player 76 78 1
	}
}end


//=========================================================================
// REVIEW: print the full challenge list to the player's console, grouped by
// category, with [progress/target] and DONE/locked. Reached via the name-append
// bind (index 34, ",chx"). Threaded from player.scr::playerNameCommand.
//=========================================================================
chal_review local.player:{
	if( level.coop_chal_init != 1 ){ waitthread chal_init }
	if( local.player == NULL ){ end }
	if( level.coop_chal_enabled != 1 ){
		waitthread coop_mod/feed.scr::feed_player local.player 2 "chal_off" "Challenges are disabled on this server"
		end
	}
	waitthread chal_ensure local.player
	if( local.player == NULL ){ end }

	local.done = 0
	local.tot  = level.coop_chal_count
	local.i = 0
	while( local.i < local.tot ){
		local.cid = level.coop_chal_id[local.i]
		if( local.player.flags["coop_chalD_" + local.cid] == 1 ){ local.done++ }
		local.i++
	}

	waitthread chal_print local.player "^5======== COOP CHALLENGES ========"
	waitthread chal_print local.player ( "Completed: " + local.done + " / " + local.tot + "   (open with the console key to read)" )

	local.c = 0
	while( local.c < level.coop_chal_catN ){
		local.cat = level.coop_chal_catOrder[local.c]
		waitthread chal_print local.player ( "^3-- " + level.coop_chal_catLabel[local.cat] + " --" )
		local.i = 0
		while( local.i < local.tot && local.player != NULL ){
			if( level.coop_chal_cat[local.i] == local.cat ){
				local.cid = level.coop_chal_id[local.i]
				local.tgt = level.coop_chal_target[local.i]
				local.p = local.player.flags["coop_chalP_" + local.cid]
				if( local.p == NIL ){ local.p = 0 }
				local.title = level.coop_chal_title[local.i]
				if( local.player.flags["coop_chalD_" + local.cid] == 1 ){
					waitthread chal_print local.player ( "  ^2[X]^7 " + local.title + "  (" + local.tgt + "/" + local.tgt + ")  unlock: " + level.coop_chal_reward[local.i] )
				} else {
					waitthread chal_print local.player ( "  [ ] " + local.title + "  (" + local.p + "/" + local.tgt + ")  " + level.coop_chal_desc[local.i] )
				}
			}
			local.i++
		}
		local.c++
	}
	waitthread chal_print local.player "^5================================="
}end

// one review line to the player's console (echo) + server log; paced so the
// client's reliable-command buffer never overflows on a 60+ line dump.
chal_print local.player local.text:{
	println( local.text )
	if( local.player != NULL ){
		local.player stufftext ( "echo " + local.text + "\n" )
	}
	wait 0.03
}end


//=========================================================================
// [303] CHALLENGES MENU - on-screen Service Record panel (ihuddraw slots
// 150-174; all >=100 so the coop HUD auto-fade leaves them alone). Reached
// via the same "Coop: Challenges" bind (player.scr index 34). Each press
// cycles to the next CATEGORY page; pressing past the last page closes it.
// Rewards are intentionally NOT drawn yet (being revisited). Auto-closes
// after 20s with no further input.
//=========================================================================
chal_menu local.player:{
	if( level.coop_chal_init != 1 ){ waitthread chal_init }
	if( local.player == NULL ){ end }
	if( level.coop_chal_enabled != 1 ){
		waitthread coop_mod/feed.scr::feed_player local.player 2 "chal_off" "Challenges are disabled on this server"
		end
	}
	waitthread chal_ensure local.player
	if( local.player == NULL ){ end }

	local.pg = local.player.flags["coop_chalMenuPage"]
	if( local.pg == NIL ){ local.pg = 0 }
	local.pg++
	if( local.pg > level.coop_chal_pageN ){ local.pg = 0 }
	local.player.flags["coop_chalMenuPage"] = local.pg

	if( local.pg == 0 ){
		waitthread chal_menu_clear local.player
		end
	}

	local.tok = local.player.flags["coop_chalMenuTok"]
	if( local.tok == NIL ){ local.tok = 0 }
	local.tok++
	local.player.flags["coop_chalMenuTok"] = local.tok

	waitthread chal_menu_draw local.player local.pg 1
	local.player playsound coop_ui_click
	local.player thread chal_menu_autoclose local.tok
	//[user 07-17] REAL-TIME: keep the open page ticking up live while you play (kills bump coop_chalP_<cid>
	//which chal_menu_draw reads each redraw). Pure server-side ihuddraw redraw (no client re-stuff, so no
	//reliable-command pressure); self-stops the instant the page/token changes or the panel closes.
	local.player thread chal_menu_refresh local.pg local.tok
}end

//=========================================================================
//[user 07-17] self = player. Live-refresh the currently OPEN challenge page every 0.5s so progress
// updates in real time while the panel is up. Guarded by the page + token so a page-change, a close,
// or the 20s autoclose ends it immediately (never leaves an orphan redraw loop running).
//=========================================================================
chal_menu_refresh local.pg local.tok:{
	//[bug-750] parse killer: the original multi-line condition put && at the START of the
	//continuation lines - the script parser ends the statement at the newline, so a leading
	//logical operator is a syntax error that killed the compile of this WHOLE FILE (no
	//challenges, no Service Record panel). Conditions must stay on ONE line.
	while( self != NULL && self.flags["coop_chalMenuTok"] == local.tok && self.flags["coop_chalMenuPage"] == local.pg ){
		wait 0.5
		if( self == NULL ){ end }
		if( self.flags["coop_chalMenuTok"] != local.tok ){ end }
		if( self.flags["coop_chalMenuPage"] != local.pg ){ end }
		waitthread chal_menu_draw self local.pg 1
	}
}end

//=========================================================================
// Draw one category page into the fixed slot block.
//=========================================================================
//[user 07-17] local.guard 1 = abort mid-draw if the open page changed/closed (the refresh + in-game
// callers pass it; the LOBBY caller omits it - the lobby never sets coop_chalMenuPage so it must NOT
// self-abort). Prevents a paced redraw from re-painting slots the close/autoclose just cleared (bug-713).
chal_menu_draw local.player local.pg local.guard:{
	if( local.player == NULL ){ end }
	local.ci   = local.pg - 1
	local.cat  = level.coop_chal_pageCat[local.ci]
	local.roff = level.coop_chal_pageOff[local.ci]
	local.rsub = level.coop_chal_pageSub[local.ci]
	local.rsubN= level.coop_chal_pageSubN[local.ci]

	// completed tally across ALL challenges (header readout)
	local.done = 0
	local.tot  = level.coop_chal_count
	local.i = 0
	while( local.i < local.tot ){
		if( local.player.flags["coop_chalD_" + level.coop_chal_id[local.i]] == 1 ){ local.done++ }
		local.i++
	}

	//[2026-09-25, bug-2906] claim the whole block this panel paints, so no late re-send of another
	//feature's teardown (surrender 152, medkit 158-160, DBNO banner 216) lands on the open panel.
	//Over-claiming is safe - it can only cancel re-sends, never add one (coop_mod/hudresend.scr).
	waitthread coop_mod/hudresend.scr::claim local.player 150 174
	waitthread coop_mod/hudresend.scr::claim local.player 196 249
	// full-screen dim
	ihuddraw_shader      local.player 150 "textures/mohmenu/black.tga"
	ihuddraw_virtualsize local.player 150 1
	ihuddraw_align       local.player 150 left top
	ihuddraw_rect        local.player 150 0 0 640 480
	ihuddraw_color       local.player 150 0 0 0
	ihuddraw_alpha       local.player 150 0.55

	// designed Service Record panel: dark leather + beveled brass frame + corner rivets + header
	// nameplate + baked divider (one texture; replaces the old flat border/panel/divider rects)
	ihuddraw_shader      local.player 151 "textures/hud/coop_chal_panel"
	ihuddraw_virtualsize local.player 151 1
	ihuddraw_align       local.player 151 left top
	ihuddraw_rect        local.player 151 140 58 360 360
	ihuddraw_color       local.player 151 1 1 1
	ihuddraw_alpha       local.player 151 1
	ihuddraw_alpha       local.player 152 0
	ihuddraw_string      local.player 152 ""

	// title "SERVICE RECORD" is now BAKED into the panel art (perfectly centered on the nameplate -
	// avoids the engine's ultrawide center-align drift where text left-anchors at screen center).
	ihuddraw_alpha  local.player 153 0
	ihuddraw_string local.player 153 ""

	// subtitle: category + page + completed. LEFT-aligned, centered on the panel (320) by an estimated
	// string width (the engine's center-align left-anchors text on non-4:3 screens, so we do it manually).
	local.sub = level.coop_chal_catLabel[local.cat]
	if( local.rsubN > 1 ){ local.sub = local.sub + " (" + local.rsub + "/" + local.rsubN + ")" }
	local.sub = local.sub + "   [ " + local.pg + " / " + level.coop_chal_pageN + " ]   COMPLETED " + local.done + " / " + local.tot
	local.subx = 320 - local.sub.size * 2.8
	ihuddraw_virtualsize local.player 154 1
	ihuddraw_align       local.player 154 left top
	ihuddraw_font        local.player 154 "verdana-12"
	ihuddraw_color       local.player 154 0.87 0.8 0.64
	ihuddraw_rect        local.player 154 local.subx 102 0 0
	ihuddraw_string      local.player 154 local.sub
	ihuddraw_alpha       local.player 154 1

	// divider is baked into the panel art now
	ihuddraw_alpha  local.player 155 0
	ihuddraw_string local.player 155 ""

	// rows.  PACED: in MP every ihuddraw call is a CGM network message, and ~4 elements/row x 18 rows
	// overflows one frame's snapshot buffer (drops the last rows). A waitframe every few rows keeps each
	// frame's CGM count safe, so the whole list actually reaches the client (host + remote).
	local.r = 0
	local.seen = 0
	local.i = 0
	local.pace = 0
	while( local.i < local.tot ){
		if( level.coop_chal_cat[local.i] == local.cat ){
			local.seen++
			if( local.seen > local.roff && local.r < 18 ){
			local.slot = 156 + local.r
			local.cid  = level.coop_chal_id[local.i]
			local.tgt  = level.coop_chal_target[local.i]
			local.p    = local.player.flags["coop_chalP_" + local.cid]
			if( local.p == NIL ){ local.p = 0 }
			if( local.p > local.tgt ){ local.p = local.tgt }
			local.dn = 0
			if( local.player.flags["coop_chalD_" + local.cid] == 1 ){ local.dn = 1 }
			local.y   = 122 + local.r * 13
			local.bbg = 196 + local.r
			local.bfl = 214 + local.r
			local.bct = 232 + local.r

			// remember this row's description (how-to-earn) + where the TITLE text ends (x), so the
			// lobbyui hover tooltip only triggers over the challenge title itself, not the whole row.
			local.player.coop_uiRowDesc[local.r]    = level.coop_chal_desc[local.i]
			local.player.coop_uiRowNameEnd[local.r] = 160 + ( level.coop_chal_title[local.i].size + 7 ) * 6	//+2 for the pin flag
			local.player.coop_uiRowCid[local.r]     = local.cid		//[user 2026-08-04] click-to-pin

			// challenge name
			ihuddraw_virtualsize local.player local.slot 1
			ihuddraw_align       local.player local.slot left top
			ihuddraw_font        local.player local.slot "verdana-12"
			ihuddraw_rect        local.player local.slot 160 local.y 0 0
			//[user 2026-08-04] a pinned row is marked so the player can see their own five at a
			//glance. Pins are per player, so this is read off THIS player's flags, never a level var.
			local.pin  = 0
			local.pinN = local.player.flags["coop_pinN"]
			if( local.pinN == NIL ){ local.pinN = 0 }
			local.pk = 1
			while( local.pk <= local.pinN ){
				if( local.player.flags["coop_pin" + local.pk] == local.cid ){
					local.pin = 1
					break
				}
				local.pk++
			}
			//fixed-width flag BETWEEN the box and the title: two characters either way, so a pinned
			//row never shifts the text or runs into the progress bar at x=346 the way a long title
			//plus a trailing suffix would.
			local.mark = "  "
			if( local.pin == 1 ){ local.mark = "* " }
			if( local.dn == 1 ){
				ihuddraw_color  local.player local.slot 0.5 0.85 0.4
				ihuddraw_string local.player local.slot ( "[X] " + local.mark + level.coop_chal_title[local.i] )
			} else {
				if( local.pin == 1 ){
					ihuddraw_color local.player local.slot 0.95 0.85 0.45
				} else {
					ihuddraw_color local.player local.slot 0.88 0.86 0.78
				}
				ihuddraw_string local.player local.slot ( "[  ] " + local.mark + level.coop_chal_title[local.i] )
			}
			ihuddraw_alpha local.player local.slot 1

			// progress bar track
			ihuddraw_shader      local.player local.bbg "textures/hud/coop_bar_white.tga"
			ihuddraw_virtualsize local.player local.bbg 1
			ihuddraw_align       local.player local.bbg left top
			ihuddraw_rect        local.player local.bbg 346 ( local.y + 3 ) 78 6
			ihuddraw_color       local.player local.bbg 0.12 0.09 0.05
			ihuddraw_alpha       local.player local.bbg 0.8

			// progress bar fill ( width = 78 * progress / target ) - glossy xpbar fill (same as the rank-up bar)
			local.fw = 78 * local.p / local.tgt
			ihuddraw_shader      local.player local.bfl "textures/hud/xpbar/xpbar_fill"
			ihuddraw_virtualsize local.player local.bfl 1
			ihuddraw_align       local.player local.bfl left top
			ihuddraw_rect        local.player local.bfl 346 ( local.y + 3 ) local.fw 6
			if( local.dn == 1 ){
				ihuddraw_color local.player local.bfl 0.6 0.98 0.5
			} else {
				ihuddraw_color local.player local.bfl 0.98 0.85 0.5
			}
			//[2026-09-27, bug-3076] >= 1, not > 0: the rect width is truncated to an int on the wire, and a
			//width-0 quad is drawn at the texture's NATIVE size (xpbar_fill = a 64x128 px gold block)
			if( local.fw >= 1 ){ ihuddraw_alpha local.player local.bfl 1 } else { ihuddraw_alpha local.player local.bfl 0 }

			// progress count
			ihuddraw_virtualsize local.player local.bct 1
			ihuddraw_align       local.player local.bct left top
			ihuddraw_font        local.player local.bct "verdana-12"
			ihuddraw_color       local.player local.bct 0.74 0.68 0.54
			ihuddraw_rect        local.player local.bct 432 local.y 0 0
			ihuddraw_string      local.player local.bct ( local.p + " / " + local.tgt )
			ihuddraw_alpha       local.player local.bct 1

			local.r++
			local.pace++
			if( local.pace >= 4 ){
				local.pace = 0
				waitframe
				if( local.player == NULL ){ end }
				//[user 07-17] guarded redraw (refresh/in-game): bail if the page closed/changed mid-draw so
				// we never re-show slots the close just cleared. Lobby caller passes no guard (NIL != 1).
				if( local.guard == 1 && local.player.flags["coop_chalMenuPage"] != local.pg ){ end }
			}
			}
		}
		local.i++
	}
	local.player.coop_uiRowN = local.r		// rows on this page - lobbyui.scr hover-tests against them

	// blank unused row slots (name 156.., bar-bg 196.., bar-fill 214.., count 232..)
	while( local.r < 18 ){
		local.slot = 156 + local.r
		ihuddraw_string local.player local.slot ""
		ihuddraw_alpha  local.player local.slot 0
		ihuddraw_alpha  local.player ( 196 + local.r ) 0
		ihuddraw_alpha  local.player ( 214 + local.r ) 0
		ihuddraw_string local.player ( 232 + local.r ) ""
		ihuddraw_alpha  local.player ( 232 + local.r ) 0
		local.r++
	}

	// footer hint (keyboard view; the clickable lobby view hides this and shows PREV/NEXT/CLOSE)
	//[user 2026-08-10] NULL guard: this teardown runs AFTER the display loop above, and that
	//loop exits precisely BECAUSE the player went away (disconnect / spectate / map change).
	//Measured in the 2-player test as "Script Error : Player entity is NULL for ihuddraw_*".
	if( local.player != NULL ){
		ihuddraw_virtualsize local.player 174 1
		ihuddraw_align       local.player 174 left top
		ihuddraw_font        local.player 174 "verdana-12"
		ihuddraw_color       local.player 174 0.55 0.48 0.36
		ihuddraw_rect        local.player 174 188 398 0 0
		ihuddraw_string      local.player 174 "Press your Challenges key again for next page"
		ihuddraw_alpha       local.player 174 1
	}
}end

//=========================================================================
// Hide the whole panel.
//=========================================================================
chal_menu_clear local.player:{
	if( local.player == NULL ){ end }
	local.s = 150
	while( local.s <= 174 ){
		ihuddraw_alpha  local.player local.s 0
		ihuddraw_string local.player local.s ""
		local.s++
	}
	// progress-bar tracks/fills/counts (196..249)
	local.s = 196
	while( local.s <= 249 ){
		ihuddraw_alpha  local.player local.s 0
		ihuddraw_string local.player local.s ""
		local.s++
	}
	//[2026-09-25, bug-2906] the close is ~160 writes in ONE frame - the likeliest teardown in the mod to
	//be lost to a remote client, and it strands the whole panel. Re-send it, alpha only (enough to hide
	//every layer, a third of the bytes), to the slots the panel can actually light: not 152/153/155
	//(written hidden only) and not 244-247 (m6l1c/m6l2a map prompts, which do not claim).
	thread coop_mod/hudresend.scr::resend local.player 150 151 0
	thread coop_mod/hudresend.scr::resend local.player 154 154 0
	thread coop_mod/hudresend.scr::resend local.player 156 174 0
	thread coop_mod/hudresend.scr::resend local.player 196 243 0
	thread coop_mod/hudresend.scr::resend local.player 248 249 0
}end

//=========================================================================
// Auto-close guard: if no further page press within 20s, hide the panel.
//=========================================================================
chal_menu_autoclose local.tok:{
	wait 20
	if( self == NULL ){ end }
	if( self.flags["coop_chalMenuTok"] != local.tok ){ end }
	if( self.flags["coop_chalMenuPage"] == 0 ){ end }
	self.flags["coop_chalMenuPage"] = 0
	waitthread chal_menu_clear self
}end


//=========================================================================
//[user 07-18] LOBBY "NEW UNLOCKS" LIST - the pending-name queue.
// Every genuinely-new unlock (challenge reward AND xp rank grant - both funnel
// through chal_add_unlock) appends its display name here. The lobby draws the
// queue for the whole stay (lobby.scr::lobbyUnlockList) and lobbyLaunch clears
// it. Persistence mirrors the unlocks channel exactly: session cvar
// coop_pend_<id> + file coop_mod/save/pend_<id>.dat, loaded in chal_ensure
// (missing = empty, so pre-feature saves need no migration). Separator is "~"
// because display names contain spaces and none contain "~".
//=========================================================================
chal_pend_append local.player local.name:{
	if( local.player == NULL ){ end }
	if( local.name == NIL || local.name == "" ){ end }
	local.pd = local.player.flags["coop_unlockPend"]
	if( local.pd == NIL ){ local.pd = "" }
	if( local.pd == "" ){ local.pd = local.name }
	else { local.pd = local.pd + "~" + local.name }
	local.player.flags["coop_unlockPend"] = local.pd
	local.id = local.player.flags["coop_chal_id"]
	if( local.id != NIL && local.id != "" ){
		setcvar ( "coop_pend_" + local.id ) local.pd
		fs_write_content ( "coop_mod/save/pend_" + local.id + ".dat" ) local.pd
	}
}end

chal_pend_clear local.player:{
	if( local.player == NULL ){ end }
	local.player.flags["coop_unlockPend"] = ""
	local.id = local.player.flags["coop_chal_id"]
	if( local.id != NIL && local.id != "" ){
		setcvar ( "coop_pend_" + local.id ) ""
		fs_write_content ( "coop_mod/save/pend_" + local.id + ".dat" ) ""
	}
}end


//=========================================================================
// Resolve an unlock reward id to its human display name.
//   models/weapons/*      -> armory roster name (loadoutroster.scr reverse map)
//   models/coop_helmets/* -> "Headgear: <helmet_initList name>"
//   models/player/*       -> "Uniform: <prettified basename>"
//   perk_* / attach_*     -> "Perk: ..." / "Attachment: ..."
//   anything else         -> prettified token
//=========================================================================
chal_unlock_displayName local.reward:{
	local.nm = ""
	if( local.reward == NIL || local.reward == "" ){ end local.nm }

	//[bug-2082] GLOVES first, because their token is a bare id rather than a path and would
	//otherwise fall through every path test to chal_pend_pretty, which would announce the unlock as
	//"Glv Wool" in the lobby and the debrief NEW UNLOCKS card.
	if( waitthread coop_mod/main.scr::containsText local.reward "glv_" 0 ){
		waitthread coop_mod/gloves.scr::glove_initList
		local.gi = 0
		while( local.gi < level.coop_gloveCount ){
			if( level.coop_gloveTok[local.gi] == local.reward ){
				end ( "Gloves: " + level.coop_gloveName[local.gi] )
			}
			local.gi++
		}
	}

	// weapons: reverse-map tik -> armory display name via the ordered roster arrays
	if( waitthread coop_mod/main.scr::containsText local.reward "models/weapons/" 0 ){
		waitthread coop_mod/loadoutroster.scr::roster_ids
		local.i = 0
		while( local.i < level.coop_loRosterN ){
			if( level.coop_loRosterGive[local.i] == local.reward ){
				local.r = waitthread coop_mod/loadoutroster.scr::roster_get level.coop_loRosterId[local.i]
				local.nm = local.r["name"]
				if( local.nm != NIL && local.nm != "" ){ end local.nm }
			}
			local.i++
		}
		// weapon not in the armory roster (future reward) - prettified filename fallback
		local.nm = waitthread chal_pend_pretty local.reward
		end local.nm
	}

	// helmets / headgear
	if( waitthread coop_mod/main.scr::containsText local.reward "models/coop_helmets/" 0 ){
		waitthread coop_mod/helmet.scr::helmet_initList
		local.i = 1
		while( local.i <= level.coop_helmetCount ){
			if( level.coop_helmetTik[local.i] == local.reward ){
				local.nm = "Headgear: " + level.coop_helmetName[local.i]
				end local.nm
			}
			local.i++
		}
		local.nm = waitthread chal_pend_pretty local.reward
		local.nm = "Headgear: " + local.nm
		end local.nm
	}

	// player skins
	if( waitthread coop_mod/main.scr::containsText local.reward "models/player/" 0 ){
		local.nm = waitthread chal_pend_pretty local.reward
		local.nm = "Uniform: " + local.nm
		end local.nm
	}

	//[user 2026-08-18] finish_* = a weapon-finish unlock (the strip). The pretty name comes
	//from the skin table so it matches the strip's own labels exactly.
	waitthread coop_mod/loadoutskins.scr::skin_init
	local.fi = 1
	while( local.fi <= 7 ){
		if( level.coop_skinFinStat[local.fi] == local.reward ){
			local.nm = "Weapon Finish: " + level.coop_skinFinName[local.fi]
			end local.nm
		}
		local.fi++
	}
	//[user 2026-08-18] mv_* = a model-variant availability marker (queued by chal_grant when
	//a host gun's Elite completes). Name from the same table.
	if( level.coop_skinMvPseudo[local.reward] != NIL ){
		local.nm = "Variant: " + level.coop_skinMvPseudo[local.reward]
		end local.nm
	}

	// symbolic ids: perk_* / attach_* get a category label, prefix stripped
	local.head = ""
	local.i = 0
	while( local.i < local.reward.size && local.i < 5 ){ local.head += local.reward[local.i]; local.i++ }
	if( local.head == "perk_" ){
		local.rest = ""
		local.i = 5
		while( local.i < local.reward.size ){ local.rest += local.reward[local.i]; local.i++ }
		local.rest = waitthread chal_pend_pretty local.rest
		local.nm = "Perk: " + local.rest
		end local.nm
	}
	while( local.i < local.reward.size && local.i < 7 ){ local.head += local.reward[local.i]; local.i++ }
	if( local.head == "attach_" ){
		local.rest = ""
		local.i = 7
		while( local.i < local.reward.size ){ local.rest += local.reward[local.i]; local.i++ }
		local.rest = waitthread chal_pend_pretty local.rest
		local.nm = "Attachment: " + local.rest
		end local.nm
	}

	local.nm = waitthread chal_pend_pretty local.reward
}end local.nm


//=========================================================================
// Prettify a token/path: keep only the basename (after the last "/"), drop a
// trailing ".tik", turn underscores into spaces. Pure char-loop (no engine
// substring helpers exist).
//=========================================================================
chal_pend_pretty local.s:{
	local.out = ""
	if( local.s == NIL || local.s == "" ){ end local.out }

	// basename: restart the accumulator at every "/"
	local.base = ""
	local.i = 0
	while( local.i < local.s.size ){
		local.c = local.s[local.i]
		if( local.c == "/" ){ local.base = "" }
		else { local.base += local.c }
		local.i++
	}

	// drop a trailing ".tik"
	if( local.base.size > 4 ){
		local.tail = ""
		local.i = local.base.size - 4
		while( local.i < local.base.size ){ local.tail += local.base[local.i]; local.i++ }
		if( local.tail == ".tik" ){
			local.tmp = ""
			local.i = 0
			while( local.i < ( local.base.size - 4 ) ){ local.tmp += local.base[local.i]; local.i++ }
			local.base = local.tmp
		}
	}

	// underscores -> spaces
	local.i = 0
	while( local.i < local.base.size ){
		local.c = local.base[local.i]
		if( local.c == "_" ){ local.out += " " }
		else { local.out += local.c }
		local.i++
	}
}end local.out

//=========================================================================
// [user 2026-08-04] bug-1346 - map a victim MODEL path onto a faction stat. Substring match,
// MOST SPECIFIC FIRST (a sniper in SS kit counts as a sniper; an SS officer counts as SS
// police, not a field officer). Result cached per model, so each unique tik walks the list
// once per map rather than once per kill. Returns "" for non-troop axis (dogs, dialogue
// props, workers) so they never advance a combat challenge.
//=========================================================================
chal_factionOf local.model:{
	if( local.model == NIL || local.model == "" ){ end "" }
	if( level.coop_chal_facCache[local.model] != NIL ){ end level.coop_chal_facCache[local.model] }
	local.f = ""
	if( waitthread chal_facHas local.model "hund" ){ local.f = "" }
	else if( waitthread chal_facHas local.model "dialogue" ){ local.f = "" }
	else if( waitthread chal_facHas local.model "worker" ){ local.f = "" }
	else if( waitthread chal_facHas local.model "scientist" ){ local.f = "" }
	else if( waitthread chal_facHas local.model "sniper" ){ local.f = "fac_sniper" }
	else if( waitthread chal_facHas local.model "colonel" ){ local.f = "fac_general" }
	else if( waitthread chal_facHas local.model "major" ){ local.f = "fac_general" }
	else if( waitthread chal_facHas local.model "commander" ){ local.f = "fac_general" }
	else if( waitthread chal_facHas local.model "gestapo" ){ local.f = "fac_ss" }
	else if( waitthread chal_facHas local.model "feldgendarmerie" ){ local.f = "fac_ss" }
	else if( waitthread chal_facHas local.model "elite_ss" ){ local.f = "fac_ss" }
	else if( waitthread chal_facHas local.model "ss_guard" ){ local.f = "fac_ss" }
	else if( waitthread chal_facHas local.model "ss_gasmask" ){ local.f = "fac_ss" }
	else if( waitthread chal_facHas local.model "_fg" ){ local.f = "fac_fallsch" }
	else if( waitthread chal_facHas local.model "ital_para" ){ local.f = "fac_bersag" }
	else if( waitthread chal_facHas local.model "ital_vol" ){ local.f = "fac_carab" }
	else if( waitthread chal_facHas local.model "ital" ){ local.f = "fac_regio" }
	else if( waitthread chal_facHas local.model "kriegsmarine" ){ local.f = "fac_kmarine" }
	else if( waitthread chal_facHas local.model "kreigsmarine" ){ local.f = "fac_kmarine" }
	else if( waitthread chal_facHas local.model "kmarine" ){ local.f = "fac_kmarine" }
	else if( waitthread chal_facHas local.model "frogman" ){ local.f = "fac_kmarine" }
	else if( waitthread chal_facHas local.model "afrika" ){ local.f = "fac_afrika" }
	else if( waitthread chal_facHas local.model "_dak" ){ local.f = "fac_afrika" }
	else if( waitthread chal_facHas local.model "officer" ){ local.f = "fac_officer" }
	else { local.f = "fac_heer" }
	level.coop_chal_facCache[local.model] = local.f
	//[user 2026-08-04] bug-1351 - one line per UNIQUE model per map (cache means it cannot
	//spam), so a mis-classification is visible in the log instead of silently miscounting.
	println( "^~^~^ FACTION " + local.model + " -> " + local.f )
	end local.f
}end

//=========================================================================
// [user 2026-08-04] bug-1351 - SELF-CONTAINED substring test. The first version called
// 'global/strings.scr::instr', which does not exist anywhere - not in the mod tree and not in
// any retail pak (the coop copy lives at coop_mod/strings.scr, and its header comment quoting
// the global/ path is what misled me). Every call therefore returned NIL, every pattern
// missed, and EVERY kill fell through to the fac_heer default - the user saw Italians
// crediting 'Frontline Sweeper'. Also note instr is 0-BASED and returns NIL when absent, so
// the old 'pos > 0' guard would additionally have missed a match at index 0.
// This version depends on nothing: plain char walk, returns 1/0. Cost is irrelevant because
// chal_factionOf caches per model (each unique tik is classified once per map).
//=========================================================================
chal_facHas local.hay local.needle:{
	if( local.hay == NIL || local.needle == NIL ){ end 0 }
	local.hs = local.hay.size
	local.ns = local.needle.size
	if( local.ns <= 0 || local.hs < local.ns ){ end 0 }
	local.i = 0
	while( local.i <= local.hs - local.ns ){
		local.j = 0
		local.ok = 1
		while( local.j < local.ns ){
			if( local.hay[local.i + local.j] != local.needle[local.j] ){
				local.ok = 0
				local.j = local.ns
			} else {
				local.j++
			}
		}
		if( local.ok == 1 ){ end 1 }
		local.i++
	}
	end 0
}end

//=========================================================================
// PINNED CHALLENGES [user 2026-08-04] bug-1363
// Pin up to 5 challenges; they show under Secondary Objectives with live progress and tick
// when earned. Pins are stored as CHALLENGE IDS, never catalogue indices - index is file
// order, so inserting one chal_def would silently re-point every pin.
//   chx pin <cid>   pin it        (bindable / console: set coop_chal_pin <cid>)
//   chx unpin <cid> unpin it
//   chx pins        list them
//=========================================================================
chal_pin_init:{
	if( level.coop_chal_pinInit == 1 ){ end }
	level.coop_chal_pinInit = 1
	setcvar "coop_chal_pin" ""
	thread chal_pin_cmdmon
}end

//=========================================================================
chal_pin_cmdmon:{
	while( 1 ){
		wait 0.5
		local.c = getcvar "coop_chal_pin"
		if( local.c == "" ){ continue }
		setcvar "coop_chal_pin" ""
		//Pins are PER PLAYER. A console command can only mean the person at the console, so this
		//resolves to the host alone - never a broadcast that pins someone else's list for them.
		local.i = 1
		while( local.i <= $player.size ){
			if( $player[local.i] != NULL && $player[local.i].flags["coop_isHost"] == 1 ){
				waitthread chal_pin_toggle $player[local.i] local.c
				break
			}
			local.i++
		}
	}
}end

//=========================================================================
//[user 08-07] Is local.cid one of this player's currently pinned challenges? Shared by
// chal_apply's quarter-progress popup gate.
//=========================================================================
chal_pin_isPinned local.player local.cid:{
	if( local.player == NULL || local.cid == NIL || local.cid == "" ){ end 0 }
	local.n = local.player.flags["coop_pinN"]
	if( local.n == NIL ){ end 0 }
	local.j = 1
	while( local.j <= local.n ){
		if( local.player.flags["coop_pin" + local.j] == local.cid ){ end 1 }
		local.j++
	}
}end 0

//=========================================================================
// [user 2026-10-06, feed round 2] pin feedback: one quiet personal line in the event feed, naming the
// challenge by its TITLE (was the internal id in the old message box, bold and beeping for the refusals).
// No wait in here (feed.scr has none either), so callers stay single-frame.
//=========================================================================
chal_pin_say local.player local.verb local.cid:{
	if( local.player == NULL ){ end }
	local.name = local.cid
	local.idx = level.coop_chal_idx[local.cid]
	if( local.idx != NIL ){
		if( level.coop_chal_title[local.idx] != NIL ){ local.name = level.coop_chal_title[local.idx] }
	}
	waitthread coop_mod/feed.scr::feed_player local.player 2 "pin" ( local.verb + local.name )
}end

//=========================================================================
// Toggle a pin. Max 5; pinning a 6th tells the player which to drop rather than silently
// evicting one they care about.
//=========================================================================
chal_pin_toggle local.player local.cid:{
	if( local.player == NULL || local.cid == "" ){ end }
	local.n = local.player.flags["coop_pinN"]
	if( local.n == NIL ){ local.n = 0 }

	//already pinned? unpin and compact
	local.i = 1
	while( local.i <= local.n ){
		if( local.player.flags["coop_pin" + local.i] == local.cid ){
			local.j = local.i
			while( local.j < local.n ){
				local.player.flags["coop_pin" + local.j] = local.player.flags["coop_pin" + ( local.j + 1 )]
				local.j++
			}
			local.player.flags["coop_pin" + local.n] = ""
			local.player.flags["coop_pinN"] = local.n - 1
			waitthread chal_pin_say local.player "Unpinned: " local.cid
			waitthread chal_pin_mark local.player local.cid 0
			waitthread chal_pin_save local.player
			waitthread chal_pin_push local.player
			end
		}
		local.i++
	}

	//[user 08-07] failsafe: nothing left to track on a challenge that's already done - refuse the
	//pin outright rather than let it occupy one of the 5 slots uselessly.
	if( local.player.flags["coop_chalD_" + local.cid] == 1 ){
		waitthread chal_pin_say local.player "Already complete - cannot pin: " local.cid
		end
	}
	if( local.n >= 5 ){
		waitthread coop_mod/feed.scr::feed_player local.player 2 "pin" "Five challenges are pinned - unpin one first"
		end
	}
	local.n = local.n + 1
	local.player.flags["coop_pin" + local.n] = local.cid
	local.player.flags["coop_pinN"] = local.n
	waitthread chal_pin_say local.player "Pinned: " local.cid
	waitthread chal_pin_mark local.player local.cid 1
	waitthread chal_pin_save local.player
	waitthread chal_pin_push local.player
}end

//=========================================================================
// [user 2026-09-09, bug-2544] Drop any pin whose challenge is already complete, and compact the
// list. Called only from chal_pin_push, which is what makes it self-healing.
//
// Compacted INLINE rather than by calling chal_pin_toggle: toggle ends by calling
// chal_pin_push, and this runs from inside push. chal_pin_save is safe to call - it writes the
// cvar and the .dat and calls nothing back.
//=========================================================================
chal_pin_dropDone local.player:{
	if( local.player == NULL ){ end }
	local.n = local.player.flags["coop_pinN"]
	if( local.n == NIL ){ local.n = 0 }
	if( local.n < 1 ){ end }
	local.w = 0
	local.dropped = 0
	local.i = 1
	while( local.i <= local.n ){
		local.cid = local.player.flags["coop_pin" + local.i]
		local.keep = 1
		if( local.cid == NIL || local.cid == "" ){ local.keep = 0 }
		else{
			if( local.player.flags["coop_chalD_" + local.cid] == 1 ){
				local.keep = 0
				local.dropped++
				//clear the gold marker too, or the Service Record and the objectives menu disagree
				waitthread chal_pin_mark local.player local.cid 0
			}
		}
		if( local.keep == 1 ){
			local.w++
			local.player.flags["coop_pin" + local.w] = local.cid
		}
		local.i++
	}
	if( local.dropped < 1 ){ end }
	local.j = local.w + 1
	while( local.j <= local.n ){
		local.player.flags["coop_pin" + local.j] = ""
		local.j++
	}
	local.player.flags["coop_pinN"] = local.w
	waitthread chal_pin_save local.player
	println( "^~^~^ CHALPIN dropped=" + local.dropped + " finished pin(s) byE" + local.player.entnum + " left=" + local.w )
}end

//=========================================================================
// Publish the five rows to ONE player. Values are pushed unquoted (bug-758: quoted stufftext
// values get truncated on the wire).
//=========================================================================
chal_pin_push local.player:{
	if( local.player == NULL ){ end }
	//[user 2026-09-09, bug-2544] A FINISHED CHALLENGE IS NEVER IN THE PIN LIST. Enforced HERE,
	//because this is the only pin routine that runs unprompted - chal_pin_monitor calls it every
	//3 s for every player - so a list that has already gone wrong heals itself with no action from
	//the player and no migration step.
	//The two guards that existed were both ONE-SHOT and both missed it: toggle refuses to ADD a
	//done challenge, and the completion path drops the pin at the instant it finishes but only if
	//it was pinned at that instant. Anything that lands a done cid in the list afterwards - the
	//disconnected menu's pin path racing the server, or chal_pin_load restoring a pins_<id>.dat
	//entry for a challenge completed since it was written - stuck there for good. Measured live:
	//coop_cp1 "The Tell-Tale Ping - 150/150" with coop_cp1d 1 and coop_pinCount 1/5, while every
	//coop_uiP marker was 0.
	waitthread chal_pin_dropDone local.player
	local.n = local.player.flags["coop_pinN"]
	if( local.n == NIL ){ local.n = 0 }
	//[user 08-07] "N/5" pinned summary for the Service Record - mirrors CL_PinToggle_f's own
	//coop_pinCount formatting so both the connected (server-driven) and disconnected (client-only)
	//pin paths agree. seta so it also survives to the disconnected menu.
	//ONE token, no trailing " Pinned": an unquoted stufftext value stops at the first space (and
	//quoting truncates on the wire instead - bug-758), so the old form silently set just "N/5"
	//anyway. The word PINNED is baked into the page texture beside the Label.
	local.player stufftext ( "seta coop_pinCount " + local.n + "/5" )
	local.i = 1
	while( local.i <= 5 ){
		if( local.i > local.n ){
			local.player stufftext ( "set coop_cp" + local.i + "d 0" )
		}else{
			local.cid  = local.player.flags["coop_pin" + local.i]
			local.idx  = level.coop_chal_idx[local.cid]
			local.name = local.cid
			local.tgt  = 0
			if( local.idx != NIL ){
				local.name = level.coop_chal_title[local.idx]
				local.tgt  = level.coop_chal_target[local.idx]
			}
			local.have = local.player.flags["coop_chalP_" + local.cid]
			if( local.have == NIL ){ local.have = 0 }
			local.done = local.player.flags["coop_chalD_" + local.cid]
			if( local.done == NIL ){ local.done = 0 }
			if( local.have > local.tgt ){ local.have = local.tgt }
			local.player stufftext ( "set coop_cp" + local.i + "d 1" )
			local.player stufftext ( "set coop_cp" + local.i + "s " + local.done )
			local.player stufftext ( "set coop_cp" + local.i + " " + local.name + " - " + local.have + "/" + local.tgt )
		}
		local.i++
	}
}end

//=========================================================================
// Cheap refresh loop - progress only changes on a bump, so 3s is plenty and costs nothing.
//=========================================================================
chal_pin_monitor:{
	while( 1 ){
		wait 3
		local.i = 1
		while( local.i <= $player.size ){
			if( $player[local.i] != NULL ){ waitthread chal_pin_push $player[local.i] }
			local.i++
		}
	}
}end

//=========================================================================
// Pin persistence. Same two-channel pattern as the unlock list: a session cvar that survives
// map transitions, backed by a file that survives the server. Stored as "cid|cid|...".
//=========================================================================
chal_pin_save local.player:{
	if( local.player == NULL ){ end }
	if( local.player.flags["coop_chal_id"] == NIL ){ end }
	local.n = local.player.flags["coop_pinN"]
	if( local.n == NIL ){ local.n = 0 }
	local.out = ""
	local.i = 1
	while( local.i <= local.n ){
		if( local.out != "" ){ local.out += "|" }
		local.out += local.player.flags["coop_pin" + local.i]
		local.i++
	}
	local.id = local.player.flags["coop_chal_id"]
	//[srvperf 2026-10-04] skip the cvar + synchronous file write when the pin list is what we last saved
	//(~1 ms per player on every chal_flush, measured). A changed list always writes.
	if( local.player.flags["coop_pins_saved"] != local.out ){
		setcvar ( "coop_pins_" + local.id ) local.out
		fs_write_content ( "coop_mod/save/pins_" + local.id + ".dat" ) local.out
		local.player.flags["coop_pins_saved"] = local.out
	}
}end

//=========================================================================
chal_pin_load local.player:{
	if( local.player == NULL ){ end }
	if( local.player.flags["coop_chal_id"] == NIL ){ end }
	local.id   = local.player.flags["coop_chal_id"]
	local.data = getcvar( "coop_pins_" + local.id )
	if( local.data == "" ){
		local.data = fs_read_content ( "coop_mod/save/pins_" + local.id + ".dat" )
	}
	local.player.flags["coop_pinN"] = 0
	if( local.data == NIL || local.data == "" ){ end }

	local.field = ""
	local.n     = 0
	local.i     = 0
	local.len   = local.data.size
	while( local.i < local.len ){
		local.c = local.data[local.i]
		if( local.c == "|" ){
			if( local.field != "" && local.n < 5 ){
				local.n++
				local.player.flags["coop_pin" + local.n] = local.field
			}
			local.field = ""
		} else {
			local.field += local.c
		}
		local.i++
	}
	if( local.field != "" && local.n < 5 ){
		local.n++
		local.player.flags["coop_pin" + local.n] = local.field
	}
	local.player.flags["coop_pinN"] = local.n
}end

//=========================================================================
//[user 08-06] bug-1503 - reconcile pins made from the DISCONNECTED Service Record menu, which
//cannot run any of the above (no server, no script VM to receive a name-bus token). That flow
//instead writes 5 client cvars directly (coop_pin1..coop_pin5, each one CATALOGUE INDEX, set by
//CL_PinToggle_f in code/client/cl_main.cpp) and marks them CVAR_USERINFO so they arrive here
//automatically on connect via self.userinfo - the same "client picks something offline, server
//learns it via userinfo on connect" pattern dm_playermodel already uses. Called right after
//chal_pin_load above, inside chal_ensure. If the player has never touched the disconnected pin
//toggle, all 5 userinfo keys are empty and this is a no-op - chal_pin_load's file/cvar-restored
//pins (from playing while connected) stand as-is. Otherwise userinfo is treated as authoritative
//(it is always at least as fresh as the file, since a connected pin click writes BOTH channels -
//see CL_PinToggle_f's clc.state==CA_ACTIVE branch) and overwrites flags["coop_pin1".."coop_pinN"].
//=========================================================================
chal_pin_importUserinfo local.player:{
//=========================================================================
	if( local.player == NULL ){ end }
	if( local.player.flags["coop_chal_id"] == NIL ){ end }
	local.info = local.player.userinfo

	local.any = 0
	local.i = 1
	while( local.i <= 5 ){
		local.v = info_valueforkey local.info ( "coop_pin" + local.i )
		if( local.v != NIL && local.v != "" ){ local.any = 1 }
		local.i++
	}
	if( local.any == 0 ){ end }

	local.n = 0
	local.i = 1
	while( local.i <= 5 ){
		local.v = info_valueforkey local.info ( "coop_pin" + local.i )
		if( local.v != NIL && local.v != "" ){
			//[user 2026-08-18] slots hold CIDS now (every cid carries an underscore; a bare index
			//never does) - a catalogue renumber used to repoint every archived pin at a DIFFERENT
			//challenge, because the index->cid mapping ran at import against whatever table was
			//current. Legacy numeric slots from pre-cid clients still resolve the old way.
			local.cid = NIL
			if( waitthread coop_mod/main.scr::containsText local.v "_" 0 ){
				if( level.coop_chal_idx[local.v] != NIL ){ local.cid = local.v }
			}else{
				local.gi  = int( local.v )
				local.cid = level.coop_chal_id[local.gi]
			}
			if( local.cid != NIL ){
				local.n++
				local.player.flags["coop_pin" + local.n] = local.cid
			}
		}
		local.i++
	}
	//clear any now-stale trailing slots from a longer PREVIOUS (file-restored) pin set
	local.i = local.n + 1
	while( local.i <= 5 ){
		local.player.flags["coop_pin" + local.i] = NIL
		local.i++
	}
	local.player.flags["coop_pinN"] = local.n
	waitthread chal_pin_save local.player
}end

//=========================================================================
// Pin/unpin by CATALOGUE INDEX - the channel the Service Record menu uses (name bus ',cp<NNN>').
// The menu is a client-side .urc and cannot know cids, only the baked row index, so it sends the
// index and we resolve it here. Everything off the name bus arrives as a STRING (player.scr wraps
// it in string()), so it MUST be int()-coerced before it indexes an array built with integer keys -
// comparing/indexing with the raw string throws and aborts this thread at that line while the
// caller still looks like it succeeded (bug-1352).
//
// [user 08-07] Was: waitthread chal_pin_toggle - which independently RE-DECIDES pinned/unpinned
// from self.flags["coop_pin*"], last synced at CONNECT (chal_pin_importUserinfo, chal_ensure).
// But CL_PinToggle_f (code/client/cl_main.cpp) already computed the DEFINITIVE new state and
// wrote it into the client's 5 userinfo cvars (coop_pin1..5) BEFORE sending this name-bus token -
// this dispatch is only a "something changed" notice, not a "toggle again" instruction. Toggling
// AGAIN here from possibly-stale flags could disagree with what the client just decided, and the
// resulting chal_pin_mark stufftext would silently overwrite the client's already-correct instant
// checkbox flip a moment later - looked exactly like "unpinning doesn't clear the checkbox".
// Fix: adopt userinfo as ground truth (chal_pin_importUserinfo, same call chal_ensure already
// trusts) instead of re-toggling, then push the live in-mission HUD sidebar to match.
//=========================================================================
chal_pin_byIndex local.player local.raw:{
	if( level.coop_chal_init != 1 ){ waitthread chal_init }
	if( local.player == NULL || local.raw == NIL || local.raw == "" ){ end }
	local.i = int( local.raw )
	if( local.i < 0 || local.i >= level.coop_chal_count ){
		println ( "^~^~^ CHAL pin: unknown challenge index " + local.raw )
		end
	}
	local.cid = level.coop_chal_id[local.i]
	if( local.cid == NIL || local.cid == "" ){ end }

	local.n = local.player.flags["coop_pinN"]
	if( local.n == NIL ){ local.n = 0 }
	local.wasPinned = 0
	local.j = 1
	while( local.j <= local.n ){
		if( local.player.flags["coop_pin" + local.j] == local.cid ){ local.wasPinned = 1 }
		local.j++
	}

	waitthread chal_pin_importUserinfo local.player

	local.n = local.player.flags["coop_pinN"]
	if( local.n == NIL ){ local.n = 0 }
	local.isPinned = 0
	local.j = 1
	while( local.j <= local.n ){
		if( local.player.flags["coop_pin" + local.j] == local.cid ){ local.isPinned = 1 }
		local.j++
	}

	//[user 08-07] failsafe: CL_PinToggle_f already refuses to pin a done challenge, but that's a
	//client-side check - a stale/hand-edited userinfo cvar could still hand this server a "pinned"
	//state for a completed cid. Force it back out server-side too, same as chal_pin_toggle's own
	//guard, so a done challenge can never actually occupy a pin slot regardless of how it got there.
	if( local.isPinned == 1 && local.player.flags["coop_chalD_" + local.cid] == 1 ){
		waitthread chal_pin_toggle local.player local.cid		//unpin branch: it's currently pinned, so this removes it
		local.isPinned = 0
		waitthread chal_pin_say local.player "Already complete - cannot pin: " local.cid
	}

	if( local.isPinned == 1 && local.wasPinned == 0 ){
		waitthread chal_pin_say local.player "Pinned: " local.cid
	} else if( local.isPinned == 0 && local.wasPinned == 1 ){
		waitthread chal_pin_say local.player "Unpinned: " local.cid
	}
	waitthread chal_pin_push local.player
}end

//=========================================================================
// Publish ONE pinned-row marker to the disconnected Service Record menu (ui/coop_sr.urc).
// That menu is client-side and reads archived cvars, so it cannot know cids - each row's marker is
// gated on coop_uiP<catalogue index>. Pushed one row at a time, only when a pin actually changes,
// which is why this costs a single reliable command per click rather than the ~281 that made the
// join-time challenge export a disconnect risk (bug-670).
// 'setas' so the flag survives the disconnect - the whole point is that the menu is browsed offline.
//=========================================================================
chal_pin_mark local.player local.cid local.on:{
	if( local.player == NULL || local.cid == NIL || local.cid == "" ){ end }
	local.idx = level.coop_chal_idx[local.cid]
	if( local.idx == NIL ){ end }
	//[user 2026-08-18] was "setas" - not a command in this engine (set/seta/setu/sets are), so
	//every SERVER-initiated marker update died as an unknown command client-side: the gold pin
	//marker never cleared when a pinned challenge completed and auto-unpinned. The engine-side
	//path (coop_pintoggle) flips the cvar locally and was never affected - which is why pin
	//clicks LOOKED fine while the server half silently failed. seta, so it also persists to
	//the disconnected menu like the rest of the Service Record state.
	local.player stufftext ( "seta coop_uiP" + local.idx + " " + local.on )
	//[user 2026-08-18] a never-finished repaint stub sat here as an empty if/else - removed.
}end

//=========================================================================
// At load: clear every marker, then re-publish this player's own pins. The clear is a single exec of
// a generated cfg (281 setas lines) rather than 281 stufftexts - the servercmd filter permits exec
// for ui/coop_* paths (cg_servercmds_filter.cpp:311). Without it a second profile on the same client
// would inherit the first profile's markers, since the flags are archived.
//=========================================================================
chal_pin_markAll local.player:{
	if( local.player == NULL ){ end }
	local.player stufftext "exec ui/coop_sr_pinclear.cfg"
	local.n = local.player.flags["coop_pinN"]
	if( local.n == NIL ){ local.n = 0 }
	local.i = 1
	while( local.i <= local.n ){
		waitthread chal_pin_mark local.player local.player.flags["coop_pin" + local.i] 1
		local.i++
	}
}end

//=========================================================================
// [user 2026-08-07] BreakTheGame.SCR - the 13 maps that still call global/stand.scr.
// The devs recorded themselves renaming it: "stand.scr" -> "formerly known as stop running dot
// scr" -> "occasionally stop running dot scr" -> "random behavior dot scr" -> "break the game dot
// scr" -> "soon to be known as eradicated from all my scripts dot scr" (retail m3l1a.scr, the dev
// quote wall). It was never eradicated: the file still ships at 175 bytes and these 13 maps still
// call it. List measured from OUR maps/*.scr, not the retail ones, so it matches what we ship.
//=========================================================================
chal_btg_isMap local.m:{
	local.r = 0
	if( local.m == "m1l2a" || local.m == "m1l3a" || local.m == "m2l1" || local.m == "m2l2a" ){ local.r = 1 }
	if( local.m == "m2l3" || local.m == "m3l1a" || local.m == "m3l1b" || local.m == "m3l2" ){ local.r = 1 }
	if( local.m == "m3l3" || local.m == "m4l1" || local.m == "m5l1b" || local.m == "t2l3" ){ local.r = 1 }
	if( local.m == "t3l2" ){ local.r = 1 }
	end local.r
}end

//=========================================================================
// [user 2026-08-11] STEALTH / U-529 HOOKS.
// Every one is team-scoped (chal_team_bump), because the spec is 'all players can earn':
// one player doing the thing earns it for the squad. Each is also self-latching, so a hook
// that can fire more than once per map (a second contain, a re-triggered investigation)
// cannot double-award.
//=========================================================================
chal_contain_done:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( level.coop_chal_containPaid != 1 ){
		level.coop_chal_containPaid = 1
		waitthread chal_team_bump "cc_pattern_disrupt" 1
	}
	//[user 2026-08-11] BAD RECEPTION - the contain that just happened was set up with the radio.
	//coop_radioBusy is true only while the officer is away on the errand (m6l1c), and is NIL on
	//every other map, so this cannot false-award anywhere else. Checked here rather than in
	//bust.scr so no map-specific state leaks into the shared contain path.
	if( level.coop_radioBusy == 1 && level.coop_chal_radioContainPaid != 1 ){
		level.coop_chal_radioContainPaid = 1
		waitthread chal_team_bump "cc_bad_reception" 1
	}
	//stamp for OSS Efficiency; level.time is seconds.
	level.coop_chal_containTime = level.time
	waitthread chal_oss_efficiency_check
}end

//=========================================================================
chal_body_blown:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( level.coop_chal_bodyPaid == 1 ){ end }
	level.coop_chal_bodyPaid = 1
	waitthread chal_team_bump "cc_dead_men_tales" 1
}end

//=========================================================================
// local.quiet = 1 when no scientist had been alerted at the moment of sabotage.
chal_naxos_done local.quiet:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( local.quiet == 1 && level.coop_chal_naxosPaid != 1 ){
		level.coop_chal_naxosPaid = 1
		waitthread chal_team_bump "cc_dead_static" 1
	}
	level.coop_chal_naxosTime = level.time
	waitthread chal_oss_efficiency_check
}end

//=========================================================================
// Both halves inside 30s, in either order, with no alarm ever raised. Called from both
// stamps so whichever lands second closes it.
chal_oss_efficiency_check:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( level.coop_chal_ossPaid == 1 ){ end }
	if( level.coop_chal_containTime == NIL || level.coop_chal_naxosTime == NIL ){ end }
	if( level.coop_alarmEver == 1 ){ end }
	local.gap = level.coop_chal_containTime - level.coop_chal_naxosTime
	if( local.gap < 0 ){ local.gap = 0 - local.gap }
	if( local.gap > 30 ){ end }
	level.coop_chal_ossPaid = 1
	waitthread chal_team_bump "cc_oss_efficiency" 1
}end

//=========================================================================
// Boarding U-529 (m2l2a::endlevel). Exactly one of the pair, decided by whether an alarm was
// EVER raised - not the live level.alarm, which is a toggle and can read 0 again after being
// switched back off (global/alarm_system.scr:688).
chal_u529_boarded:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( level.coop_chal_u529Paid == 1 ){ end }
	level.coop_chal_u529Paid = 1
	if( level.coop_alarmEver == 1 ){
		waitthread chal_team_bump "cc_alarm_alarm" 1
	}else{
		waitthread chal_team_bump "cc_shadow_u529" 1
	}
}end

//=========================================================================
// level.alarm is a TOGGLE, so any challenge that means 'was the base ever alerted' needs its
// own sticky latch. Started per map from chal_init; 0.5s poll is ample for a mission-scale fact.
chal_alarm_ever_watch:{
	if( level.coop_chal_alarmWatchRun == 1 ){ end }
	level.coop_chal_alarmWatchRun = 1
	while( level.coop_alarmEver != 1 ){
		if( level.alarm == 1 ){ level.coop_alarmEver = 1 }
		wait 0.5
	}
}end

//=========================================================================
// [user 2026-08-11] ALL HANDS ON DECK (m2l2b). Window: coop_exitthesub (first player off the
// ladder, which is also where the 'Eliminate the enemies and Exfiltrate' objective is raised)
// until gateopen (level.gatecount hits 0 = every counted defender dead). Fail on any DBNO or
// death, and on anyone crossing off the boat into the pen - the spec is to fight her from
// aboard.
// The aboard test is a distance from the SEGMENT bow->stern, not a radius: a U-boat is long and
// narrow, so a sphere big enough to cover her length would also cover most of the dock. The two
// endpoints come from the user in-game; until they are set the position test is SKIPPED rather
// than guessed, because a wrong boundary silently fails a challenge nobody can then earn.
//=========================================================================
chal_all_hands_start:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( level.coop_chal_deckRun == 1 ){ end }
	level.coop_chal_deckRun = 1
	level.coop_chal_deckClean = 1
	thread chal_all_hands_watch
	thread chal_gangway_watch
}end

//=========================================================================
chal_all_hands_watch:{
	while( level.coop_chal_deckRun == 1 && level.coop_chal_deckDone != 1 ){
		for( local.i = 1; local.i <= $player.size; local.i++ ){
			local.p = $player[local.i]
			if( local.p == NULL || local.p == NIL ){ continue }
			if( local.p.dmteam == "spectator" ){ continue }
			//down or dead - the spec is 'without anyone going down', so DBNO counts, not just death.
			if( local.p.flags["coop_dbno_active"] == 1 ){
				level.coop_chal_deckClean = 0
				println "^~^~^ ALLHANDS failed - a player went down"
			}
			if( !isAlive local.p ){
				level.coop_chal_deckClean = 0
				println "^~^~^ ALLHANDS failed - a player died"
			}
			//leaving the boat is caught by chal_gangway_watch, not measured here - see below.
		}
		wait 0.5
	}
}end

//=========================================================================
// [user 2026-08-11] LEAVING THE BOAT = CROSSING THE GANGWAY. The user confirmed she has exactly
// one crossing, narrow and impossible to vault, so a touch trigger on it is both simpler and
// stricter than any geometric test.
// It also solves the hatch for free. The ladder hatch teleports a player to a different part of
// the map entirely, so ANY 'are you near the hull' distance test would fail the challenge the
// moment somebody went below decks - which the user explicitly wants to stay legal. A teleport
// does not pass through the gangway, so this simply never fires for it. No special case needed.
// Inert until level.coop_chal_deckCross is set: a boundary in the wrong place would silently
// fail a challenge nobody could then earn, which is worse than not enforcing it yet.
//=========================================================================
chal_gangway_watch:{
	if( level.coop_chal_deckCross == NIL ){ end }
	local.w = level.coop_chal_deckCrossW
	if( local.w == NIL ){ local.w = 96 }

	local.trig = spawn trigger_multiple
	local.trig.origin = level.coop_chal_deckCross
	local.trig setsize ( ( 0 - local.w ) ( 0 - local.w ) -32 ) ( local.w local.w 128 )

	while( level.coop_chal_deckDone != 1 ){
		local.trig waittill trigger
		local.who = parm.other
		if( local.who == NULL || local.who == NIL ){ continue }
		if( local.who.classname != "Player" ){ continue }
		level.coop_chal_deckClean = 0
		println "^~^~^ ALLHANDS failed - a player crossed the gangway into the pen"
	}
	local.trig remove
}end
//=========================================================================
chal_all_hands_done:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( level.coop_chal_deckRun != 1 ){ end }
	if( level.coop_chal_deckDone == 1 ){ end }
	level.coop_chal_deckDone = 1
	if( level.coop_chal_deckClean != 1 ){
		println "^~^~^ ALLHANDS not awarded - the run was not clean"
		end
	}
	waitthread chal_team_bump "cc_all_hands" 1
}end

//=========================================================================
// [user 2026-08-11] THUNDER / FLASH (m3l2, Battle in the Bocage). The clock starts at
// scene1_german_presence - the BSP trigger in front of the house, which is what enables the
// defenders - and stops when scene1_german_defender_deathtracker falls through, which happens
// only after all eleven $scene1_german_defenderN are dead. That fall-through IS 'the house is
// clear'; no separate counter is needed and none can drift from it.
//=========================================================================
chal_bocage_start:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( level.coop_chal_bocageT != NIL ){ end }
	level.coop_chal_bocageT = level.time
}end

//=========================================================================
chal_bocage_done:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( level.coop_chal_bocagePaid == 1 ){ end }
	if( level.coop_chal_bocageT == NIL ){ end }
	level.coop_chal_bocagePaid = 1
	local.elapsed = level.time - level.coop_chal_bocageT
	println( "^~^~^ BOCAGE house cleared in " + local.elapsed + "s" )
	if( local.elapsed > 30 ){ end }
	waitthread chal_team_bump "cc_thunder_flash" 1
}end

//=========================================================================
// [user 2026-08-11] THE STORM RISES (m6l1c). Infiltrate stealthily, leave with a bang: the
// stealth has to hold from the truck cache all the way to the charge going off, and then the
// mission has to actually be completed.
// Two separate facts, so two separate calls. chal_storm_snapshot is taken INSIDE blowstuffup,
// before the escape raises the alarm itself - sampling after that would always read 'blown' and
// the challenge would be unearnable. chal_storm_done fires at the exfil trigger.
//=========================================================================
chal_storm_snapshot:{
	if( level.coop_chal_enabled != 1 ){ end }
	//stealth still live AND no alarm ever raised this mission. coop_startUnarmed is cleared by
	//coop_armOnBlown the instant cover breaks, and coop_alarmEver is the sticky latch (level.alarm
	//itself is a toggle and can read 0 again after being switched back off).
	level.coop_chal_stormClean = 0
	if( level.coop_startUnarmed == 1 && level.coop_alarmEver != 1 ){
		level.coop_chal_stormClean = 1
	}
	println( "^~^~^ STORM snapshot clean=" + level.coop_chal_stormClean )
}end

//=========================================================================
chal_storm_done:{
	if( level.coop_chal_enabled != 1 ){ end }
	if( level.coop_chal_stormPaid == 1 ){ end }
	if( level.coop_chal_stormClean != 1 ){ end }
	level.coop_chal_stormPaid = 1
	waitthread chal_team_bump "cc_storm_rises" 1
}end

//=========================================================================
// A BRIEF RESPITE - play BOTH instruments in the m6l2a music room, in either order.
// The two trigger_use entities there already call the map's own piano: and cello: labels via
// setthread, so the map hooks these; this only holds the two halves and pays once.
//=========================================================================
chal_respite_play local.what:{
//=========================================================================
	if( level.coop_chal_enabled != 1 ){ end }
	if( level.coop_chal_respitePaid == 1 ){ end }
	if( local.what == "piano" ){ level.coop_chal_respitePiano = 1 }
	if( local.what == "cello" ){ level.coop_chal_respiteCello = 1 }
	if( level.coop_chal_respitePiano != 1 ){ end }
	if( level.coop_chal_respiteCello != 1 ){ end }
	level.coop_chal_respitePaid = 1
	waitthread chal_team_bump "cc_brief_respite" 1
}end


//=========================================================================
// [user 2026-08-14] Alarm latch. Once the alarm has been raised on this map it stays raised for
// scoring, because every "without the alarm" feat means "not once", not "not right now".
// level.alarm and level.alarm_on are both watched: the vanilla alarm scripts use the first,
// the coop stealth layer (bust.scr) uses the second, and a map can trip either.
//=========================================================================
chal_alarm_watch:{
//=========================================================================
	while( 1 ){
		if( level.alarm || level.alarm_on == 1 || level.coop_bustLoud == 1 ){
			level.coop_chalAlarmEver = 1
			end
		}
		wait 2
	}
}end

//=========================================================================
// [user 2026-08-14] "Quiet" segment feats. A map calls this when the thing the challenge asks
// about is done; it pays out only if the alarm never went off. One helper for all of them, so a
// new quiet feat is one call from a map script rather than a new block of logic.
//   local.cid  - the stat to bump
// Team-scoped: these are squad outcomes, not individual ones.
//=========================================================================
chal_quiet_feat local.stat:{
//=========================================================================
	if( level.coop_chal_enabled != 1 ){ end }
	if( local.stat == NIL || local.stat == "" ){ end }
	if( level.coop_chalAlarmEver == 1 ){ end }
	if( level.coop_chalQuietPaid[local.stat] == 1 ){ end }
	level.coop_chalQuietPaid[local.stat] = 1
	waitthread chal_team_bump local.stat 1
	println( "^~^~^ CHAL quiet feat paid: " + local.stat )
}end
