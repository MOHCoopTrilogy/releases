	// ============ [user 2026-08-08] PICKED CHALLENGE BATCH ============
	// 25 of a 30-idea shortlist. Five were cut at the "does the variable hold the assumed value"
	// filter and are NOT defined here:
	//   Coastal Clean Sweep  - level.totalbaddies is a LIVE population gauge driving a respawner
	//                          (global/ai.scr:854 ++ on spawn, :976 -- on death), not a total, and
	//                          m1l3b refills it forever inside while(level.aircraft_intact > 0).
	//   Clip Their Wings     - m3l2:2853 flak20dead=1 sits in the mandatory path that removes
	//                          $level_end_blocker, so it is mission completion under another name.
	//   Needle Drop          - the only phonograph in the trilogy is $cp1_phonograph1, which
	//                          m6l2a:407 REMOVES. No sound trigger, no dialogue. Wiki claim, no data.
	//   The Devs Argued...   - already shipped as cc_breakthegame.
	//   behind-cover blindfire - already shipped as kt_blind ("Blind Faith").
	// Peacetime + the over-shoulder cover kill need engine fields; held for the next binary ship.

	// ---- cover kills: xp.scr:633 already COMPUTES isCoverKill and pays XP for it, but
	// ---- chal_ai_killed never bumped a stat for it. The else-branch there is the whole wiring.
	waitthread chal_def "kt_cover"          "combat"    "Behind the Sandbags"      "Get 25 kills from a cover pose or deployed cover"                             "coverkill"        25  ""
	waitthread chal_def "kt_cover_e"        "combat"    "Fire and Movement"        "Get 100 kills from a cover pose or deployed cover (Elite)"                    "coverkill"        100 "models/player/american_army_bar.tik"
	waitthread chal_def "cc_dug_in"         "combat"    "Dug In"                   "Get 10 kills from behind cover you deployed yourself"                         "coverown"         10  ""
	waitthread chal_def "cc_quartermaster"  "fireteam"    "Quartermaster"            "Resupply teammates 25 times from ammo boxes you placed"                       "ammoboxuse"       25  ""

