	//vehicle kills - it is the most numerous anti-tank weapon of the war, so the thing it
	//is for is the gate. The revolver on headshots, one rung above the C96's.
	waitthread chal_def "wpn_m10_unlock" "pistols" "Victory Model" "Get 250 headshots to unlock the S&W M10 .38" "headshot" 250 "models/weapons/m10_revolver.tik"
