	//automatic, so the thing it is for is breaking up a counter-attack.
	waitthread chal_def "wpn_dp28_unlock" "support_weapons" "Pan Fed" "Kill 200 reinforcements to unlock the DP-28" "reinf" 200 "models/weapons/dp28.tik"
