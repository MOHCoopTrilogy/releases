// ===== Surgical Operations 'KUN' HD iterations REMOVED per user (2026-07-10) - they were HD dupes of guns
// we already have. The zzzzz_kun_weapons.pk3 is pulled from deployment; nothing references the _kun tiks. =====

// ===== Grenades / smoke / rifle-grenade (ammo granted by developer.scr::give_all_weapons) =====
weapon weapons/m2frag_grenade_sp_start.tik
weapon weapons/steilhandgranate_start.tik
weapon weapons/mills_grenade_sp_start.tik
weapon weapons/it_w_bomba_sp_start.tik
weapon weapons/Russian_F1_grenade_sp_start.tik
// SMOKE variants: the coop itemhandler DELETES M18/RDG-1/Nebelhandgranate + dedups grenades by ammo
// type, BUT developer.scr::give_all_weapons turns the itemhandler OFF during the give, so all of
// these survive here (US / German / Russian national smokes + the coop's own signal smoke).
weapon weapons/M18_smoke_grenade_start.tik
weapon weapons/nebelhandgranate_start.tik
weapon weapons/RDG-1_Smoke_grenade_start.tik
weapon weapons/coop_smoke_grenade.tik
weapon weapons/kar98_mortar.tik

// ===== East imports (2026-08-17). Added as NEW guns, not replacements: his C96 ships as a Walther
// P38 replacement and his Johnson as an M1 Garand replacement, so both were re-pathed onto private
// meshes, shaders and textures instead. Fire sounds are ours (real C96 from our WWI library; our
// .30-06 Garand recording for the Johnson - same cartridge, same action). =====
weapon weapons/mauser_c96.tik
weapon weapons/johnson_m1941.tik
// Lt. Pato's DP-28 (ds-servers). Also a replacement - of the BAR - re-pathed the same way.
weapon weapons/dp28.tik
// East's Panzerfaust and S&W M10 .38 - both replacements (of the Panzerschreck and
// the Colt 45), re-pathed the same way as the rest.
weapon weapons/m10_revolver.tik
