+    }
+    cgi.Printf("^~^~^ RAINCOV%s\n", line);
+    memset(&g_hzmRS, 0, sizeof(g_hzmRS));
+    g_hzmBeamPoolFail = 0;
+    g_hzmBeamsUs      = 0;
