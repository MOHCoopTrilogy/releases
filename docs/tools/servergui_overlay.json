{
  "_README": "HAND-AUTHORED overlay for the server host GUI's settings catalogue. docs/tools/gen_server_catalogue.py (called by docgen.py build) merges it into docs/generated/server_settings.json. Holds ONLY what the code cannot say: grouping, labels, ranges, page placement, and what to hide. Every cvar name, default, flag, seed and description comes from the sweep. A name listed here that the sweep does not find is reported in the catalogue's 'overlay_unknown' list rather than invented.",

  "exclude_name_regex": [
    "^coop_selftest", "^coop_st_", "^coop_maptest", "^coop_regress", "^coop_discbot", "^coop_bot",
    "Probe$", "probe", "Debug$", "^coop_dbg", "Dbg$", "_dbg", "Test$", "^coop_test",
    "Step$", "Do$", "^coop_tileArt", "^coop_ded(Keep|Status|Log|Timeout)$", "^coop_report",
    "^coop_lobbyFresh$", "^coop_helmet(X|Y|Z|Pitch|Roll|Yaw)$", "^coop_campaignNext$", "^coop_prevMapList$", "^coop_modVersion$"
  ],
  "exclude_files_regex": [
    "coop_selftest", "discbot\\.scr$", "probe\\.scr$", "aiaudit\\.scr$", "ads_dbg\\.scr$", "maptest",
    "tracescan\\.scr$", "regression"
  ],

  "category_order": [
    "Players and lives", "Difficulty and AI", "Allies and squad", "Alarms and counter-attacks",
    "Weather and world", "Progression", "Campaign and lobby", "Multiplayer modes", "Admin", "Build mode",
    "Mission tuning", "Own-disc missions", "Engine coop features", "Engine game rules", "Engine server", "Other", "No shipped default"
