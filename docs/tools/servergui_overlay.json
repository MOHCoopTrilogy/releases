  "engine_server_dirs": ["server", "fgame", "gamespy"],
  "engine_qcommon_include": ["net_port", "net_ip", "net_enabled", "developer", "logfile", "sv_packetdelay"],
  "engine_exclude_flags": ["CVAR_ROM", "CVAR_CHEAT", "CVAR_INIT"],

  "server_tab": ["sv_hostname", "password", "rconPassword", "sv_maxclients", "net_port", "net_gamespy_port",
                 "sv_gamespy", "coop_campaign", "g_gametype", "dedicated", "com_target_game", "fs_basepath",
                 "fs_homepath", "logfile", "net_ip", "net_enabled", "developer", "config", "rconpassword"],
  "tuning_tab": ["sv_fps", "sv_maxRate", "sv_minRate", "sv_maxPing", "sv_minPing", "sv_timeout",
                 "sv_floodProtect", "sv_lanForceRate", "maxentities", "sv_privateClients", "sv_packetdelay",
                 "sv_allowDownload", "g_inactivespectate", "g_inactivekick", "g_teamkillwarn", "g_teamkillkick"],

  "overrides": {
    "coop_health":        { "label": "Player health", "category": "Players and lives", "type": "int", "min": 1, "max": 99999 },
    "coop_lmsLives":      { "label": "Last Man Standing lives (0 = off)", "category": "Players and lives", "type": "int", "min": 0, "max": 99 },
    "coop_dbno":          { "label": "Down-But-Not-Out revives", "category": "Players and lives", "type": "bool" },
    "coop_hardcore":      { "label": "Hardcore", "type": "bool" },
    "coop_campaign":      { "type": "bool" },
    "coop_dev":           { "label": "Developer cheats (noclip, console)", "type": "bool" },
    "coop_check":         { "label": "Admin password checks", "type": "bool" },
    "coop_paraShootdownChance": { "type": "int", "min": 0, "max": 100 },
    "coop_airstrikeFlakChance": { "type": "int", "min": 0, "max": 100 },
    "coop_paraGreaseChance":    { "type": "int", "min": 0, "max": 100 },
    "sv_fps":             { "label": "Server frames per second", "type": "int", "min": 10, "max": 120,
                            "description": "How many times a second the server simulates the world. The coop servers run 40." },
    "sv_maxRate":         { "label": "Max bytes/s per player (0 = no cap)", "type": "int", "min": 0, "max": 90000 },
    "sv_minRate":         { "label": "Min bytes/s per player (0 = none)", "type": "int", "min": 0, "max": 90000 },
    "sv_maxPing":         { "type": "int", "min": 0, "max": 9999 },
    "sv_minPing":         { "type": "int", "min": 0, "max": 9999 },
    "sv_timeout":         { "label": "Drop a player who sends nothing for (s)", "type": "int", "min": 10, "max": 3600,
                            "description": "120 = the engine default, the same as hosting from the game. A player who is still loading a map sends nothing, so a very slow PC on a big map can need more. It cannot be switched off: 0 would drop everyone at once, and a crashed player's slot is only freed by this timer." },
    "sv_floodProtect":    { "type": "bool" },
    "sv_lanForceRate":    { "type": "bool" },
    "sv_allowDownload":   { "type": "bool" },
    "sv_privateClients":  { "type": "int", "min": 0, "max": 64 },
    "maxentities":        { "label": "Entity pool (never above the engine's 4096)", "type": "int", "min": 1024, "max": 4096 },
    "sv_maxclients":      { "type": "int", "min": 1, "max": 64 },
    "g_inactivespectate": { "type": "int", "min": 0, "max": 86400 },
    "g_inactivekick":     { "type": "int", "min": 0, "max": 86400 },
    "g_teamkillwarn":     { "type": "int", "min": 0, "max": 99 },
    "g_teamkillkick":     { "type": "int", "min": 0, "max": 99 }
  }
}
