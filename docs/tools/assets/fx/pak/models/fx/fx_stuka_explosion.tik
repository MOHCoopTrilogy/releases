TIKI
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy2.skd
}

init
{

	server
	{
		classname Animate
		notsolid
		rendereffects +dontdraw
	}
	client
	{
		cache cfx_fire_tk.spr
		cache cfx_smoke_tk.spr
		cache cfx_puff.spr
		cache cfx_ember.spr
	}
}

animations
{
	idle dummy2.skc
	start dummy2.skc
	{

		server    
		{ 
			last commanddelay 1 anim idle
		}
		client
		{
entry commanddelay 0.100 originspawn
			(
				spawnrate 1.00
				model models/fx/bp_debris1.tik
				count 5
				color 1.00 1.00 1.00
				collision
				bouncefactor 0.30
				scale 1.50
				life 2.50
				velocity 500.00
				randvel crandom -60 crandom -50 0
				accel 0.00 0.00 -120.00
				angles crandom 20 crandom 30 crandom -30
				avelocity range 22 -50 range 22 -50 range 22 -50
				scalemin 0.05
				scalemax 0.20
				fade
				sphere
			)
entry originspawn
			(
				model models/fx/exp_dynamic2.tik
			)
		enter blockdlight 856 0.16
		(
			color 1.0 0.88 0.65
			colorvelocity -6 -6 -6
			scalerate -1.0
			offset 0 0 68
		)
		enter blockdlight 550 2.05
		(
			color 1.0 0.5 0.2
			colorvelocity -0.7 -0.45 -0.2
			scalerate -0.5
			offset 0 0 85
		)
		enter originspawn
		(
			model cfx_fire_tk.spr
			alpha 1.0
			life 1.6
			scale 1.054
			offset 0 0 81
		)
		enter commanddelay 0.50 originspawn
		(
			model cfx_smoke_tk.spr
			alpha 0.92
			life 7.0
			scale 2.040
			offset 0 0 91
			randvel 0 0 37
			accel 0 0 14
			fadein 0.4
			fadedelay 5.0
			color 0.55 0.53 0.52
			spritegridlighting 
		)
		enter commanddelay 0.35 originspawn
		(
			model cfx_puff.spr
			count 6
			alpha 0.5
			color 0.55 0.53 0.52
			life 8 2
			scale 0.935
			scalerate 0.2
			offset 0 0 85
			randvel crandom 14 crandom 14 range 76 144
			accel 0 0 6
			fadein 0.6
			fadedelay 3.5
			spritegridlighting 
		)
		enter originspawn
		(
			model cfx_ember.spr
			count 57
			offset 0 0 51
			randvel crandom 816 crandom 816 range 238 1190
			accel 0 0 -1400
			life 0.9 0.5
			scalemin 0.045
			scalemax 0.11
			color 1 0.78 0.4
			alpha 1
			fade 
			collision 
			bouncefactor 0.25
		)
		enter originspawn
		(
			model bh_dirt_piece.spr
			count 1
			offset 0 0 24
			velocity 0 0 -600
			life 0.3
			alpha 0.8
			fadein 0.3
			collision 
			bouncedecal 1 0
			decalshader coop_scorch
			decalradius 125
			dietouch 
		)
		enter commanddelay 0.10 hazeburst 255 0.90 2.8
		}
	}
}
