			scale 0.550
			scalerate 0.2
			offset 0 0 50
			randvel crandom 14 crandom 14 range 45 85
			accel 0 0 6
			fadein 0.6
			fadedelay 3.5
			spritegridlighting 
		)
		sfx originspawn
		(
			model cfx_ember.spr
			count 34
			offset 0 0 30
			randvel crandom 480 crandom 480 range 140 700
			accel 0 0 -1400
			life 0.9 0.5
