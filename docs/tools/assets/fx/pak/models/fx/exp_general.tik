		)
		sfx originspawn
		(
			model cfx_fire_fb.spr
			alpha 1.0
			life 1.0
			scale 0.750
			offset 0 0 48
		)
		delayedsfx 0.45 originspawn
		(
			model cfx_smoke_fb.spr
