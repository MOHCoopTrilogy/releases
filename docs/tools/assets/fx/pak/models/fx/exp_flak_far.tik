TIKI
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy2.skd
}

init
{

	client
	{
		cache cfx_fire_fb.spr
		cache cfx_smoke_fb.spr
		cache cfx_puff.spr
		cache cfx_ember.spr
	}
}

animations
{
	idle dummy2.skc
	{
		client
		{
		enter blockdlight 160 0.16
		(
			color 1.0 0.88 0.65
			colorvelocity -6 -6 -6
			scalerate -1.0
			offset 0 0 20
		)
		enter blockdlight 103 1.45
		(
			color 1.0 0.5 0.2
			colorvelocity -0.7 -0.45 -0.2
			scalerate -0.5
			offset 0 0 25
		)
		enter originspawn
		(
			model cfx_fire_fb.spr
			alpha 1.0
			life 1.0
			scale 0.375
			offset 0 0 24
		)
		enter commanddelay 0.45 originspawn
		(
			model cfx_smoke_fb.spr
			alpha 0.92
			life 4.0
			scale 0.475
			offset 0 0 27
			randvel 0 0 11
			accel 0 0 14
			fadein 0.4
			fadedelay 2.6
			color 0.55 0.53 0.52
			spritegridlighting 
		)
		enter commanddelay 0.35 originspawn
		(
			model cfx_puff.spr
			count 4
			alpha 0.5
			color 0.55 0.53 0.52
			life 6 2
			scale 0.275
			scalerate 0.2
			offset 0 0 25
			randvel crandom 14 crandom 14 range 22 42
			accel 0 0 6
			fadein 0.6
			fadedelay 3.5
			spritegridlighting 
		)
		enter commanddelay 0.10 hazeburst 75 0.90 2.1
		}
	}
}
