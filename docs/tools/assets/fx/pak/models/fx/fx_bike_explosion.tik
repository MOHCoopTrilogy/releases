TIKI
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy2.skd
}

init
{

	server
	{
		notsolid
		rendereffects +dontdraw
	}
	client
	{
		cache cfx_fire_fb.spr
		cache cfx_smoke_fb.spr
		cache cfx_puff.spr
		cache cfx_ember.spr
	}
}

animations
{
	idle dummy2.skc
	start dummy2.skc
	{

		server    
		{ 
			last commanddelay 1 anim idle
		}
		client
		{
entry commanddelay 0.100 originspawn
			(
				spawnrate 1.00
				model models/fx/bp_debris1.tik
				count 5
				color 1.00 1.00 1.00
				collision
				bouncefactor 0.30
				scale 0.10
				life 2.50
				velocity 500.00
				randvel crandom -60 crandom -50 0
				accel 0.00 0.00 -120.00
				angles crandom 20 crandom 30 crandom -30
				avelocity range 22 -50 range 22 -50 range 22 -50
				scalemin 0.05
				scalemax 0.20
				fade
				sphere
			)
entry commanddelay 0.200 originspawn
			(
				spawnrate 1.00
				model models/fx/ibeam_piece.tik
				count 5
				color 1.00 1.00 1.00
				scale 0.70
				life 2.00
				velocity 5000.00
				angles crandom -80 range -360 180 range 23 -64
				avelocity 0 crandom -50 0
				sphere
			)
		enter blockdlight 560 0.16
		(
			color 1.0 0.88 0.65
			colorvelocity -6 -6 -6
			scalerate -1.0
			offset 0 0 40
		)
		enter blockdlight 360 1.70
		(
			color 1.0 0.5 0.2
			colorvelocity -0.7 -0.45 -0.2
			scalerate -0.5
			offset 0 0 50
		)
		enter originspawn
		(
			model cfx_fire_fb.spr
			alpha 1.0
			life 1.0
			scale 0.750
			offset 0 0 48
		)
		enter commanddelay 0.45 originspawn
		(
			model cfx_smoke_fb.spr
			alpha 0.92
			life 4.0
			scale 0.950
			offset 0 0 54
			randvel 0 0 22
			accel 0 0 14
			fadein 0.4
			fadedelay 2.6
			color 0.50 0.48 0.47
			spritegridlighting 
		)
		enter commanddelay 0.35 originspawn
		(
			model cfx_puff.spr
			count 5
			alpha 0.5
			color 0.50 0.48 0.47
			life 7 2
			scale 0.550
			scalerate 0.2
			offset 0 0 50
			randvel crandom 14 crandom 14 range 45 85
			accel 0 0 6
			fadein 0.6
			fadedelay 3.5
			spritegridlighting 
		)
		enter originspawn
		(
			model cfx_ember.spr
			count 34
			offset 0 0 30
			randvel crandom 480 crandom 480 range 140 700
			accel 0 0 -1400
			life 0.9 0.5
			scalemin 0.045
			scalemax 0.11
			color 1 0.78 0.4
			alpha 1
			fade 
			collision 
			bouncefactor 0.25
		)
		enter originspawn
		(
			model bh_dirt_piece.spr
			count 1
			offset 0 0 24
			velocity 0 0 -600
			life 0.3
			alpha 0.8
			fadein 0.3
			collision 
			bouncedecal 1 0
			decalshader coop_scorch
			decalradius 78
			dietouch 
		)
		enter commanddelay 0.10 hazeburst 150 0.90 2.4
		}
	}
}
