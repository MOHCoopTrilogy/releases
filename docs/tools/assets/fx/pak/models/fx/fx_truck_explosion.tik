				life 2
				fadein 2
			)
		enter blockdlight 815 0.16
		(
			color 1.0 0.88 0.65
			colorvelocity -6 -6 -6
			scalerate -1.0
			offset 0 0 64
		)
		enter blockdlight 524 2.00
		(
			color 1.0 0.5 0.2
			colorvelocity -0.7 -0.45 -0.2
			scalerate -0.5
			offset 0 0 80
		)
		enter originspawn
		(
			model cfx_fire_tk.spr
			alpha 1.0
			life 1.6
			scale 0.992
			offset 0 0 76
		)
		enter commanddelay 0.50 originspawn
		(
			model cfx_smoke_tk.spr
			alpha 0.92
			life 7.0
			scale 1.920
			offset 0 0 86
			randvel 0 0 35
			accel 0 0 14
			fadein 0.4
			fadedelay 5.0
			color 0.50 0.48 0.47
