				offset crandom 10 crandom 10 random 10
				angles crandom 180 crandom 180 crandom 180
				avelocity crandom 50 crandom 50 crandom 70
				scalemin .1
				scalemax .6
				)
enter commanddelay .5 originspawn
			(
				model models/fx/heavy_pipe.tik
