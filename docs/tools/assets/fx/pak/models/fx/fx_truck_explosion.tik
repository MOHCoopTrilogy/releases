TIKI
setup
{
	scale 1.00
	path models/fx/dummy
	skelmodel dummy2.skd
}

init
{

	client
	{
		cache cfx_fire_tk.spr
		cache cfx_smoke_tk.spr
		cache cfx_puff.spr
		cache cfx_ember.spr
	}
}

animations
{
	aaaa dummy2.skc
	idle dummy2.skc
	{
		client
		{
enter commanddelay .2 originspawn
			(
				model models/fx/bp_debris1.tik
				count 8
				varycolor
				life 2.5
