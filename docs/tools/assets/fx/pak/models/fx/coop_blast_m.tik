TIKI
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy2.skd
}

init
{
	server
	{
		classname Animate
		notsolid
		rendereffects +dontdraw
		life 0
	}
	client
	{
		cache cfx_fire_fb.spr
		cache cfx_smoke_fb.spr
		cache cfx_puff.spr
		cache cfx_ember.spr
	}
}

animations
{
	idle dummy2.skc
	start dummy2.skc
	{
		server
		{
			last commanddelay 1 anim idle
		}
		client
		{
		enter blockdlight 690 0.16
		(
			color 1.0 0.88 0.65
			colorvelocity -6 -6 -6
			scalerate -1.0
			offset 0 0 52
		)
		enter blockdlight 444 1.85
		(
			color 1.0 0.5 0.2
			colorvelocity -0.7 -0.45 -0.2
			scalerate -0.5
			offset 0 0 65
		)
		enter originspawn
		(
			model cfx_fire_fb.spr
			alpha 1.0
			life 1.0
			scale 0.975
			offset 0 0 62
		)
		enter commanddelay 0.45 originspawn
		(
			model cfx_smoke_fb.spr
			alpha 0.92
			life 4.0
			scale 1.235
			offset 0 0 70
			randvel 0 0 28
			accel 0 0 14
			fadein 0.4
			fadedelay 2.6
			color 0.55 0.52 0.50
			spritegridlighting 
		)
		enter commanddelay 0.35 originspawn
		(
			model cfx_puff.spr
			count 5
			alpha 0.5
			color 0.55 0.52 0.50
			life 8 2
			scale 0.715
			scalerate 0.2
			offset 0 0 65
			randvel crandom 14 crandom 14 range 58 110
			accel 0 0 6
			fadein 0.6
			fadedelay 3.5
			spritegridlighting 
		)
		enter originspawn
		(
			model cfx_ember.spr
			count 44
			offset 0 0 39
			randvel crandom 624 crandom 624 range 182 910
			accel 0 0 -1400
			life 0.9 0.5
			scalemin 0.045
			scalemax 0.11
			color 1 0.78 0.4
			alpha 1
			fade 
			collision 
			bouncefactor 0.25
		)
		enter originspawn
		(
			model bh_dirt_piece.spr
			count 1
			offset 0 0 24
			velocity 0 0 -600
			life 0.3
			alpha 0.8
			fadein 0.3
			collision 
			bouncedecal 1 0
			decalshader coop_scorch
			decalradius 98
			dietouch 
		)
		enter commanddelay 0.10 hazeburst 195 0.90 2.6
		}
	}
}
