TIKI
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy3.skd
}

init
{

	server
	{
		classname effectentity
		notsolid
		rendereffects +dontdraw
		angles 270 0 0
	}
	client
	{
		cache cfx_fire_tk.spr
		cache cfx_smoke_tk.spr
		cache cfx_puff.spr
		cache cfx_ember.spr
	}
}

animations
{
	idle dummy3.skc
	start dummy3.skc
	{

		server
		{
			last commanddelay 1 anim idle
		}
		client
		{
enter sound bazooka_exp
enter originspawn
			(
				model models/emitters/higgins_mushroom.tik
				offset -50 0 0
				randvel 0 0 64
				friction 0.3
				life 5
				anim idle
			)
		enter blockdlight 975 0.16
		(
			color 1.0 0.88 0.65
			colorvelocity -6 -6 -6
			scalerate -1.0
			offset 0 0 80
		)
		enter blockdlight 626 2.20
		(
			color 1.0 0.5 0.2
			colorvelocity -0.7 -0.45 -0.2
			scalerate -0.5
			offset 0 0 100
		)
		enter originspawn
		(
			model cfx_fire_tk.spr
			alpha 1.0
			life 1.6
			scale 1.240
			offset 0 0 96
		)
		enter commanddelay 0.50 originspawn
		(
			model cfx_smoke_tk.spr
			alpha 0.92
			life 7.0
			scale 2.400
			offset 0 0 108
			randvel 0 0 44
			accel 0 0 14
			fadein 0.4
			fadedelay 5.0
			color 0.50 0.48 0.47
			spritegridlighting 
		)
		enter commanddelay 0.35 originspawn
		(
			model cfx_puff.spr
			count 7
			alpha 0.5
			color 0.50 0.48 0.47
			life 9 2
			scale 1.100
			scalerate 0.2
			offset 0 0 100
			randvel crandom 14 crandom 14 range 90 170
			accel 0 0 6
			fadein 0.6
			fadedelay 3.5
			spritegridlighting 
		)
		enter originspawn
		(
			model cfx_ember.spr
			count 68
			offset 0 0 60
			randvel crandom 960 crandom 960 range 280 1400
			accel 0 0 -1400
			life 0.9 0.5
			scalemin 0.045
			scalemax 0.11
			color 1 0.78 0.4
			alpha 1
			fade 
			collision 
			bouncefactor 0.25
		)
		enter originspawn
		(
			model bh_dirt_piece.spr
			count 1
			offset 0 0 24
			velocity 0 0 -600
			life 0.3
			alpha 0.8
			fadein 0.3
			collision 
			bouncedecal 1 0
			decalshader coop_scorch
			decalradius 145
			dietouch 
		)
		enter commanddelay 0.10 hazeburst 300 0.90 3.0
		}
	}
}
