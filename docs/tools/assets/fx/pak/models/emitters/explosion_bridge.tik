TIKI
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy3.skd
}

init
{

	server
	{
		classname effectentity
		notsolid
		rendereffects +dontdraw
		angles 270 0 0
	}
	client
	{
		cache cfx_fire_tk.spr
		cache cfx_smoke_tk.spr
		cache cfx_puff.spr
		cache cfx_ember.spr
	}
}

animations
{
	idle dummy3.skc
	start dummy3.skc
	{

		server
		{
			last commanddelay 1 anim idle
		}
		client
		{
enter sound explode_bridge
		enter blockdlight 815 0.16
		(
			color 1.0 0.88 0.65
			colorvelocity -6 -6 -6
			scalerate -1.0
			offset 0 0 64
		)
		enter blockdlight 524 2.00
		(
			color 1.0 0.5 0.2
			colorvelocity -0.7 -0.45 -0.2
			scalerate -0.5
			offset 0 0 80
		)
		enter originspawn
		(
			model cfx_fire_tk.spr
			alpha 1.0
			life 1.6
			scale 0.992
			offset 0 0 76
		)
		enter commanddelay 0.50 originspawn
		(
			model cfx_smoke_tk.spr
			alpha 0.92
			life 7.0
			scale 1.920
			offset 0 0 86
			randvel 0 0 35
			accel 0 0 14
			fadein 0.4
			fadedelay 5.0
			color 0.58 0.56 0.54
			spritegridlighting 
		)
		enter commanddelay 0.35 originspawn
		(
			model cfx_puff.spr
			count 6
			alpha 0.5
			color 0.58 0.56 0.54
			life 8 2
			scale 0.880
			scalerate 0.2
			offset 0 0 80
			randvel crandom 14 crandom 14 range 72 136
			accel 0 0 6
			fadein 0.6
			fadedelay 3.5
			spritegridlighting 
		)
		enter originspawn
		(
			model cfx_ember.spr
			count 54
			offset 0 0 48
			randvel crandom 768 crandom 768 range 224 1120
			accel 0 0 -1400
			life 0.9 0.5
			scalemin 0.045
			scalemax 0.11
			color 1 0.78 0.4
			alpha 1
			fade 
			collision 
			bouncefactor 0.25
		)
		enter originspawn
		(
			model bh_dirt_piece.spr
			count 1
			offset 0 0 24
			velocity 0 0 -600
			life 0.3
			alpha 0.8
			fadein 0.3
			collision 
			bouncedecal 1 0
			decalshader coop_scorch
			decalradius 119
			dietouch 
		)
		enter commanddelay 0.10 hazeburst 240 0.90 2.8
		}
	}
}
