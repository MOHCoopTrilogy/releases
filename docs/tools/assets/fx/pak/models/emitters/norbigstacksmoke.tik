TIKI
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy3.skd
}

init
{

	server
	{
		classname effectentity
		notsolid
		rendereffects +dontdraw

	}
	client
	{
		cache cfx_puff.spr
		cache cfx_flame.spr
		cache cfx_ember.spr
originemitter col
		(
			spawnrate 5.0
			model cfx_puff.spr
			color 0.36 0.35 0.34
			alpha 0.7
			life 14.0 4.2
			scale 1.100
			scalerate 0.4
			offset crandom 12 crandom 12 60
			randvel crandom 10 crandom 10 range 90 180
			accel crandom 8 crandom 8 16
			fadein 0.8
			fadedelay 8.4
			spritegridlighting 
		)
	}
}

animations
{
	idle dummy3.skc
	start dummy3.skc
	{
		client
		{
			enter emitteron col
		}
	}
	stop dummy3.skc
	{
		client
		{
			enter emitteroff col
		}
	}
}
