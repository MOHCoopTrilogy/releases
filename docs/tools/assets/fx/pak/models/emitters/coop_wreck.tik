TIKI
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy3.skd
}

init
{
	server
	{
		classname effectentity
		notsolid
		rendereffects +dontdraw
	}
	client
	{
originemitter flame
		(
			spawnrate 6.3
			model cfx_flame.spr
			fadein 0.12
			fadedelay 0.64
			alpha 1
			life 1.07
			scale 1.690
			scalemin 0.9
			scalemax 1.15
			offset crandom 9 crandom 9 2
			randvel crandom 3 crandom 3 range 0 10
		)
originemitter embers
		(
			spawnrate 13.0
			model cfx_ember.spr
			color 1 0.62 0.22
			alpha 1
			life 2.2 1.2
			scale 0.011
			scalemin 0.7
			scalemax 1.6
			offset crandom 12 crandom 12 10
			randvel crandom 28 crandom 28 range 40 120
			accel crandom 14 crandom 14 36
			friction 0.35
			fadedelay 1.2
			fade 
		)
originemitter lt
		(
			firelight 1.0 0.5 0.18 630 0.25
			offset 0 0 74
		)
originemitter hz
		(
			hazespot 206 0.85
		)
originemitter col
		(
			spawnrate 4.0
			model cfx_puff.spr
			color 0.22 0.21 0.20
			alpha 0.75
			life 11.0 3.3
			scale 0.715
			scalerate 0.4
			offset crandom 12 crandom 12 39
			randvel crandom 10 crandom 10 range 58 117
			accel crandom 8 crandom 8 16
			fadein 0.8
			fadedelay 6.6
			spritegridlighting 
		)
	}
}

animations
{
	idle dummy3.skc
	start dummy3.skc
	{
		client
		{
			enter emitteron flame
			enter emitteron embers
			enter emitteron lt
			enter emitteron hz
			enter emitteron col
		}
	}
	stop dummy3.skc
	{
		client
		{
			enter emitteroff flame
			enter emitteroff embers
			enter emitteroff lt
			enter emitteroff hz
			enter emitteroff col
		}
	}
}
