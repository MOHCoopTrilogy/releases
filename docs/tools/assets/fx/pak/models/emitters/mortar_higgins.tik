			color 0.55 0.52 0.50
			spritegridlighting 
		)
		enter commanddelay 0.35 originspawn
		(
			model cfx_puff.spr
			count 4
			alpha 0.5
			color 0.55 0.52 0.50
			life 7 2
			scale 0.468
			scalerate 0.2
			offset 0 0 42
			randvel crandom 14 crandom 14 range 38 72
			accel 0 0 6
			fadein 0.6
			fadedelay 3.5
			spritegridlighting 
		)
		enter commanddelay 0.15 originspawn
		(
			model cfx_dust.spr
			alpha 0.85
			life 3.4
			scale 0.765
			offset 0 0 34
			randvel 0 0 34
			accel 0 0 10
			fadein 0.2
			fadedelay 1.9
			color 0.62 0.50 0.36
