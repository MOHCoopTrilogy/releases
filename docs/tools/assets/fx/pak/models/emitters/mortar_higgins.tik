TIKI
setup
{
	scale 1.0
	path models/fx/dummy
	skelmodel dummy3.skd
}

init
{

	server  
	{
		classname Animate
		notsolid
		rendereffects +dontdraw
		angles 270 0 0
	}
	client
	{
		cache cfx_fire_fb.spr
		cache cfx_smoke_fb.spr
		cache cfx_puff.spr
		cache cfx_ember.spr
	}
}

animations
{
	idle dummy3.skc
	start dummy3.skc
	{

		server
		{
			last commanddelay 1 anim idle
		}
		client
		{
enter originspawn
			(
				model models/emitters/higgins_mushroom.tik
				offset 0 0 256
				randvel 0 0 64
				friction 0.3
				life 5
				anim idle
			)
		enter blockdlight 491 0.16
		(
			color 1.0 0.88 0.65
			colorvelocity -6 -6 -6
			scalerate -1.0
			offset 0 0 34
		)
		enter blockdlight 316 1.62
		(
			color 1.0 0.5 0.2
			colorvelocity -0.7 -0.45 -0.2
			scalerate -0.5
			offset 0 0 42
		)
		enter originspawn
		(
			model cfx_fire_fb.spr
			alpha 1.0
			life 1.0
			scale 0.382
			offset 0 0 40
		)
		enter commanddelay 0.45 originspawn
		(
			model cfx_smoke_fb.spr
			alpha 0.92
