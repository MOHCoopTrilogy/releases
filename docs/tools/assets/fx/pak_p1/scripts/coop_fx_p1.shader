// [smoke&fire Phase 1] scorch variants (docs/proposals/smokefire_2026-11-24/tools/gen_scorch.py, our own procedural
// art): picked at random per blast by cgame when cg_hzmScorchVar is 1; same blend as coop_scorch (rgb/alpha from the mark).

coop_scorch_a
{
	polygonOffset
	{
		map textures/coop_fx/fx/scorch_a.tga
		blendFunc blend
		rgbGen vertex
		alphaGen vertex
	}
}

