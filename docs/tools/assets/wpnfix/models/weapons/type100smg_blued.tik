TIKI
setup
{
	scale 0.52			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/weapons/highstandard
	skelmodel type100.skd
	surface Skin* shader coop_skin_type100smg_blued
	surface Clip shader coop_skin_type100smg_blued
}
$define sounddir sound/weapons

init
{
	server
	{
//		surface tag* +nodraw
//		surface origin +nodraw

		classname		Weapon
		weapontype		smg
		name			"Type 100 SMG (Blued)"
		rank			1121 1121


		pickupsound		silencer_snd_pickup
		ammopickupsound	silencer_snd_pickup_ammo
		noammosound		silencer_snd_noammo

		// Holstering info
holstertag				"Bip01 Pelvis"
holsteroffset			"1.5 -4 -10.0"
holsterangles			"5 190 195"
holsterScale			1.0

		// Primary fire type info
		firetype		bullet
		ammotype		"smg"
		meansofdeath	bullet
//		//semiauto
		bulletcount		1
		clipsize		30
		startammo		60
		ammorequired	1
		firedelay		0.096
		bulletrange		4000	 			//the range at which bulletspread is applied
		bulletspread	53 53 70 70 		//minpitch minyaw maxpitch maxyaw
		bulletdamage 	24
		firespreadmult	0.08 0.35 200 0.25 	//add falloff cap maxtime
		movementspeed 	1.0

		tracerfrequency 2


		crosshair		1
		

		secondary firetype			melee
		secondary ammotype			none
		secondary meansofdeath		bash
		secondary ammorequired		0
		secondary bulletrange		64
		secondary bulletdamage		45
		secondary bulletknockback	50
		secondary quiet

		// AI animation group info
		weapongroup		xw_type100smg

		// DM Attributes
		dmbulletcount	1
		dmstartammo		90
		dmammorequired	1
		dmfiredelay		0.096
		dmbulletrange	4000
		dmbulletspread	38 38 50 50	 	
		dmfirespreadmult	0.3 0.6 150 0.25	
		dmbulletdamage	25			
		dmmovementspeed	1.0


		// Secondary fire DM Attributes
		secondary dmammorequired	0
		secondary dmbulletrange		96
		secondary dmbulletdamage	45
		
		// this is attached to the player during reload
		cache models/ammo/type100_clip.tik
	}
	client
	{
		aliascache coop_sten_reload_loaded sound/weapons/foley/coop_sten_reload_loaded.wav soundparms 1.5 0.0 1.0 0.05 160 1000 item loaded always maps "m e t dm obj lib" // HZM coop [smg rounds-left reload sound]
		cache tracer.spr
		cache muzsprite.spr
		cache models/ammo/pistolshell.tik
	}
}

animations
{
	idle     coop_type100_reload.skc
	// HZM coop [smg action rows] open bolt: the handle rests back, runs forward and back per shot, stays forward on empty
	idle_empty	coop_type100_idle_empty.skc
	fire_empty    coop_type100_fire_empty.skc
	{
		server
		{
			entry shoot primary
		}
		client
		{
			entry stopaliaschannel WaWtype100_fire
			entry sound WaWtype100_fire

			// By now, the server has already fired the weapon, so it's
			// ok to apply the view kick apon entry to avoid problems
			// with multiple application on single frame animations.

			////////////////////////////////////////////////////////////////////////////////////////
			// View Kick Controls
			//
			// View Kicking works based on the assumptions that every weapon has its own tendencies to kick in
			// a paticular fashion. In MOH we call then scatter patterns. Currently we have 2 scatter patterns which
			// will be explained.
			// Scatter Patterns:
			// "V" - the cone. The longer you shoot the more random your shots will be in the horizontal axis.
			// "T" - the T shape. The gun has a tendancy to push in a paticular direction. not used much...too artificial looking
			//
			//
			//             		+-------------------------------------------- Scatter Pitch Min
			//              		|    +--------------------------------------- Scatter Pitch Max
			//              		|    |       +------------------------------- Scatter Yaw Min
			//             		|    |       |   +--------------------------- Scatter Yaw Max
			//             		|    |       |   |     +--------------------- The Recentering speed in fraction per second
			//              		|    |       |   |     |    +---------------- The Scatter Pattern
			//              		|    |       |   |     |    |     +---------- The absolute pitch min/max
			//              		|    |       |   |     |    |     |  +------- The absolute yaw min/max
			//              		|    |       |   |     |    |     |  | +----- This is the pitch at which you loose all
			//              		|    |       |   |     |    |     |  | |      control of the weapon and its behavior is
			//             	 	|    |       |   |     |    |     |  | |      purely random.
			//				V    V       V   V     V    V     V  V V

			entry viewkick 	    -0.2 -0.2   0.0  0.0    1   "V"    3.0 1.0 1.6


			// muzzle flash
			entry tagdlight tag_barrel 0.25 0.2 0.15 120 0.11
			entry tagspawn tag_barrel
			(
				scale 0.2
				offsetalongaxis 2 0 0
				count 1
				alpha 0.5
				model muzsprite.spr
				angles 0 0 crandom 25
				life 0.01
			)

			// smoke puff
			entry commanddelay 0.05 tagspawn tag_barrel
			(
				volumetric
				model gun			// sets the type of smoke
				life 10				// amount of smoke
				scale 1.0			// radius
				alpha 0.3			// density
				color 0.7 0.7 0.7		// RBG color of the smoke
				velocity 2			// base velocity away from the surface
				randvelaxis random 6 0 0	// velocity offset
				offsetalongaxis random 4 0 0	// positional offset
			)

			// shell eject
			entry commanddelay 0.1 tagspawn tag_eject
			(
				count 1
				model models/ammo/pistolshell.tik
				spawnrange 1024
				scale 0.8  //HZM caliber
				velocity 50
				randvel crandom 10 crandom 10 random 20
				emitterangles 0 0 0
				avelocity crandom 90 crandom 90 0
				accel 0 0 -800
				physicsrate 20
				life 2.0
				fadedelay 1.7
				collision
				bouncefactor 0.6
				bouncesoundonce snd_pistol_shell
			)

			// shell eject puff
			entry commanddelay 0.1 tagspawn tag_eject
			(
				count 2
				model vsssource.spr
				alpha 0.30
				color 0.50 0.50 0.50
				spritegridlighting
				scale 0.10
				life 1.00
				scalerate 10.00
				velocity 60.00
				randvel range 20 -60 crandom -40 range 20 -60
				friction 5.00
				fade
				randomroll
			)
		}
	}
	reload_empty	coop_type100_reload_empty.skc
	{
		client
		{
				entry sound sten_reload item
		}
	}
	reload_ads_empty	coop_type100_reload_ads_empty.skc
	{
		client
		{
				entry sound sten_reload item
		}
	}
	// HZM coop [smg action rows end]
	reload	 coop_type100_reload.skc
	{
		server
		{
			10 surface Clip +nodraw
			48 surface Clip -nodraw
			last idle
		}
		client
		{
				entry sound coop_sten_reload_loaded item
		}

	}
	reload_s	 coop_type100_reload_s.skc
	{
		server
		{
			8 surface Clip +nodraw
			38 surface Clip -nodraw
			last idle
		}
		client
		{
				entry sound coop_sten_reload_loaded item
		}

	}
	reload_m	 coop_type100_reload_m.skc
	{
		server
		{
			8 surface Clip +nodraw
			51 surface Clip -nodraw
			last idle
		}
		client
		{
				entry sound coop_sten_reload_loaded item
		}

	}
	reload_empty_s	coop_type100_reload_empty_s.skc
	{
		client
		{
				entry sound sten_reload item
		}
	}
	reload_empty_m	coop_type100_reload_empty_m.skc
	{
		client
		{
				entry sound sten_reload item
		}
	}
	reload_ads_empty_s	coop_type100_reload_ads_empty_s.skc
	{
		client
		{
				entry sound sten_reload item
		}
	}
	reload_ads_empty_m	coop_type100_reload_ads_empty_m.skc
	{
		client
		{
				entry sound sten_reload item
		}
	}
	secondaryfire     coop_type100_held_hs_pistol.skc
	{
		server
		{
			entry shoot secondary
		}
	}
	fire    coop_type100_fire.skc
	{
		server
		{
			entry shoot primary
		}
		client
		{
			entry stopaliaschannel WaWtype100_fire
			entry sound WaWtype100_fire

			// By now, the server has already fired the weapon, so it's
			// ok to apply the view kick apon entry to avoid problems
			// with multiple application on single frame animations.

			////////////////////////////////////////////////////////////////////////////////////////
			// View Kick Controls
			//
			// View Kicking works based on the assumptions that every weapon has its own tendencies to kick in
			// a paticular fashion. In MOH we call then scatter patterns. Currently we have 2 scatter patterns which
			// will be explained.
			// Scatter Patterns:
			// "V" - the cone. The longer you shoot the more random your shots will be in the horizontal axis.
			// "T" - the T shape. The gun has a tendancy to push in a paticular direction. not used much...too artificial looking
			//
			//
			//             		+-------------------------------------------- Scatter Pitch Min
			//              		|    +--------------------------------------- Scatter Pitch Max
			//              		|    |       +------------------------------- Scatter Yaw Min
			//             		|    |       |   +--------------------------- Scatter Yaw Max
			//             		|    |       |   |     +--------------------- The Recentering speed in fraction per second
			//              		|    |       |   |     |    +---------------- The Scatter Pattern
			//              		|    |       |   |     |    |     +---------- The absolute pitch min/max
			//              		|    |       |   |     |    |     |  +------- The absolute yaw min/max
			//              		|    |       |   |     |    |     |  | +----- This is the pitch at which you loose all
			//              		|    |       |   |     |    |     |  | |      control of the weapon and its behavior is
			//             	 	|    |       |   |     |    |     |  | |      purely random.
			//				V    V       V   V     V    V     V  V V

			entry viewkick 	    -0.2 -0.2   0.0  0.0    1   "V"    3.0 1.0 1.6


			// muzzle flash
			entry tagdlight tag_barrel 0.25 0.2 0.15 120 0.11
			entry tagspawn tag_barrel
			(
				scale 0.2
				offsetalongaxis 2 0 0
				count 1
				alpha 0.5
				model muzsprite.spr
				angles 0 0 crandom 25
				life 0.01
			)

			// smoke puff
			entry commanddelay 0.05 tagspawn tag_barrel
			(
				volumetric
				model gun			// sets the type of smoke
				life 10				// amount of smoke
				scale 1.0			// radius
				alpha 0.3			// density
				color 0.7 0.7 0.7		// RBG color of the smoke
				velocity 2			// base velocity away from the surface
				randvelaxis random 6 0 0	// velocity offset
				offsetalongaxis random 4 0 0	// positional offset
			)

			// shell eject
			entry commanddelay 0.1 tagspawn tag_eject
			(
				count 1
				model models/ammo/pistolshell.tik
				spawnrange 1024
				scale 0.8  //HZM caliber
				velocity 50
				randvel crandom 10 crandom 10 random 20
				emitterangles 0 0 0
				avelocity crandom 90 crandom 90 0
				accel 0 0 -800
				physicsrate 20
				life 2.0
				fadedelay 1.7
				collision
				bouncefactor 0.6
				bouncesoundonce snd_pistol_shell
			)

			// shell eject puff
			entry commanddelay 0.1 tagspawn tag_eject
			(
				count 2
				model vsssource.spr
				alpha 0.30
				color 0.50 0.50 0.50
				spritegridlighting
				scale 0.10
				life 1.00
				scalerate 10.00
				velocity 60.00
				randvel range 20 -60 crandom -40 range 20 -60
				friction 5.00
				fade
				randomroll
			)
		}
	}
}

/*QUAKED playerweapon_allied_highstandard-pistol (0.0 0.0 1.0) (-8 -8 -8) (8 8 8)
American highperformance Pistol
*/
