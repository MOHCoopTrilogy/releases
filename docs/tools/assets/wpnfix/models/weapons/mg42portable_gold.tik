TIKI
// [reload audit phase B 2026-10-05] MOD COPY of the xw pack's mg42portable.tik (zzzzz_xw_weapons.pk3), identical except the reload
// block and the cached belt prop - the mod pk3 sorts after the xw pack, so this copy wins.
setup
{
	scale 0.52
	path models/weapons/mg42portable
	skelmodel mg42.skd

	surface mg421 shader coop_skin_mg42portable_gold
	surface mg422 shader coop_skin_mg42portable_gold
	surface shellbelt shader coop_skin_30calportable_gold_0
}

init
{
	server
	{
		classname		Weapon
		weapontype		mg
		name			"MG42 (Gold)"
		rank			1140 1140

		pickupsound		bar_snd_pickup
		ammopickupsound	bar_snd_pickup_ammo
		noammosound		bar_snd_noammo

		// Holstering info
holstertag				"Bip01 Spine2"
holsteroffset			"8.0 -7.75 6.5"
holsterangles			"0 185 -25"
holsterScale			1.0

		// Primary fire type info
		firetype		bullet
		ammotype		"mg"
		meansofdeath		bullet
		bulletcount		2
		clipsize		120
		startammo		120
		ammorequired		1
		firedelay		0.06
		bulletrange		4000
		bulletspread		11 11 45 45
		firespreadmult		0.38 0.61 200 0.6
		bulletdamage		60
		crosshair		1
		movementspeed		0.6

		tracerfrequency 	3

		// AI animation group info
		weapongroup		bar

		// DM Attributes
		dmbulletcount		2
		dmstartammo		150
		dmammorequired		1
		dmfiredelay		0.07
		dmbulletrange		4000
		dmbulletspread		13 13 60 60
		dmfirespreadmult	0.39 0.62 170 0.6
		dmbulletdamage		60
		dmcrosshair		1
		dmmovementspeed		0.6
		// [v1.10.41] coop pickup handler, as bazooka.tik: a dropped copy (player death) stays pickupable
		exec coop_mod/itemhandler.scr "initialiseItem" "mg" "MG42"
	}
	client
	{
		cache models/ammo/coop_belt_mg42.tik	// [reload audit phase B] belt prop
		cache muzsprite.spr
		cache models/ammo/rifleshell.tik
		cache models/fx/muzflash.tik
		cache vsssource.spr
	}
}

animations
{
	idle		mg42.skc
	idle_empty	mg42.skc
	{
		server
		{
			entry surface shellbelt +nodraw
		}
	}
	//[reload audit phase B polish 2026-10-05] BELT reload, hand-keyed (keyclip.py / beltsched.py, one timeline):
	//cocking handle (its own bone) pulled back and pushed forward by hand f8-17, latch f22, cover lifted f24-32 and
	//flicked open, the old belt end stripped out left and a new one laid in and seated (belt prop f43-69, the gun's belt
	//hidden f45-67), cover pulled down and slapped shut f74-82.
	reload 		coop_mg42_reload.skc
	{
		server
		{
			45 surface shellbelt +nodraw
			67 surface shellbelt -nodraw
			last idle
		}
		client
		{
			entry sound bar_snd_reload
		}
	}
	reload_s 		coop_mg42_reload_s.skc
	{
		server
		{
			36 surface shellbelt +nodraw
			54 surface shellbelt -nodraw
			last idle
		}
		client
		{
			entry sound bar_snd_reload
		}
	}
	reload_m 		coop_mg42_reload_m.skc
	{
		server
		{
			36 surface shellbelt +nodraw
			65 surface shellbelt -nodraw
			last idle
		}
		client
		{
			entry sound bar_snd_reload
		}
	}
	fire		mg42.skc
	{
		server
		{
			entry shoot
		}
		client
		{
			entry stopaliaschannel mg42_gun_snd_fire
			entry sound mg42_gun_snd_fire

			entry viewkick 	     -2.6 -2.6  -1.8 1.8   3.2  "T" 10 0.60 12.0

			entry tagdlight tag_barrel 0.25 0.2 0.05 140 0.11
			entry tagspawnlinked tag_barrel
			(
				spawnrange 4096
				scale 0.4
				offsetalongaxis 1.5 0 0
				count 1
				model muzsprite.spr
				angles 0 0 crandom 25
				life 0.06
			)
			entry tagspawnlinked tag_barrel
			(
				spawnrange 4096
				count 1
				scalemin 0.9
				scalemax 1.1
				model models/fx/muzflash.tik
				randomroll
				life 0.04
			)

			// shell eject
			entry commanddelay 0.1 tagspawn tag_eject
			(
				spawnrange 1024
				count 1
				model models/ammo/rifleshell.tik
				scale 1.0
				velocity 20  //HZM MG: the case drops out of the port
				randvel crandom 6 crandom 6 -30
				emitterangles 0 0 0
				avelocity crandom 90 crandom 90 0
				accel 0 0 -800
				physicsrate 20
				life 2.0
				fadedelay 1.7
				collision
				bouncefactor 0.2
				bouncesoundonce snd_rifle_shell
			)

			entry tagspawn tag_barrel
			(
				spawnrate 1.00
				model vsssource.spr
				alpha 0.30
				color 1.00 1.00 1.00
				scale 0.10
				life 1.00
				scalerate 10.00
				velocity 65.00
				randvel range 20 -60 crandom -40 range 20 -60
				friction 7.00
				fade
				randomroll
			)
		}
	}
}
