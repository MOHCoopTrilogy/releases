TIKI
// [reload audit phase B 2026-10-05] MOD COPY of the xw pack's carbine.tik (zzzzz_xw_weapons.pk3), byte-identical
// except the reload block - the mod pk3 sorts after the xw pack, so this copy wins.
setup
{
	scale 0.52			// Set default scale to 16/30.5 since world is in 16 units per foot and model is in cm's
	path models/weapons/carbine
	skelmodel carbine.skd
	surface skin1 shader coop_skin_carbine_gold_5
	surface skin2 shader coop_skin_carbine_gold_3
	surface skin3 shader coop_skin_carbine_gold_0
	surface skin4 shader coop_skin_carbine_gold_4
        surface skin5 shader coop_skin_carbine_gold_2
        surface skin7 shader coop_skin_carbine_gold_4
        surface skin9 shader coop_skin_carbine_gold_1
}

init
{
	server
	{
				


		classname		Weapon
		weapontype		rifle
		name			"M1 Carbine (Gold)"
		rank			1014 1014

		pickupsound		m1_snd_pickup
		ammopickupsound	m1_snd_pickup_ammo
		noammosound		m1_snd_noammo

		// Holstering info
holstertag				"Bip01 Spine2"
holsteroffset			"8.0 -7.75 6.5"
holsterangles			"0 185 -25"
holsterScale			1.0

		// Primary fire type info
		firetype		bullet
		ammotype		"rifle"
		meansofdeath	bullet
		semiauto
		bulletcount		1
		clipsize		15
		startammo		15
		ammorequired	1
		firedelay		0.15

		//========================================//
		//		WEAPON ACCURACY MODELLING	//
		//========================================//

//		M1 Garand: Max Eff. Range is 300 yds with a muzzle velocity of 2800 ft/s. (30-06 Springfield)

		bulletrange		4000	 	//the range at which bulletspread is applied
		bulletspread	10 10 60 60 //minpitch minyaw maxpitch maxyaw
		bulletdamage	45
		firespreadmult	0.7 0.685 200 0.8
		zoomspreadmult  	0.055

		tracerfrequency 	2

		
                
		crosshair		1
//		viewkick		-2 -3   -1 1

		// AI animation group info
		weapongroup		rifle

		// DM Attributes
		dmbulletcount	1
		dmstartammo		195
		dmammorequired	1
		dmfiredelay		0.15

		dmbulletrange	4000
		dmbulletspread	10 10 80 80
//		dmbulletdamage	50
		dmbulletdamage	47
//		dmfirespreadmult 	0.7 0.685 200 0.8
		dmfirespreadmult 	0.75 0.6 200 0.8
		dmzoomspreadmult	0.055
		dmmovementspeed	0.94

		dmcrosshair		1
		
		// this is attached to the player during reload
		cache models/ammo/g43_clip.tik	// [reload audit phase B] the box magazine prop (g43_reload torso)
	}
	client
	{
		cache tracer.spr
		cache muzsprite.spr
		cache vsssource.spr
		cache models/fx/muzflash.tik
		cache models/ammo/rifleshell.tik
		cache models/fx/snipesmoke.tik
		cache models/ammo/garand_clip_empty.tik
	}
}

animations
{
	idle		garand.skc
	idle_empty	garand.skc
	//[reload audit phase B 2026-10-05] the M1 Carbine reloads its 15-round BOX MAGAZINE from below (was the Garand's
	//en-bloc reload anim). Static pose (coop_carbine_reload.skc = garand.skc frame 0 x 88, 2.93 s = the G43 torso the
	//carbine now uses); the magazine (skin7) is hidden while the left hand carries the swap (0.5-1.63 s = exactly the
	//torso g43_reload g43_clip prop window, so the magazine is never shown twice or not at all).
	reload		coop_carbine_reload.skc
	{
		server
		{
			15 surface skin7 +nodraw
			49 surface skin7 -nodraw
			last idle
		}
		client
		{
			entry sound thompson_snd_reload
		}
	}
	reload_s		coop_carbine_reload_s.skc
	{
		server
		{
			12 surface skin7 +nodraw
			39 surface skin7 -nodraw
			last idle
		}
		client
		{
			entry sound thompson_snd_reload
		}
	}
	reload_m		coop_carbine_reload_m.skc
	{
		server
		{
			12 surface skin7 +nodraw
			51 surface skin7 -nodraw
			last idle
		}
		client
		{
			entry sound thompson_snd_reload
		}
	}
	fire	garand_fire1.skc
	{
		server
		{
			entry shoot
		}
		client
		{
			entry stopaliaschannel m1_snd_fire
			entry sound m1_snd_fire

			// By now, the server has already fired the weapon, so it's
			// ok to apply the view kick apon entry to avoid problems
			// with multiple application on single frame animations.

			////////////////////////////////////////////////////////////////////////////////////////
			// View Kick Controls
			//
			// View Kicking works based on the assumptions that every weapon has its own tendencies to kick in
			// a paticular fashion. In MOH we call then scatter patterns. Currently we have 2 scatter patterns which
			// will be explained.
			// Scatter Patterns:
			// "V" - the cone. The longer you shoot the more random your shots will be in the horizontal axis.
			// "T" - the T shape. The gun has a tendancy to push in a paticular direction. not used much...too artificial looking
			//
			//
			//             		+-------------------------------------------- Scatter Pitch Min
			//              		|    +--------------------------------------- Scatter Pitch Max
			//              		|    |       +------------------------------- Scatter Yaw Min
			//             		|    |       |   +--------------------------- Scatter Yaw Max
			//             		|    |       |   |     +--------------------- The Recentering speed in fraction per second
			//              		|    |       |   |     |    +---------------- The Scatter Pattern
			//              		|    |       |   |     |    |     +---------- The absolute pitch min/max
			//              		|    |       |   |     |    |     |  +------- The absolute yaw min/max
			//              		|    |       |   |     |    |     |  | +----- This is the pitch at which you loose all
			//              		|    |       |   |     |    |     |  | |      control of the weapon and its behavior is
			//             	 	|    |       |   |     |    |     |  | |      purely random.
			//				V    V       V   V     V    V     V  V V

			entry viewkick 	    -2.5 -2.5   -0.1 -0.1   0.15   "T"  8.0 8.2 3.6

//			entry viewkick 	    -3.0 -3.0   -0.1 -0.1   0.15   "T"  8.0 8.2 3.6//original recent
//			entry viewkick 	    -1.0 -1.0   -0.1 -0.1   0.45   "T"  8.0 8.2 3.6//original old

			// muzzle flash
			entry tagdlight tag_barrel 0.25 0.2 0.15 150 0.11
			entry tagspawn tag_barrel
			(
				count 1
				model models/fx/muzflash.tik
				color 0.00 0.00 1.00
				scale 0.20
				life 0.01
				velocity 300.00
				alignstretch 0.02
				randomroll
			)

			entry tagspawn tag_barrel
			(
				count 1
				model muzsprite.spr
				color 1.00 1.00 1.00
				scale 0.10
				scalerate 10
				life 0.04
			)

			entry tagspawn tag_barrel
			(
				count 1
				scale .7
				model models/fx/snipesmoke.tik
			)

			// shell eject
			entry tagspawn tag_eject
			(
				spawnrange 2048
				count 1
				model models/ammo/rifleshell.tik
				scale 0.55  //HZM caliber
				velocity 70
				randvel crandom 10 crandom 10 random 20
				emitterangles 0 0 0
				avelocity crandom 90 crandom 90 0
				accel 0 0 -800
				life 2.0
				fadedelay 1.7
				collision
				bouncefactor 0.2
				bouncesoundonce snd_rifle_shell
			)

			// smoke puff
//			entry commanddelay 0.05 tagspawn tag_barrel
//			(
//				volumetric
//				model gun			// sets the type of smoke
//				life 10				// amount of smoke
//				scale 1.5			// radius
//				alpha 0.4			// density
//				color 0.7 0.7 0.7		// RBG color of the smoke
//				velocity 2			// base velocity away from the surface
//				randvelaxis random 6 0 0	// velocity offset
//				offsetalongaxis random 4 0 0	// positional offset
//			)
		}
	}
	fire_empty	garand.skc
	{
		server
		{
			entry shoot
		}
		client
		{
			entry stopaliaschannel m1_snd_fire
			entry sound m1_snd_fire

			// this view kick needs to match that in the main fire animation
			entry viewkick 	    -2.5 -2.5   -0.1 -0.1   0.15   "T"  8.0 8.2 3.6

			// muzzle flash
			entry tagdlight tag_barrel 0.25 0.2 0.15 150 0.11
			entry tagspawn tag_barrel
			(
				count 1
				model models/fx/muzflash.tik
				color 0.00 0.00 1.00
				scale 0.20
				life 0.01
				velocity 300.00
				alignstretch 0.03
				randomroll
			)

			entry tagspawn tag_barrel
			(
				count 1
				model muzsprite.spr
				color 1.00 1.00 1.00
				scale 0.10
				scalerate 10
				life 0.04
			)

			entry tagspawn tag_barrel
			(
				count 1
				scale .7
				model models/fx/snipesmoke.tik
			)

			// shell eject
			entry tagspawn tag_eject
			(
				spawnrange 2048
				count 1
				model models/ammo/rifleshell.tik
				scale 0.55  //HZM caliber
				velocity 70
				randvel crandom 10 crandom 10 random 20
				emitterangles 0 0 0
				avelocity crandom 90 crandom 90 0
				accel 0 0 -800
				physicsrate 20
				life 2.0
				fadedelay 1.7
				collision
				bouncefactor 0.2
				bouncesoundonce snd_rifle_shell
			)

			// eject the empty clip
			//entry commanddelay 0.3 tagspawn tag_eject
			(
				spawnrange 2048
				count 1
				model models/ammo/garand_clip_empty.tik
				scale 1.0
				velocity 40
				randvel crandom 20 crandom 20 60
				emitterangles 0 0 0
				avelocity crandom 70 crandom 70 0
				offset 0 0 2
				accel 0 0 -800
				physicsrate 20
				life 2.0
				fadedelay 1.7
				collision
				bouncefactor 0.2
				bouncesoundonce snd_rifle_shell
			)
			// and make the *ping* sound
			//entry commanddelay 0.3 sound snd_ping

			// smoke puff
//			entry commanddelay 0.05 tagspawn tag_barrel
//			(
//				volumetric
//				model gun			// sets the type of smoke
//				life 10				// amount of smoke
//				scale 1.5			// radius
//				alpha 0.4			// density
//				color 0.7 0.7 0.7		// RBG color of the smoke
//				velocity 2			// base velocity away from the surface
//				randvelaxis random 6 0 0	// velocity offset
//				offsetalongaxis random 4 0 0	// positional offset
//			)
		}
	}
}

/*QUAKED playerweapon_allied_m1-Garand (0.0 0.0 1.0) (-8 -8 -8) (8 8 8)
American rifle - M1 Garand.
*/